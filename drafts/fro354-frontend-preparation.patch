+import { PurchaseOrderStatusPill } from '#/features/purchase-orders/components/purchase-order-status-pill'
+import {
+  changeOrderOption,
+  editBlocked,
+} from '../customs-storage-details-rules'
+import {
+  fillLabel,
+  useCustomsStorageDetailsLabels,
+  type CustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import {
+  ChangeOrderLocalReason,
+  EntryIneligibleReason,
+  type EditingCard,
+  type EntryEligibility,
+  type OrderSearchResult,
+  type OrderSearchState,
+  type RecordHref,
+  type SaveFeedback,
+  type SavedEntry,
+} from '../types'
+import {
+  CardHeading,
+  EditActions,
+  EditButton,
+  ReadOnlyField,
+  RecordLink,
+  SearchPicker,
+  ValueMarker,
+  cancelOnEscape,
+  cardPadding,
+  formatAmount,
+  formatAthensDateTime,
+} from './customs-storage-details-ui-parts'
+
+/** A FRO-319 eligibility reason, with links to the Order or entry it names. */
+export function EligibilityReason({
+  eligibility,
+  hrefFor,
+  text,
+}: {
+  eligibility: EntryEligibility
+  hrefFor: RecordHref
+  text: CustomsStorageDetailsLabels
+}): ReactNode {
+  if (eligibility.eligible) return null
+  const withOrder = (template: string, entryNumber?: string) => {
+    const order = eligibility.order
+    if (!order) return template
+    const [before, after] = fillLabel(template, {
+      entryNumber: entryNumber ?? '',
+    }).split('{stockId}')
+    return (
+      <>
+        {before}
+        <RecordLink href={hrefFor('order', order.id)}>
+          {order.stockId}
+        </RecordLink>
+        {after}
+      </>
+    )
+  }
+  switch (eligibility.reason) {
+    case EntryIneligibleReason.CANCELLED:
+      return text.reasonCancelled
+    case EntryIneligibleReason.NOT_CUSTOMS_STORAGE:
+      return text.reasonNotCustomsStorage
+    case EntryIneligibleReason.NOT_ADMITTED:
+      return text.reasonNotAdmitted
+    case EntryIneligibleReason.ADMITTED_UNDER_ANOTHER_ORDER:
+      return withOrder(text.reasonAdmittedUnder)
+    case EntryIneligibleReason.ALREADY_COVERED:
+      return (
+        <>
+          {withOrder(text.reasonCovered, eligibility.entry?.entryNumber)}
+          {eligibility.entry && (
+            <>
+              {' '}
+              <RecordLink
+                href={hrefFor('entry', eligibility.entry.id)}
+                mono={false}
+              >
+                {text.open}
+              </RecordLink>
+            </>
+          )}
+        </>
+      )
+  }
+}
+
+export interface OrderRelationshipCardProps {
+  entry: SavedEntry
+  canEdit: boolean
+  editing: EditingCard
+  onEdit: () => void
+  onCancel: () => void
+  /** Opens the Change Order confirmation; disabled until an Order is chosen. */
+  onSave: () => void
+  onRefresh: () => void
+  saving: boolean
+  feedback: SaveFeedback | null
+  query: string
+  onQueryChange: (query: string) => void
+  /** Restores the field to the chosen Stock ID when the list closes. */
+  onSearchClose: () => void
+  search: OrderSearchState
+  onRetrySearch: () => void
+  onSelect: (orderId: string) => void
+  /** The eligible Order chosen in the picker, if any. */
+  chosen: OrderSearchResult | null
+  hrefFor: RecordHref
+}
+
+export function OrderRelationshipCard(props: OrderRelationshipCardProps) {
+  const { entry, editing, search, hrefFor } = props
+  const text = useCustomsStorageDetailsLabels()
+  const { locale } = useLocale()
+  const order = entry.owner
+  const editingHere = editing === 'order'
+  const editButton = useRef<HTMLButtonElement>(null)
+  const card = useRef<HTMLDivElement>(null)
+  const wasEditing = useRef(false)
+
+  // Focus the search when editing starts and return to Edit when it ends.
+  useEffect(() => {
+    if (editingHere && !wasEditing.current)
+      card.current
+        ?.querySelector<HTMLInputElement>('[role="combobox"]')
+        ?.focus()
+    if (!editingHere && wasEditing.current) editButton.current?.focus()
+    wasEditing.current = editingHere
+  }, [editingHere])
+
+  const results = search.kind === 'results' ? search.results : []
+  const status =
+    search.kind === 'loading' ? (
+      text.loading
+    ) : search.kind === 'error' ? (
+      <span className="flex flex-wrap items-center gap-2 text-danger-fg">
+        {text.searchFailed}
+        <Button size="sm" variant="secondary" onClick={props.onRetrySearch}>
+          {text.retry}
+        </Button>
+      </span>
+    ) : search.kind === 'results' && results.length === 0 ? (
+      text.noOrders
+    ) : search.kind === 'idle' ? (
+      text.orderSearchPlaceholder
+    ) : undefined
+
+  const reasonFor = (result: OrderSearchResult): ReactNode => {
+    const option = changeOrderOption(result, {
+      id: entry.id,
+      ownerId: order.id,
+    })
+    if (option.selectable) return undefined
+    if ('local' in option)
+      return option.local === ChangeOrderLocalReason.CURRENT_ORDER
+        ? text.reasonCurrentOrder
+        : text.reasonCoveredHere
+    return (
+      <EligibilityReason
+        eligibility={option.eligibility}
+        hrefFor={hrefFor}
+        text={text}
+      />
+    )
+  }
+
+  const action =
+    props.canEdit && !editingHere ? (
+      <EditButton
+        ref={editButton}
+        label={text.edit}
+        blockedHint={
+          editBlocked(editing, 'order') ? text.editBlocked : undefined
+        }
+        onClick={props.onEdit}
+      />
+    ) : undefined
+
+  const feedback = props.feedback
+  return (
+    <Card
+      flush
+      className={cardPadding}
+      role="region"
+      aria-labelledby="csd-order-heading"
+    >
+      <div
+        ref={card}
+        onKeyDown={editingHere ? cancelOnEscape(props.onCancel) : undefined}
+      >
+        <CardHeading
+          id="csd-order-heading"
+          title={text.orderRelationship}
+          action={action}
+        />
+        {editingHere && (
+          <div className="mb-4">
+            {/* New composition: SearchPicker with reasons (FRO-353 pattern). */}
+            <SearchPicker
+              label={text.order}
+              required
+              placeholder={text.orderSearchPlaceholder}
+              query={props.query}
+              onQueryChange={props.onQueryChange}
+              onClose={props.onSearchClose}
+              status={status}
+              fieldName="order"
+              onSelect={props.onSelect}
+              results={results.map((result) => ({
+                key: result.id,
+                primary: (
+                  <span className="flex flex-wrap items-center gap-2">
+                    <span className="font-mono">{result.stockId}</span>
+                    <PurchaseOrderStatusPill status={result.status} />
+                  </span>
+                ),
+                secondary: [result.clientName, result.supplierName]
+                  .filter(Boolean)
+                  .join(' · '),
+                unavailableReason: reasonFor(result),
+              }))}
+            />
+            {feedback?.kind === 'rejected' && (
+              <Alert tone="warning" className="mt-3">
+                <EligibilityReason
+                  eligibility={feedback.eligibility}
+                  hrefFor={hrefFor}
+                  text={text}
+                />
+              </Alert>
+            )}
+          </div>
+        )}
+
+        <div className="grid gap-x-5 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
+          <ReadOnlyField label={text.stockId}>
+            <RecordLink href={hrefFor('order', order.id)}>
+              {order.stockId}
+            </RecordLink>
+          </ReadOnlyField>
+          <ReadOnlyField label={text.admission}>
+            {`${order.warehouse.code} · ${order.warehouse.name} · ${formatAthensDateTime(order.admissionAt)}`}
+          </ReadOnlyField>
+          <ReadOnlyField label={text.admittedCollis} mono>
+            {String(order.admittedCollis)}
+          </ReadOnlyField>
+          <ReadOnlyField
+            label={text.grossWeight}
+            mono
+            marker={
+              order.grossWeightKg === null && (
+                <ValueMarker>{text.unknown}</ValueMarker>
+              )
+            }
+          >
+            {order.grossWeightKg === null
+              ? text.unknown
+              : fillLabel(text.grossWeightValue, {
+                  value: formatAmount(order.grossWeightKg, locale),
+                })}
+          </ReadOnlyField>
+          <ReadOnlyField
+            label={text.depositor}
+            marker={
+              !order.depositor && <ValueMarker>{text.missing}</ValueMarker>
+            }
+          >
+            {order.depositor?.name}
+          </ReadOnlyField>
+          <ReadOnlyField label={text.depositorVat} mono>
+            {order.depositor?.vatNumber}
+          </ReadOnlyField>
+          <ReadOnlyField label={text.client}>{order.client.name}</ReadOnlyField>
+          <ReadOnlyField
+            label={text.supplier}
+            marker={
+              !order.supplier && <ValueMarker>{text.missing}</ValueMarker>
+            }
+          >
+            {order.supplier?.name}
+          </ReadOnlyField>
+          <ReadOnlyField label={text.supplierVat} mono>
+            {order.supplier?.vatNumber}
+          </ReadOnlyField>
+        </div>
+
+        {editingHere && (
+          <EditActions
+            text={text}
+            feedback={
+              feedback?.kind === 'failed' || feedback?.kind === 'stale'
+                ? feedback.kind
+                : null
+            }
+            saving={props.saving}
+            saveDisabled={!props.chosen}
+            onCancel={props.onCancel}
+            onSave={props.onSave}
+            onRefresh={props.onRefresh}
+          />
+        )}
+      </div>
+    </Card>
+  )
+}
