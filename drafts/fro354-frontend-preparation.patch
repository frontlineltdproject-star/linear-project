+import { useLocale } from '#/app/providers/labels-provider'
+import { Alert } from '#/components/ui/alert'
+import { Card } from '#/components/ui/card'
+import { TBody, TD, TH, THead, TR, Table } from '#/components/ui/table'
+import { formatDMY, parseIsoDate } from '#/lib/date'
+import { invoiceTotals, statisticalVat } from '../customs-storage-details-rules'
+import { useCustomsStorageDetailsLabels } from '../localization/customs-storage-details-labels'
+import type { InvoiceRow, RecordHref } from '../types'
+import {
+  CardHeading,
+  RecordLink,
+  cardPadding,
+  formatAmount,
+  tableScroll,
+} from './customs-storage-details-ui-parts'
+
+export interface RelatedInvoicesCardProps {
+  invoices: InvoiceRow[]
+  hrefFor: RecordHref
+}
+
+const amountCell = 'whitespace-nowrap text-right font-mono'
+
+export function RelatedInvoicesCard({
+  invoices,
+  hrefFor,
+}: RelatedInvoicesCardProps) {
+  const text = useCustomsStorageDetailsLabels()
+  const { locale } = useLocale()
+  const totals = invoiceTotals(invoices)
+  const amount = (value: string) => formatAmount(value, locale)
+  const date = (value: string) => {
+    const parsed = parseIsoDate(value)
+    return parsed ? formatDMY(parsed) : value
+  }
+
+  return (
+    <Card flush className={cardPadding} aria-labelledby="csd-invoices-heading">
+      <CardHeading
+        id="csd-invoices-heading"
+        title={text.invoicesCard}
+        description={text.invoicesDescription}
+      />
+      {invoices.length === 0 ? (
+        <p className="rounded-md border border-dashed border-border p-4 text-sm text-fg-muted">
+          {text.noInvoices}
+        </p>
+      ) : (
+        <div className="space-y-3">
+          {totals.kind === 'mixedCurrency' && (
+            <Alert tone="warning">{text.mixedCurrency}</Alert>
+          )}
+          <div className={tableScroll}>
+            <Table>
+              <THead>
+                <TR>
+                  <TH>{text.invoiceId}</TH>
+                  <TH>{text.invoiceNumber}</TH>
+                  <TH>{text.invoiceDate}</TH>
+                  <TH>{text.supplier}</TH>
+                  <TH>{text.invoiceType}</TH>
+                  <TH>{text.currency}</TH>
+                  <TH className="text-right">{text.netValue}</TH>
+                  <TH className="text-right">{text.actualVat}</TH>
+                  <TH className="text-right">{text.statisticalVat}</TH>
+                </TR>
+              </THead>
+              <TBody>
+                {invoices.map((row) => (
+                  <TR key={row.id}>
+                    <TD>
+                      <RecordLink href={hrefFor('invoice', row.id)}>
+                        {row.id}
+                      </RecordLink>
+                    </TD>
+                    <TD className="whitespace-nowrap font-mono">
+                      {row.invoiceNumber}
+                    </TD>
+                    <TD className="whitespace-nowrap font-mono">
+                      {date(row.invoiceDate)}
+                    </TD>
+                    <TD>{row.supplierName ?? '—'}</TD>
+                    <TD>{row.invoiceType}</TD>
+                    <TD className="font-mono">{row.currency}</TD>
+                    <TD className={amountCell}>{amount(row.netValue)}</TD>
+                    <TD className={amountCell}>{amount(row.vatValue)}</TD>
+                    <TD className={amountCell}>
+                      {amount(statisticalVat(row.netValue))}
+                    </TD>
+                  </TR>
+                ))}
+              </TBody>
+              {totals.kind === 'eur' && (
+                // New composition: table.tsx has no footer part.
+                <tfoot className="border-t-2 border-border-strong bg-surface-2 font-semibold">
+                  <TR>
+                    <TD colSpan={6}>{text.totals}</TD>
+                    <TD className={amountCell}>{amount(totals.net)}</TD>
+                    <TD className={amountCell}>{amount(totals.vat)}</TD>
+                    <TD className={amountCell}>
+                      {amount(totals.statisticalVat)}
+                    </TD>
+                  </TR>
+                </tfoot>
+              )}
+            </Table>
+          </div>
+          <p className="text-xs text-fg-subtle">{text.statisticalVatNote}</p>
+        </div>
+      )}
+    </Card>
+  )
+}
