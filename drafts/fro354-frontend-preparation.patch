+import { Alert } from '#/components/ui/alert'
+import { StatusPill, type StatusTone } from '#/components/ui/badge'
+import { Card } from '#/components/ui/card'
+import { formatDMY, parseIsoDate } from '#/lib/date'
+import type { ExportCoverage } from '../customs-storage-details-rules'
+import {
+  fillLabel,
+  useCustomsStorageDetailsLabels,
+  type CustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import { CustomsStatus, type RecordHref } from '../types'
+import {
+  CardHeading,
+  ReadOnlyField,
+  RecordLink,
+  cardPadding,
+} from './customs-storage-details-ui-parts'
+
+const statusTone: Record<CustomsStatus, StatusTone> = {
+  [CustomsStatus.AWAITING_EAD]: 'warning',
+  [CustomsStatus.AWAITING_IE599]: 'info',
+  [CustomsStatus.COMPLETED]: 'success',
+}
+
+function statusLabel(text: CustomsStorageDetailsLabels, status: CustomsStatus) {
+  return status === CustomsStatus.AWAITING_EAD
+    ? text.awaitingEad
+    : status === CustomsStatus.AWAITING_IE599
+      ? text.awaitingIe599
+      : text.completed
+}
+
+export function RelatedExportCard({
+  coverage,
+  hrefFor,
+}: {
+  coverage: ExportCoverage
+  hrefFor: RecordHref
+}) {
+  const text = useCustomsStorageDetailsLabels()
+  const empty =
+    coverage.kind === 'noInvoices'
+      ? text.exportNoInvoices
+      : coverage.kind === 'notInExport'
+        ? text.exportNotYet
+        : null
+  const mrnDate =
+    coverage.kind === 'all' || coverage.kind === 'partial'
+      ? parseIsoDate(coverage.export.mrnDate)
+      : null
+
+  return (
+    <Card flush className={cardPadding} aria-labelledby="csd-export-heading">
+      <CardHeading id="csd-export-heading" title={text.exportCard} />
+      {empty !== null ? (
+        <p className="rounded-md border border-dashed border-border p-4 text-sm text-fg-muted">
+          {empty}
+        </p>
+      ) : coverage.kind === 'all' || coverage.kind === 'partial' ? (
+        <div className="space-y-3">
+          {coverage.kind === 'partial' && (
+            <Alert tone="info">
+              {fillLabel(text.exportPartial, {
+                count: coverage.inExport,
+                total: coverage.total,
+              })}
+            </Alert>
+          )}
+          <div className="grid gap-x-5 gap-y-4 sm:grid-cols-2 xl:grid-cols-4">
+            <ReadOnlyField label={text.exportLabel}>
+              <RecordLink href={hrefFor('export', coverage.export.id)}>
+                {coverage.export.exportNumber}
+              </RecordLink>
+            </ReadOnlyField>
+            <ReadOnlyField label={text.exportMrn} mono>
+              {coverage.export.mrn}
+            </ReadOnlyField>
+            <ReadOnlyField label={text.exportMrnDate} mono>
+              {mrnDate ? formatDMY(mrnDate) : null}
+            </ReadOnlyField>
+            <ReadOnlyField label={text.customsStatus}>
+              <StatusPill tone={statusTone[coverage.export.customsStatus]}>
+                {statusLabel(text, coverage.export.customsStatus)}
+              </StatusPill>
+            </ReadOnlyField>
+          </div>
+          <p className="text-xs text-fg-subtle">{text.exportSource}</p>
+        </div>
+      ) : null}
+    </Card>
+  )
+}
