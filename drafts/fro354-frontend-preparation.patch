+import { Button } from '#/components/ui/button'
+import { Modal } from '#/components/ui/modal'
+import { useCustomsStorageDetailsLabels } from '../localization/customs-storage-details-labels'
+
+/** Back to Order with a changed draft asks first. Keep editing keeps it. */
+export function DiscardChangesDialog({
+  open,
+  onKeep,
+  onDiscard,
+}: {
+  open: boolean
+  onKeep: () => void
+  onDiscard: () => void
+}) {
+  const text = useCustomsStorageDetailsLabels()
+  return (
+    <Modal
+      open={open}
+      onClose={onKeep}
+      size="sm"
+      title={text.discardTitle}
+      footer={
+        <>
+          <Button variant="secondary" onClick={onKeep}>
+            {text.keepEditing}
+          </Button>
+          <Button variant="danger" onClick={onDiscard}>
+            {text.discard}
+          </Button>
+        </>
+      }
+    >
+      <p className="text-sm text-fg-muted">{text.discardDescription}</p>
+    </Modal>
+  )
+}
