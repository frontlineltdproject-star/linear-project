+/**
+ * UI view models for the FRO-354 Customs Storage Entry details page. They
+ * mirror the reads FRO-319 will provide; no GraphQL type exists for them yet.
+ */
+
+export type CustomsStorageDetailsTab = 'overview' | 'invoices' | 'export'
+
+/** FRO-319 creation-eligibility reasons, in the order the server checks them. */
+export enum EntryIneligibleReason {
+  CANCELLED = 'CANCELLED',
+  NOT_CUSTOMS_STORAGE = 'NOT_CUSTOMS_STORAGE',
+  NOT_ADMITTED = 'NOT_ADMITTED',
+  ADMITTED_UNDER_ANOTHER_ORDER = 'ADMITTED_UNDER_ANOTHER_ORDER',
+  ALREADY_COVERED = 'ALREADY_COVERED',
+}
+
+/** Change Order reasons specific to this page; they come before FRO-319's. */
+export enum ChangeOrderLocalReason {
+  CURRENT_ORDER = 'CURRENT_ORDER',
+  COVERED_BY_THIS_ENTRY = 'COVERED_BY_THIS_ENTRY',
+}
+
+export interface OrderReference {
+  id: string
+  stockId: string
+}
+
+export interface EntryReference {
+  id: string
+  entryNumber: string
+}
+
+export type EntryEligibility =
+  | { eligible: true }
+  | {
+      eligible: false
+      reason: EntryIneligibleReason
+      /** The admitted Order (ADMITTED_UNDER_ANOTHER_ORDER) or owning Order (ALREADY_COVERED). */
+      order?: OrderReference
+      /** The covering entry (ALREADY_COVERED). */
+      entry?: EntryReference
+    }
+
+/** One row of FRO-319's Order search for entry creation. */
+export interface OrderSearchResult extends OrderReference {
+  status: string
+  clientName: string
+  supplierName: string | null
+  eligibility: EntryEligibility
+}
+
+/** What the Change Order picker shows for one search result. */
+export type ChangeOrderOption =
+  | { selectable: true }
+  | { selectable: false; local: ChangeOrderLocalReason }
+  | { selectable: false; eligibility: EntryEligibility }
+
+export interface CompanyFact {
+  name: string
+  vatNumber: string | null
+}
+
+export interface WarehouseReference {
+  id: string
+  code: string
+  name: string
+}
+
+/** The entry's owning Order with the facts FRO-319 derives from it. */
+export interface EntryOrder extends OrderReference {
+  admissionAt: string
+  warehouse: WarehouseReference
+  admittedCollis: number
+  /** Kilograms as a decimal string; null when FRO-319 reports it unknown. */
+  grossWeightKg: string | null
+  depositor: CompanyFact | null
+  client: CompanyFact
+  supplier: CompanyFact | null
+}
+
+/** Entry-owned values. Dates are ISO (yyyy-mm-dd), time HH:mm. */
+export interface EntryValues {
+  entryDate: string
+  entryTime: string
+  entryMrn: string
+  entryMrnDate: string
+  tariffCode: string
+  goodsDescription: string
+  transportMeans: string
+  permitNumber: string
+  operatorName: string
+  operatorVat: string
+  warehouseAddress: string
+}
+
+export type EntryField = keyof EntryValues
+
+/** A saved Customs Storage Entry as the details page reads it. */
+export interface SavedEntry {
+  id: string
+  entryNumber: string
+  /** Optimistic-concurrency token sent back with every save. */
+  version: string
+  values: EntryValues
+  createdBy: { name: string; at: string }
+  owner: EntryOrder
+}
+
+export interface InvoiceRow {
+  id: string
+  invoiceNumber: string
+  invoiceDate: string
+  supplierName: string | null
+  invoiceType: string
+  currency: string
+  /** Exact decimal strings with at most two decimals. */
+  netValue: string
+  vatValue: string
+  /** Export holding this invoice, if any. */
+  exportId: string | null
+}
+
+export enum CustomsStatus {
+  AWAITING_EAD = 'AWAITING_EAD',
+  AWAITING_IE599 = 'AWAITING_IE599',
+  COMPLETED = 'COMPLETED',
+}
+
+export interface ExportSummary {
+  id: string
+  exportNumber: string
+  mrn: string | null
+  mrnDate: string | null
+  customsStatus: CustomsStatus
+}
+
+/** Where the page was opened from (FRO-355 or FRO-353 success). */
+export interface ReturnContext {
+  order: OrderReference
+  /** True when that Order is a covered child, not the owner. */
+  coveredChild: boolean
+}
+
+export type PageState =
+  | { kind: 'loading' }
+  | { kind: 'error' }
+  | { kind: 'notFound'; entryNumber: string }
+  | { kind: 'denied' }
+  | { kind: 'ready' }
+
+/** The card currently in edit mode; only one at a time. */
+export type EditingCard = 'order' | 'details' | null
+
+/** Change Order search lookup state owned by the controller. */
+export type OrderSearchState =
+  | { kind: 'idle' }
+  | { kind: 'loading' }
+  | { kind: 'error' }
+  | { kind: 'results'; results: OrderSearchResult[] }
+
+export type SaveFeedback =
+  | { kind: 'validation' }
+  | { kind: 'failed' }
+  | { kind: 'stale' }
+  /** Change Order rejected by the server with a FRO-319 reason. */
+  | { kind: 'rejected'; eligibility: EntryEligibility }
+
+export type RecordKind = 'order' | 'entry' | 'invoice' | 'export'
+
+/** Authorized detail URLs supplied by the controller. */
+export type RecordHref = (kind: RecordKind, id: string) => string
