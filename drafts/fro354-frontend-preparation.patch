+import { useEffect, useId, useRef, type ReactNode } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Card } from '#/components/ui/card'
+import { DatePicker } from '#/components/ui/date-picker'
+import { FormField, Input, Textarea } from '#/components/ui/input'
+import { formatDMY, formatIsoDate, parseIsoDate } from '#/lib/date'
+import { cn } from '#/lib/utils'
+import {
+  athensNow,
+  editBlocked,
+  entryDateTimeLabel,
+  type EntryValueErrors,
+} from '../customs-storage-details-rules'
+import {
+  fillLabel,
+  useCustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import type {
+  EditingCard,
+  EntryField,
+  EntryValues,
+  SaveFeedback,
+  SavedEntry,
+  WarehouseReference,
+} from '../types'
+import {
+  CardHeading,
+  EditActions,
+  EditButton,
+  ReadOnlyField,
+  cancelOnEscape,
+  cardPadding,
+  entryErrorMessage,
+  formatAthensDateTime,
+} from './customs-storage-details-ui-parts'
+
+export const TRANSPORT_COMPANY = 'FRONT LINE Forwarding & Agency LTD'
+
+export interface EntryDetailsCardProps {
+  entry: SavedEntry
+  canEdit: boolean
+  editing: EditingCard
+  /** The open draft while this card is in edit mode. */
+  draft: EntryValues | null
+  errors: EntryValueErrors
+  onEdit: () => void
+  onChange: (field: EntryField, value: string) => void
+  onCancel: () => void
+  onSave: () => void
+  onRefresh: () => void
+  saving: boolean
+  feedback: SaveFeedback | null
+  /** Set after a Change Order moved the entry to another admitting warehouse. */
+  warehouseReview: WarehouseReference | null
+  /** Clock for the date limits; defaults to now. */
+  now?: Date
+}
+
+function SubCard({
+  id,
+  title,
+  children,
+}: {
+  id: string
+  title: string
+  children: ReactNode
+}) {
+  return (
+    <section
+      aria-labelledby={id}
+      className="rounded-md border border-border bg-canvas p-4"
+    >
+      <CardHeading id={id} title={title} level={3} />
+      {children}
+    </section>
+  )
+}
+
+export function EntryDetailsCard({
+  entry,
+  canEdit,
+  editing,
+  draft,
+  errors,
+  onEdit,
+  onChange,
+  onCancel,
+  onSave,
+  onRefresh,
+  saving,
+  feedback,
+  warehouseReview,
+  now = new Date(),
+}: EntryDetailsCardProps) {
+  const text = useCustomsStorageDetailsLabels()
+  const id = useId()
+  const editButton = useRef<HTMLButtonElement>(null)
+  const card = useRef<HTMLDivElement>(null)
+  const wasEditing = useRef(false)
+  const values = entry.values
+  const editingHere = editing === 'details' && draft !== null
+
+  // Focus the first field when editing starts and return to Edit when it ends.
+  useEffect(() => {
+    if (editingHere && !wasEditing.current)
+      card.current
+        ?.querySelector<HTMLElement>(
+          '[data-entry-field] button, [data-entry-field] input',
+        )
+        ?.focus()
+    if (!editingHere && wasEditing.current) editButton.current?.focus()
+    wasEditing.current = editingHere
+  }, [editingHere])
+
+  const today = parseIsoDate(athensNow(now).date) ?? undefined
+  const error = (field: EntryField) => {
+    const value = errors[field]
+    return value ? entryErrorMessage(text, field, value) : undefined
+  }
+  const optional = (label: string) => (
+    <>
+      {label}{' '}
+      <span className="font-normal text-fg-subtle">· {text.optional}</span>
+    </>
+  )
+  const savedDate = (value: string) => {
+    const parsed = parseIsoDate(value)
+    return parsed ? formatDMY(parsed) : null
+  }
+
+  /** A saved value, or its text control while editing. */
+  const textField = (
+    field: EntryField,
+    label: string,
+    options: {
+      mono?: boolean
+      maxLength?: number
+      hint?: string
+      inputMode?: 'numeric'
+    } = {},
+  ) =>
+    editingHere ? (
+      <div data-entry-field={field} className="min-w-0">
+        <FormField
+          label={optional(label)}
+          htmlFor={`${id}-${field}`}
+          error={error(field)}
+          hint={options.hint}
+        >
+          <Input
+            id={`${id}-${field}`}
+            value={draft[field]}
+            maxLength={options.maxLength ?? 500}
+            inputMode={options.inputMode}
+            invalid={!!errors[field]}
+            className={cn(options.mono && 'font-mono')}
+            onChange={(event) => onChange(field, event.target.value)}
+          />
+        </FormField>
+      </div>
+    ) : (
+      <ReadOnlyField label={label} mono={options.mono}>
+        {values[field]}
+      </ReadOnlyField>
+    )
+
+  const mrnDate = editingHere ? parseIsoDate(draft.entryMrnDate) : null
+  const action =
+    canEdit && !editingHere ? (
+      <EditButton
+        ref={editButton}
+        label={text.edit}
+        blockedHint={
+          editBlocked(editing, 'details') ? text.editBlocked : undefined
+        }
+        onClick={onEdit}
+      />
+    ) : undefined
+
+  return (
+    <Card
+      flush
+      className={cardPadding}
+      role="region"
+      aria-labelledby={`${id}-heading`}
+    >
+      <div
+        ref={card}
+        onKeyDown={editingHere ? cancelOnEscape(onCancel) : undefined}
+      >
+        <CardHeading
+          id={`${id}-heading`}
+          title={text.entryDetailsCard}
+          action={action}
+        />
+        <div className="space-y-4">
+          <SubCard id={`${id}-entry`} title={text.entryDetails}>
+            <div className="grid gap-x-5 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
+              <ReadOnlyField label={text.entryNumber} mono>
+                {entry.entryNumber}
+              </ReadOnlyField>
+              {editingHere ? (
+                <div data-entry-field="entryDate" className="min-w-0">
+                  <FormField
+                    label={text.entryDateTime}
+                    required
+                    error={error('entryDate')}
+                  >
+                    <div className="grid grid-cols-[minmax(0,1fr)_8rem] gap-2">
+                      <DatePicker
+                        value={parseIsoDate(draft.entryDate)}
+                        max={today}
+                        invalid={!!errors.entryDate}
+                        onChange={(date) =>
+                          onChange('entryDate', formatIsoDate(date))
+                        }
+                      />
+                      <Input
+                        type="time"
+                        aria-label={text.entryTime}
+                        value={draft.entryTime}
+                        invalid={!!errors.entryDate}
+                        className="font-mono"
+                        onChange={(event) =>
+                          onChange('entryTime', event.target.value)
+                        }
+                      />
+                    </div>
+                  </FormField>
+                </div>
+              ) : (
+                <ReadOnlyField label={text.entryDateTime} mono>
+                  {entryDateTimeLabel(values)}
+                </ReadOnlyField>
+              )}
+              {textField('entryMrn', text.entryMrn, { mono: true })}
+              {editingHere ? (
+                <div data-entry-field="entryMrnDate" className="min-w-0">
+                  <FormField
+                    label={optional(text.entryMrnDate)}
+                    error={error('entryMrnDate')}
+                  >
+                    <div className="flex flex-wrap gap-2">
+                      <div className="min-w-40 flex-1">
+                        <DatePicker
+                          value={mrnDate}
+                          max={today}
+                          invalid={!!errors.entryMrnDate}
+                          onChange={(date) =>
+                            onChange('entryMrnDate', formatIsoDate(date))
+                          }
+                        />
+                      </div>
+                      {mrnDate && (
+                        <Button
+                          variant="ghost"
+                          onClick={() => onChange('entryMrnDate', '')}
+                        >
+                          {text.clearDate}
+                        </Button>
+                      )}
+                    </div>
+                  </FormField>
+                </div>
+              ) : (
+                <ReadOnlyField label={text.entryMrnDate} mono>
+                  {savedDate(values.entryMrnDate)}
+                </ReadOnlyField>
+              )}
+              {textField('tariffCode', text.tariffCode, {
+                mono: true,
+                maxLength: 10,
+                inputMode: 'numeric',
+                hint: text.tariffHint,
+              })}
+            </div>
+            <p className="mt-3 text-xs text-fg-subtle">
+              {fillLabel(text.createdBy, {
+                user: entry.createdBy.name,
+                dateTime: formatAthensDateTime(entry.createdBy.at),
+              })}
+            </p>
+          </SubCard>
+
+          <SubCard id={`${id}-goods`} title={text.goodsAndTransport}>
+            <div className="grid gap-x-5 gap-y-4 sm:grid-cols-2">
+              {editingHere ? (
+                <div
+                  data-entry-field="goodsDescription"
+                  className="min-w-0 sm:col-span-2"
+                >
+                  <FormField
+                    label={optional(text.goodsDescription)}
+                    htmlFor={`${id}-goods-description`}
+                    error={error('goodsDescription')}
+                  >
+                    <Textarea
+                      id={`${id}-goods-description`}
+                      rows={4}
+                      maxLength={2000}
+                      value={draft.goodsDescription}
+                      invalid={!!errors.goodsDescription}
+                      onChange={(event) =>
+                        onChange('goodsDescription', event.target.value)
+                      }
+                    />
+                  </FormField>
+                </div>
+              ) : (
+                <ReadOnlyField
+                  label={text.goodsDescription}
+                  className="sm:col-span-2 [&>[role=group]]:whitespace-pre-line"
+                >
+                  {values.goodsDescription}
+                </ReadOnlyField>
+              )}
+              {textField('transportMeans', text.transportMeans)}
+              <ReadOnlyField label={text.transportCompany}>
+                {TRANSPORT_COMPANY}
+              </ReadOnlyField>
+            </div>
+          </SubCard>
+
+          <SubCard id={`${id}-operator`} title={text.warehouseOperator}>
+            {warehouseReview && (
+              <Alert tone="warning" className="mb-4">
+                {fillLabel(text.warehouseReview, {
+                  warehouse: `${warehouseReview.code} · ${warehouseReview.name}`,
+                })}
+              </Alert>
+            )}
+            <div className="grid gap-x-5 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
+              {textField('permitNumber', text.permitNumber, { mono: true })}
+              {textField('operatorName', text.operatorName)}
+              {textField('operatorVat', text.operatorVat, { mono: true })}
+              <div className="min-w-0 sm:col-span-2 xl:col-span-3">
+                {textField('warehouseAddress', text.warehouseAddress)}
+              </div>
+            </div>
+          </SubCard>
+        </div>
+
+        {editingHere && (
+          <EditActions
+            text={text}
+            feedback={
+              feedback && feedback.kind !== 'rejected' ? feedback.kind : null
+            }
+            saving={saving}
+            onCancel={onCancel}
+            onSave={onSave}
+            onRefresh={onRefresh}
+          />
+        )}
+      </div>
+    </Card>
+  )
+}
