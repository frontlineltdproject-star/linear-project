+import { describe, expect, it } from 'vitest'
+import {
+  canStartEdit,
+  changeOrderOption,
+  editBlocked,
+  entryDateTimeLabel,
+  exportCoverage,
+  firstErrorField,
+  invoiceTotals,
+  isEditDirty,
+  statisticalVat,
+  validateEntryValues,
+  warehouseChanged,
+} from './customs-storage-details-rules'
+import {
+  ChangeOrderLocalReason,
+  CustomsStatus,
+  EntryIneligibleReason,
+  type EntryValues,
+  type ExportSummary,
+  type InvoiceRow,
+  type OrderSearchResult,
+} from './types'
+
+// 10:00 in Athens (UTC+2 after the October clock change).
+const NOW = new Date('2026-10-27T08:00:30Z')
+
+const invoice = (
+  id: string,
+  netValue: string,
+  currency = 'EUR',
+  exportId: string | null = 'exp-1',
+): InvoiceRow => ({
+  id,
+  invoiceNumber: `INV-${id}`,
+  invoiceDate: '2026-10-12',
+  supplierName: 'Demo Supplier S.A.',
+  invoiceType: 'Αποθήκη Αποθήκευσης (Δελτίο Εισόδου)',
+  currency,
+  netValue,
+  vatValue: '0.00',
+  exportId,
+})
+
+const exp: ExportSummary = {
+  id: 'exp-1',
+  exportNumber: 'EXP-31',
+  mrn: '26GR0000EX00000412',
+  mrnDate: '2026-10-24',
+  customsStatus: CustomsStatus.AWAITING_IE599,
+}
+
+const saved: EntryValues = {
+  entryDate: '2026-10-20',
+  entryTime: '10:05',
+  entryMrn: '26GR0000CS00001042',
+  entryMrnDate: '2026-10-20',
+  tariffCode: '0402100000',
+  goodsDescription: 'Ship spares',
+  transportMeans: 'Truck DEMO-1234',
+  permitNumber: 'DEMO-CS-0001',
+  operatorName: 'Demo Hub Operator S.A.',
+  operatorVat: '800000003',
+  warehouseAddress: 'Demo Street 12, 18545 Piraeus',
+}
+
+const values = (patch: Partial<EntryValues> = {}): EntryValues => ({
+  ...saved,
+  ...patch,
+})
+
+const result = (
+  id: string,
+  eligibility: OrderSearchResult['eligibility'],
+): OrderSearchResult => ({
+  id,
+  stockId: id.toUpperCase(),
+  status: 'IN_STOCK',
+  clientName: 'Demo Client Company',
+  supplierName: 'Demo Supplier S.A.',
+  eligibility,
+})
+
+const thisEntry = { id: 'cse-1042', ownerId: 'po-5' }
+
+describe('Statistical VAT and totals', () => {
+  it('rounds 24% of each row half-up in its own currency', () => {
+    expect(statisticalVat('250.00')).toBe('60.00')
+    expect(statisticalVat('199.99')).toBe('48.00')
+    expect(statisticalVat('0.02')).toBe('0.00')
+    expect(statisticalVat('0.03')).toBe('0.01')
+  })
+
+  it('totals only when every row is EUR, rounding the total once', () => {
+    const rows = [
+      invoice('1', '250.00'),
+      invoice('2', '199.99'),
+      invoice('3', '210.50'),
+      invoice('4', '143.13'),
+    ]
+    expect(invoiceTotals(rows)).toEqual({
+      kind: 'eur',
+      net: '803.62',
+      vat: '0.00',
+      statisticalVat: '192.87',
+    })
+  })
+
+  it('shows no totals for mixed currency or no rows', () => {
+    expect(
+      invoiceTotals([invoice('1', '10.00'), invoice('2', '5.00', 'USD')]),
+    ).toEqual({ kind: 'mixedCurrency' })
+    expect(invoiceTotals([])).toEqual({ kind: 'none' })
+  })
+})
+
+describe('Export coverage', () => {
+  it('distinguishes no invoices, none in an Export, all and partial', () => {
+    expect(exportCoverage([], null)).toEqual({ kind: 'noInvoices' })
+    expect(exportCoverage([invoice('1', '1.00', 'EUR', null)], null)).toEqual({
+      kind: 'notInExport',
+    })
+    expect(exportCoverage([invoice('1', '1.00')], exp)).toEqual({
+      kind: 'all',
+      export: exp,
+    })
+    expect(
+      exportCoverage(
+        [invoice('1', '1.00'), invoice('2', '1.00', 'EUR', null)],
+        exp,
+      ),
+    ).toEqual({ kind: 'partial', export: exp, inExport: 1, total: 2 })
+  })
+})
+
+describe('entry validation', () => {
+  it('accepts the saved values', () => {
+    expect(validateEntryValues(values(), NOW)).toEqual({})
+  })
+
+  it('requires date and time and rejects a future date-time', () => {
+    expect(validateEntryValues(values({ entryTime: '' }), NOW)).toEqual({
+      entryDate: 'required',
+    })
+    expect(
+      validateEntryValues(
+        values({ entryDate: '2026-10-27', entryTime: '10:01' }),
+        NOW,
+      ),
+    ).toEqual({ entryDate: 'future' })
+    expect(
+      validateEntryValues(
+        values({ entryDate: '2026-10-27', entryTime: '10:00' }),
+        NOW,
+      ),
+    ).toEqual({})
+  })
+
+  it('rejects an MRN date after today and a bad tariff code', () => {
+    expect(
+      validateEntryValues(values({ entryMrnDate: '2026-10-28' }), NOW),
+    ).toEqual({ entryMrnDate: 'future' })
+    for (const tariffCode of ['12a', '12345678901', '1.5'])
+      expect(validateEntryValues(values({ tariffCode }), NOW)).toEqual({
+        tariffCode: 'format',
+      })
+    expect(validateEntryValues(values({ tariffCode: '0012' }), NOW)).toEqual({})
+  })
+
+  it('enforces text limits and reports the first field in page order', () => {
+    const errors = validateEntryValues(
+      values({
