+import { describe, expect, it } from 'vitest'
+import {
+  customsStorageDetailsLabelsFor,
+  fillLabel,
+} from './customs-storage-details-labels'
+
+describe('customs storage details labels', () => {
+  it('provides every key in English and Greek', () => {
+    const en = customsStorageDetailsLabelsFor('en')
+    const el = customsStorageDetailsLabelsFor('el')
+    expect(Object.keys(el).sort()).toEqual(Object.keys(en).sort())
+    for (const value of [...Object.values(en), ...Object.values(el)])
+      expect(value.trim()).not.toBe('')
+  })
+
+  it('keeps the same placeholders in both languages', () => {
+    const en = customsStorageDetailsLabelsFor('en')
+    const el = customsStorageDetailsLabelsFor('el')
+    const placeholders = (s: string) => (s.match(/\{\w+\}/g) ?? []).sort()
+    for (const key of Object.keys(en) as (keyof typeof en)[])
+      expect(placeholders(el[key])).toEqual(placeholders(en[key]))
+  })
+
+  it('fills placeholders and leaves unknown ones', () => {
+    expect(fillLabel('Back to Order {stockId}', { stockId: 'PO-1' })).toBe(
+      'Back to Order PO-1',
+    )
+    expect(fillLabel('{count} of {total}', { count: 2 })).toBe('2 of {total}')
+  })
+})
