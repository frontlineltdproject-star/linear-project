+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Modal } from '#/components/ui/modal'
+import {
+  fillLabel,
+  useCustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import type { WarehouseReference } from '../types'
+
+export interface ChangeOrderDialogProps {
+  /** The chosen Order; the dialog is closed when null. */
+  target: { stockId: string } | null
+  /** The chosen Order's admitting warehouse when it differs from the current one. */
+  otherWarehouse: WarehouseReference | null
+  confirming: boolean
+  /** Cancel, Escape or the backdrop; nothing is saved. */
+  onCancel: () => void
+  onConfirm: () => void
+}
+
+/** Simple Change Order confirmation; no impact breakdown (FRO-354). */
+export function ChangeOrderDialog({
+  target,
+  otherWarehouse,
+  confirming,
+  onCancel,
+  onConfirm,
+}: ChangeOrderDialogProps) {
+  const text = useCustomsStorageDetailsLabels()
+  const stockId = target?.stockId ?? ''
+  return (
+    <Modal
+      open={target !== null}
+      onClose={onCancel}
+      size="md"
+      title={fillLabel(text.changeOrderTitle, { stockId })}
+      footer={
+        <>
+          <Button variant="secondary" onClick={onCancel}>
+            {text.cancel}
+          </Button>
+          <Button onClick={onConfirm} loading={confirming}>
+            {text.confirmChange}
+          </Button>
+        </>
+      }
+    >
+      <div className="space-y-3">
+        <p className="text-sm text-fg">
+          {fillLabel(text.changeOrderText, { stockId })}
+        </p>
+        {otherWarehouse && (
+          <Alert tone="warning">
+            {fillLabel(text.changeOrderWarehouse, {
+              stockId,
+              warehouse: `${otherWarehouse.code} · ${otherWarehouse.name}`,
+            })}
+          </Alert>
+        )}
+      </div>
+    </Modal>
+  )
+}
