+import {
+  forwardRef,
+  useEffect,
+  useId,
+  useRef,
+  useState,
+  type KeyboardEvent,
+  type ReactNode,
+} from 'react'
+import { Search } from 'lucide-react'
+import type { Locale } from '#/app/providers/labels-provider'
+import { Alert } from '#/components/ui/alert'
+import { Badge } from '#/components/ui/badge'
+import { Button } from '#/components/ui/button'
+import { Input, Label } from '#/components/ui/input'
+import { cn } from '#/lib/utils'
+import {
+  textLimits,
+  type EntryValueError,
+} from '../customs-storage-details-rules'
+import {
+  fillLabel,
+  type CustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import type { EntryField } from '../types'
+
+/*
+ * Local copies of the FRO-353 parts (mock/fro-353-customs-storage-entry-create,
+ * `../create/components/customs-storage-ui-parts.tsx`, themselves copies of the
+ * FRO-350 picker parts), so this folder shares no file with another mock
+ * branch. De-duplicate with `create/` on integration. New here: the card
+ * heading action slot and `EditActions`.
+ */
+
+/** Card spacing used by every FRO-354 card. */
+export const cardPadding = 'p-4 min-[701px]:p-5'
+
+/** Tables scroll inside their card; `relative` keeps visually hidden headers inside. */
+export const tableScroll =
+  'relative max-w-full overflow-x-auto rounded-lg border border-border'
+
+export function CardHeading({
+  id,
+  title,
+  description,
+  level = 2,
+  action,
+}: {
+  id: string
+  title: string
+  description?: string
+  level?: 2 | 3
+  /** Top-right card action, such as Edit. */
+  action?: ReactNode
+}) {
+  const Heading = level === 2 ? 'h2' : 'h3'
+  return (
+    <div className="mb-4 flex min-w-0 flex-wrap items-start justify-between gap-3">
+      <div className="min-w-0">
+        <Heading id={id} className="text-subheading text-fg">
+          {title}
+        </Heading>
+        {description && (
+          <p className="mt-1 text-body-sm text-fg-muted">{description}</p>
+        )}
+      </div>
+      {action}
+    </div>
+  )
+}
+
+/**
+ * The card's Edit button (FRO-348/352 per-card pattern). While another card is
+ * in edit mode it stays visible but disabled, with the reason underneath.
+ */
+export const EditButton = forwardRef<
+  HTMLButtonElement,
+  { label: string; blockedHint?: string; onClick: () => void }
+>(function EditButton({ label, blockedHint, onClick }, ref) {
+  const hintId = useId()
+  return (
+    <div className="flex flex-col items-end gap-1">
+      <Button
+        ref={ref}
+        variant="secondary"
+        size="sm"
+        disabled={!!blockedHint}
+        aria-describedby={blockedHint ? hintId : undefined}
+        onClick={onClick}
+      >
+        {label}
+      </Button>
+      {blockedHint && (
+        <p id={hintId} className="max-w-56 text-right text-xs text-fg-muted">
+          {blockedHint}
+        </p>
+      )}
+    </div>
+  )
+})
+
+/** Save feedback and Cancel / Save at the bottom of a card in edit mode. */
+export function EditActions({
+  text,
+  feedback,
+  saving,
+  saveDisabled,
+  onCancel,
+  onSave,
+  onRefresh,
+}: {
+  text: CustomsStorageDetailsLabels
+  feedback: 'validation' | 'failed' | 'stale' | null
+  saving: boolean
+  saveDisabled?: boolean
+  onCancel: () => void
+  onSave: () => void
+  onRefresh: () => void
+}) {
+  return (
+    <div className="mt-4 space-y-3">
+      {feedback === 'validation' && (
+        <Alert tone="danger">{text.errorSummary}</Alert>
+      )}
+      {feedback === 'failed' && <Alert tone="danger">{text.saveFailed}</Alert>}
+      {feedback === 'stale' && (
+        <Alert tone="warning">
+          <span>{text.saveStale}</span>{' '}
+          <Button size="sm" variant="secondary" onClick={onRefresh}>
+            {text.refresh}
+          </Button>
+        </Alert>
+      )}
+      <div className="flex flex-wrap justify-end gap-2">
+        <Button variant="secondary" onClick={onCancel}>
+          {text.cancel}
+        </Button>
+        <Button onClick={onSave} loading={saving} disabled={saveDisabled}>
+          {saving ? text.saving : text.save}
+        </Button>
+      </div>
+    </div>
+  )
+}
+
+/** Escape cancels a card's edit unless an open picker or calendar takes it first. */
+export function cancelOnEscape(onCancel: () => void) {
+  return (event: KeyboardEvent<HTMLElement>) => {
+    if (
+      event.key !== 'Escape' ||
+      event.defaultPrevented ||
+      event.currentTarget.querySelector('[aria-expanded="true"]')
+    )
+      return
+    event.preventDefault()
+    onCancel()
+  }
+}
+
+/** A value flag such as Unknown or Missing; text, never colour alone. */
+export function ValueMarker({ children }: { children: ReactNode }) {
+  return (
+    <Badge tone="warning" className="ml-1.5 align-middle">
+      {children}
+    </Badge>
+  )
+}
+
+export function ReadOnlyField({
+  label,
+  marker,
+  className,
+  mono = false,
+  children,
+}: {
+  label: string
+  marker?: ReactNode
+  className?: string
+  mono?: boolean
+  children?: ReactNode
+}) {
+  const id = useId()
+  const empty = children === null || children === undefined || children === ''
+  return (
+    <div className={cn('flex min-w-0 flex-col gap-1.5', className)}>
+      <Label id={id}>
+        {label}
+        {marker}
+      </Label>
+      <div
+        aria-labelledby={id}
+        role="group"
+        className={cn(
+          'flex min-h-10 items-center rounded-md border border-border bg-surface-2 px-3 py-1.5 text-sm [overflow-wrap:anywhere]',
+          empty ? 'text-fg-subtle' : 'text-fg',
+          mono && !empty && 'font-mono',
+        )}
+      >
+        {empty ? '—' : children}
+      </div>
+    </div>
+  )
+}
+
+export function RecordLink({
+  href,
+  mono = true,
+  children,
+}: {
+  href: string
+  mono?: boolean
+  children: ReactNode
+}) {
+  return (
+    <a
+      href={href}
+      className={cn(
+        'font-semibold text-accent-active underline underline-offset-2 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40',
+        mono && 'font-mono',
+      )}
+    >
+      {children}
+    </a>
+  )
+}
+
+const athensParts = new Intl.DateTimeFormat('en-GB', {
+  timeZone: 'Europe/Athens',
+  day: '2-digit',
+  month: '2-digit',
+  year: 'numeric',
+  hour: '2-digit',
+  minute: '2-digit',
+  hourCycle: 'h23',
+})
+
+/** dd/mm/yyyy HH:mm of an instant in Europe/Athens, the same in EN and EL. */
+export function formatAthensDateTime(iso: string): string {
+  const parts = athensParts.formatToParts(new Date(iso))
+  const part = (type: Intl.DateTimeFormatPartTypes) =>
+    parts.find((p) => p.type === type)?.value ?? ''
+  return `${part('day')}/${part('month')}/${part('year')} ${part('hour')}:${part('minute')}`
+}
+
+/** Formats an exact decimal string with two decimals, without float conversion. */
+export function formatAmount(value: string, locale: Locale): string {
+  const [whole, fraction = ''] = value.split('.')
+  const group = locale === 'el' ? '.' : ','
+  const decimal = locale === 'el' ? ',' : '.'
+  const grouped = whole.replace(/\B(?=(\d{3})+(?!\d))/g, group)
+  return `${grouped}${decimal}${fraction.padEnd(2, '0').slice(0, 2)}`
+}
+
+export interface SearchPickerResult {
+  key: string
+  primary: ReactNode
+  secondary?: ReactNode
+  /** When set, the result is listed but cannot be selected. */
+  unavailableReason?: ReactNode
+  /** Extra control shown under an unavailable result (e.g. Open). */
+  unavailableAction?: ReactNode
+}
+
+export interface SearchPickerProps {
+  label: string
+  placeholder: string
+  query: string
+  onQueryChange: (query: string) => void
+  /** Restores the field to the selected value when the list closes. */
+  onClose?: () => void
+  results: SearchPickerResult[]
+  /** Replaces the results with a loading, empty or error row. */
+  status?: ReactNode
+  onSelect: (key: string) => void
+  required?: boolean
+  fieldName: string
+}
+
+/**
+ * Search field with an overlay result list (FRO-347/350 picker behaviour):
+ * opens on focus or click, closes on outside click, focus leaving or Escape.
+ * Arrow keys move through results, including unavailable ones so their reason
+ * is read; Enter selects only available results. Typing never changes the
+ * current selection.
+ */
+export function SearchPicker({
+  label,
+  placeholder,
+  query,
+  onQueryChange,
+  onClose,
+  results,
+  status,
+  onSelect,
+  required,
+  fieldName,
+}: SearchPickerProps) {
+  const id = useId()
+  const [open, setOpen] = useState(false)
+  const root = useRef<HTMLDivElement>(null)
+  const input = useRef<HTMLInputElement>(null)
+  const suppressOpen = useRef(false)
+
+  function close() {
+    setOpen(false)
+    onClose?.()
+  }
+
+  useEffect(() => {
+    if (!open) return
+    const onPointer = (event: PointerEvent) => {
+      if (!root.current?.contains(event.target as Node)) close()
+    }
+    document.addEventListener('pointerdown', onPointer)
+    return () => document.removeEventListener('pointerdown', onPointer)
+  })
+
+  function options() {
+    return Array.from(
+      root.current?.querySelectorAll<HTMLElement>('[data-picker-option]') ?? [],
+    )
+  }
+
+  function onKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    if (event.key === 'Escape' && open) {
+      event.preventDefault()
+      close()
+      if (document.activeElement !== input.current) {
+        suppressOpen.current = true
+        input.current?.focus()
+      }
+      return
+    }
+    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
+    event.preventDefault()
+    if (!open) setOpen(true)
+    requestAnimationFrame(() => {
+      const list = options()
+      if (list.length === 0) return
+      const current = list.indexOf(document.activeElement as HTMLElement)
+      const next =
+        event.key === 'ArrowDown'
+          ? Math.min(current + 1, list.length - 1)
+          : current <= 0
+            ? -1
+            : current - 1
+      if (next < 0) input.current?.focus()
+      else list[next].focus()
+    })
+  }
+
+  const optionClass =
+    'block w-full rounded-md px-2.5 py-2 text-left outline-none hover:bg-accent-subtle focus-visible:bg-accent-subtle'
+
+  return (
+    <div
+      ref={root}
+      className="relative flex min-w-0 flex-col gap-1.5"
+      data-entry-field={fieldName}
+      onKeyDown={onKeyDown}
+      onBlur={(event) => {
+        if (open && !root.current?.contains(event.relatedTarget as Node | null))
+          close()
+      }}
+    >
+      <Label htmlFor={`${id}-input`} required={required}>
+        {label}
+      </Label>
+      <Input
+        ref={input}
+        id={`${id}-input`}
+        role="combobox"
+        aria-expanded={open}
+        aria-controls={`${id}-list`}
+        aria-autocomplete="list"
+        autoComplete="off"
+        placeholder={placeholder}
+        value={query}
+        leadingIcon={<Search aria-hidden />}
+        onFocus={() => {
+          if (suppressOpen.current) suppressOpen.current = false
+          else setOpen(true)
+        }}
+        onClick={() => setOpen(true)}
+        onChange={(event) => {
+          onQueryChange(event.target.value)
+          setOpen(true)
+        }}
+      />
+      {open && (
+        <ul
+          id={`${id}-list`}
+          role="listbox"
+          aria-label={label}
+          className="absolute inset-x-0 top-full mt-1 max-h-80 overflow-y-auto rounded-md border border-border bg-surface p-1 shadow-popover"
+          style={{ zIndex: 'var(--z-popover)' as unknown as number }}
+        >
+          {status ? (
+            <li className="px-2.5 py-2 text-xs text-fg-muted">{status}</li>
+          ) : (
+            results.map((result) => {
+              const unavailable = result.unavailableReason != null
+              const body = (
+                <>
+                  <span className="block text-sm font-semibold text-fg">
+                    {result.primary}
+                  </span>
+                  {result.secondary && (
+                    <span className="block text-xs text-fg-muted">
+                      {result.secondary}
+                    </span>
+                  )}
+                </>
+              )
+              return (
+                <li
+                  key={result.key}
+                  role="option"
+                  aria-selected={false}
+                  aria-disabled={unavailable || undefined}
+                >
+                  {unavailable ? (
+                    <div
+                      data-picker-option
+                      tabIndex={-1}
+                      aria-disabled
+                      className={cn(optionClass, 'cursor-not-allowed')}
+                    >
+                      {body}
+                      <span className="mt-0.5 block text-xs text-warning-fg">
+                        {result.unavailableReason}
+                      </span>
+                      {result.unavailableAction}
+                    </div>
+                  ) : (
+                    <button
+                      type="button"
+                      data-picker-option
+                      className={optionClass}
+                      onClick={() => {
+                        onSelect(result.key)
+                        setOpen(false)
+                      }}
+                    >
+                      {body}
+                    </button>
+                  )}
+                </li>
+              )
+            })
+          )}
+        </ul>
+      )}
+    </div>
+  )
+}
+
+/** Focuses the first control of a field after the controller opens Overview. */
+export function focusEntryField(field: EntryField) {
+  requestAnimationFrame(() => {
+    const container = document.querySelector<HTMLElement>(
+      `[data-entry-field="${field}"]`,
+    )
+    const target =
+      container?.querySelector<HTMLElement>('input, textarea, button') ??
+      container
+    target?.focus()
+  })
+}
+
+export function entryErrorMessage(
+  text: CustomsStorageDetailsLabels,
+  field: EntryField,
+  error: EntryValueError,
+): string {
+  if (error === 'tooLong')
+    return fillLabel(text.errorTooLong, { limit: textLimits[field] ?? 500 })
+  switch (field) {
+    case 'entryDate':
+    case 'entryTime':
+      return error === 'required'
+        ? text.errorEntryDateRequired
+        : text.errorEntryDateFuture
+    case 'entryMrnDate':
+      return text.errorMrnDateFuture
+    case 'tariffCode':
+      return text.errorTariff
+    default:
+      return text.errorSummary
+  }
+}
