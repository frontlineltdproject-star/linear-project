+import { useEffect, useRef, type KeyboardEvent, type ReactNode } from 'react'
+import { TopBar } from '#/components/layout/top-bar'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Card } from '#/components/ui/card'
+import { Tab, TabList, TabPanel, Tabs } from '#/components/ui/tabs'
+import { entryDateTimeLabel } from '../customs-storage-details-rules'
+import {
+  fillLabel,
+  useCustomsStorageDetailsLabels,
+} from '../localization/customs-storage-details-labels'
+import type {
+  CustomsStorageDetailsTab,
+  PageState,
+  RecordHref,
+  ReturnContext,
+  SavedEntry,
+} from '../types'
+
+export interface CustomsStorageDetailsPanels {
+  overview: ReactNode
+  invoices: ReactNode
+  export: ReactNode
+}
+
+export interface CustomsStorageDetailsLayoutProps {
+  state: PageState
+  /** Required when `state.kind` is `ready`. */
+  entry?: SavedEntry
+  panels: CustomsStorageDetailsPanels
+  activeTab: CustomsStorageDetailsTab
+  onTabChange: (tab: CustomsStorageDetailsTab) => void
+  invoiceCount: number
+  /** Present only when opened from an Order (FRO-355) or after creation. */
+  returnContext?: ReturnContext | null
+  /** Back to Order; the controller asks first when a draft is open. */
+  onBack: () => void
+  onRetry: () => void
+  hrefFor: RecordHref
+  /** Header action place reserved for FRO-358's Print. */
+  headerActions?: ReactNode
+}
+
+const tabValues: CustomsStorageDetailsTab[] = ['overview', 'invoices', 'export']
+
+export function CustomsStorageDetailsLayout({
+  state,
+  entry,
+  panels,
+  activeTab,
+  onTabChange,
+  invoiceCount,
+  returnContext,
+  onBack,
+  onRetry,
+  hrefFor,
+  headerActions,
+}: CustomsStorageDetailsLayoutProps) {
+  const text = useCustomsStorageDetailsLabels()
+  const tabList = useRef<HTMLDivElement>(null)
+
+  // Complete roving focus locally without changing the shared Tabs primitive.
+  useEffect(() => {
+    tabList.current
+      ?.querySelectorAll<HTMLButtonElement>('[role="tab"]')
+      .forEach((tab, index) => {
+        tab.tabIndex = tabValues[index] === activeTab ? 0 : -1
+      })
+  }, [activeTab, state.kind])
+
+  function onTabKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    const tabs = Array.from(
+      event.currentTarget.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
+    )
+    const current = tabs.indexOf(event.target as HTMLButtonElement)
+    if (
+      current < 0 ||
+      !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)
+    )
+      return
+    event.preventDefault()
+    const next =
+      event.key === 'Home'
+        ? 0
+        : event.key === 'End'
+          ? tabs.length - 1
+          : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) %
+            tabs.length
+    onTabChange(tabValues[next])
+    tabs[next].focus()
+  }
+
+  if (state.kind === 'denied')
+    return (
+      <div className="min-w-0">
+        <Alert tone="danger">{text.accessDenied}</Alert>
+      </div>
+    )
+
+  if (state.kind === 'loading')
+    return (
+      <div className="min-w-0 space-y-5" aria-busy="true">
+        <span className="sr-only">{text.loading}</span>
+        <div className="h-7 w-72 max-w-full animate-pulse rounded-md bg-surface-2" />
+        <Card flush className="space-y-3 p-4 min-[701px]:p-5">
+          {[0, 1, 2].map((row) => (
+            <div
+              key={row}
+              className="h-10 animate-pulse rounded-md bg-surface-2"
+            />
+          ))}
+        </Card>
+      </div>
+    )
+
+  if (state.kind === 'error')
+    return (
+      <div className="min-w-0">
+        <Alert tone="danger">
+          <span className="flex flex-wrap items-center gap-2">
+            {text.loadFailed}
+            <Button size="sm" variant="secondary" onClick={onRetry}>
+              {text.retry}
+            </Button>
+          </span>
+        </Alert>
+      </div>
+    )
+
+  if (state.kind === 'notFound')
+    return (
+      <div className="min-w-0">
+        <p className="rounded-md border border-dashed border-border p-4 text-sm text-fg-muted">
+          {fillLabel(text.notFound, { entryNumber: state.entryNumber })}
+        </p>
+      </div>
+    )
+
+  if (!entry) return null
+
+  return (
+    <div className="min-w-0 space-y-5">
+      <div className="[&>div]:mb-2">
+        <TopBar
+          title={fillLabel(text.title, { entryNumber: entry.entryNumber })}
+          description={fillLabel(text.subtitle, {
+            stockId: entry.owner.stockId,
+            dateTime: entryDateTimeLabel(entry.values),
+          })}
+          actions={headerActions}
+        />
+        {returnContext && (
+          <p className="text-body-sm">
+            <a
+              href={hrefFor('order', returnContext.order.id)}
+              onClick={(event) => {
+                event.preventDefault()
+                onBack()
+              }}
+              className="font-semibold text-accent-active underline underline-offset-2 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40"
+            >
+              {fillLabel(text.backToOrder, {
+                stockId: returnContext.order.stockId,
+              })}
+            </a>
+          </p>
+        )}
+      </div>
+      {returnContext?.coveredChild && (
+        <Alert tone="info">
+          {fillLabel(text.coveredChild, {
+            childStockId: returnContext.order.stockId,
+            ownerStockId: entry.owner.stockId,
+          })}
+        </Alert>
+      )}
+      <Card flush className="p-4 min-[701px]:p-5">
+        <Tabs
+          defaultValue="overview"
+          value={activeTab}
+          onValueChange={(value) => {
+            const tab = tabValues.find((t) => t === value)
+            if (tab) onTabChange(tab)
+          }}
+        >
+          <div
+            ref={tabList}
+            onKeyDown={onTabKeyDown}
+            className="overflow-x-auto"
+          >
+            {/* Long Greek labels stay on one line; the row scrolls instead. */}
+            <TabList className="w-max min-w-full [&>[role=tab]]:whitespace-nowrap">
+              <Tab value="overview">{text.overview}</Tab>
+              <Tab value="invoices">
+                {fillLabel(text.invoicesTab, { count: invoiceCount })}
+              </Tab>
+              <Tab value="export">{text.exportTab}</Tab>
+            </TabList>
+          </div>
+          <TabPanel value="overview" className="space-y-5 pt-5">
+            {panels.overview}
+          </TabPanel>
+          <TabPanel value="invoices" className="pt-5">
+            {panels.invoices}
+          </TabPanel>
+          <TabPanel value="export" className="pt-5">
+            {panels.export}
+          </TabPanel>
+        </Tabs>
+      </Card>
+    </div>
+  )
+}
