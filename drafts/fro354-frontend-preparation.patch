@@ -0,0 +1,215 @@
+import {
+  ChangeOrderLocalReason,
+  EntryIneligibleReason,
+  type ChangeOrderOption,
+  type EditingCard,
+  type EntryField,
+  type EntryValues,
+  type ExportSummary,
+  type InvoiceRow,
+  type OrderSearchResult,
+  type WarehouseReference,
+} from './types'
+
+/*
+ * Page-side rules for FRO-354. FRO-319 stays authoritative: the server repeats
+ * every check and owns eligibility, Change Order, versions and derived values.
+ * The money and validation rules are copies of FRO-353's
+ * (`../create/customs-storage-create-rules.ts`); de-duplicate on integration.
+ */
+
+export type EntryValueError = 'required' | 'future' | 'format' | 'tooLong'
+export type EntryValueErrors = Partial<Record<EntryField, EntryValueError>>
+
+const STATISTICAL_VAT_PERCENT = 24n
+
+/** Parses a non-negative decimal string with at most two decimals into cents. */
+function toCents(value: string): bigint {
+  const [whole, fraction = ''] = value.trim().split('.')
+  return (
+    BigInt(whole || '0') * 100n + BigInt(fraction.padEnd(2, '0').slice(0, 2))
+  )
+}
+
+function fromCents(cents: bigint): string {
+  const whole = cents / 100n
+  const fraction = (cents % 100n).toString().padStart(2, '0')
+  return `${whole}.${fraction}`
+}
+
+/** 24% of cents, rounded half-up to whole cents. */
+function percentHalfUp(cents: bigint): bigint {
+  return (cents * STATISTICAL_VAT_PERCENT + 50n) / 100n
+}
+
+/** Statistical VAT (hypothetical, 24%) of one net value, in its own currency. */
+export function statisticalVat(net: string): string {
+  return fromCents(percentHalfUp(toCents(net)))
+}
+
+export type InvoiceTotals =
+  | { kind: 'none' }
+  | { kind: 'mixedCurrency' }
+  | { kind: 'eur'; net: string; vat: string; statisticalVat: string }
+
+/** Totals only when every invoice is in EUR; the total VAT is rounded once. */
+export function invoiceTotals(rows: InvoiceRow[]): InvoiceTotals {
+  if (rows.length === 0) return { kind: 'none' }
+  if (rows.some((row) => row.currency !== 'EUR'))
+    return { kind: 'mixedCurrency' }
+  const net = rows.reduce((sum, row) => sum + toCents(row.netValue), 0n)
+  const vat = rows.reduce((sum, row) => sum + toCents(row.vatValue), 0n)
+  return {
+    kind: 'eur',
+    net: fromCents(net),
+    vat: fromCents(vat),
+    statisticalVat: fromCents(percentHalfUp(net)),
+  }
+}
+
+export type ExportCoverage =
+  | { kind: 'noInvoices' }
+  | { kind: 'notInExport' }
+  | { kind: 'all'; export: ExportSummary }
+  | { kind: 'partial'; export: ExportSummary; inExport: number; total: number }
+
+export function exportCoverage(
+  invoices: InvoiceRow[],
+  exp: ExportSummary | null,
+): ExportCoverage {
+  if (invoices.length === 0) return { kind: 'noInvoices' }
+  if (!exp) return { kind: 'notInExport' }
+  const inExport = invoices.filter((row) => row.exportId === exp.id).length
+  return inExport === invoices.length
+    ? { kind: 'all', export: exp }
+    : { kind: 'partial', export: exp, inExport, total: invoices.length }
+}
+
+const athensFormat = new Intl.DateTimeFormat('en-GB', {
+  timeZone: 'Europe/Athens',
+  year: 'numeric',
+  month: '2-digit',
+  day: '2-digit',
+  hour: '2-digit',
+  minute: '2-digit',
+  hourCycle: 'h23',
+})
+
+/** The current date (yyyy-mm-dd) and minute (HH:mm) in Europe/Athens. */
+export function athensNow(now: Date): { date: string; time: string } {
+  const part = (type: Intl.DateTimeFormatPartTypes) =>
+    athensFormat.formatToParts(now).find((p) => p.type === type)?.value ?? ''
+  return {
+    date: `${part('year')}-${part('month')}-${part('day')}`,
+    time: `${part('hour')}:${part('minute')}`,
+  }
+}
+
+/** Page order, used to focus the first invalid field. */
+const fieldOrder: EntryField[] = [
+  'entryDate',
+  'entryTime',
+  'entryMrn',
+  'entryMrnDate',
+  'tariffCode',
+  'goodsDescription',
+  'transportMeans',
+  'permitNumber',
+  'operatorName',
+  'operatorVat',
+  'warehouseAddress',
+]
+
+export const textLimits: Partial<Record<EntryField, number>> = {
+  entryMrn: 500,
+  goodsDescription: 2000,
+  transportMeans: 500,
+  permitNumber: 500,
+  operatorName: 500,
+  operatorVat: 500,
+  warehouseAddress: 500,
+}
+
+/** The date-time error is reported on `entryDate`, the pair's first control. */
+export function validateEntryValues(
+  values: EntryValues,
+  now: Date,
+): EntryValueErrors {
+  const errors: EntryValueErrors = {}
+  const today = athensNow(now)
+  if (!values.entryDate || !values.entryTime) errors.entryDate = 'required'
+  else if (
+    `${values.entryDate}T${values.entryTime}` > `${today.date}T${today.time}`
+  )
+    errors.entryDate = 'future'
+  if (values.entryMrnDate && values.entryMrnDate > today.date)
+    errors.entryMrnDate = 'future'
+  if (values.tariffCode && !/^\d{1,10}$/.test(values.tariffCode))
+    errors.tariffCode = 'format'
+  for (const [field, limit] of Object.entries(textLimits) as [
+    EntryField,
+    number,
+  ][])
+    if (values[field].length > limit) errors[field] = 'tooLong'
+  return errors
+}
+
+export function firstErrorField(errors: EntryValueErrors): EntryField | null {
+  return fieldOrder.find((field) => errors[field]) ?? null
+}
+
+/** Only one card can be in edit mode, and only with edit authority. */
+export function canStartEdit(editing: EditingCard, canEdit: boolean): boolean {
+  return canEdit && editing === null
+}
+
+/** True when another card's edit keeps this card's Edit disabled. */
+export function editBlocked(
+  editing: EditingCard,
+  card: Exclude<EditingCard, null>,
+): boolean {
+  return editing !== null && editing !== card
+}
+
+export function isEditDirty(draft: EntryValues, saved: EntryValues): boolean {
+  return (Object.keys(draft) as EntryField[]).some(
+    (field) => draft[field] !== saved[field],
+  )
+}
+
+/**
+ * How a Change Order search result appears. FRO-319 reports the entry's own
+ * owner and the Orders it covers as "already covered" by this entry; the page
+ * names those cases instead of pointing the operator to the entry they are on.
+ */
+export function changeOrderOption(
+  result: OrderSearchResult,
+  entry: { id: string; ownerId: string },
+): ChangeOrderOption {
+  if (result.id === entry.ownerId)
+    return { selectable: false, local: ChangeOrderLocalReason.CURRENT_ORDER }
+  const eligibility = result.eligibility
+  if (eligibility.eligible) return { selectable: true }
+  if (
+    eligibility.reason === EntryIneligibleReason.ALREADY_COVERED &&
+    eligibility.entry?.id === entry.id
+  )
+    return {
+      selectable: false,
+      local: ChangeOrderLocalReason.COVERED_BY_THIS_ENTRY,
+    }
+  return { selectable: false, eligibility }
+}
+
+/** dd/mm/yyyy HH:mm of the entry's own date and time. */
+export function entryDateTimeLabel(values: EntryValues): string {
+  const [year, month, day] = values.entryDate.split('-')
+  return `${day}/${month}/${year} ${values.entryTime}`
+}
+
+export function warehouseChanged(
+  current: WarehouseReference,
+  next: WarehouseReference,
+): boolean {
+  return current.id !== next.id
+}
