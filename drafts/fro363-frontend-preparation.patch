+import { ShipmentInvoiceShipmentPicker } from './shipment-invoice-shipment-picker'
+import { ShipmentInvoiceGoods } from './shipment-invoice-goods'
+import {
+  ShipmentInvoiceConfirmations,
+  type Confirmation,
+} from './shipment-invoice-confirmations'
+export function ShipmentInvoiceCreateForm(
+  props: ShipmentInvoiceCreateFormProps,
+) {
+  const { locale } = useLocale(),
+    l = labelsFor(locale)
+  const [shipment, setShipment] = useState<ShipmentPresentation | null>(null),
+    [selection, setSelection] = useState<Selection>([]),
+    [evaluation, setEvaluation] = useState<SelectionEvaluation | null>(null)
+  const [reading, setReading] = useState(false),
+    [evaluating, setEvaluating] = useState(false),
+    [saving, setSaving] = useState(false),
+    [dirty, setDirty] = useState(false),
+    [error, setError] = useState<'read' | 'evaluate' | 'save' | null>(null),
+    [removed, setRemoved] = useState<string[]>([]),
+    [confirmation, setConfirmation] = useState<Confirmation | null>(null)
+  const [readValid, setReadValid] = useState(false),
+    [savedId, setSavedId] = useState(''),
+    [navigationError, setNavigationError] = useState(false)
+  const savedIdentity = useRef('')
+  const initializedId = useRef('')
+  const request = useRef(0),
+    evalRequest = useRef(0),
+    pendingSave = useRef(false),
+    shipperEdited = useRef(false),
+    selectionRef = useRef<Selection>([]),
+    currentId = useRef(props.initialShipmentId ?? ''),
+    callbacks = useRef(props)
+  callbacks.current = props
+  const form = useAppForm({
+    defaultValues: createDraftDefaults(props.todayAthens),
+  })
+  useDraftGuards(dirty || saving)
+  const usable =
+    props.available &&
+    !!props.onLoadShipment &&
+    !!props.onEvaluateSelection &&
+    !!props.onSubmit &&
+    !!props.onSaved
+  const eligibleMap = (data: ShipmentPresentation) =>
+    Object.fromEntries(
+      data.orders.map((o) => [
+        o.id,
+        o.rows.filter((r) => !r.ineligibleReason).map((r) => r.id),
+      ]),
+    )
+  function change(key: keyof ShipmentInvoiceDraftValues, value: string) {
+    form.setFieldValue(key, value)
+    setDirty(true)
+    if (key === 'shipper') shipperEdited.current = true
+    if (key === 'clientId') form.setFieldValue('companyId', '')
+  }
+  function select(next: Selection) {
+    selectionRef.current = next
+    setSelection(next)
+  }
+  async function evaluate(id: string, next: Selection) {
+    const token = ++evalRequest.current
+    setEvaluating(true)
+    setEvaluation(null)
+    try {
+      const result = await callbacks.current.onEvaluateSelection?.(id, next)
+      if (token === evalRequest.current && id === currentId.current) {
+        setEvaluation(result ?? null)
+        setError(result ? null : 'evaluate')
+      }
+    } catch {
+      if (token === evalRequest.current && id === currentId.current)
+        setError('evaluate')
+    } finally {
+      if (token === evalRequest.current) setEvaluating(false)
+    }
+  }
+  async function load(id: string, reset: boolean) {
+    const token = ++request.current
+    evalRequest.current++
+    currentId.current = id
+    setReading(true)
+    setReadValid(false)
+    setEvaluation(null)
+    setError(null)
+    if (reset) {
+      form.reset({
+        ...createDraftDefaults(callbacks.current.todayAthens),
+        shipmentId: id,
+      })
+      select([])
+      setShipment(null)
+      setRemoved([])
+      shipperEdited.current = false
+      initializedId.current = ''
+    }
+    try {
+      const data = await callbacks.current.onLoadShipment?.(id)
+      if (token !== request.current) return
+      if (!data || data.id !== id || !data.eligible) {
+        setShipment(null)
+        setError('read')
+        return
+      }
+      setShipment(data)
+      setReadValid(true)
+      form.setFieldValue('shipmentId', id)
+      if (initializedId.current !== id)
+        form.setFieldValue(
+          'clientId',
+          data.clients.length === 1 ? data.clients[0].id : '',
+        )
+      initializedId.current = id
+      const reconciled = reconcileSelection(
+        selectionRef.current,
+        eligibleMap(data),
+      )
+      select(reconciled.selection)
+      if (reconciled.removed.length) {
+        setRemoved((old) => [
+          ...new Set([
+            ...old,
+            ...reconciled.removed.map((r) => `${r.orderId} / ${r.rowId}`),
+          ]),
+        ])
+        setDirty(true)
+      }
+      await evaluate(id, reconciled.selection)
+    } catch {
+      if (token === request.current) setError('read')
+    } finally {
+      if (token === request.current) setReading(false)
+    }
+  }
+  useEffect(() => {
+    if (props.initialShipmentId && props.available)
+      void load(props.initialShipmentId, true)
+    return () => {
+      request.current++
+      evalRequest.current++
+    }
+  }, []) // Entry context is fixed for this form instance; hosts remount for a different entry.
+  function ask(kind: Confirmation['kind'], accept: () => void) {
+    setConfirmation({
+      kind,
+      accept,
+      trigger:
+        document.activeElement instanceof HTMLElement
+          ? document.activeElement
+          : null,
+    })
+  }
+  function close() {
+    const trigger = confirmation?.trigger
+    setConfirmation(null)
+    requestAnimationFrame(() => trigger?.focus())
+  }
+  useEffect(
+    () =>
+      props.registerNavigationGuard?.((proceed) => {
+        if (savedIdentity.current) {
+          proceed()
+          return
+        }
+        if (pendingSave.current) return
+        if (dirty) ask('discard', proceed)
+        else proceed()
+      }),
+    [props.registerNavigationGuard, dirty],
+  )
+  function chooseShipment(id: string) {
+    if (id === currentId.current) return
+    const apply = () => {
+      setDirty(true)
+      void load(id, true)
+    }
+    if (dirty) ask('shipment', apply)
+    else apply()
+  }
+  function company(id: string) {
+    const company = shipment?.companies.find(
+      (c) => c.id === id && c.clientId === form.state.values.clientId,
+    )
+    form.setFieldValue('companyId', company?.id ?? '')
+    setDirty(true)
+    if (!company) return
+    const replace = () => {
+      form.setFieldValue('shipper', company.shipper)
+      shipperEdited.current = false
+    }
+    if (shipperEdited.current) ask('shipper', replace)
+    else replace()
+  }
+  function updateSelection(next: Selection) {
+    select(next)
+    setDirty(true)
+    setError(null)
+    void evaluate(currentId.current, next)
+  }
+  const canSave =
+    usable &&
+    readValid &&
+    !savedId &&
+    !confirmation &&
+    !!shipment?.eligible &&
+    !reading &&
+    !evaluating &&
+    !saving &&
+    !!evaluation &&
+    !evaluation.mixed &&
+    error !== 'read' &&
+    error !== 'evaluate'
+  function navigateSaved(id: string) {
+    try {
+      callbacks.current.onSaved!(id)
+      setNavigationError(false)
+    } catch {
+      setNavigationError(true)
+    }
+  }
+  async function submit() {
+    if (!canSave || pendingSave.current) return
+    pendingSave.current = true
+    setSaving(true)
+    setError(null)
+    try {
+      const id = await callbacks.current.onSubmit!(
+        form.state.values,
+        selectionRef.current,
+      )
+      setDirty(false)
+      savedIdentity.current = id
+      setSavedId(id)
+      navigateSaved(id)
+    } catch {
+      setError('save')
+    } finally {
+      pendingSave.current = false
+      setSaving(false)
+    }
+  }
+  return (
+    <form
+      className="mx-auto w-full max-w-5xl space-y-5 pb-6"
+      noValidate
+      onSubmit={(e) => {
+        e.preventDefault()
+        void submit()
+      }}
+    >
+      <header>
+        <p className="text-caption text-fg-muted">{l.draft}</p>
+        <h1 className="text-title font-semibold">{l.title}</h1>
+        <p className="mt-2 text-body-sm text-fg-muted">{l.intro}</p>
+      </header>
+      {!usable && <Alert tone="warning">{l.unavailable}</Alert>}
+      {navigationError && (
+        <Alert tone="warning">
+          {l.navigationError} {savedId}
+          <Button type="button" onClick={() => navigateSaved(savedId)}>
+            {l.openSaved}
+          </Button>
+        </Alert>
+      )}
+      <fieldset
+        disabled={saving || !!savedId || !props.available}
+        className="min-w-0 space-y-5 border-0 p-0"
+      >
+        <ShipmentInvoiceShipmentPicker
+          value={currentId.current}
+          label={shipment?.label}
+          onChoose={chooseShipment}
+          onSearch={props.onSearchShipments}
+          disabled={saving || !!savedId || !props.available}
+          labels={l}
+        />
+        {reading && <p role="status">{l.loading}</p>}
+        {error && (
+          <Alert tone="danger">
+            {error === 'save' ? l.saveError : l.error}
+            {error !== 'save' && (
+              <Button
+                type="button"
+                variant="ghost"
+                onClick={() =>
+                  error === 'evaluate'
+                    ? void evaluate(currentId.current, selectionRef.current)
+                    : void load(currentId.current, false)
+                }
+              >
+                {l.retry}
+              </Button>
+            )}
+          </Alert>
+        )}
+        <form.Subscribe selector={(state) => state.values}>
+          {(values) => (
+            <ShipmentInvoiceDocumentFields
+              values={values}
+              change={change}
+              chooseCompany={company}
+              shipment={shipment}
+              currencies={props.currencies}
+              labels={l}
+            />
+          )}
+        </form.Subscribe>
+        {shipment && (
+          <ShipmentInvoiceGoods
+            orders={shipment.orders}
+            selection={selection}
+            disabled={reading || saving || !readValid}
+            onRefresh={() => void load(currentId.current, false)}
+            onOrder={(id) =>
+              updateSelection(
+                toggleOrder(
+                  selectionRef.current,
+                  id,
+                  eligibleMap(shipment)[id] ?? [],
+                ),
+              )
+            }
+            onRow={(id, row) =>
+              updateSelection(
+                toggleRow(
+                  selectionRef.current,
+                  id,
+                  row,
+                  eligibleMap(shipment)[id] ?? [],
+                ),
+              )
+            }
+            onAllocation={props.onOpenAllocation}
+            labels={l}
+          />
+        )}
+        {removed.length > 0 && (
+          <Alert tone="warning">
+            {l.removed} {removed.join(', ')} {l.changed}
+          </Alert>
+        )}
+        {evaluation?.mixed && <Alert tone="warning">{l.mixed}</Alert>}
+        {!!evaluation?.overlaps.length && (
+          <Alert tone="warning">
+            {l.overlap} {evaluation.overlaps.join(', ')}
+          </Alert>
+        )}
+        <form.Subscribe selector={(state) => state.values}>
+          {(values) => (
+            <ShipmentInvoicePackingFields
+              values={values}
+              change={change}
+              labels={l}
+              currencies={props.currencies}
+            />
+          )}
+        </form.Subscribe>
+      </fieldset>
+      <footer className="sticky bottom-0 z-[var(--z-sticky)] flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border bg-surface p-4 shadow-card">
+        <div className="min-w-0">
+          <p className="text-caption text-fg-muted">{l.total}</p>
+          <output className="font-mono font-semibold">
+            {evaluating
+              ? l.loading
+              : evaluation && !evaluation.mixed
+                ? evaluation.totalDisplay
+                : '—'}
+          </output>
+        </div>
+        <div className="flex flex-wrap gap-2">
+          <Button
+            type="button"
+            variant="secondary"
+            disabled={saving}
+            onClick={() =>
+              dirty ? ask('discard', props.onCancel) : props.onCancel()
+            }
+          >
+            {l.cancel}
+          </Button>
+          <Button
+            type="submit"
+            disabled={!canSave}
+            loading={saving}
+            className="h-auto min-h-10 whitespace-normal py-2"
+          >
+            {l.create}
+          </Button>
+        </div>
+      </footer>
+      <ShipmentInvoiceConfirmations
+        value={confirmation}
+        close={close}
+        labels={l}
+      />
+    </form>
+  )
+}
