+import type { ReactNode } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Card } from '#/components/ui/card'
+import { useSupplierInvoiceCreateLabels } from '../localization/supplier-invoice-create-labels'
+
+export type SupplierInvoiceCreationResultProps =
+  | {
+      outcome: 'unknown'
+      busy: boolean
+      onCheckAttempt: () => void
+      documents: ReactNode
+    }
+  | {
+      outcome: 'saved'
+      invoiceId: string
+      selectedOrderLabel: string
+      originatingOrderLabel?: string
+      documents: ReactNode
+      nextAction: ReactNode
+    }
+
+/** The caller supplies the authoritative outcome and retains draft/file state. */
+export function SupplierInvoiceCreationResult(
+  props: SupplierInvoiceCreationResultProps,
+) {
+  const text = useSupplierInvoiceCreateLabels()
+  const unknown = props.outcome === 'unknown'
+  return (
+    <div data-density="comfortable" className="min-w-0 space-y-5">
+      <Card className="space-y-5 p-4 min-[701px]:p-5">
+        <h1 className="text-title text-fg">
+          {unknown ? text.unknownTitle : text.savedTitle}
+        </h1>
+        <Alert tone={unknown ? 'warning' : 'success'}>
+          {unknown ? text.unknownDescription : text.savedDescription}
+        </Alert>
+        {props.outcome === 'saved' && (
+          <dl className="grid gap-5 [overflow-wrap:anywhere] min-[701px]:grid-cols-3">
+            <div>
+              <dt className="text-caption font-semibold text-fg-muted">
+                {text.invoiceId}
+              </dt>
+              <dd className="mt-1 font-mono text-body-sm">{props.invoiceId}</dd>
+            </div>
+            <div>
+              <dt className="text-caption font-semibold text-fg-muted">
+                {text.selectedOrder}
+              </dt>
+              <dd className="mt-1 font-mono text-body-sm">
+                {props.selectedOrderLabel}
+              </dd>
+            </div>
+            {props.originatingOrderLabel && (
+              <div>
+                <dt className="text-caption font-semibold text-fg-muted">
+                  {text.originatingOrder}
+                </dt>
+                <dd className="mt-1 font-mono text-body-sm">
+                  {props.originatingOrderLabel}
+                </dd>
+              </div>
+            )}
+          </dl>
+        )}
+        {props.outcome === 'unknown' && (
+          <Button
+            type="button"
+            loading={props.busy}
+            onClick={props.onCheckAttempt}
+            className="h-auto min-h-10 whitespace-normal py-2 text-left"
+          >
+            {text.checkAttempt}
+          </Button>
+        )}
+      </Card>
+      {props.documents}
+      {props.outcome === 'saved' && (
+        <div className="flex flex-wrap justify-end gap-3">
+          {props.nextAction}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/frontline-forwarding-client/src/features/supplier-invoices/components/supplier-invoice-document-queue.tsx b/frontline-forwarding-client/src/features/supplier-invoices/components/supplier-invoice-document-queue.tsx
