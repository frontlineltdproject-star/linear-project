+++ b/frontline-forwarding-client/src/features/supplier-invoices/components/supplier-invoice-document-queue.tsx
@@ -0,0 +1,192 @@
+import { useId, useRef } from 'react'
+import { FileText, Paperclip } from 'lucide-react'
+import { Alert } from '#/components/ui/alert'
+import { StatusPill, type StatusTone } from '#/components/ui/badge'
+import { Button } from '#/components/ui/button'
+import { Card } from '#/components/ui/card'
+import { useSupplierInvoiceCreateLabels } from '../localization/supplier-invoice-create-labels'
+
+/** UI display state only, not an attachment DTO or ownership/access contract. */
+export interface SupplierInvoiceDocumentRow {
+  key: string
+  filename: string
+  metadata: string
+  outcome: 'queued' | 'uploaded' | 'failed' | 'unknown'
+  message?: string
+}
+
+export interface SupplierInvoiceDocumentQueueProps {
+  rows: SupplierInvoiceDocumentRow[]
+  errors: string[]
+  busy: boolean
+  onChoose?: (files: File[]) => void
+  onDownload?: (key: string) => void
+  onRemove?: (key: string) => void
+  onRetry?: (key: string) => void
+  onCheck?: (key: string) => void
+}
+
+const tones: Record<SupplierInvoiceDocumentRow['outcome'], StatusTone> = {
+  queued: 'neutral',
+  uploaded: 'success',
+  failed: 'danger',
+  unknown: 'warning',
+}
+
+export function SupplierInvoiceDocumentQueue({
+  rows,
+  errors,
+  busy,
+  onChoose,
+  onDownload,
+  onRemove,
+  onRetry,
+  onCheck,
+}: SupplierInvoiceDocumentQueueProps) {
+  const text = useSupplierInvoiceCreateLabels()
+  const input = useRef<HTMLInputElement>(null)
+  const id = useId()
+  return (
+    <Card
+      className="p-4 min-[701px]:p-5"
+      role="region"
+      aria-labelledby={`${id}-title`}
+      aria-busy={busy}
+    >
+      <div className="flex flex-wrap items-start justify-between gap-4">
+        <div className="min-w-0">
+          <h2
+            id={`${id}-title`}
+            className="flex items-center gap-2 text-heading text-fg"
+          >
+            <Paperclip className="size-4 shrink-0 text-accent" aria-hidden />
+            {text.documents}
+          </h2>
+          <p className="mt-1 text-body-sm text-fg-muted">
+            {text.documentDescription}
+          </p>
+        </div>
+        {onChoose && (
+          <>
+            <input
+              ref={input}
+              type="file"
+              className="sr-only"
+              aria-label={text.chooseFiles}
+              aria-describedby={`${id}-hint`}
+              multiple
+              disabled={busy}
+              accept=".pdf,.jpg,.jpeg,.png,.webp,.gif,.doc,.docx,.xls,.xlsx,.csv,.txt"
+              onChange={(event) => {
+                const files = Array.from(event.currentTarget.files ?? [])
+                event.currentTarget.value = ''
+                if (!busy && files.length) onChoose(files)
+              }}
+            />
+            <Button
+              type="button"
+              variant="secondary"
+              disabled={busy}
+              onClick={() => input.current?.click()}
+            >
+              {text.chooseFiles}
+            </Button>
+          </>
+        )}
+      </div>
+      <p id={`${id}-hint`} className="mt-2 text-caption text-fg-subtle">
+        {text.documentHint}
+      </p>
+      {errors.length > 0 && (
+        <Alert tone="danger" className="mt-3 break-words">
+          <ul className="list-inside list-disc">
+            {errors.map((error, index) => (
+              <li key={index}>{error}</li>
+            ))}
+          </ul>
+        </Alert>
+      )}
+      <div className="mt-4 grid gap-2">
+        {rows.length === 0 ? (
+          <p className="rounded-md border border-dashed border-border p-4 text-body-sm text-fg-muted">
+            {text.documentEmpty}
+          </p>
+        ) : (
+          rows.map((row) => (
+            <div
+              key={row.key}
+              role="group"
+              aria-label={row.filename}
+              className="flex min-w-0 flex-wrap items-center justify-between gap-3 rounded-md border border-border bg-surface-2 p-3"
+            >
+              <div className="flex min-w-0 flex-1 basis-48 items-start gap-3">
+                <span className="rounded-md bg-surface p-2 text-accent">
+                  <FileText className="size-5 shrink-0" aria-hidden />
+                </span>
+                <div className="min-w-0 space-y-1 [overflow-wrap:anywhere]">
+                  <p className="text-body-sm font-semibold">{row.filename}</p>
+                  <p className="text-caption text-fg-muted">{row.metadata}</p>
+                  <StatusPill
+                    tone={tones[row.outcome]}
+                    className="whitespace-normal"
+                  >
+                    {text[row.outcome]}
+                  </StatusPill>
+                  {row.message && (
+                    <p className="text-caption text-fg-muted">{row.message}</p>
+                  )}
+                </div>
+              </div>
+              <div className="flex max-w-full flex-wrap gap-1">
+                {onDownload && (
+                  <Button
+                    type="button"
+                    size="sm"
+                    variant="ghost"
+                    disabled={busy}
+                    onClick={() => onDownload(row.key)}
+                  >
+                    {text.download}
+                  </Button>
+                )}
+                {row.outcome === 'queued' && onRemove && (
+                  <Button
+                    type="button"
+                    size="sm"
+                    variant="ghost"
+                    disabled={busy}
+                    onClick={() => onRemove(row.key)}
+                  >
+                    {text.remove}
+                  </Button>
+                )}
+                {row.outcome === 'failed' && onRetry && (
+                  <Button
+                    type="button"
+                    size="sm"
+                    variant="secondary"
+                    disabled={busy}
+                    onClick={() => onRetry(row.key)}
+                  >
+                    {text.retryUpload}
+                  </Button>
+                )}
+                {row.outcome === 'unknown' && onCheck && (
+                  <Button
+                    type="button"
+                    size="sm"
+                    variant="secondary"
+                    disabled={busy}
+                    onClick={() => onCheck(row.key)}
+                  >
+                    {text.checkUpload}
+                  </Button>
+                )}
+              </div>
+            </div>
+          ))
+        )}
+      </div>
+    </Card>
+  )
+}
