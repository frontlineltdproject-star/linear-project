+import {
+  useEffect,
+  useId,
+  useRef,
+  type KeyboardEvent,
+  type ReactNode,
+} from 'react'
+import { TopBar } from '#/components/layout/top-bar'
+import { Card } from '#/components/ui/card'
+import { Tab, TabList, TabPanel, Tabs } from '#/components/ui/tabs'
+import { useSupplierInvoiceCreateLabels } from '../localization/supplier-invoice-create-labels'
+
+export type SupplierInvoiceCreateTab = 'overview' | 'documents'
+
+/** Complete labelled fields; the controller owns values, errors and operations. */
+export interface SupplierInvoiceCreateSlots {
+  orderSearch: ReactNode
+  stockId: ReactNode
+  client: ReactNode
+  invoiceCompany: ReactNode
+  supplier: ReactNode
+  entryNote: ReactNode
+  invoiceNumber: ReactNode
+  invoiceDate: ReactNode
+  expirationDate: ReactNode
+  currency: ReactNode
+  invoiceType: ReactNode
+  invoiceVessel: ReactNode
+  netValue: ReactNode
+  vatValue: ReactNode
+  vatStatus: ReactNode
+  documents: ReactNode
+  actions: ReactNode
+  feedback?: ReactNode
+}
+
+export interface SupplierInvoiceCreateLayoutProps {
+  slots: SupplierInvoiceCreateSlots
+  activeTab: SupplierInvoiceCreateTab
+  onTabChange: (tab: SupplierInvoiceCreateTab) => void
+  documentCount: number
+}
+
+const grid =
+  'grid grid-cols-1 gap-x-7 gap-y-[18px] min-[701px]:grid-cols-2 min-[1101px]:grid-cols-4 [&>*]:min-w-0'
+const card = 'p-4 min-[701px]:p-5'
+const tabValues: SupplierInvoiceCreateTab[] = ['overview', 'documents']
+
+export function SupplierInvoiceCreateLayout({
+  slots,
+  activeTab,
+  onTabChange,
+  documentCount,
+}: SupplierInvoiceCreateLayoutProps) {
+  const text = useSupplierInvoiceCreateLabels()
+  const id = useId()
+  const tabList = useRef<HTMLDivElement>(null)
+
+  // Complete roving focus locally without changing the shared Tabs primitive.
+  useEffect(() => {
+    tabList.current
+      ?.querySelectorAll<HTMLButtonElement>('[role="tab"]')
+      .forEach((tab, index) => {
+        tab.tabIndex = tabValues[index] === activeTab ? 0 : -1
+      })
+  }, [activeTab])
+
+  function onTabKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    const tabs = Array.from(
+      event.currentTarget.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
+    )
+    const current = tabs.indexOf(event.target as HTMLButtonElement)
+    if (
+      current < 0 ||
+      !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)
+    )
+      return
+    event.preventDefault()
+    const next =
+      event.key === 'Home'
+        ? 0
+        : event.key === 'End'
+          ? tabs.length - 1
+          : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) %
+            tabs.length
+    onTabChange(tabValues[next])
+    tabs[next].focus()
+  }
+
+  return (
+    <div data-density="comfortable" className="min-w-0 space-y-5">
+      <Card className={`${card} [&>div]:mb-0`}>
+        <TopBar title={text.title} />
+      </Card>
+      {slots.feedback}
+      <Card className={card}>
+        <Tabs
+          defaultValue="overview"
+          value={activeTab}
+          onValueChange={(value) => {
+            if (value === 'overview' || value === 'documents')
+              onTabChange(value)
+          }}
+        >
+          <div ref={tabList} onKeyDown={onTabKeyDown}>
+            <TabList>
+              <Tab value="overview">{text.overview}</Tab>
+              <Tab value="documents">
+                {text.documents} ({documentCount})
+              </Tab>
+            </TabList>
+          </div>
+          <TabPanel value="overview" className="space-y-5 pt-5">
+            <Card
+              className={card}
+              role="region"
+              aria-labelledby={`${id}-relationship`}
+            >
+              <h2
+                id={`${id}-relationship`}
+                className="mb-5 text-heading text-fg"
+              >
+                {text.relationship}
+              </h2>
+              <div className="mb-[18px] max-w-[480px]">{slots.orderSearch}</div>
+              <div className={grid}>
+                {slots.stockId}
+                {slots.client}
+                {slots.invoiceCompany}
+                {slots.supplier}
+                {slots.entryNote}
+              </div>
+            </Card>
+            <Card
+              className={card}
+              role="region"
+              aria-labelledby={`${id}-details`}
+            >
+              <h2 id={`${id}-details`} className="mb-5 text-heading text-fg">
+                {text.details}
+              </h2>
+              <div className={grid}>
+                {slots.invoiceNumber}
+                {slots.invoiceDate}
+                {slots.expirationDate}
+                {slots.currency}
+                {slots.invoiceType}
+                {slots.invoiceVessel}
+                {slots.netValue}
+                {slots.vatValue}
+              </div>
+            </Card>
+            <Card
+              className={card}
+              role="region"
+              aria-labelledby={`${id}-exemption`}
+            >
+              <h2 id={`${id}-exemption`} className="mb-5 text-heading text-fg">
+                {text.exemption}
+              </h2>
+              <div className="max-w-[400px]">{slots.vatStatus}</div>
+            </Card>
+          </TabPanel>
+          <TabPanel value="documents" className="pt-5">
+            {slots.documents}
+          </TabPanel>
+        </Tabs>
+      </Card>
+      <div className="flex flex-wrap justify-end gap-3">{slots.actions}</div>
+    </div>
+  )
+}
