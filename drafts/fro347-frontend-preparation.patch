+import { describe, expect, it } from 'vitest'
+import { supplierInvoiceCreateLabelsFor } from './supplier-invoice-create-labels'
+
+describe('Supplier invoice create localization', () => {
+  it('provides complete nonempty Greek copy for the same presentation states and actions', () => {
+    const en = supplierInvoiceCreateLabelsFor('en')
+    const el = supplierInvoiceCreateLabelsFor('el')
+    expect(Object.keys(el).sort()).toEqual(Object.keys(en).sort())
+    expect(Object.values(el).every((value) => value.trim().length > 0)).toBe(
+      true,
+    )
+    expect(el.title).toBe('Δημιουργία τιμολογίου προμηθευτή')
+    expect(el.unknownTitle).not.toBe(en.unknownTitle)
+    expect(el.checkUpload).not.toBe(en.checkUpload)
+  })
+})
