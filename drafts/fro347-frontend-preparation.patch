+    failed: 'Αποτυχία μεταφόρτωσης',
+    unknown: 'Άγνωστο αποτέλεσμα μεταφόρτωσης',
+    download: 'Λήψη',
+    remove: 'Αφαίρεση',
+    retryUpload: 'Επανάληψη μεταφόρτωσης',
+    checkUpload: 'Έλεγχος μεταφόρτωσης',
+    unknownTitle: 'Άγνωστο αποτέλεσμα δημιουργίας',
+    unknownDescription:
+      'Ελέγξτε την αρχική προσπάθεια πριν δημιουργήσετε άλλο τιμολόγιο. Το προσχέδιο και τα τοπικά αρχεία πρέπει να διατηρηθούν μέχρι να διευκρινιστεί το αποτέλεσμα.',
+    checkAttempt: 'Έλεγχος αρχικής προσπάθειας',
+    savedTitle: 'Το τιμολόγιο προμηθευτή δημιουργήθηκε',
+    savedDescription:
+      'Το τιμολόγιο αποθηκεύτηκε. Ελέγξτε τα αποτελέσματα των εγγράφων παρακάτω πριν συνεχίσετε.',
+    invoiceId: 'ID τιμολογίου προμηθευτή',
+    selectedOrder: 'Τιμολογημένη παραγγελία',
+    originatingOrder: 'Αρχική παραγγελία',
