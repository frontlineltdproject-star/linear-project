+import { useState } from 'react'
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  within,
+} from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { LabelsProvider, useLocale } from '#/app/providers/labels-provider'
+import { FormField, Input } from '#/components/ui/input'
+import {
+  SupplierInvoiceCreateLayout,
+  type SupplierInvoiceCreateSlots,
+  type SupplierInvoiceCreateTab,
+} from './supplier-invoice-create-layout'
+import { SupplierInvoiceDocumentQueue } from './supplier-invoice-document-queue'
+import { SupplierInvoiceCreationResult } from './supplier-invoice-creation-result'
+
+afterEach(() => {
+  cleanup()
+  localStorage.clear()
+})
+
+function Draft() {
+  const [tab, setTab] = useState<SupplierInvoiceCreateTab>('overview')
+  const [number, setNumber] = useState('0007/a')
+  const [amount, setAmount] = useState('99999999999999999.99')
+  const [files, setFiles] = useState<File[]>([])
+  const { locale, setLocale } = useLocale()
+  const field = (name: string) => (
+    <FormField label={name} htmlFor={name}>
+      <Input id={name} readOnly value="" />
+    </FormField>
+  )
+  const slots: SupplierInvoiceCreateSlots = {
+    orderSearch: field('Search Order'),
+    stockId: field('Stock ID'),
+    client: field('Client'),
+    invoiceCompany: field('Invoice company'),
+    supplier: field('Supplier'),
+    entryNote: field('Entry Note'),
+    invoiceNumber: (
+      <FormField label="Invoice number" htmlFor="number">
+        <Input
+          id="number"
+          value={number}
+          onChange={(e) => setNumber(e.target.value)}
+        />
+      </FormField>
+    ),
+    invoiceDate: field('Invoice date'),
+    expirationDate: field('Invoice expiration date'),
+    currency: field('Currency'),
+    invoiceType: field('Invoice type'),
+    invoiceVessel: field('Invoice vessel'),
+    netValue: (
+      <FormField label="Invoice net value" htmlFor="amount">
+        <Input
+          id="amount"
+          value={amount}
+          onChange={(e) => setAmount(e.target.value)}
+        />
+      </FormField>
+    ),
+    vatValue: field('Invoice VAT value'),
+    vatStatus: (
+      <FormField label="VAT exemption status" htmlFor="status">
+        <Input id="status" readOnly value="Not started" />
+      </FormField>
+    ),
+    documents: (
+      <SupplierInvoiceDocumentQueue
+        rows={files.map((file, index) => ({
+          key: String(index),
+          filename: file.name,
+          metadata: String(file.size),
+          outcome: 'queued',
+        }))}
+        errors={[]}
+        busy={false}
+        onChoose={(chosen) => setFiles([...files, ...chosen])}
+        onDownload={() => {}}
+        onRemove={() => {}}
+      />
+    ),
+    actions: <button type="button">Create supplier invoice</button>,
+  }
+  return (
+    <>
+      <button onClick={() => setLocale(locale === 'en' ? 'el' : 'en')}>
+        Language
+      </button>
+      <SupplierInvoiceCreateLayout
+        slots={slots}
+        activeTab={tab}
+        onTabChange={setTab}
+        documentCount={files.length}
+      />
+    </>
+  )
+}
+
+describe('Create layout', () => {
+  it('preserves caller-controlled exact text and file bytes across tabs and locale changes', () => {
+    render(
+      <LabelsProvider>
+        <Draft />
+      </LabelsProvider>,
+    )
+    fireEvent.change(screen.getByLabelText('Invoice number'), {
+      target: { value: '0010/B' },
+    })
+    fireEvent.click(screen.getByRole('tab', { name: /Documents/ }))
+    const file = new File(['retained bytes'], 'invoice.pdf', {
+      type: 'application/pdf',
+    })
+    fireEvent.change(screen.getByLabelText('Choose files'), {
+      target: { files: [file] },
+    })
+    expect(screen.getByText('invoice.pdf')).toBeTruthy()
+    fireEvent.click(screen.getByRole('tab', { name: 'Overview' }))
+    fireEvent.click(screen.getByText('Language'))
+    expect(
+      (screen.getByLabelText('Invoice number') as HTMLInputElement).value,
+    ).toBe('0010/B')
+    expect(
+      (screen.getByLabelText('Invoice net value') as HTMLInputElement).value,
+    ).toBe('99999999999999999.99')
+    fireEvent.click(screen.getByRole('tab', { name: /Έγγραφα/ }))
+    expect(screen.getByText('invoice.pdf')).toBeTruthy()
+    expect(screen.getByRole('heading', { level: 1 }).textContent).toBe(
+      'Δημιουργία τιμολογίου προμηθευτή',
+    )
+  })
+
+  it('keeps relationship, detail and read-only status fields in the agreed reading order', () => {
+    render(
+      <LabelsProvider>
+        <Draft />
+      </LabelsProvider>,
+    )
+    expect(screen.getAllByRole('textbox').map((input) => input.id)).toEqual([
+      'Search Order',
+      'Stock ID',
+      'Client',
+      'Invoice company',
+      'Supplier',
+      'Entry Note',
+      'number',
+      'Invoice date',
+      'Invoice expiration date',
+      'Currency',
+      'Invoice type',
+      'Invoice vessel',
+      'amount',
+      'Invoice VAT value',
+      'status',
+    ])
+    expect(
+      (screen.getByLabelText('VAT exemption status') as HTMLInputElement)
+        .readOnly,
+    ).toBe(true)
+    expect(screen.queryByRole('progressbar')).toBeNull()
+    expect(
+      screen.getAllByRole('heading', { level: 2 }).map((h) => h.textContent),
+    ).toEqual([
+      'Order relationship',
+      'Supplier invoice details',
+      'VAT exemption',
+    ])
+  })
+
+  it('supports arrow/Home/End activation with one focusable tab and one callback per key', () => {
+    const change = vi.fn()
+    render(
+      <LabelsProvider>
+        <Draft />
+      </LabelsProvider>,
+    )
+    const overview = screen.getByRole('tab', { name: 'Overview' })
+    overview.focus()
+    fireEvent.keyDown(overview, { key: 'ArrowRight' })
+    const documents = screen.getByRole('tab', { name: /Documents/ })
+    expect(document.activeElement).toBe(documents)
+    expect(documents.getAttribute('aria-selected')).toBe('true')
+    expect(overview.tabIndex).toBe(-1)
+    fireEvent.keyDown(documents, { key: 'Home' })
+    expect(document.activeElement).toBe(overview)
+    fireEvent.keyDown(overview, { key: 'End' })
+    expect(document.activeElement).toBe(documents)
+    fireEvent.keyDown(documents, { key: 'ArrowLeft' })
+    expect(document.activeElement).toBe(overview)
+    cleanup()
+    const empty = {} as SupplierInvoiceCreateSlots
+    render(
+      <SupplierInvoiceCreateLayout
+        slots={empty}
+        activeTab="overview"
+        onTabChange={change}
+        documentCount={0}
+      />,
+    )
+    fireEvent.keyDown(screen.getByRole('tab', { name: 'Overview' }), {
+      key: 'ArrowRight',
+    })
+    expect(change.mock.calls).toEqual([['documents']])
+  })
+})
+
+describe('Document queue', () => {
+  const rows = [
+    {
+      key: 'q',
+      filename: 'queued.pdf',
+      metadata: 'PDF · 10 B',
+      outcome: 'queued' as const,
+    },
+    {
+      key: 's',
+      filename: 'saved.pdf',
+      metadata: 'PDF · 20 B',
+      outcome: 'uploaded' as const,
+    },
+    {
+      key: 'f',
+      filename: 'failed.pdf',
+      metadata: 'PDF · 30 B',
+      outcome: 'failed' as const,
+      message: 'Access changed. Review before retry.',
+    },
+    {
+      key: 'u',
+      filename: 'unknown.pdf',
+      metadata: 'PDF · 40 B',
+      outcome: 'unknown' as const,
+    },
+  ]
+
+  it('forwards chosen bytes and row keys while separating failed retry from unknown checking', () => {
+    const choose = vi.fn(),
+      download = vi.fn(),
+      remove = vi.fn(),
+      retry = vi.fn(),
+      check = vi.fn()
+    render(
+      <SupplierInvoiceDocumentQueue
+        rows={rows}
+        errors={['empty.txt: File is empty']}
+        busy={false}
+        onChoose={choose}
+        onDownload={download}
+        onRemove={remove}
+        onRetry={retry}
+        onCheck={check}
+      />,
+    )
+    expect(screen.getByText('empty.txt: File is empty')).toBeTruthy()
+    const file = new File(['bytes'], 'new.pdf')
+    const input = screen.getByLabelText('Choose files')
+    fireEvent.change(input, { target: { files: [file] } })
+    expect(choose.mock.calls[0][0][0]).toBe(file)
+    const row = (name: string) => within(screen.getByRole('group', { name }))
+    fireEvent.click(row('queued.pdf').getByRole('button', { name: 'Download' }))
+    fireEvent.click(row('queued.pdf').getByRole('button', { name: 'Remove' }))
+    fireEvent.click(
+      row('failed.pdf').getByRole('button', { name: 'Retry upload' }),
+    )
+    fireEvent.click(
+      row('unknown.pdf').getByRole('button', { name: 'Check upload' }),
+    )
+    expect(download.mock.calls).toEqual([['q']])
+    expect(remove.mock.calls).toEqual([['q']])
+    expect(retry.mock.calls).toEqual([['f']])
+    expect(check.mock.calls).toEqual([['u']])
+    expect(
+      row('unknown.pdf').queryByRole('button', { name: 'Retry upload' }),
+    ).toBeNull()
+    expect(
+      row('saved.pdf').queryByRole('button', { name: 'Remove' }),
+    ).toBeNull()
+    expect(
+      row('failed.pdf').queryByRole('button', { name: 'Remove' }),
+    ).toBeNull()
+  })
+
+  it('blocks operation callbacks while busy and hides actions the caller has not supplied', () => {
+    const action = vi.fn()
+    const { rerender } = render(
+      <SupplierInvoiceDocumentQueue
+        rows={rows}
+        errors={[]}
+        busy
+        onChoose={action}
+        onDownload={action}
+        onRemove={action}
+        onRetry={action}
+        onCheck={action}
+      />,
+    )
+    for (const button of screen.getAllByRole('button'))
+      expect((button as HTMLButtonElement).disabled).toBe(true)
+    fireEvent.change(screen.getByLabelText('Choose files'), {
+      target: { files: [new File(['x'], 'x.pdf')] },
+    })
+    expect(action).not.toHaveBeenCalled()
+    rerender(
+      <SupplierInvoiceDocumentQueue rows={rows} errors={[]} busy={false} />,
+    )
+    expect(screen.queryAllByRole('button')).toHaveLength(0)
+  })
+})
+
+describe('Creation result', () => {
+  it('shows only original-attempt checking for an unknown creation, without claiming a saved ID', () => {
+    const check = vi.fn()
+    const { rerender } = render(
+      <SupplierInvoiceCreationResult
+        outcome="unknown"
+        busy={false}
+        onCheckAttempt={check}
+        documents={<p>Pending local files</p>}
+      />,
+    )
+    expect(
+      screen.getByRole('heading', { name: 'Creation outcome unknown' }),
+    ).toBeTruthy()
+    expect(screen.queryByText('Supplier Invoice ID')).toBeNull()
+    expect(screen.getAllByRole('button').map((b) => b.textContent)).toEqual([
+      'Check original attempt',
+    ])
+    fireEvent.click(
+      screen.getByRole('button', { name: 'Check original attempt' }),
+    )
+    expect(check).toHaveBeenCalledTimes(1)
+    rerender(
+      <SupplierInvoiceCreationResult
+        outcome="unknown"
+        busy
+        onCheckAttempt={check}
+        documents={<p>Pending local files</p>}
+      />,
+    )
+    expect((screen.getByRole('button') as HTMLButtonElement).disabled).toBe(
+      true,
+    )
+    expect(screen.getByText('Pending local files')).toBeTruthy()
+  })
+
+  it('keeps the saved invoice, selected Order and different originating Order distinct beside file recovery', () => {
+    render(
+      <SupplierInvoiceCreationResult
+        outcome="saved"
+        invoiceId="42"
+        selectedOrderLabel="FL-002"
+        originatingOrderLabel="FL-001"
+        documents={<p>Unknown upload retained</p>}
+        nextAction={<button>Return to FL-001</button>}
+      />,
+    )
+    expect(screen.getByText('42')).toBeTruthy()
+    expect(screen.getByText('FL-002')).toBeTruthy()
+    expect(screen.getByText('FL-001')).toBeTruthy()
+    expect(screen.getByText('Unknown upload retained')).toBeTruthy()
+    expect(screen.getAllByRole('button').map((b) => b.textContent)).toEqual([
+      'Return to FL-001',
+    ])
+    expect(screen.queryByRole('textbox')).toBeNull()
+  })
+})
