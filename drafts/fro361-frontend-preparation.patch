+import { useEffect, useId, useRef, useState } from 'react'
+import { useLabels } from '#/app/providers/labels-provider'
+import { Button } from '#/components/ui/button'
+import { Alert } from '#/components/ui/alert'
+import { canPreviewDeliveryNotePdf } from '#/features/shipments/components/delivery-note-form-validation'
+import type {
+  DeliveryNoteDetailsModel,
+  DeliveryNoteDetailsProps,
+} from '../types'
+type Props = Pick<
+  DeliveryNoteDetailsProps,
+  'onOpenShipment' | 'onPreviewPdf'
+> & { model: DeliveryNoteDetailsModel }
+// Parent keys by identity only: refreshing the same note must preserve in-flight work.
+export function DeliveryNoteDetailsActions({
+  model,
+  onOpenShipment,
+  onPreviewPdf,
+}: Props) {
+  const text = useLabels().deliveryNotesText
+  const [pending, setPending] = useState(false)
+  const [failed, setFailed] = useState(false)
+  const inFlight = useRef(false)
+  const active = useRef(true)
+  const explanationId = useId()
+  useEffect(() => {
+    active.current = true
+    return () => {
+      active.current = false
+    }
+  }, [])
+  const draft = model.note.status === 'DRAFT'
+  const unsaved = draft && !model.hasSavedDraft
+  const visible = model.note.status !== 'SUBMISSION_PENDING'
+  const allowed =
+    visible &&
+    (draft
+      ? canPreviewDeliveryNotePdf({
+          hasSavedDraft: model.hasSavedDraft,
+          isDirty: false,
+          isSaving: false,
+          isPreviewing: pending,
+        })
+      : !pending)
+  async function preview() {
+    if (!allowed || inFlight.current) return
+    inFlight.current = true
+    setPending(true)
+    setFailed(false)
+    try {
+      await onPreviewPdf(String(model.note.shipmentId), String(model.note.id))
+    } catch {
+      if (active.current) setFailed(true)
+    } finally {
+      inFlight.current = false
+      if (active.current) setPending(false)
+    }
+  }
+  return (
+    <div className="min-w-0 max-w-full space-y-3">
+      <div className="flex flex-wrap gap-2">
+        {model.canOpenShipment && (
+          <Button
+            type="button"
+            variant="secondary"
+            className="h-auto min-h-10 whitespace-normal py-2"
+            onClick={() => onOpenShipment(String(model.note.shipmentId))}
+          >
+            {text.openShipment}
+          </Button>
+        )}
+        {visible && (
+          <Button
+            type="button"
+            className="h-auto min-h-10 whitespace-normal py-2"
+            disabled={!allowed}
+            loading={pending}
+            onClick={preview}
+            aria-describedby={unsaved ? explanationId : undefined}
+          >
+            {pending ? text.previewingPdf : text.previewPdf}
+          </Button>
+        )}
+      </div>
+      {unsaved && (
+        <div id={explanationId}>
+          <Alert>{text.saveMovementFirst}</Alert>
+        </div>
+      )}
+      {failed && <Alert tone="danger">{text.pdfPreviewFailed}</Alert>}
+    </div>
+  )
+}
