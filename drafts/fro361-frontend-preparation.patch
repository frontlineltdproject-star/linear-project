+import { useLabels } from '#/app/providers/labels-provider'
+import { Breadcrumbs } from '#/components/ui/navigation'
+import { Heading, Text } from '#/components/ui/typography'
+import { Button } from '#/components/ui/button'
+import { Tabs, TabList, Tab, TabPanel } from '#/components/ui/tabs'
+import { Spinner, EmptyState } from '#/components/ui/feedback'
+import type { DeliveryNoteDetailsProps } from '../types'
+import {
+  DeliveryNoteDetailsSections,
+  NoteStatus,
+} from './delivery-note-details-sections'
+import { DeliveryNoteDetailsActions } from './delivery-note-details-actions'
+export function DeliveryNoteDetails(props: DeliveryNoteDetailsProps) {
+  const text = useLabels().deliveryNotesText
+  if (props.state.kind !== 'ready')
+    return (
+      <div className="space-y-4">
+        <Breadcrumbs
+          items={[
+            { label: text.title, onClick: props.onBack },
+            { label: text.detailsTab },
+          ]}
+        />
+        {props.state.kind === 'loading' ? (
+          <Spinner label={text.loading} />
+        ) : (
+          <EmptyState
+            title={
+              props.state.kind === 'error' ? text.loadFailed : text.unavailable
+            }
+            action={
+              props.state.kind === 'error' ? (
+                <Button onClick={props.onRetry}>{text.retry}</Button>
+              ) : undefined
+            }
+          />
+        )}
+      </div>
+    )
+  const model = props.state.model
+  const n = model.note
+  const identity =
+    n.fiscalNumber == null
+      ? text.awaitingNumber
+      : `${n.series} ${n.fiscalNumber}`
+  return (
+    <article className="min-w-0 space-y-4">
+      <Breadcrumbs
+        items={[
+          { label: text.title, onClick: props.onBack },
+          { label: identity },
+        ]}
+      />
+      <div className="flex flex-wrap items-start justify-between gap-4">
+        <div className="min-w-0">
+          <div className="flex flex-wrap items-center gap-3">
+            <Heading
+              level={1}
+              className="text-title break-words [overflow-wrap:anywhere]"
+            >
+              {text.detailTitle}
+              {n.fiscalNumber != null ? ' ' + identity : ''}
+            </Heading>
+            <NoteStatus status={n.status} />
+          </div>
+          <Text
+            as="p"
+            tone="muted"
+            className="mt-1 break-words [overflow-wrap:anywhere]"
+          >
+            {model.shipmentReference} · {model.invoicingCompanyName}
+          </Text>
+        </div>
+        <DeliveryNoteDetailsActions
+          key={`${n.shipmentId}:${n.id}`}
+          model={model}
+          onOpenShipment={props.onOpenShipment}
+          onPreviewPdf={props.onPreviewPdf}
+        />
+      </div>
+      <Tabs defaultValue="details">
+        <TabList>
+          <Tab value="details">{text.detailsTab}</Tab>
+        </TabList>
+        <TabPanel value="details">
+          <DeliveryNoteDetailsSections model={model} />
+        </TabPanel>
+      </Tabs>
+    </article>
+  )
+}
