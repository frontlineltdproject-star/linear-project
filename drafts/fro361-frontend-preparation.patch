+import type { DeliveryNoteStatus } from '#/graphql/generated/graphql'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { LabelsProvider } from '#/app/providers/labels-provider'
+import { DeliveryNoteDetails } from './delivery-note-details'
+import { makeDetailsModel } from '../testing/delivery-note-details-fixtures'
+import type { DeliveryNoteDetailsProps } from '../types'
+afterEach(cleanup)
+beforeEach(() => localStorage.clear())
+function setup(status: DeliveryNoteStatus = 'ISSUED', saved = true) {
+  const model = makeDetailsModel()
+  model.note.status = status
+  model.hasSavedDraft = saved
+  const p: DeliveryNoteDetailsProps = {
+    state: { kind: 'ready', model },
+    onBack: vi.fn(),
+    onRetry: vi.fn(),
+    onOpenShipment: vi.fn(),
+    onPreviewPdf: vi.fn().mockResolvedValue(undefined),
+  }
+  const view = (props: DeliveryNoteDetailsProps) => (
+    <LabelsProvider>
+      <DeliveryNoteDetails {...props} />
+    </LabelsProvider>
+  )
+  return { p, model, view }
+}
+it.each([
+  'DRAFT',
+  'SUBMISSION_FAILED',
+  'ISSUED',
+  'CANCELLATION_PENDING',
+  'CANCELLED',
+] as const)('previews %s using selected IDs', async (status) => {
+  const { p, view } = setup(status)
+  render(view(p))
+  await act(async () =>
+    fireEvent.click(screen.getByRole('button', { name: 'Preview PDF' })),
+  )
+  expect(p.onPreviewPdf).toHaveBeenCalledExactlyOnceWith('41', '103')
+})
+it('omits PDF during submission pending', () => {
+  const { p, view } = setup('SUBMISSION_PENDING')
+  render(view(p))
+  expect(screen.queryByRole('button', { name: 'Preview PDF' })).toBeNull()
+  expect(p.onPreviewPdf).not.toHaveBeenCalled()
+})
+it.each(['en', 'el'])(
+  'blocks unsaved shared movement state with visible %s explanation',
+  (locale) => {
+    localStorage.setItem('frontline.locale', locale)
+    const { p, view } = setup('DRAFT', false)
+    render(view(p))
+    const b = screen.getByRole('button', {
+      name: locale === 'en' ? 'Preview PDF' : 'Προεπισκόπηση PDF',
+    }) as HTMLButtonElement
+    expect(b.disabled).toBe(true)
+    fireEvent.click(b)
+    expect(p.onPreviewPdf).not.toHaveBeenCalled()
+    expect(
+      screen.getByText(
+        locale === 'en'
+          ? 'Save the draft’s movement details in Shipment first'
+          : 'Αποθηκεύστε πρώτα τα στοιχεία διακίνησης του πρόχειρου δελτίου στην Αποστολή',
+      ),
+    ).toBeTruthy()
+    const ship = screen.getByRole('button', {
+      name: locale === 'en' ? 'Open Shipment' : 'Άνοιγμα αποστολής',
+    }) as HTMLButtonElement
+    expect(ship.disabled).toBe(false)
+  },
+)
+it('prevents double preview, reports localized failure and permits retry', async () => {
+  const { p, view } = setup()
+  let reject!: (e: Error) => void
+  p.onPreviewPdf = vi
+    .fn()
+    .mockImplementationOnce(
+      () =>
+        new Promise<void>((_, r) => {
+          reject = r
+        }),
+    )
+    .mockResolvedValue(undefined)
+  render(view(p))
+  const b = screen.getByRole('button', { name: 'Preview PDF' })
+  act(() => {
+    fireEvent.click(b)
+    fireEvent.click(b)
+  })
+  expect(p.onPreviewPdf).toHaveBeenCalledTimes(1)
+  expect(
+    (
+      screen.getByRole('button', {
+        name: 'Preparing PDF…',
+      }) as HTMLButtonElement
+    ).disabled,
+  ).toBe(true)
+  await act(async () => reject(new Error('private raw error')))
+  expect(
+    screen.getByText('The delivery note PDF could not be generated.'),
+  ).toBeTruthy()
+  expect(screen.queryByText('private raw error')).toBeNull()
+  await act(async () =>
+    fireEvent.click(screen.getByRole('button', { name: 'Preview PDF' })),
+  )
+  expect(p.onPreviewPdf).toHaveBeenCalledTimes(2)
+})
+it('ignores late rejection after note identity changes', async () => {
+  const { p, model, view } = setup()
+  let reject!: (e: Error) => void
+  p.onPreviewPdf = vi.fn(
+    () =>
+      new Promise<void>((_, r) => {
+        reject = r
+      }),
+  )
+  const r = render(view(p))
+  fireEvent.click(screen.getByRole('button', { name: 'Preview PDF' }))
+  const next = {
+    ...model,
+    note: { ...model.note, id: '104', shipmentId: '42' },
+  }
+  r.rerender(view({ ...p, state: { kind: 'ready', model: next } }))
+  expect(
+    (screen.getByRole('button', { name: 'Preview PDF' }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(false)
+  await act(async () => reject(new Error('old failure')))
+  expect(
+    screen.queryByText('The delivery note PDF could not be generated.'),
+  ).toBeNull()
+})
+it('navigates with selected Shipment and back callback, respects missing Shipment access', () => {
+  const { p, model, view } = setup()
+  const r = render(view(p))
+  fireEvent.click(screen.getByRole('button', { name: 'Open Shipment' }))
+  expect(p.onOpenShipment).toHaveBeenCalledExactlyOnceWith('41')
+  fireEvent.click(screen.getByRole('button', { name: 'Delivery notes' }))
+  expect(p.onBack).toHaveBeenCalledOnce()
+  r.rerender(
+    view({
+      ...p,
+      state: { kind: 'ready', model: { ...model, canOpenShipment: false } },
+    }),
+  )
+  expect(screen.queryByRole('button', { name: 'Open Shipment' })).toBeNull()
+})
+it('retry is explicit and never triggers PDF', () => {
+  const { p, view } = setup()
+  render(view({ ...p, state: { kind: 'error' } }))
+  fireEvent.click(screen.getByRole('button', { name: 'Try again' }))
+  expect(p.onRetry).toHaveBeenCalledOnce()
+  expect(p.onPreviewPdf).not.toHaveBeenCalled()
+})
+
+it('keeps the in-flight guard when the same note is refreshed', async () => {
+  const { p, model, view } = setup()
+  let resolve!: () => void
+  p.onPreviewPdf = vi.fn(
+    () =>
+      new Promise<void>((r) => {
+        resolve = r
+      }),
+  )
+  const result = render(view(p))
+  fireEvent.click(screen.getByRole('button', { name: 'Preview PDF' }))
+  result.rerender(
+    view({
+      ...p,
+      state: {
+        kind: 'ready',
+        model: {
+          ...model,
+          hasSavedDraft: false,
+          note: { ...model.note, version: '2' },
+        },
+      },
+    }),
+  )
+  const button = screen.getByRole('button', {
+    name: /PDF/,
+  }) as HTMLButtonElement
+  expect(button.disabled).toBe(true)
+  fireEvent.click(button)
+  expect(p.onPreviewPdf).toHaveBeenCalledTimes(1)
+  await act(async () => resolve())
+  expect(
+    (screen.getByRole('button', { name: 'Preview PDF' }) as HTMLButtonElement)
+      .disabled,
+  ).toBe(false)
+})
