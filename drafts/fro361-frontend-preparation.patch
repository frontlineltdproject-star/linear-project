+import type { DeliveryNote } from '#/features/shipments/services/delivery-note-service'
+export interface DeliveryNoteDetailsModel {
+  note: DeliveryNote
+  shipmentReference: string
+  invoicingCompanyName: string
+  hasSavedDraft: boolean
+  canOpenShipment: boolean
+}
+export type DeliveryNoteDetailsState =
+  | { kind: 'loading' | 'unavailable' | 'error' }
+  | { kind: 'ready'; model: DeliveryNoteDetailsModel }
+export interface DeliveryNoteDetailsProps {
+  state: DeliveryNoteDetailsState
+  onBack: () => void
+  onRetry: () => void
+  onOpenShipment: (shipmentId: string) => void
+  onPreviewPdf: (shipmentId: string, noteId: string) => Promise<void>
+}
