+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render, screen, within } from '@testing-library/react'
+import { LabelsProvider } from '#/app/providers/labels-provider'
+import { DeliveryNoteDetails } from './delivery-note-details'
+import { makeDetailsModel } from '../testing/delivery-note-details-fixtures'
+import type { DeliveryNoteDetailsProps } from '../types'
+afterEach(cleanup)
+beforeEach(() => localStorage.clear())
+function props(): DeliveryNoteDetailsProps {
+  return {
+    state: { kind: 'ready', model: makeDetailsModel() },
+    onBack: vi.fn(),
+    onRetry: vi.fn(),
+    onOpenShipment: vi.fn(),
+    onPreviewPdf: vi.fn().mockResolvedValue(undefined),
+  }
+}
+function view(p: DeliveryNoteDetailsProps) {
+  return (
+    <LabelsProvider>
+      <DeliveryNoteDetails {...p} />
+    </LabelsProvider>
+  )
+}
+describe('DeliveryNoteDetails', () => {
+  it('renders section order and only selected note with stored totals', () => {
+    const p = props()
+    if (p.state.kind === 'ready') p.state.model.note.totalGrossWeightKg = 99
+    render(view(p))
+    expect(
+      screen.getAllByRole('heading', { level: 2 }).map((e) => e.textContent),
+    ).toEqual(['Document', 'Movement', 'Goods covered'])
+    expect(screen.getAllByRole('tab')).toHaveLength(1)
+    expect(screen.getByRole('tab').textContent).toBe('Details')
+    expect(screen.getByText('DEMO-PO-12')).toBeTruthy()
+    expect(screen.queryByText('DEMO-PO-99')).toBeNull()
+    expect(screen.getByText('99 kg')).toBeTruthy()
+    expect(screen.queryByRole('textbox')).toBeNull()
+    expect(
+      screen.queryByRole('button', {
+        name: /issue delivery|cancel delivery|save|edit/i,
+      }),
+    ).toBeNull()
+  })
+  it('renders unnumbered draft and missing date without inventing values, preserving zero totals', () => {
+    const p = props()
+    if (p.state.kind === 'ready')
+      Object.assign(p.state.model.note, {
+        status: 'DRAFT',
+        fiscalNumber: null,
+        issuedAt: null,
+        totalCollis: 0,
+        totalGrossWeightKg: 0,
+        lines: [],
+      })
+    render(view(p))
+    expect(screen.getAllByText('Awaiting number').length).toBeGreaterThan(0)
+    expect(screen.queryByText('DN 103')).toBeNull()
+    expect(screen.getByText('No goods recorded.')).toBeTruthy()
+    expect(screen.getByText('0 kg')).toBeTruthy()
+    const dt = screen.getByText('Issue date')
+    expect(dt.nextElementSibling?.textContent).toBe('—')
+  })
+  it.each(['unavailable', 'loading', 'error'] as const)(
+    'clears previous document in %s state',
+    (kind) => {
+      const p = props()
+      const r = render(view(p))
+      r.rerender(view({ ...p, state: { kind } }))
+      expect(screen.queryByText('DEMO-PO-12')).toBeNull()
+      expect(screen.queryByText('DEMO-MARK')).toBeNull()
+      expect(screen.queryByRole('button', { name: 'Preview PDF' })).toBeNull()
+    },
+  )
+  it('renders submission errors as text, not executable markup', () => {
+    const p = props()
+    if (p.state.kind === 'ready')
+      Object.assign(p.state.model.note, {
+        status: 'SUBMISSION_FAILED',
+        submissionError: '<img src=x onerror=alert(1)>',
+      })
+    const r = render(view(p))
+    expect(screen.getByText('<img src=x onerror=alert(1)>')).toBeTruthy()
+    expect(r.container.querySelector('img')).toBeNull()
+  })
+  it('renders Greek labels with the same section content', () => {
+    localStorage.setItem('frontline.locale', 'el')
+    render(view(props()))
+    expect(screen.getByRole('tab').textContent).toBe('Στοιχεία')
+    expect(
+      screen.getByRole('heading', { name: 'Εμπορεύματα δελτίου' }),
+    ).toBeTruthy()
+    expect(
+      within(screen.getByRole('table')).getByText('DEMO-PO-12'),
+    ).toBeTruthy()
+  })
+})
