+import type { ReactNode } from 'react'
+import { useLabels, useLocale } from '#/app/providers/labels-provider'
+import { Card, CardHeader, CardBody } from '#/components/ui/card'
+import { Heading } from '#/components/ui/typography'
+import { Table, THead, TBody, TR, TH, TD } from '#/components/ui/table'
+import { StatusPill } from '#/components/ui/badge'
+import { Alert } from '#/components/ui/alert'
+import { formatDateTime } from '#/lib/date'
+import type { DeliveryNoteDetailsModel } from '../types'
+export function NoteStatus({ status }: { status: string }) {
+  const text = useLabels().deliveryNotesText
+  return (
+    <StatusPill
+      tone={
+        status === 'SUBMISSION_FAILED'
+          ? 'danger'
+          : status === 'DRAFT'
+            ? 'warning'
+            : 'info'
+      }
+      className="max-w-full leading-normal"
+    >
+      {text.statusLabels[status] ?? status}
+    </StatusPill>
+  )
+}
+function Fields({ entries }: { entries: Array<[string, ReactNode]> }) {
+  return (
+    <dl className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
+      {entries.map(([label, value]) => (
+        <div key={label} className="min-w-0">
+          <dt className="text-caption text-fg-muted">{label}</dt>
+          <dd className="mt-1 break-words [overflow-wrap:anywhere]">
+            {value ?? '—'}
+          </dd>
+        </div>
+      ))}
+    </dl>
+  )
+}
+function Section({ title, children }: { title: string; children: ReactNode }) {
+  return (
+    <Card flush className="min-w-0">
+      <CardHeader>
+        <Heading level={2} className="text-heading">
+          {title}
+        </Heading>
+      </CardHeader>
+      <CardBody>{children}</CardBody>
+    </Card>
+  )
+}
+export function DeliveryNoteDetailsSections({
+  model,
+}: {
+  model: DeliveryNoteDetailsModel
+}) {
+  const text = useLabels().deliveryNotesText
+  const { locale } = useLocale()
+  const n = model.note
+  const address = (a: typeof n.loadingAddress | null) =>
+    a
+      ? [a.street, a.number, a.postalCode, a.city].filter(Boolean).join(', ') ||
+        '—'
+      : '—'
+  const time = (v: typeof n.issuedAt) =>
+    v ? formatDateTime(String(v), locale) : '—'
+  const purpose = n.movementPurpose
+    ? (text.movementPurposeLabels[n.movementPurpose] ?? n.movementPurpose)
+    : '—'
+  return (
+    <div className="mt-4 space-y-4">
+      <Section title={text.documentSection}>
+        <Fields
+          entries={[
+            [
+              text.documentNumber,
+              n.fiscalNumber == null
+                ? text.awaitingNumber
+                : `${n.series} ${n.fiscalNumber}`,
+            ],
+            [text.status, <NoteStatus status={n.status} />],
+            [text.issueDate, time(n.issuedAt)],
+            [text.invoiceCompany, model.invoicingCompanyName],
+            [text.shipment, model.shipmentReference],
+            ...(n.mark ? [[text.mark, n.mark] as [string, ReactNode]] : []),
+          ]}
+        />
+        {n.status === 'SUBMISSION_FAILED' && n.submissionError && (
+          <div className="mt-4 break-words [overflow-wrap:anywhere]">
+            <Alert tone="danger" title={text.submissionFailureDetails}>
+              {n.submissionError}
+            </Alert>
+          </div>
+        )}
+      </Section>
+      <Section title={text.movementSection}>
+        <Fields
+          entries={[
+            [text.recipient, n.recipient.name],
+            [text.loadingAddress, address(n.loadingAddress)],
+            [text.destinationAddress, address(n.destinationAddress)],
+            [text.movementStart, time(n.movementStartAt)],
+            [text.vehicleNumber, n.vehicleNumber || '—'],
+            [
+              text.movementPurpose,
+              n.movementPurpose === 'OTHER_MOVEMENTS' &&
+              n.otherMovementPurposeTitle
+                ? `${purpose} — ${n.otherMovementPurposeTitle}`
+                : purpose,
+            ],
+          ]}
+        />
+      </Section>
+      <Section title={text.goodsSection}>
+        {n.lines.length === 0 && (
+          <p className="mb-3 text-fg-muted">{text.noGoods}</p>
+        )}
+        <Table className="table-fixed" aria-label={text.goodsSection}>
+          <THead>
+            <TR>
+              <TH scope="col" className="w-1/2 break-words">
+                {text.order}
+              </TH>
+              <TH scope="col" className="break-words">
+                {text.collis}
+              </TH>
+              <TH scope="col" className="break-words">
+                {text.grossWeight}
+              </TH>
+            </TR>
+          </THead>
+          <TBody>
+            {n.lines.map((line) => (
+              <TR key={String(line.id)}>
+                <TD className="break-words font-mono [overflow-wrap:anywhere]">
+                  {String(line.stockId)}
+                </TD>
+                <TD className="break-words font-mono">{line.colliQuantity}</TD>
+                <TD className="break-words font-mono">
+                  {line.grossWeightKg} kg
+                </TD>
+              </TR>
+            ))}
+            <TR>
+              <TH scope="row">{text.total}</TH>
+              <TD className="font-mono">{n.totalCollis}</TD>
+              <TD className="break-words font-mono">
+                {n.totalGrossWeightKg} kg
+              </TD>
+            </TR>
+          </TBody>
+        </Table>
+      </Section>
+    </div>
+  )
+}
