@@ -0,0 +1,277 @@
+import type {
+  MeasurementSource,
+  PackingDraft,
+  PackingPlanSubmission,
+  ParticipationCandidateOrder,
+  PartialReason,
+  RecordedMoment,
+  RouteDraft,
+  ShipmentDetailsStatus,
+  ShipmentLoadUnitRow,
+} from './shipment-details-types'
+
+export const lifecycleSteps: ShipmentDetailsStatus[] = [
+  'PREPARING',
+  'READY_FOR_DISPATCH',
+  'DISPATCHED',
+  'ARRIVED',
+]
+
+export function isPreDispatch(status: ShipmentDetailsStatus) {
+  return status === 'PREPARING' || status === 'READY_FOR_DISPATCH'
+}
+
+export function isExceptionStatus(status: ShipmentDetailsStatus) {
+  return status === 'CANCELLED' || status === 'LOCATION_UNKNOWN'
+}
+
+export type StepState = 'done' | 'current' | 'upcoming' | 'unrecorded'
+
+/**
+ * Display-only lifecycle steps. Exceptions return null so callers never show a
+ * progress position for them. A historical arrival has no recorded earlier
+ * transitions, so those steps are never shown as completed.
+ */
+export function statusSteps(
+  status: ShipmentDetailsStatus,
+  historical: boolean,
+): StepState[] | null {
+  if (isExceptionStatus(status)) return null
+  const current = lifecycleSteps.indexOf(status)
+  return lifecycleSteps.map((_, index) => {
+    if (index === current) return 'current'
+    if (index > current) return 'upcoming'
+    return historical ? 'unrecorded' : 'done'
+  })
+}
+
+export function shipmentStatusTone(status: ShipmentDetailsStatus) {
+  if (status === 'ARRIVED') return 'success' as const
+  if (isExceptionStatus(status)) return 'danger' as const
+  if (status === 'DISPATCHED') return 'info' as const
+  return 'neutral' as const
+}
+
+const numberFormat = new Intl.NumberFormat('en-GB', {
+  maximumFractionDigits: 2,
+})
+
+/** FRO-299 values: confirmed, else declared (marked), else absent. */
+export function dimensionsText(measurement: {
+  lengthCm: number | null
+  widthCm: number | null
+  heightCm: number | null
+  dimensionsSource: MeasurementSource
+}) {
+  const { lengthCm, widthCm, heightCm, dimensionsSource } = measurement
+  if (lengthCm == null || widthCm == null || heightCm == null)
+    return { text: '—', declared: false }
+  return {
+    text: `${lengthCm} × ${widthCm} × ${heightCm} cm`,
+    declared: dimensionsSource === 'DECLARED',
+  }
+}
+
+export function weightText(measurement: {
+  grossWeightKg: number | null
+  grossWeightSource: MeasurementSource
+}) {
+  if (measurement.grossWeightKg == null) return { text: '—', declared: false }
+  return {
+    text: `${numberFormat.format(measurement.grossWeightKg)} kg`,
+    declared: measurement.grossWeightSource === 'DECLARED',
+  }
+}
+
+export function formatMoment(
+  locale: 'en' | 'el',
+  moment: RecordedMoment | null | undefined,
+) {
+  if (!moment) return '—'
+  const date = new Date(moment.iso)
+  if (Number.isNaN(date.getTime())) return '—'
+  return new Intl.DateTimeFormat(locale === 'el' ? 'el-GR' : 'en-GB', {
+    dateStyle: 'short',
+    ...(moment.dateOnly ? { timeZone: 'UTC' } : { timeStyle: 'short' }),
+  }).format(date)
+}
+
+/** Each load unit counts once; contained collis are not counted again. */
+export function transportPieceCount(
+  colliIds: string[],
+  assignment: Record<string, string>,
+  unitKeys?: string[],
+) {
+  const known = unitKeys ? new Set(unitKeys) : null
+  const used = new Set<string>()
+  let individual = 0
+  for (const id of colliIds) {
+    const key = assignment[id]
+    if (key && (!known || known.has(key))) used.add(key)
+    else individual += 1
+  }
+  const loadUnits = known ? known.size : used.size
+  return { loadUnits, individual, transportPieces: loadUnits + individual }
+}
+
+export function draftFromLoadUnits(units: ShipmentLoadUnitRow[]): PackingDraft {
+  const assignment: Record<string, string> = {}
+  for (const unit of units)
+    for (const colliId of unit.colliIds) assignment[colliId] = unit.id
+  return {
+    units: units.map((unit) => ({
+      key: unit.id,
+      id: unit.id,
+      type: unit.type,
+      label: unit.label ?? '',
+      length: String(unit.lengthCm),
+      width: String(unit.widthCm),
+      height: String(unit.heightCm),
+      gross: unit.grossWeightKg == null ? '' : String(unit.grossWeightKg),
+    })),
+    assignment,
+  }
+}
+
+export function packingSubmission(draft: PackingDraft): PackingPlanSubmission {
+  return {
+    units: draft.units.map((unit) => ({
+      id: unit.id,
+      type: unit.type,
+      label: unit.label.trim() || null,
+      lengthCm: Number(unit.length),
+      widthCm: Number(unit.width),
+      heightCm: Number(unit.height),
+      grossWeightKg: unit.gross.trim() === '' ? null : Number(unit.gross),
+      colliIds: Object.entries(draft.assignment)
+        .filter(([, key]) => key === unit.key)
+        .map(([colliId]) => colliId)
+        .sort(),
+    })),
+  }
+}
+
+/** Compares canonical values; ordering alone is not a change. */
+export function packingDraftChanged(
+  saved: ShipmentLoadUnitRow[],
+  draft: PackingDraft,
+) {
+  const canonical = (units: PackingPlanSubmission['units']) =>
+    JSON.stringify(
+      units
+        .map((unit) => ({ ...unit, colliIds: [...unit.colliIds].sort() }))
+        .sort((a, b) => String(a.id).localeCompare(String(b.id))),
+    )
+  return (
+    canonical(packingSubmission(draftFromLoadUnits(saved)).units) !==
+    canonical(packingSubmission(draft).units)
+  )
+}
+
+export const loadUnitLabelMaxLength = 100
+
+export type UnitErrors = Partial<
+  Record<'length' | 'width' | 'height', 'dimension'> & {
+    gross: 'weight'
+    label: 'duplicate' | 'tooLong'
+    empty: true
+  }
+>
+
+export function validatePackingDraft(
+  draft: PackingDraft,
+): Record<string, UnitErrors> {
+  const errors: Record<string, UnitErrors> = {}
+  const labels = new Map<string, number>()
+  for (const unit of draft.units) {
+    const label = unit.label.trim()
+    if (label) labels.set(label, (labels.get(label) ?? 0) + 1)
+  }
+  for (const unit of draft.units) {
+    const unitErrors: UnitErrors = {}
+    for (const field of ['length', 'width', 'height'] as const) {
+      const value = unit[field].trim()
+      if (!/^\d+$/.test(value) || Number(value) <= 0)
+        unitErrors[field] = 'dimension'
+    }
+    const gross = unit.gross.trim()
+    if (gross !== '' && !(Number(gross) > 0)) unitErrors.gross = 'weight'
+    const label = unit.label.trim()
+    if (label.length > loadUnitLabelMaxLength) unitErrors.label = 'tooLong'
+    else if (label && (labels.get(label) ?? 0) > 1)
+      unitErrors.label = 'duplicate'
+    if (!Object.values(draft.assignment).includes(unit.key))
+      unitErrors.empty = true
+    if (Object.keys(unitErrors).length) errors[unit.key] = unitErrors
+  }
+  return errors
+}
+
+const materialRouteFields: (keyof RouteDraft)[] = [
+  'originCountryId',
+  'originCityId',
+  'destinationCountryId',
+  'destinationCityId',
+  'originWarehouseId',
+  'mode',
+  'destinationWarehouseId',
+]
+
+/** Material changes invalidate readiness; a document number alone does not. */
+export function isMaterialRouteChange(saved: RouteDraft, draft: RouteDraft) {
+  return materialRouteFields.some((field) => saved[field] !== draft[field])
+}
+
+export function validateParticipation(
+  selected: Set<string>,
+  orders: ParticipationCandidateOrder[],
+  units: ShipmentLoadUnitRow[],
+  decisions: Record<string, { reason: PartialReason | ''; remark: string }>,
+) {
+  const emptiedUnits = units
+    .filter(
+      (unit) =>
+        unit.colliIds.length > 0 &&
+        unit.colliIds.every((colliId) => !selected.has(colliId)),
+    )
+    .map((unit) => unit.label ?? unit.id)
+  const partialMissing: string[] = []
+  const wholeRequired: string[] = []
+  for (const order of orders) {
+    const selectable = order.collis.filter(
+      (colli) => colli.available || selected.has(colli.id),
+    )
+    const count = selectable.filter((colli) => selected.has(colli.id)).length
+    if (count === 0 || count === selectable.length) continue
+    if (!order.inStock) {
+      wholeRequired.push(order.id)
+      continue
+    }
+    const decision = decisions[order.id]
+    if (
+      !decision?.reason ||
+      (decision.reason === 'OTHER' && !decision.remark.trim())
+    )
+      partialMissing.push(order.id)
+  }
+  return {
+    empty: selected.size === 0,
+    emptiedUnits,
+    partialMissing,
+    wholeRequired,
+  }
+}
+
+/** Orders that are partly selected and therefore need a split decision. */
+export function partialOrders(
+  selected: Set<string>,
+  orders: ParticipationCandidateOrder[],
+) {
+  return orders.filter((order) => {
+    const selectable = order.collis.filter(
+      (colli) => colli.available || selected.has(colli.id),
+    )
+    const count = selectable.filter((colli) => selected.has(colli.id)).length
+    return order.inStock && count > 0 && count < selectable.length
+  })
+}
