+          id: 'ev-hist',
+          from: null,
+          to: 'ARRIVED' as const,
+          reason: 'Historical arrival recorded',
+          actor: 'Demo operator',
+          recordedAt: at('2026-10-20T07:31:00Z'),
+          occurredAt: at('2026-09-28T00:00:00Z', true),
+        },
+      ]
+    : events.reverse()
+  return {
+    state: 'ready',
+    statusEvents,
+    operations: [
+      {
+        id: 'op-doc',
+        summary: 'Transport document assigned — CMR-DEMO-01',
+        actor: 'Demo operator',
+        recordedAt: at('2026-09-29T11:10:00Z'),
