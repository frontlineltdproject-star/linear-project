+function historyFor(view: ShipmentDetailsView): ShipmentHistoryView {
+  const created = {
+    id: 'ev-created',
+    from: null,
+    to: 'PREPARING' as const,
+    reason: null,
+    actor: 'Demo operator',
+    recordedAt: at('2026-09-29T09:07:00Z'),
+    occurredAt: null,
+  }
+  const steps: Partial<
+    Record<ShipmentDetailsStatus, ShipmentHistoryView['statusEvents']>
+  > = {
+    READY_FOR_DISPATCH: [
+      {
+        id: 'ev-ready',
+        from: 'PREPARING',
+        to: 'READY_FOR_DISPATCH',
+        reason: null,
+        actor: 'Demo operator',
+        recordedAt: at('2026-09-29T12:20:00Z'),
+        occurredAt: null,
+      },
+    ],
+  }
+  const events = [created, ...(steps.READY_FOR_DISPATCH ?? [])]
+  if (
+    ['DISPATCHED', 'ARRIVED', 'LOCATION_UNKNOWN'].includes(view.status) &&
+    !view.historicalArrival
+  )
+    events.push({
+      id: 'ev-dispatch',
+      from: 'READY_FOR_DISPATCH',
+      to: 'DISPATCHED',
+      reason: null,
+      actor: 'Demo operator',
+      recordedAt: at('2026-09-30T06:14:00Z'),
+      occurredAt: null,
+    })
+  if (view.status === 'ARRIVED' && !view.historicalArrival)
+    events.push({
+      id: 'ev-arrive',
+      from: 'DISPATCHED',
+      to: 'ARRIVED',
+      reason: 'Handover to Demo Agent Company',
+      actor: 'Demo operator',
+      recordedAt: at('2026-10-02T14:40:00Z'),
+      occurredAt: null,
+    })
+  if (view.status === 'LOCATION_UNKNOWN')
+    events.push({
+      id: 'ev-lu',
+      from: 'DISPATCHED',
+      to: 'LOCATION_UNKNOWN',
+      reason: 'Carrier lost contact with the truck after the border crossing.',
+      actor: 'Demo operator',
+      recordedAt: at('2026-10-01T09:05:00Z'),
+      occurredAt: at('2026-10-01T08:30:00Z'),
+    })
+  if (view.status === 'CANCELLED')
+    events.splice(1, events.length, {
+      id: 'ev-cancel',
+      from: 'PREPARING',
+      to: 'CANCELLED',
+      reason: 'The client postponed the order; goods return to stock.',
+      actor: 'Demo operator',
+      recordedAt: at('2026-09-29T12:02:00Z'),
+      occurredAt: null,
+    })
+  const statusEvents = view.historicalArrival
