+import type {
+  PurposeDraft,
+  RouteDraft,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+
+/**
+ * Drafts owned above the tab panels: Tabs unmount inactive panels, so editors
+ * keep their values here across tab and language changes.
+ */
+export interface ShipmentDetailsDrafts {
+  route: RouteDraft | null
+  purpose: PurposeDraft | null
+  internalNotes: string | null
+  externalNotes: string | null
+  comment: string
+  cancelReason: string
+  locationReason: string
+}
+
+export const emptyDrafts: ShipmentDetailsDrafts = {
+  route: null,
+  purpose: null,
+  internalNotes: null,
+  externalNotes: null,
+  comment: '',
+  cancelReason: '',
+  locationReason: '',
+}
+
+export function routeDraftFromView(view: ShipmentDetailsView): RouteDraft {
+  return {
+    originCountryId: view.originCountry?.id ?? '',
+    originCityId: view.originCity?.id ?? '',
+    destinationCountryId: view.destinationCountry?.id ?? '',
+    destinationCityId: view.destinationCity?.id ?? '',
+    originWarehouseId: view.originWarehouse?.id ?? '',
+    mode: view.mode ?? '',
+    documentNumber: view.transportDocumentNumber ?? '',
+    documentResolution: '',
+    destinationWarehouseId: view.destination.warehouseId ?? '',
+  }
+}
+
+export function purposeDraftFromView(view: ShipmentDetailsView): PurposeDraft {
+  return {
+    purpose: view.purpose,
+    destinationId:
+      view.destination.kind === 'WAREHOUSE'
+        ? (view.destination.warehouseId ?? '')
+        : view.destination.kind === 'AGENT'
+          ? (view.destination.agentId ?? '')
+          : '',
+  }
+}
