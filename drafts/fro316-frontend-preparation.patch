+import { describe, expect, it } from 'vitest'
+import { shipmentDetailsText } from './shipment-details-labels'
+
+// Identical in both languages by design (codes, units and format templates).
+const sameInBothLanguages = new Set(['CMR', 'characters'])
+
+describe('shipment details labels', () => {
+  it('translates every Greek label, including those reused from production', () => {
+    const untranslated = Object.entries(shipmentDetailsText.el)
+      .filter(
+        ([key, value]) =>
+          !sameInBothLanguages.has(key) &&
+          value ===
+            shipmentDetailsText.en[key as keyof typeof shipmentDetailsText.en],
+      )
+      .map(([key]) => key)
+    expect(untranslated).toEqual([])
+  })
+})
