+function Review() {
+  const params = new URLSearchParams(location.search)
+  const initial = scenarios[params.get('scenario') ?? '']
+    ? (params.get('scenario') as string)
+    : 'preparing'
+  const [scenario, setScenario] = useState(initial)
+  const [view, setView] = useState<ShipmentDetailsView>(() => ({
+    ...base,
+    ...scenarios[initial].view,
+  }))
+  const [comments, setComments] = useState<ShipmentHistoryView['comments']>([])
+  const [tab, setTab] = useState<ShipmentDetailsTab>(
+    (params.get('tab') as ShipmentDetailsTab) || 'overview',
+  )
+  const [state, setState] = useState(params.get('state') ?? 'default')
+  const [viewOnly, setViewOnly] = useState(params.get('access') === 'view')
+  const [failNext, setFailNext] = useState(false)
+
+  const shown = useMemo<ShipmentDetailsView>(
+    () =>
+      state === 'empty'
+        ? { ...view, internalNotes: null, externalNotes: null }
+        : view,
+    [state, view],
+  )
+  const history = useMemo<ShipmentHistoryView>(() => {
+    const value = historyFor(view)
+    if (state === 'empty')
+      return { state: 'ready', statusEvents: [], operations: [], comments: [] }
+    return { ...value, comments }
+  }, [view, comments, state])
+
+  const choose = (key: string) => {
+    setScenario(key)
+    setView({ ...base, ...scenarios[key].view })
+    setComments([])
+  }
+
+  const simulate = (
+    effect: () => void,
+    failure = 'The Shipment changed meanwhile (simulated). Your draft is unchanged.',
+  ) =>
+    new Promise<OperationResult>((resolve) =>
+      setTimeout(() => {
+        if (failNext) {
+          setFailNext(false)
+          resolve({ ok: false, message: failure })
+          return
+        }
+        effect()
+        resolve({ ok: true })
+      }, 350),
+    )
+
+  const readyBlockersFor = (next: ShipmentDetailsView) =>
+    next.status === 'READY_FOR_DISPATCH' && !next.transportDocumentNumber
+      ? [noDocument]
+      : []
+
+  const commands: ShipmentDetailsCommands = {
+    saveRoute: (submission) => {
+      const destinationChanged =
+        submission.destinationCityId !== (view.destinationCity?.id ?? '')
+      if (destinationChanged && !submission.reconciliation)
+        return Promise.resolve({
+          ok: false,
+          reconciliation: [
+            {
+              id: 'r1',
+              draftNumber: 'DN-DEMO-DRAFT-1',
+              field: 'Destination address',
+              enteredValue: '4 Harbour Road, Rotterdam',
+              routeValue: 'Frontline Piraeus Agent Hub',
+            },
+          ],
+        })
+      return simulate(() =>
+        setView((current) => {
+          const city =
+            options.cities.find(
+              (item) => item.id === submission.destinationCityId,
+            ) ?? null
+          const material =
+            submission.mode !== current.mode ||
+            destinationChanged ||
+            submission.originWarehouseId !== current.originWarehouse?.id
+          const number =
+            submission.documentResolution === 'CLEAR'
+              ? null
+              : submission.documentNumber || null
+          const next: ShipmentDetailsView = {
+            ...current,
+            originCountry:
+              options.countries.find(
+                (item) => item.id === submission.originCountryId,
+              ) ?? null,
+            originCity:
+              options.cities.find(
+                (item) => item.id === submission.originCityId,
+              ) ?? null,
+            destinationCountry:
+              options.countries.find(
+                (item) => item.id === submission.destinationCountryId,
+              ) ?? null,
+            destinationCity: city,
+            originWarehouse:
+              options.warehouses.find(
+                (item) => item.id === submission.originWarehouseId,
+              ) ?? null,
+            mode: submission.mode || null,
+            transportDocumentNumber: number,
+            status:
+              material && current.status === 'READY_FOR_DISPATCH'
+                ? 'PREPARING'
+                : current.status,
+            packingState:
+              material && current.packingState === 'CONFIRMED'
+                ? 'SAVED'
+                : current.packingState,
+            destination:
+              submission.destinationWarehouseId && destinationChanged
+                ? {
+                    kind: 'WAREHOUSE',
+                    name:
+                      options.warehouses.find(
+                        (item) => item.id === submission.destinationWarehouseId,
+                      )?.name ?? null,
+                    warehouseId: submission.destinationWarehouseId,
+                  }
+                : current.destination,
+          }
+          return { ...next, dispatchBlockers: readyBlockersFor(next) }
+        }),
+      )
+    },
+    savePurpose: (draft) =>
+      simulate(() =>
+        setView((current) => ({
+          ...current,
+          purpose: draft.purpose,
+          status:
+            current.status === 'READY_FOR_DISPATCH'
+              ? 'PREPARING'
+              : current.status,
+          destination:
+            draft.purpose === 'DELIVERY_TO_VESSEL'
+              ? { kind: 'VESSEL', name: 'MV Oceanic Dawn, MV Aegean Star' }
+              : draft.purpose === 'NETWORK_TRANSFER'
+                ? {
+                    kind: 'WAREHOUSE',
+                    name:
+                      options.warehouses.find(
+                        (item) => item.id === draft.destinationId,
+                      )?.name ?? null,
+                    warehouseId: draft.destinationId,
+                  }
+                : {
+                    kind: 'AGENT',
+                    name:
+                      options.agents.find(
+                        (item) => item.id === draft.destinationId,
+                      )?.name ?? null,
+                    agentId: draft.destinationId,
+                  },
+        })),
+      ),
+    saveNote: (field, value) =>
+      simulate(() =>
+        setView((current) => ({
+          ...current,
+          [field === 'internal' ? 'internalNotes' : 'externalNotes']:
+            value.trim() || null,
+        })),
+      ),
+    dispatch: () =>
+      simulate(() =>
+        setView((current) => ({
+          ...current,
+          status: 'DISPATCHED',
+          departure: at(new Date().toISOString()),
+        })),
+      ),
+    saveParticipation: (submission) =>
+      simulate(() =>
+        setView((current) => {
+          const extra = candidatesFor(current).flatMap((order) =>
+            order.collis.map((item) => ({ order, item })),
+          )
+          const nextCollis = submission.colliIds.map(
+            (id) =>
+              current.collis.find((item) => item.id === id) ??
+              colli(
+                id,
+                extra.find((entry) => entry.item.id === id)!.order.id,
+                extra.find((entry) => entry.item.id === id)!.item.description,
+                'CARDBOARD_BOX',
+                null,
+                null,
+                null,
+                null,
+              ),
+          )
+          const nextOrders = [
+            ...current.orders,
+            {
+              id: 'PO-DEMO-0021',
+              number: 'PO-DEMO-0021',
+              rootNumber: null,
+              ownerReference: 'REF-7788',
+              client: 'Demo Client Company',
+              vessel: 'MV Aegean Star',
+              supplier: 'Demo Supplier Company',
+            },
+          ].filter(
+            (order, index, all) =>
+              all.findIndex((other) => other.id === order.id) === index &&
+              nextCollis.some((item) => item.orderId === order.id),
+          )
+          const changed =
+            nextCollis.length !== current.collis.length ||
+            nextCollis.some((item) => !current.collis.includes(item))
+          return {
+            ...current,
+            collis: nextCollis,
+            orders: nextOrders,
+            loadUnits: current.loadUnits.map((unit) => ({
+              ...unit,
+              colliIds: unit.colliIds.filter((id) =>
+                submission.colliIds.includes(id),
+              ),
+            })),
+            status:
+              changed && current.status === 'READY_FOR_DISPATCH'
+                ? 'PREPARING'
+                : current.status,
+          }
+        }),
+      ),
+    savePacking: (plan) =>
+      simulate(() =>
+        setView((current) => {
+          const units = plan.units.map((unit, index) => ({
+            ...unit,
+            id: unit.id ?? `new-${Date.now()}-${index}`,
+          }))
+          const changed =
+            JSON.stringify(units) !== JSON.stringify(current.loadUnits)
+          return {
+            ...current,
+            loadUnits: units,
+            packingState: changed ? 'SAVED' : current.packingState,
+            status:
+              changed && current.status === 'READY_FOR_DISPATCH'
+                ? 'PREPARING'
+                : current.status,
+          }
+        }),
+      ),
+    confirmReadiness: (plan) =>
+      simulate(() =>
+        setView((current) => {
+          const next: ShipmentDetailsView = {
+            ...current,
+            loadUnits: plan.units.map((unit, index) => ({
+              ...unit,
+              id: unit.id ?? `new-${Date.now()}-${index}`,
+            })),
+            packingState: 'CONFIRMED',
+            status: 'READY_FOR_DISPATCH',
+          }
+          return { ...next, dispatchBlockers: readyBlockersFor(next) }
+        }),
+      ),
+    addComment: (text) =>
+      simulate(() =>
+        setComments((current) => [
+          {
+            id: `c-${Date.now()}`,
+            summary: text,
+            actor: 'Demo operator',
+            recordedAt: at(new Date().toISOString()),
+          },
+          ...current,
+        ]),
+      ),
+    cancelShipment: () =>
+      simulate(() =>
+        setView((current) => ({
+          ...current,
+          lastConfirmedStage: current.status,
+          exceptionEventId: 'ev-cancel',
+          status: 'CANCELLED',
+        })),
+      ),
+    markLocationUnknown: () =>
+      simulate(() =>
+        setView((current) => ({
+          ...current,
+          lastConfirmedStage: 'DISPATCHED',
+          exceptionEventId: 'ev-lu',
+          status: 'LOCATION_UNKNOWN',
+        })),
+      ),
+    searchCandidates: () => undefined,
+    retryHistory: () => setState('default'),
+  }
+
+  return (
+    <div className="min-h-screen bg-canvas text-fg">
+      <header className="flex flex-wrap items-center justify-between gap-3 bg-chrome px-6 py-3">
+        <span className="text-body-sm font-semibold text-fg-on-chrome">
+          Frontline console · FRO-316 local review
+        </span>
+        <LanguageSelector />
+      </header>
+      <div className="flex flex-wrap items-end gap-3 border-b border-border bg-warning-subtle px-6 py-3 text-xs text-warning-fg">
+        <Badge tone="warning">Fixtures only — nothing is sent or saved</Badge>
+        <label className="flex flex-col gap-1">
+          Scenario
+          <Select
+            aria-label="Scenario"
+            value={scenario}
+            onChange={(event) => choose(event.target.value)}
+          >
+            {Object.entries(scenarios).map(([key, value]) => (
+              <option key={key} value={key}>
+                {value.label}
+              </option>
+            ))}
+          </Select>
+        </label>
+        <label className="flex flex-col gap-1">
+          Screen state
+          <Select
+            aria-label="Screen state"
+            value={state}
+            onChange={(event) => setState(event.target.value)}
+          >
+            <option value="default">Default</option>
+            <option value="loading">Loading</option>
+            <option value="empty">Empty lists</option>
+            <option value="error">Error</option>
+          </Select>
+        </label>
+        <Button
+          variant="secondary"
+          size="sm"
+          onClick={() => setViewOnly(!viewOnly)}
+          aria-pressed={viewOnly}
+        >
+          {viewOnly ? 'Access: view only' : 'Access: SHIPMENT_EDIT'}
+        </Button>
+        <Button
+          variant="secondary"
+          size="sm"
+          onClick={() => setFailNext(!failNext)}
+          aria-pressed={failNext}
+        >
+          {failNext ? 'Next save fails' : 'Saves succeed'}
+        </Button>
+      </div>
+      <main className="mx-auto max-w-[100rem] p-4 sm:p-6">
+        {state === 'loading' ? (
+          <DetailLoadingPlaceholder />
+        ) : state === 'error' ? (
+          <Card>
+            <ErrorMessage message="Could not load this shipment (simulated)." />
+            <Button
+              className="mt-3"
+              variant="secondary"
+              onClick={() => setState('default')}
+            >
+              Retry
+            </Button>
+          </Card>
+        ) : (
+          <ShipmentDetailsPreparedPage
+            view={shown}
+            capabilities={capabilitiesFor(view, viewOnly)}
+            options={options}
+            history={history}
+            candidates={candidatesFor(view)}
+            candidatesState="ready"
+            tab={tab}
+            onTabChange={setTab}
+            commands={commands}
+            slots={{
+              documents: (
+                <Alert tone="info">
+                  The live page renders the existing AttachmentPanel here
+                  (Shipment attachments, SHIPMENT_EDIT upload/remove). Not
+                  simulated in this review.
+                </Alert>
+              ),
+              deliveryNotes: (
+                <Alert tone="info">
+                  The live page renders the existing DeliveryNotesCard here,
+                  with FRO-307 address choices and its DELIVERY_NOTE_*
+                  permissions. Not simulated in this review.
+                </Alert>
+              ),
+              arrivalForm: (
+                <div className="flex flex-col gap-2">
+                  <p className="text-body-sm text-fg-muted">
+                    The existing purpose-specific arrival form goes here.
+                  </p>
+                  <div>
+                    <Button
+                      variant="secondary"
+                      onClick={() =>
+                        void simulate(() =>
+                          setView((current) => ({
+                            ...current,
+                            status: 'ARRIVED',
+                            arrival: at(new Date().toISOString()),
+                          })),
+                        )
+                      }
+                    >
+                      Record arrival (simulated)
+                    </Button>
+                  </div>
+                </div>
+              ),
+            }}
+            orderHref={() => '#order'}
+            colliHref={() => '#colli'}
+          />
+        )}
+      </main>
+    </div>
+  )
+}
+
+if (
+  import.meta.env.DEV &&
+  ['127.0.0.1', 'localhost', '[::1]'].includes(location.hostname)
+) {
+  const root = createRoot(document.getElementById('root')!)
+  import.meta.hot?.dispose(() => root.unmount())
+  root.render(
+    <LabelsProvider>
+      <ThemeProvider>
+        <Review />
+      </ThemeProvider>
+    </LabelsProvider>,
+  )
+} else {
+  document.body.textContent = 'Local development review only.'
+}
