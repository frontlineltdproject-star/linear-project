+export const shipmentDetailsText = { en, el }
+
+export function useShipmentDetailsLabels() {
+  const { locale } = useLocale()
+  const text = shipmentDetailsText[locale]
+  const format = (value: string, parameters: Record<string, string | number>) =>
+    Object.entries(parameters).reduce(
+      (result, [key, parameter]) =>
+        result.replaceAll(`{${key}}`, String(parameter)),
+      value,
+    )
+  return { text, locale, format }
+}
