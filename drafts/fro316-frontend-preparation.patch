+import { useState } from 'react'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import {
+  ReadyWarningDialog,
+  ReconciliationDialog,
+} from './shipment-change-dialogs'
+import {
+  purposeDraftFromView,
+  routeDraftFromView,
+  type ShipmentDetailsDrafts,
+} from './shipment-details-drafts'
+import type {
+  DeliveryNoteReconciliationItem,
+  OperationResult,
+  PurposeDraft,
+  ReconciliationChoice,
+  RouteOptions,
+  RouteSubmission,
+  ShipmentDetailsCapabilities,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+import { isMaterialRouteChange } from './shipment-details-values'
+import { ShipmentNotesCard } from './shipment-notes-card'
+import {
+  ShipmentDetailsCard,
+  ShipmentHandoverCard,
+  ShipmentPurposeCard,
+  validateRouteDraft,
+  type RouteDraftErrors,
+} from './shipment-route-cards'
+import { ShipmentStatusCard } from './shipment-status-card'
+
+type PendingSave =
+  | { kind: 'route'; submission: RouteSubmission }
+  | { kind: 'purpose'; draft: PurposeDraft }
+
+export interface ShipmentOverviewTabProps {
+  view: ShipmentDetailsView
+  capabilities: ShipmentDetailsCapabilities
+  options: RouteOptions
+  drafts: ShipmentDetailsDrafts
+  onDraftsChange: (drafts: ShipmentDetailsDrafts) => void
+  onSaveRoute: (submission: RouteSubmission) => Promise<OperationResult>
+  onSavePurpose: (draft: PurposeDraft) => Promise<OperationResult>
+  onSaveNote: (
+    field: 'internal' | 'external',
+    value: string,
+  ) => Promise<OperationResult>
+  onDispatch: () => Promise<OperationResult>
+  onOpenOrders: () => void
+  onViewHistory: (eventId: string | null) => void
+}
+
+export function ShipmentOverviewTab({
+  view,
+  capabilities,
+  options,
+  drafts,
+  onDraftsChange,
+  onSaveRoute,
+  onSavePurpose,
+  onSaveNote,
+  onDispatch,
+  onOpenOrders,
+  onViewHistory,
+}: ShipmentOverviewTabProps) {
+  const { text } = useShipmentDetailsLabels()
+  const savedRoute = routeDraftFromView(view)
+  const [routeErrors, setRouteErrors] = useState<RouteDraftErrors>({})
+  const [routeError, setRouteError] = useState<string | null>(null)
+  const [purposeError, setPurposeError] = useState<string | null>(null)
+  const [saving, setSaving] = useState<'route' | 'purpose' | null>(null)
+  const [warning, setWarning] = useState<PendingSave | null>(null)
+  const [reconciliation, setReconciliation] = useState<{
+    submission: RouteSubmission
+    items: DeliveryNoteReconciliationItem[]
+  } | null>(null)
+  const [choices, setChoices] = useState<Record<string, ReconciliationChoice>>(
+    {},
+  )
+  const ready = view.status === 'READY_FOR_DISPATCH'
+
+  const update = (patch: Partial<ShipmentDetailsDrafts>) =>
+    onDraftsChange({ ...drafts, ...patch })
+
+  async function submitRoute(submission: RouteSubmission) {
+    setSaving('route')
+    setRouteError(null)
+    const result = await onSaveRoute(submission)
+    setSaving(null)
+    setWarning(null)
+    if (result.ok) {
+      setReconciliation(null)
+      setChoices({})
+      update({ route: null })
+    } else if ('reconciliation' in result) {
+      setReconciliation({ submission, items: result.reconciliation })
+    } else {
+      setReconciliation(null)
+      setRouteError(result.message)
+    }
+  }
+
+  async function submitPurpose(draft: PurposeDraft) {
+    setSaving('purpose')
+    setPurposeError(null)
+    const result = await onSavePurpose(draft)
+    setSaving(null)
+    setWarning(null)
+    if (result.ok) update({ purpose: null })
+    else
+      setPurposeError(
+        'message' in result ? result.message : text.operationFailed,
+      )
+  }
+
+  function saveRoute() {
+    const draft = drafts.route
+    if (!draft) return
+    const errors = validateRouteDraft(savedRoute, draft, view.purpose, options)
+    setRouteErrors(errors)
+    if (Object.keys(errors).length) return
+    const submission: RouteSubmission = { ...draft }
+    if (ready && isMaterialRouteChange(savedRoute, draft))
+      setWarning({ kind: 'route', submission })
+    else void submitRoute(submission)
+  }
+
+  function savePurpose() {
+    const draft = drafts.purpose
+    if (!draft) return
+    const saved = purposeDraftFromView(view)
+    const changed =
+      draft.purpose !== saved.purpose ||
+      draft.destinationId !== saved.destinationId
+    if (ready && changed) setWarning({ kind: 'purpose', draft })
+    else void submitPurpose(draft)
+  }
+
+  return (
+    <div className="flex flex-col gap-[var(--section-gap)]">
+      <ShipmentDetailsCard
+        view={view}
+        statusCard={
+          <ShipmentStatusCard
+            view={view}
+            canDispatch={capabilities.dispatch}
+            canPrepare={capabilities.editPacking}
+            onOpenOrders={onOpenOrders}
+            onViewHistory={onViewHistory}
+            onDispatch={onDispatch}
+          />
+        }
+        canEdit={capabilities.editRoute}
+        draft={drafts.route}
+        saved={savedRoute}
+        errors={routeErrors}
+        saving={saving === 'route'}
+        saveError={routeError}
+        options={options}
+        onBeginEdit={() => {
+          setRouteErrors({})
+          setRouteError(null)
+          update({ route: savedRoute })
+        }}
+        onDraftChange={(route) => update({ route })}
+        onCancel={() => update({ route: null })}
+        onSave={saveRoute}
+      />
+      <ShipmentPurposeCard
+        view={view}
+        canEdit={capabilities.editPurpose}
+        draft={drafts.purpose}
+        saving={saving === 'purpose'}
+        saveError={purposeError}
+        options={options}
+        onBeginEdit={() => {
+          setPurposeError(null)
+          update({ purpose: purposeDraftFromView(view) })
+        }}
+        onDraftChange={(purpose) => update({ purpose })}
+        onCancel={() => update({ purpose: null })}
+        onSave={savePurpose}
+      />
+      <ShipmentHandoverCard view={view} />
+      <ShipmentNotesCard
+        internalNotes={view.internalNotes}
+        externalNotes={view.externalNotes}
+        internalDraft={drafts.internalNotes}
+        externalDraft={drafts.externalNotes}
+        canEdit={capabilities.editNotes}
+        onDraftChange={(field, draft) =>
+          update(
+            field === 'internal'
+              ? { internalNotes: draft }
+              : { externalNotes: draft },
+          )
+        }
+        onSave={onSaveNote}
+      />
+      <ReadyWarningDialog
+        open={!!warning}
+        saving={saving !== null}
+        onBack={() => setWarning(null)}
+        onConfirm={() => {
+          if (warning?.kind === 'route') void submitRoute(warning.submission)
+          else if (warning?.kind === 'purpose')
+            void submitPurpose(warning.draft)
+        }}
+      />
+      <ReconciliationDialog
+        items={reconciliation?.items ?? null}
+        choices={choices}
+        saving={saving === 'route'}
+        onChoose={(id, choice) => setChoices({ ...choices, [id]: choice })}
+        onBack={() => {
+          setReconciliation(null)
+          setChoices({})
+        }}
+        onConfirm={() => {
+          if (reconciliation)
+            void submitRoute({
+              ...reconciliation.submission,
+              reconciliation: choices,
+            })
+        }}
+      />
+    </div>
+  )
+}
