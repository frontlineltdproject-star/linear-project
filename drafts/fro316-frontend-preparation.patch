+import { useRef, useState, type KeyboardEvent, type ReactNode } from 'react'
+import { TopBar } from '#/components/layout/top-bar'
+import { Card } from '#/components/ui/card'
+import { Tab, TabList, TabPanel, Tabs } from '#/components/ui/tabs'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import { ShipmentActionsTab } from './shipment-actions-tab'
+import {
+  emptyDrafts,
+  type ShipmentDetailsDrafts,
+} from './shipment-details-drafts'
+import type {
+  LoadState,
+  OperationResult,
+  PackingPlanSubmission,
+  ParticipationCandidateOrder,
+  ParticipationSubmission,
+  PurposeDraft,
+  RouteOptions,
+  RouteSubmission,
+  ShipmentDetailsCapabilities,
+  ShipmentDetailsTab,
+  ShipmentDetailsView,
+  ShipmentHistoryView,
+} from './shipment-details-types'
+import { ShipmentHistoryTab } from './shipment-history-tab'
+import { ShipmentOrdersTab } from './shipment-orders-tab'
+import { ShipmentOverviewTab } from './shipment-overview-tab'
+import { ShipmentPackingModal } from './shipment-packing-modal'
+
+export const shipmentDetailsTabs: ShipmentDetailsTab[] = [
+  'overview',
+  'orders',
+  'history',
+  'documents',
+  'actions',
+]
+
+export interface ShipmentDetailsCommands {
+  saveRoute: (submission: RouteSubmission) => Promise<OperationResult>
+  savePurpose: (draft: PurposeDraft) => Promise<OperationResult>
+  saveNote: (
+    field: 'internal' | 'external',
+    value: string,
+  ) => Promise<OperationResult>
+  dispatch: () => Promise<OperationResult>
+  saveParticipation: (
+    submission: ParticipationSubmission,
+  ) => Promise<OperationResult>
+  savePacking: (plan: PackingPlanSubmission) => Promise<OperationResult>
+  confirmReadiness: (plan: PackingPlanSubmission) => Promise<OperationResult>
+  addComment: (text: string) => Promise<OperationResult>
+  cancelShipment: (reason: string) => Promise<OperationResult>
+  markLocationUnknown: (reason: string) => Promise<OperationResult>
+  searchCandidates: (query: string) => void
+  retryHistory: () => void
+}
+
+export interface ShipmentDetailsPreparedPageProps {
+  view: ShipmentDetailsView
+  capabilities: ShipmentDetailsCapabilities
+  options: RouteOptions
+  history: ShipmentHistoryView
+  candidates: ParticipationCandidateOrder[]
+  candidatesState: LoadState
+  /** Route-owned query state (`?tab=`). */
+  tab: ShipmentDetailsTab
+  onTabChange: (tab: ShipmentDetailsTab) => void
+  commands: ShipmentDetailsCommands
+  /** Existing production components, passed through unchanged. */
+  slots: {
+    documents: ReactNode
+    deliveryNotes: ReactNode
+    arrivalForm: ReactNode
+  }
+  orderHref: (id: string) => string
+  colliHref: (id: string) => string
+}
+
+/**
+ * Prepared FRO-316 Shipment Details composition. Controlled and unconnected:
+ * the future controller supplies the view, capabilities and commands. Drafts
+ * live here, above the tab panels, because inactive panels unmount.
+ */
+export function ShipmentDetailsPreparedPage({
+  view,
+  capabilities,
+  options,
+  history,
+  candidates,
+  candidatesState,
+  tab,
+  onTabChange,
+  commands,
+  slots,
+  orderHref,
+  colliHref,
+}: ShipmentDetailsPreparedPageProps) {
+  const { text } = useShipmentDetailsLabels()
+  const [draftState, setDraftState] = useState<{
+    shipment: string
+    drafts: ShipmentDetailsDrafts
+  }>({ shipment: view.shipmentNumber, drafts: emptyDrafts })
+  const drafts =
+    draftState.shipment === view.shipmentNumber
+      ? draftState.drafts
+      : emptyDrafts
+  const setDrafts = (next: ShipmentDetailsDrafts) =>
+    setDraftState({ shipment: view.shipmentNumber, drafts: next })
+  const [highlightedEventId, setHighlightedEventId] = useState<string | null>(
+    null,
+  )
+  const [packingOpen, setPackingOpen] = useState(false)
+  const tabListRef = useRef<HTMLDivElement>(null)
+
+  const labels: Record<ShipmentDetailsTab, string> = {
+    overview: text.overview,
+    orders: text.ordersTab,
+    history: text.historyTab,
+    documents: text.documentsTab,
+    actions: text.actionsTab,
+  }
+
+  // Local keyboard support (Arrow/Home/End); the shared Tabs stay unchanged.
+  function onTabKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End']
+    if (!keys.includes(event.key)) return
+    const buttons = Array.from(
+      tabListRef.current?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ??
+        [],
+    )
+    const current = buttons.indexOf(event.target as HTMLButtonElement)
+    if (current < 0) return
+    event.preventDefault()
+    const last = buttons.length - 1
+    const next =
+      event.key === 'Home'
+        ? 0
+        : event.key === 'End'
+          ? last
+          : event.key === 'ArrowRight'
+            ? (current + 1) % buttons.length
+            : (current - 1 + buttons.length) % buttons.length
+    onTabChange(shipmentDetailsTabs[next])
+    buttons[next]?.focus()
+  }
+
+  return (
+    <>
+      <TopBar title={`${text.shipment} · ${view.shipmentNumber}`} />
+      <Card>
+        <Tabs
+          value={tab}
+          defaultValue="overview"
+          onValueChange={(value) => onTabChange(value as ShipmentDetailsTab)}
+        >
+          <div
+            ref={tabListRef}
+            className="overflow-x-auto"
+            onKeyDown={onTabKeyDown}
+          >
+            <TabList className="min-w-max">
+              {shipmentDetailsTabs.map((value) => (
+                <Tab key={value} value={value}>
+                  {labels[value]}
+                </Tab>
+              ))}
+            </TabList>
+          </div>
+          <TabPanel value="overview">
+            <ShipmentOverviewTab
+              view={view}
+              capabilities={capabilities}
+              options={options}
+              drafts={drafts}
+              onDraftsChange={setDrafts}
+              onSaveRoute={commands.saveRoute}
+              onSavePurpose={commands.savePurpose}
+              onSaveNote={commands.saveNote}
+              onDispatch={commands.dispatch}
+              onOpenOrders={() => onTabChange('orders')}
+              onViewHistory={(eventId) => {
+                setHighlightedEventId(eventId)
+                onTabChange('history')
+              }}
+            />
+          </TabPanel>
+          <TabPanel value="orders">
+            <ShipmentOrdersTab
+              view={view}
+              capabilities={capabilities}
+              candidates={candidates}
+              candidatesState={candidatesState}
+              onSearchCandidates={commands.searchCandidates}
+              onSaveParticipation={commands.saveParticipation}
+              onOpenPacking={() => setPackingOpen(true)}
+              packingOpen={packingOpen}
+              orderHref={orderHref}
+              colliHref={colliHref}
+            />
+          </TabPanel>
+          <TabPanel value="history">
+            <ShipmentHistoryTab
+              history={history}
+              canComment={capabilities.comment}
+              commentDraft={drafts.comment}
+              onCommentDraftChange={(comment) =>
+                setDrafts({ ...drafts, comment })
+              }
+              highlightedEventId={highlightedEventId}
+              onAddComment={commands.addComment}
+              onRetry={commands.retryHistory}
+            />
+          </TabPanel>
+          <TabPanel value="documents">{slots.documents}</TabPanel>
+          <TabPanel value="actions">
+            <ShipmentActionsTab
+              view={view}
+              capabilities={capabilities}
+              drafts={drafts}
+              onDraftsChange={setDrafts}
+              onCancelShipment={commands.cancelShipment}
+              onMarkLocationUnknown={commands.markLocationUnknown}
+              arrivalForm={slots.arrivalForm}
+              deliveryNotes={slots.deliveryNotes}
+            />
+          </TabPanel>
+        </Tabs>
+      </Card>
+      {packingOpen ? (
+        <ShipmentPackingModal
+          view={view}
+          onSavePacking={commands.savePacking}
+          onConfirmReadiness={commands.confirmReadiness}
+          onClose={() => setPackingOpen(false)}
+        />
+      ) : null}
+    </>
+  )
+}
