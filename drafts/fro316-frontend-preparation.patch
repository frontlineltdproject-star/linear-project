+function capabilitiesFor(
+  view: ShipmentDetailsView,
+  viewOnly: boolean,
+): ShipmentDetailsCapabilities {
+  if (viewOnly)
+    return Object.fromEntries(
+      Object.keys(allowed).map((key) => [key, false]),
+    ) as unknown as ShipmentDetailsCapabilities
+  const pre = isPreDispatch(view.status)
+  return {
+    ...allowed,
+    editRoute: pre,
+    editPurpose: pre,
+    editParticipation: pre,
+    editPacking: pre,
+    dispatch: view.status === 'READY_FOR_DISPATCH',
+    cancel: pre,
+    recordArrival: view.status === 'DISPATCHED',
+    markLocationUnknown: view.status === 'DISPATCHED',
+  }
