+import { useId } from 'react'
+import { Button } from '#/components/ui/button'
+import { Radio } from '#/components/ui/choice'
+import { Modal } from '#/components/ui/modal'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type {
+  DeliveryNoteReconciliationItem,
+  ReconciliationChoice,
+} from './shipment-details-types'
+import { ModalActions } from './modal-actions'
+
+/** Shown before a material change that would clear readiness. */
+export function ReadyWarningDialog({
+  open,
+  packing = false,
+  saving,
+  onBack,
+  onConfirm,
+}: {
+  open: boolean
+  packing?: boolean
+  saving: boolean
+  onBack: () => void
+  onConfirm: () => void
+}) {
+  const { text } = useShipmentDetailsLabels()
+  return (
+    <Modal
+      open={open}
+      onClose={() => !saving && onBack()}
+      title={text.readyWarningTitle}
+      footer={
+        <ModalActions>
+          <Button variant="secondary" onClick={onBack} disabled={saving}>
+            {text.back}
+          </Button>
+          <Button onClick={onConfirm} loading={saving}>
+            {text.saveAndReturn}
+          </Button>
+        </ModalActions>
+      }
+    >
+      <p>{packing ? text.readyWarningPacking : text.readyWarning}</p>
+    </Modal>
+  )
+}
+
+function ReconciliationRow({
+  item,
+  choice,
+  onChoose,
+}: {
+  item: DeliveryNoteReconciliationItem
+  choice: ReconciliationChoice | undefined
+  onChoose: (choice: ReconciliationChoice) => void
+}) {
+  const { text, format } = useShipmentDetailsLabels()
+  const name = useId()
+  const options: [ReconciliationChoice, string][] = item.removal
+    ? [
+        ['KEEP', text.keepEntered],
+        ['REMOVE', text.removeDraft],
+      ]
+    : [
+        ['KEEP', text.keepEntered],
+        ['UPDATE', text.updateFromRoute],
+      ]
+  return (
+    <li className="rounded-md border border-border p-3">
+      <p className="text-sm font-semibold text-fg">
+        <span className="font-mono">{item.draftNumber}</span> · {item.field}
+      </p>
+      <p className="mt-1 text-xs text-fg-muted">
+        {format(text.enteredValue, { value: item.enteredValue || '—' })}
+        {item.routeValue != null
+          ? ` · ${format(text.routeValue, { value: item.routeValue })}`
+          : null}
+      </p>
+      <div className="mt-2 flex flex-wrap gap-4">
+        {options.map(([value, label]) => (
+          <Radio
+            key={value}
+            id={`${name}-${value}`}
+            name={name}
+            checked={choice === value}
+            onChange={() => onChoose(value)}
+            label={label}
+          />
+        ))}
+      </div>
+    </li>
+  )
+}
+
+/**
+ * FRO-344 delivery-note draft reconciliation: every affected value needs an
+ * explicit choice before the route change is saved. Rules stay server-side.
+ */
+export function ReconciliationDialog({
+  items,
+  choices,
+  saving,
+  onChoose,
+  onBack,
+  onConfirm,
+}: {
+  items: DeliveryNoteReconciliationItem[] | null
+  choices: Record<string, ReconciliationChoice>
+  saving: boolean
+  onChoose: (id: string, choice: ReconciliationChoice) => void
+  onBack: () => void
+  onConfirm: () => void
+}) {
+  const { text } = useShipmentDetailsLabels()
+  const complete = !!items && items.every((item) => choices[item.id])
+  return (
+    <Modal
+      open={!!items}
+      onClose={() => !saving && onBack()}
+      title={text.reconciliationTitle}
+      size="lg"
+      footer={
+        <ModalActions>
+          <Button variant="secondary" onClick={onBack} disabled={saving}>
+            {text.back}
+          </Button>
+          <Button onClick={onConfirm} loading={saving} disabled={!complete}>
+            {text.confirmAndSave}
+          </Button>
+        </ModalActions>
+      }
+    >
+      <p>{text.reconciliationBody}</p>
+      <ul className="mt-3 flex max-h-[50vh] flex-col gap-2 overflow-y-auto">
+        {items?.map((item) => (
+          <ReconciliationRow
+            key={item.id}
+            item={item}
+            choice={choices[item.id]}
+            onChoose={(choice) => onChoose(item.id, choice)}
+          />
+        ))}
+      </ul>
+    </Modal>
+  )
+}
