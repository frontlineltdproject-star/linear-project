+    fireEvent.change(within(dialog).getByLabelText(/HU-TEST-1/), {
+      target: {
+        value: within(dialog)
+          .getByLabelText(/HU-TEST-1/)
+          .querySelectorAll('option')[1]
+          .getAttribute('value'),
+      },
+    })
+    fireEvent.click(
+      within(dialog).getByRole('button', { name: 'Confirm packing' }),
+    )
+    const metrics = within(dialog).getByRole('list', {
+      name: 'Review repacking',
+    })
+    expect(
+      within(metrics)
+        .getAllByRole('listitem')
+        .map((item) => item.textContent),
+    ).toEqual([
+      'Optional load units1',
+      'Individual collis1',
+      'Transport pieces2',
+    ])
+    const block = within(dialog).getByRole('region', {
+      name: 'Individual collis',
+    })
+    expect(within(block).getByText('HU-TEST-2')).toBeTruthy()
+    expect(within(block).queryByText('HU-TEST-1')).toBeNull()
+    fireEvent.click(
+      within(dialog).getByRole('button', {
+        name: 'Confirm ready for dispatch',
+      }),
+    )
+    await waitFor(() => expect(onConfirmReadiness).toHaveBeenCalledTimes(1))
+    expect(onConfirmReadiness.mock.calls[0][0].units[0]).toMatchObject({
+      id: null,
+      lengthCm: 120,
+      grossWeightKg: 40,
+      colliIds: ['c1'],
+    })
+    expect(onClose).toHaveBeenCalled()
