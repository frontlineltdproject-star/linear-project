+    ).toBeTruthy()
+    const block = within(dialog).getByRole('region', {
+      name: 'Individual collis',
+    })
+    expect(within(block).getByText('HU-TEST-1')).toBeTruthy()
+    expect(within(block).getByText('HU-TEST-2')).toBeTruthy()
+    expect(
+      within(dialog).getByText('PO-TEST-1 is not stock-confirmed.'),
+    ).toBeTruthy()
+    const confirm = within(dialog).getByRole('button', {
+      name: 'Confirm ready for dispatch',
+    }) as HTMLButtonElement
+    expect(confirm.disabled).toBe(true)
+    fireEvent.click(
+      within(dialog).getByRole('button', { name: 'Back to repacking' }),
+    )
+    expect(
+      within(dialog).getByRole('button', { name: 'Add load unit' }),
+    ).toBeTruthy()
+    expect(onConfirmReadiness).not.toHaveBeenCalled()
+  })
+
+  it('warns before saving changed packing from Ready, not for an unchanged save', async () => {
+    const view = buildView({
+      status: 'READY_FOR_DISPATCH',
+      loadUnits: [pallet],
+      packingState: 'CONFIRMED',
+    })
+    const { dialog, onSavePacking } = renderPacking({ view })
+    fireEvent.click(
+      within(dialog).getByRole('button', { name: 'Save packing' }),
+    )
+    await waitFor(() => expect(onSavePacking).toHaveBeenCalledTimes(1))
+    cleanup()
+
+    const second = renderPacking({ view })
+    fireEvent.click(
+      within(second.dialog).getByRole('button', { name: 'Remove' }),
+    )
+    fireEvent.click(
+      within(second.dialog).getByRole('button', { name: 'Save packing' }),
+    )
+    expect(
+      within(second.dialog).getByText(
+        /Saving changed packing returns this Shipment/,
+      ),
+    ).toBeTruthy()
+    expect(second.onSavePacking).not.toHaveBeenCalled()
+    fireEvent.click(
+      within(second.dialog).getByRole('button', {
+        name: 'Save and return to Preparing',
+      }),
+    )
+    await waitFor(() =>
+      expect(second.onSavePacking).toHaveBeenCalledWith({ units: [] }),
+    )
+  })
+
+  it('keeps the draft and the review when confirmation fails', async () => {
+    const { dialog, onClose } = renderPacking({
+      onConfirmReadiness: vi.fn<PlanCommand>(async () => ({
+        ok: false,
+        message: 'Stale arrangement.',
+      })),
+    })
+    fireEvent.click(
+      within(dialog).getByRole('button', { name: 'Confirm packing' }),
+    )
+    fireEvent.click(
+      within(dialog).getByRole('button', {
+        name: 'Confirm ready for dispatch',
+      }),
