+import { useId, useState } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Textarea } from '#/components/ui/input'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type { OperationResult } from './shipment-details-types'
+import { SectionCard } from './shipment-route-cards'
+import { useEditFocus } from './use-edit-focus'
+
+export const notesMaxLength = 2000
+
+type NoteField = 'internal' | 'external'
+
+function NoteSection({
+  field,
+  title,
+  value,
+  draft,
+  canEdit,
+  onDraftChange,
+  onSave,
+}: {
+  field: NoteField
+  title: string
+  value: string | null
+  draft: string | null
+  canEdit: boolean
+  onDraftChange: (draft: string | null) => void
+  onSave: (field: NoteField, value: string) => Promise<OperationResult>
+}) {
+  const { text, format } = useShipmentDetailsLabels()
+  const id = useId()
+  const editRef = useEditFocus(draft != null)
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  async function save() {
+    if (draft == null || saving) return
+    setSaving(true)
+    setError(null)
+    const result = await onSave(field, draft)
+    setSaving(false)
+    if (result.ok) onDraftChange(null)
+    else setError('message' in result ? result.message : text.operationFailed)
+  }
+
+  return (
+    <div className="rounded-md border border-border p-3.5">
+      <div className="mb-2 flex items-center justify-between gap-2">
+        <h4 className="text-sm font-semibold text-fg">{title}</h4>
+        {canEdit && draft == null ? (
+          <Button
+            ref={editRef}
+            variant="secondary"
+            size="sm"
+            onClick={() => {
+              setError(null)
+              onDraftChange(value ?? '')
+            }}
+          >
+            {text.edit}
+          </Button>
+        ) : null}
+      </div>
+      {draft != null ? (
+        <div
+          onKeyDown={(event) => {
+            if (event.key === 'Escape') {
+              event.stopPropagation()
+              onDraftChange(null)
+            }
+          }}
+        >
+          <label htmlFor={id} className="sr-only">
+            {title}
+          </label>
+          <Textarea
+            id={id}
+            rows={4}
+            maxLength={notesMaxLength}
+            value={draft}
+            onChange={(event) => onDraftChange(event.target.value)}
+          />
+          <p className="mt-1 text-right text-xs text-fg-subtle">
+            {format(text.characters, {
+              count: draft.length,
+              max: notesMaxLength,
+            })}
+          </p>
+          {error ? (
+            <Alert tone="danger" className="mt-2">
+              {error}
+            </Alert>
+          ) : null}
+          <div className="mt-2 flex justify-end gap-2">
+            <Button
+              variant="secondary"
+              size="sm"
+              onClick={() => onDraftChange(null)}
+              disabled={saving}
+            >
+              {text.cancel}
+            </Button>
+            <Button size="sm" onClick={save} loading={saving}>
+              {text.save}
+            </Button>
+          </div>
+        </div>
+      ) : (
+        <p className="whitespace-pre-wrap text-sm text-fg">{value || '—'}</p>
+      )}
+    </div>
+  )
+}
+
+/** Internal and External Notes (FRO-292): independent drafts and saves. */
+export function ShipmentNotesCard({
+  internalNotes,
+  externalNotes,
+  internalDraft,
+  externalDraft,
+  canEdit,
+  onDraftChange,
+  onSave,
+}: {
+  internalNotes: string | null
+  externalNotes: string | null
+  internalDraft: string | null
+  externalDraft: string | null
+  canEdit: boolean
+  onDraftChange: (field: NoteField, draft: string | null) => void
+  onSave: (field: NoteField, value: string) => Promise<OperationResult>
+}) {
+  const { text } = useShipmentDetailsLabels()
+  return (
+    <SectionCard title={text.notes}>
+      <NoteSection
+        field="internal"
+        title={text.internalNotes}
+        value={internalNotes}
+        draft={internalDraft}
+        canEdit={canEdit}
+        onDraftChange={(draft) => onDraftChange('internal', draft)}
+        onSave={onSave}
+      />
+      <NoteSection
+        field="external"
+        title={text.externalNotes}
+        value={externalNotes}
+        draft={externalDraft}
+        canEdit={canEdit}
+        onDraftChange={(draft) => onDraftChange('external', draft)}
+        onSave={onSave}
+      />
+    </SectionCard>
+  )
+}
