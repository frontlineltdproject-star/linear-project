+import { useId, useState } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { FormField, Textarea } from '#/components/ui/input'
+import { Spinner } from '#/components/ui/feedback'
+import { cn } from '#/lib/utils'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type {
+  OperationResult,
+  ShipmentActivityEntry,
+  ShipmentHistoryView,
+  ShipmentStatusEvent,
+} from './shipment-details-types'
+import { formatMoment } from './shipment-details-values'
+import { SectionCard } from './shipment-route-cards'
+
+export const commentMaxLength = 2000
+
+function EntryRow({
+  time,
+  title,
+  actor,
+  detail,
+  current = false,
+}: {
+  time: string
+  title: string
+  actor: string | null
+  detail?: string | null
+  current?: boolean
+}) {
+  return (
+    <li
+      aria-current={current ? 'true' : undefined}
+      className={cn(
+        'grid grid-cols-1 gap-x-4 gap-y-0.5 border-b border-border py-2.5 text-body-sm last:border-0 sm:grid-cols-[minmax(9rem,auto)_minmax(0,1fr)]',
+        current && 'rounded-md bg-accent-subtle px-2',
+      )}
+    >
+      <span className="font-mono text-fg-muted">{time}</span>
+      <div className="min-w-0">
+        <span className="font-semibold text-fg">{title}</span>
+        {actor ? <span className="text-fg-muted"> · {actor}</span> : null}
+        {detail ? (
+          <p className="mt-0.5 whitespace-pre-wrap break-words text-fg">
+            {detail}
+          </p>
+        ) : null}
+      </div>
+    </li>
+  )
+}
+
+function EmptyLine({ children }: { children: string }) {
+  return (
+    <p className="rounded-md border border-dashed border-border p-3 text-body-sm text-fg-muted">
+      {children}
+    </p>
+  )
+}
+
+/** FRO-345 history presentation: status events, operations and comments. */
+export function ShipmentHistoryTab({
+  history,
+  canComment,
+  commentDraft,
+  onCommentDraftChange,
+  highlightedEventId,
+  onAddComment,
+  onRetry,
+}: {
+  history: ShipmentHistoryView
+  canComment: boolean
+  commentDraft: string
+  onCommentDraftChange: (draft: string) => void
+  highlightedEventId: string | null
+  onAddComment: (text: string) => Promise<OperationResult>
+  onRetry: () => void
+}) {
+  const { text, locale, format } = useShipmentDetailsLabels()
+  const commentId = useId()
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  const statusTitle = (event: ShipmentStatusEvent) =>
+    event.from
+      ? `${text[event.from]} → ${text[event.to]}`
+      : `${text.created} — ${text[event.to]}`
+  const statusDetail = (event: ShipmentStatusEvent) =>
+    [
+      event.reason,
+      event.occurredAt
+        ? format(text.occurred, {
+            value: formatMoment(locale, event.occurredAt),
+          })
+        : null,
+    ]
+      .filter(Boolean)
+      .join('\n') || null
+
+  async function addComment() {
+    const value = commentDraft.trim()
+    if (!value || saving) return
+    setSaving(true)
+    setError(null)
+    const result = await onAddComment(value)
+    setSaving(false)
+    if (result.ok) onCommentDraftChange('')
+    else setError('message' in result ? result.message : text.operationFailed)
+  }
+
+  if (history.state === 'loading')
+    return (
+      <div
+        className="flex items-center gap-2 p-4 text-body-sm text-fg-muted"
+        aria-busy="true"
+      >
+        <Spinner /> {text.loading}
+      </div>
+    )
+
+  if (history.state === 'error')
+    return (
+      <Alert tone="danger">
+        {text.historyError}{' '}
+        <Button
+          variant="secondary"
+          size="sm"
+          className="ml-2"
+          onClick={onRetry}
+        >
+          {text.retry}
+        </Button>
+      </Alert>
+    )
+
+  const entries = (list: ShipmentActivityEntry[]) =>
+    list.map((entry) => (
+      <EntryRow
+        key={entry.id}
+        time={formatMoment(locale, entry.recordedAt)}
+        title={entry.summary}
+        actor={entry.actor}
+      />
+    ))
+
+  return (
+    <div className="flex flex-col gap-[var(--section-gap)]">
+      <SectionCard title={text.shipmentActivity}>
+        <h4 className="text-sm font-semibold text-fg">{text.statusHistory}</h4>
+        {history.statusEvents.length ? (
+          <ol>
+            {history.statusEvents.map((event) => (
+              <EntryRow
+                key={event.id}
+                time={formatMoment(locale, event.recordedAt)}
+                title={statusTitle(event)}
+                actor={event.actor}
+                detail={statusDetail(event)}
+                current={event.id === highlightedEventId}
+              />
+            ))}
+          </ol>
+        ) : (
+          <EmptyLine>{text.noActivity}</EmptyLine>
+        )}
+        <h4 className="text-sm font-semibold text-fg">
+          {text.recordedOperations}
+        </h4>
+        {history.operations.length ? (
+          <ol>{entries(history.operations)}</ol>
+        ) : (
+          <EmptyLine>{text.noActivity}</EmptyLine>
+        )}
+      </SectionCard>
+      <SectionCard title={text.comments}>
+        {history.comments.length ? (
+          <ol>{entries(history.comments)}</ol>
+        ) : (
+          <EmptyLine>{text.noComments}</EmptyLine>
+        )}
+        {canComment ? (
+          <div>
+            <FormField label={text.addComment} htmlFor={commentId}>
+              <Textarea
+                id={commentId}
+                rows={3}
+                maxLength={commentMaxLength}
+                value={commentDraft}
+                onChange={(event) => onCommentDraftChange(event.target.value)}
+              />
+            </FormField>
+            <p className="mt-1 text-right text-xs text-fg-subtle">
+              {format(text.characters, {
+                count: commentDraft.length,
+                max: commentMaxLength,
+              })}
+            </p>
+            {error ? (
+              <Alert tone="danger" className="mt-2">
+                {error}
+              </Alert>
+            ) : null}
+            <div className="mt-2 flex justify-end">
+              <Button
+                variant="secondary"
+                onClick={addComment}
+                loading={saving}
+                disabled={!commentDraft.trim()}
+              >
+                {text.addComment}
+              </Button>
+            </div>
+          </div>
+        ) : null}
+      </SectionCard>
+    </div>
+  )
+}
