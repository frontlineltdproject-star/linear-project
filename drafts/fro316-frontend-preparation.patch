+  noCapabilities,
+} from './shipment-details-fixtures.test-utils'
+import type {
+  OperationResult,
+  ParticipationCandidateOrder,
+  ParticipationSubmission,
+  ShipmentDetailsCapabilities,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+
+afterEach(() => {
+  cleanup()
+  localStorage.clear()
+})
+
+type SaveParticipation = (
+  submission: ParticipationSubmission,
+) => Promise<OperationResult>
+
+const candidates: ParticipationCandidateOrder[] = [
+  {
+    id: 'o1',
+    number: 'PO-TEST-1',
+    rootNumber: 'PO-TEST-0',
+    client: 'Demo Client Company',
+    vessel: 'MV Demo',
+    inStock: true,
+    inShipment: true,
+    collis: [
+      {
+        id: 'c1',
+        code: 'HU-TEST-1',
+        description: 'Spare parts',
+        available: true,
+      },
+      { id: 'c2', code: 'HU-TEST-2', description: null, available: true },
+    ],
+  },
+]
+
+function renderOrders({
+  view = buildView(),
+  capabilities = allCapabilities,
+  onSaveParticipation = vi.fn<SaveParticipation>(async () => ({ ok: true })),
+  onOpenPacking = vi.fn<() => void>(),
+}: {
+  view?: ShipmentDetailsView
+  capabilities?: ShipmentDetailsCapabilities
+  onSaveParticipation?: Mock<SaveParticipation>
+  onOpenPacking?: Mock<() => void>
+} = {}) {
+  render(
+    <LabelsProvider>
+      <ShipmentOrdersTab
+        view={view}
