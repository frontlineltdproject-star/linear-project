+import { useId, useState, type ReactNode } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { FormField, Textarea } from '#/components/ui/input'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type { ShipmentDetailsDrafts } from './shipment-details-drafts'
+import type {
+  OperationResult,
+  ShipmentDetailsCapabilities,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+import { isPreDispatch } from './shipment-details-values'
+import { SectionCard } from './shipment-route-cards'
+
+function ReasonAction({
+  title,
+  label,
+  action,
+  value,
+  onChange,
+  onSubmit,
+}: {
+  title: string
+  label: string
+  action: string
+  value: string
+  onChange: (value: string) => void
+  onSubmit: (reason: string) => Promise<OperationResult>
+}) {
+  const { text } = useShipmentDetailsLabels()
+  const id = useId()
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  async function submit() {
+    const reason = value.trim()
+    if (!reason || saving) return
+    setSaving(true)
+    setError(null)
+    const result = await onSubmit(reason)
+    setSaving(false)
+    if (result.ok) onChange('')
+    else setError('message' in result ? result.message : text.operationFailed)
+  }
+
+  return (
+    <div className="rounded-md border border-border p-4">
+      <h4 className="mb-2 text-subheading text-fg">{title}</h4>
+      <FormField label={label} htmlFor={id} required>
+        <Textarea
+          id={id}
+          rows={3}
+          maxLength={2000}
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+        />
+      </FormField>
+      {error ? (
+        <Alert tone="danger" className="mt-2">
+          {error}
+        </Alert>
+      ) : null}
+      <div className="mt-3 flex justify-end">
+        <Button
+          variant="danger"
+          onClick={submit}
+          loading={saving}
+          disabled={!value.trim()}
+        >
+          {action}
+        </Button>
+      </div>
+    </div>
+  )
+}
+
+/**
+ * Lifecycle actions allowed for the current status, then the existing
+ * delivery-note workflow. Slots keep the existing production forms intact.
+ */
+export function ShipmentActionsTab({
+  view,
+  capabilities,
+  drafts,
+  onDraftsChange,
+  onCancelShipment,
+  onMarkLocationUnknown,
+  arrivalForm,
+  deliveryNotes,
+}: {
+  view: ShipmentDetailsView
+  capabilities: ShipmentDetailsCapabilities
+  drafts: ShipmentDetailsDrafts
+  onDraftsChange: (drafts: ShipmentDetailsDrafts) => void
+  onCancelShipment: (reason: string) => Promise<OperationResult>
+  onMarkLocationUnknown: (reason: string) => Promise<OperationResult>
+  /** The existing purpose-specific arrival / final handover form. */
+  arrivalForm: ReactNode
+  /** The existing delivery-note workflow (FRO-307 address choices included). */
+  deliveryNotes: ReactNode
+}) {
+  const { text } = useShipmentDetailsLabels()
+  const cards: ReactNode[] = []
+  if (isPreDispatch(view.status) && capabilities.cancel)
+    cards.push(
+      <ReasonAction
+        key="cancel"
+        title={text.cancelBeforeDispatch}
+        label={text.cancellationReason}
+        action={text.cancelShipment}
+        value={drafts.cancelReason}
+        onChange={(cancelReason) => onDraftsChange({ ...drafts, cancelReason })}
+        onSubmit={onCancelShipment}
+      />,
+    )
+  if (view.status === 'DISPATCHED' && capabilities.recordArrival)
+    cards.push(
+      <div key="arrival" className="rounded-md border border-border p-4">
+        <h4 className="mb-2 text-subheading text-fg">{text.recordArrival}</h4>
+        {arrivalForm}
+      </div>,
+    )
+  if (view.status === 'DISPATCHED' && capabilities.markLocationUnknown)
+    cards.push(
+      <ReasonAction
+        key="unknown"
+        title={text.markLocationUnknown}
+        label={text.locationReason}
+        action={text.markUnknown}
+        value={drafts.locationReason}
+        onChange={(locationReason) =>
+          onDraftsChange({ ...drafts, locationReason })
+        }
+        onSubmit={onMarkLocationUnknown}
+      />,
+    )
+  const lifecycleAllowed =
+    capabilities.cancel ||
+    capabilities.recordArrival ||
+    capabilities.markLocationUnknown
+
+  return (
+    <div className="flex flex-col gap-[var(--section-gap)]">
+      <SectionCard title={text.actionsTab}>
+        {cards.length ? (
+          cards
+        ) : (
+          <p className="rounded-md border border-dashed border-border p-3 text-body-sm text-fg-muted">
+            {lifecycleAllowed ? text.noFurtherActions : text.viewOnly}
+          </p>
+        )}
+      </SectionCard>
+      <SectionCard title={text.issueDeliveryNotes}>
+        {view.historicalArrival ? (
+          <Alert tone="info">{text.historicalNoDeliveryNotes}</Alert>
+        ) : (
+          deliveryNotes
+        )}
+      </SectionCard>
+    </div>
+  )
+}
