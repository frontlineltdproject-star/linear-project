+}
+
+function fillUnit(
+  dialog: HTMLElement,
+  index: number,
+  values: Record<string, string>,
+) {
+  for (const [label, value] of Object.entries(values))
+    fireEvent.change(within(dialog).getAllByLabelText(label)[index], {
+      target: { value },
+    })
+}
+
+describe('Optional repacking editor', () => {
+  it('validates new load units before opening the review', () => {
+    const { dialog } = renderPacking()
+    fireEvent.click(
+      within(dialog).getByRole('button', { name: 'Add load unit' }),
+    )
