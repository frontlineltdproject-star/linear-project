+// UI view models for the prepared Shipment Details presentation (FRO-316).
+// These are presentation interfaces supplied by a future controller, not wire
+// contracts: the owning structural tickets define the real reads and commands.
+
+export type ShipmentDetailsStatus =
+  | 'PREPARING'
+  | 'READY_FOR_DISPATCH'
+  | 'DISPATCHED'
+  | 'ARRIVED'
+  | 'CANCELLED'
+  | 'LOCATION_UNKNOWN'
+
+export type ShipmentDetailsMode = 'ROAD' | 'AIR' | 'SEA'
+
+export type ShipmentDetailsPurpose =
+  | 'NETWORK_TRANSFER'
+  | 'THIRD_PARTY_TRANSFER'
+  | 'DELIVERY_TO_LAUNCH_STATION'
+  | 'DELIVERY_TO_VESSEL'
+
+export type ShipmentDetailsTab =
+  'overview' | 'orders' | 'history' | 'documents' | 'actions'
+
+export interface NamedReference {
+  id: string
+  name: string
+}
+
+/** A recorded moment. Date-only values must stay date-only when displayed. */
+export interface RecordedMoment {
+  iso: string
+  dateOnly: boolean
+}
+
+export type MeasurementSource = 'WAREHOUSE_CONFIRMED' | 'DECLARED' | null
+
+/** A reason the server reports for blocked readiness or dispatch. */
+export interface ShipmentBlocker {
+  code: string
+  /** Localized, actionable message supplied by the controller. */
+  message: string
+  orderNumber?: string | null
+}
+
+export interface ShipmentOrderRow {
+  id: string
+  number: string
+  /** Root Order number for a split child; null otherwise. */
+  rootNumber: string | null
+  ownerReference: string | null
+  client: string | null
+  vessel: string | null
+  supplier: string | null
+}
+
+export interface ShipmentColliRow {
+  id: string
+  code: string
+  /** Loading-time Order attribution. */
+  orderId: string
+  orderNumber: string
+  description: string | null
+  packageType: string | null
+  lengthCm: number | null
+  widthCm: number | null
+  heightCm: number | null
+  dimensionsSource: MeasurementSource
+  grossWeightKg: number | null
+  grossWeightSource: MeasurementSource
+}
+
+export type LoadUnitType = 'PALLET' | 'CARDBOARD_BOX'
+
+export interface ShipmentLoadUnitRow {
+  id: string
+  type: LoadUnitType
+  label: string | null
+  lengthCm: number
+  widthCm: number
+  heightCm: number
+  grossWeightKg: number | null
+  colliIds: string[]
+}
+
+export type PackingState = 'NONE' | 'SAVED' | 'CONFIRMED'
+
+export interface ShipmentHandoverView {
+  recipientKind: string
+  recipient: string | null
+  receivedBy: string | null
+  proof: string | null
+  confirmedAt: RecordedMoment | null
+}
+
+export interface ShipmentDestinationView {
+  kind: 'WAREHOUSE' | 'AGENT' | 'VESSEL'
+  /** Warehouse/agent name, or the derived vessel name(s). */
+  name: string | null
+  warehouseId?: string | null
+  agentId?: string | null
+}
+
+export interface ShipmentDetailsView {
+  shipmentNumber: string
+  status: ShipmentDetailsStatus
+  /** Recorded through the historical already-arrived operation (FRO-324). */
+  historicalArrival: boolean
+  /** Only when recorded history proves the preceding principal state. */
+  lastConfirmedStage: ShipmentDetailsStatus | null
+  /** Status event to open from View history, when known. */
+  exceptionEventId: string | null
+  originCountry: NamedReference | null
+  originCity: NamedReference | null
+  destinationCountry: NamedReference | null
+  destinationCity: NamedReference | null
+  originWarehouse: NamedReference | null
+  mode: ShipmentDetailsMode | null
+  transportDocumentNumber: string | null
+  departure: RecordedMoment | null
+  arrival: RecordedMoment | null
+  dangerousGoodsCount: number | null
+  recordedAt: RecordedMoment | null
+  recordedBy: string | null
+  purpose: ShipmentDetailsPurpose
+  destination: ShipmentDestinationView
+  handover: ShipmentHandoverView | null
+  internalNotes: string | null
+  externalNotes: string | null
+  orders: ShipmentOrderRow[]
+  collis: ShipmentColliRow[]
+  loadUnits: ShipmentLoadUnitRow[]
+  packingState: PackingState
+  readinessBlockers: ShipmentBlocker[]
+  dispatchBlockers: ShipmentBlocker[]
+}
+
+/** Capabilities are resolved by the controller from authority and state. */
+export interface ShipmentDetailsCapabilities {
+  editRoute: boolean
+  editPurpose: boolean
+  editParticipation: boolean
+  editPacking: boolean
+  editNotes: boolean
+  comment: boolean
+  dispatch: boolean
+  cancel: boolean
+  recordArrival: boolean
+  markLocationUnknown: boolean
+}
+
+export type OperationResult =
+  | { ok: true }
+  | { ok: false; message: string }
+  | { ok: false; reconciliation: DeliveryNoteReconciliationItem[] }
+
+/** A delivery-note draft value affected by a route change (FRO-344). */
+export interface DeliveryNoteReconciliationItem {
+  id: string
+  draftNumber: string
+  /** Localized field name supplied by the controller. */
+  field: string
+  enteredValue: string
+  routeValue: string | null
+  /** Draft whose origin is no longer eligible; removal needs confirmation. */
+  removal?: boolean
+}
