+import { useId, useState } from 'react'
+import { CircleCheck, CircleX, Plus } from 'lucide-react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { MetricCard } from '#/components/ui/card'
+import { FormField, Input } from '#/components/ui/input'
+import { Modal } from '#/components/ui/modal'
+import { Select } from '#/components/ui/select'
+import { Table, TBody, TD, TH, THead, TR } from '#/components/ui/table'
+import { cn } from '#/lib/utils'
+import { shipmentComposerEnumLabel } from '../../localization/shipment-composer-labels'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type {
+  LoadUnitType,
+  OperationResult,
+  PackingDraft,
+  PackingPlanSubmission,
+  ShipmentColliRow,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+import {
+  dimensionsText,
+  draftFromLoadUnits,
+  loadUnitLabelMaxLength,
+  packingDraftChanged,
+  packingSubmission,
+  transportPieceCount,
+  validatePackingDraft,
+  weightText,
+  type UnitErrors,
+} from './shipment-details-values'
+import {
+  MeasurementCell,
+  PackageCard,
+  loadUnitTitle,
+} from './shipment-orders-tab'
+import { ModalActions } from './modal-actions'
+
+type Stage = 'edit' | 'review'
+
+function ColliReviewTable({
+  collis,
+  view,
+  assignmentLabel,
+}: {
+  collis: ShipmentColliRow[]
+  view: ShipmentDetailsView
+  assignmentLabel?: (colli: ShipmentColliRow) => string
+}) {
+  const { text, format } = useShipmentDetailsLabels()
+  const root = (orderId: string) =>
+    view.orders.find((order) => order.id === orderId)?.rootNumber ?? null
+  return (
+    <div className="overflow-x-auto rounded-md border border-border">
+      <Table>
+        <THead>
+          <TR>
+            <TH>{text.colli}</TH>
+            <TH>{text.description}</TH>
+            <TH>{text.order}</TH>
+            <TH>{text.dimensions}</TH>
+            <TH className="text-right">{text.grossWeight}</TH>
+            {assignmentLabel ? <TH>{text.shippingForm}</TH> : null}
+          </TR>
+        </THead>
+        <TBody>
+          {collis.map((colli) => {
+            const rootNumber = root(colli.orderId)
+            return (
+              <TR key={colli.id}>
+                <TD className="whitespace-nowrap font-mono">{colli.code}</TD>
+                <TD>
+                  {colli.description ?? (
+                    <span className="text-fg-subtle">{text.noDescription}</span>
+                  )}
+                </TD>
+                <TD className="whitespace-nowrap">
+                  <span className="font-mono">{colli.orderNumber}</span>
+                  {rootNumber ? (
+                    <div className="text-caption text-fg-muted">
+                      {format(text.splitFrom, { root: rootNumber })}
+                    </div>
+                  ) : null}
+                </TD>
+                <TD className="whitespace-nowrap">
+                  <MeasurementCell value={dimensionsText(colli)} />
+                </TD>
+                <TD className="whitespace-nowrap text-right">
+                  <MeasurementCell value={weightText(colli)} />
+                </TD>
+                {assignmentLabel ? <TD>{assignmentLabel(colli)}</TD> : null}
+              </TR>
+            )
+          })}
+        </TBody>
+      </Table>
+    </div>
+  )
+}
+
+function unitErrorText(
+  errors: UnitErrors | undefined,
+  text: ReturnType<typeof useShipmentDetailsLabels>['text'],
+) {
+  return {
+    length: errors?.length ? text.dimensionError : undefined,
+    width: errors?.width ? text.dimensionError : undefined,
+    height: errors?.height ? text.dimensionError : undefined,
+    gross: errors?.gross ? text.weightError : undefined,
+    label:
+      errors?.label === 'duplicate'
+        ? text.labelDuplicate
+        : errors?.label === 'tooLong'
+          ? text.labelTooLong
+          : undefined,
+  }
+}
+
+/**
+ * Optional repacking (FRO-325/FRO-299/FRO-300). Save packing saves the plan
+ * only; Confirm packing opens the review; Confirm ready for dispatch saves and
+ * attests readiness in one operation. Nothing is saved on Cancel or Escape.
+ */
+export function ShipmentPackingModal({
+  view,
+  onSavePacking,
+  onConfirmReadiness,
+  onClose,
+}: {
+  view: ShipmentDetailsView
+  onSavePacking: (plan: PackingPlanSubmission) => Promise<OperationResult>
+  onConfirmReadiness: (plan: PackingPlanSubmission) => Promise<OperationResult>
+  onClose: () => void
+}) {
+  const { text, locale, format } = useShipmentDetailsLabels()
+  const baseId = useId()
+  const [draft, setDraft] = useState<PackingDraft>(() =>
+    draftFromLoadUnits(view.loadUnits),
+  )
+  const [stage, setStage] = useState<Stage>('edit')
+  const [showErrors, setShowErrors] = useState(false)
+  const [confirmingSave, setConfirmingSave] = useState(false)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const [sequence, setSequence] = useState(1)
+
+  const errors = validatePackingDraft(draft)
+  const visibleErrors = showErrors ? errors : {}
+  const hasErrors = Object.keys(errors).length > 0
+  const unitKeys = draft.units.map((unit) => unit.key)
+  const counts = transportPieceCount(
+    view.collis.map((colli) => colli.id),
+    draft.assignment,
+    unitKeys,
+  )
+  const individual = view.collis.filter(
+    (colli) => !unitKeys.includes(draft.assignment[colli.id] ?? ''),
+  )
+  const blocked = view.readinessBlockers.length > 0
+
+  const edit = (next: PackingDraft) => {
+    setDraft(next)
+    setConfirmingSave(false)
+    setError(null)
+  }
+  const updateUnit = (
+    key: string,
+    patch: Partial<PackingDraft['units'][number]>,
+  ) =>
+    edit({
+      ...draft,
+      units: draft.units.map((unit) =>
+        unit.key === key ? { ...unit, ...patch } : unit,
+      ),
+    })
+  const addUnit = () => {
+    edit({
+      ...draft,
+      units: [
+        ...draft.units,
+        {
+          key: `${baseId}-new-${sequence}`,
+          id: null,
+          type: 'PALLET',
+          label: '',
+          length: '',
+          width: '',
+          height: '',
+          gross: '',
+        },
+      ],
+    })
+    setSequence(sequence + 1)
+  }
+  const removeUnit = (key: string) => {
+    const assignment = Object.fromEntries(
+      Object.entries(draft.assignment).filter(([, unitKey]) => unitKey !== key),
+    )
+    edit({ units: draft.units.filter((unit) => unit.key !== key), assignment })
+  }
+
+  async function run(command: typeof onSavePacking) {
+    setBusy(true)
+    setError(null)
+    const result = await command(packingSubmission(draft))
+    setBusy(false)
+    setConfirmingSave(false)
+    if (result.ok) onClose()
+    else setError('message' in result ? result.message : text.operationFailed)
+  }
+
+  function savePacking() {
+    setShowErrors(true)
+    if (hasErrors) return
+    const changed = packingDraftChanged(view.loadUnits, draft)
+    if (view.status === 'READY_FOR_DISPATCH' && changed) setConfirmingSave(true)
+    else void run(onSavePacking)
+  }
+
+  function openReview() {
+    setShowErrors(true)
+    if (hasErrors) return
+    setError(null)
+    setStage('review')
+  }
+
+  const unitLabel = (key: string) => {
+    const unit = draft.units.find((candidate) => candidate.key === key)
+    return unit
+      ? unit.label.trim() || text[unit.type]
+      : text.individualColliForm
+  }
+
+  const footer =
+    stage === 'review' ? (
+      <>
+        <Button
+          variant="secondary"
+          onClick={() => setStage('edit')}
+          disabled={busy}
+        >
+          {text.backToRepacking}
+        </Button>
+        <Button
+          onClick={() => void run(onConfirmReadiness)}
+          loading={busy}
+          disabled={blocked}
+        >
+          {text.confirmReady}
+        </Button>
+      </>
+    ) : confirmingSave ? (
+      <>
+        <Button
+          variant="secondary"
+          onClick={() => setConfirmingSave(false)}
+          disabled={busy}
+        >
+          {text.back}
+        </Button>
+        <Button onClick={() => void run(onSavePacking)} loading={busy}>
+          {text.saveAndReturn}
+        </Button>
+      </>
+    ) : (
+      <>
+        <Button variant="secondary" onClick={onClose} disabled={busy}>
+          {text.cancel}
+        </Button>
+        <Button variant="secondary" onClick={savePacking} loading={busy}>
+          {text.savePacking}
+        </Button>
+        <Button onClick={openReview} disabled={busy}>
+          {text.confirmPacking}
+        </Button>
+      </>
+    )
+
+  return (
+    <Modal
+      open
+      onClose={() => !busy && onClose()}
+      title={stage === 'review' ? text.reviewRepacking : text.optionalRepacking}
+      size="xl"
+      className="max-w-6xl"
+      footer={<ModalActions>{footer}</ModalActions>}
+    >
+      <div className="flex max-h-[68vh] flex-col gap-5 overflow-y-auto pr-1 text-fg">
+        {stage === 'edit' ? (
+          <>
+            <section className="flex flex-col gap-3">
+              <div className="flex items-center justify-between gap-2">
+                <h3 className="text-heading">{text.loadUnits}</h3>
+                <Button
+                  variant="secondary"
+                  size="sm"
+                  leadingIcon={<Plus className="size-4" aria-hidden />}
+                  onClick={addUnit}
+                >
+                  {text.addLoadUnit}
+                </Button>
+              </div>
+              {!draft.units.length ? (
+                <p className="text-body-sm text-fg-muted">{text.noRepacks}</p>
+              ) : null}
+              {draft.units.map((unit) => {
+                const unitErrors = visibleErrors[unit.key]
+                const messages = unitErrorText(unitErrors, text)
+                const id = (field: string) => `${unit.key}-${field}`
