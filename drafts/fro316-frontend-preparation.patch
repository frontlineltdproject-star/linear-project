+                  value={draft.documentNumber}
+                  onChange={(event) =>
+                    set({ documentNumber: event.target.value })
+                  }
+                />
+              </FormField>
+            ) : null}
+            {errors.resolution ? (
+              <p className="mt-2 text-xs text-danger-fg">
+                {text.chooseResolution}
+              </p>
+            ) : null}
+          </fieldset>
+        ) : null}
+        {saveError ? (
+          <Alert tone="danger" className="mt-4">
+            {saveError}
+          </Alert>
+        ) : null}
+        <div className="mt-4 flex justify-end gap-2">
+          <Button variant="secondary" onClick={onCancel} disabled={saving}>
+            {text.cancel}
+          </Button>
+          <Button onClick={onSave} loading={saving}>
+            {text.save}
+          </Button>
+        </div>
+      </div>
+    )
+  } else {
+    const dash = '—'
+    body = (
+      <dl className="grid grid-cols-1 gap-x-5 gap-y-3.5 sm:grid-cols-2 lg:grid-cols-4">
+        <Fact label={text.originCountry}>
+          {view.originCountry?.name ?? dash}
+        </Fact>
+        <Fact label={text.originCity}>{view.originCity?.name ?? dash}</Fact>
+        <Fact label={text.destinationCountry}>
+          {view.destinationCountry?.name ?? dash}
+        </Fact>
+        <Fact label={text.destinationCity}>
+          {view.destinationCity?.name ?? dash}
+        </Fact>
+        <Fact label={text.originWarehouse}>
+          {view.originWarehouse?.name ?? dash}
+        </Fact>
+        <Fact label={text.mode}>{view.mode ? text[view.mode] : dash}</Fact>
+        <Fact label={text.documentType}>
+          {documentType ? text[documentType] : dash}
+        </Fact>
+        <Fact label={view.mode ? text.documentNumber : text.transportReference}>
+          {view.transportDocumentNumber ? (
+            <span className="font-mono">{view.transportDocumentNumber}</span>
+          ) : (
+            text.notRecorded
+          )}
+        </Fact>
+        <Fact label={text.departureDate}>
+          <span className="font-mono">
+            {formatMoment(locale, view.departure)}
+          </span>
+        </Fact>
+        <Fact label={text.arrivalDate}>
+          <span className="font-mono">
+            {formatMoment(locale, view.arrival)}
+          </span>
+        </Fact>
+        <Fact label={text.dangerousGoods}>
+          {view.dangerousGoodsCount == null ? (
+            text.unavailable
+          ) : (
+            <span className="font-mono">{view.dangerousGoodsCount}</span>
+          )}
+        </Fact>
+      </dl>
+    )
+  }
+
+  return (
+    <SectionCard title={text.shipmentDetails} actions={editButton}>
+      {statusCard}
+      {body}
+      <div className="flex flex-wrap gap-x-5 gap-y-1 border-t border-border pt-3 text-caption text-fg-muted">
+        <span>
+          {metaLabels[0]}:{' '}
+          <span className="font-mono">
+            {formatMoment(locale, view.recordedAt)}
+          </span>
+        </span>
+        <span>
+          {metaLabels[1]}: {view.recordedBy ?? '—'}
+        </span>
+      </div>
+    </SectionCard>
+  )
+}
+
+export function ShipmentPurposeCard({
+  view,
+  canEdit,
+  draft,
+  saving,
+  saveError,
+  options,
+  onBeginEdit,
+  onDraftChange,
+  onCancel,
+  onSave,
+}: {
+  view: ShipmentDetailsView
+  canEdit: boolean
+  draft: PurposeDraft | null
+  saving: boolean
+  saveError: string | null
+  options: RouteOptions
+  onBeginEdit: () => void
+  onDraftChange: (draft: PurposeDraft) => void
+  onCancel: () => void
+  onSave: () => void
+}) {
+  const { text } = useShipmentDetailsLabels()
+  const editRef = useEditFocus(draft != null)
+  const purposeId = useId()
+  const destinationId = useId()
+  const destinationLabel = (purpose: ShipmentDetailsPurpose) =>
+    purpose === 'NETWORK_TRANSFER'
+      ? text.destinationWarehouse
+      : purpose === 'DELIVERY_TO_VESSEL'
+        ? text.vessel
+        : text.destinationDetails
+
+  let body: ReactNode
+  if (draft) {
+    const destinationWarehouses = options.warehouses.filter(
+      (warehouse) =>
+        warehouse.cityId === view.destinationCity?.id &&
+        warehouse.id !== view.originWarehouse?.id,
+    )
+    body = (
+      <div
+        onKeyDown={(event) => {
+          if (event.key === 'Escape') {
+            event.stopPropagation()
+            onCancel()
+          }
+        }}
+      >
+        <div className="grid grid-cols-1 gap-x-5 gap-y-4 sm:grid-cols-2">
+          <FormField label={text.purpose} htmlFor={purposeId}>
+            <Select
+              id={purposeId}
+              value={draft.purpose}
+              onChange={(event) =>
+                onDraftChange({
+                  purpose: event.target.value as ShipmentDetailsPurpose,
+                  destinationId: '',
+                })
+              }
+            >
+              {(
+                [
+                  'NETWORK_TRANSFER',
+                  'THIRD_PARTY_TRANSFER',
+                  'DELIVERY_TO_VESSEL',
+                  'DELIVERY_TO_LAUNCH_STATION',
+                ] as const
+              ).map((purpose) => (
+                <option key={purpose} value={purpose}>
+                  {text[purpose]}
+                </option>
+              ))}
+            </Select>
+          </FormField>
+          {draft.purpose === 'DELIVERY_TO_VESSEL' ? (
+            <Fact label={text.vessel}>{text.derivedVessel}</Fact>
+          ) : (
+            <FormField
+              label={destinationLabel(draft.purpose)}
+              htmlFor={destinationId}
+            >
+              <Select
+                id={destinationId}
+                value={draft.destinationId}
+                onChange={(event) =>
+                  onDraftChange({ ...draft, destinationId: event.target.value })
+                }
+              >
+                <OptionList
+                  placeholder={
+                    draft.purpose === 'NETWORK_TRANSFER'
+                      ? destinationWarehouses.length
+                        ? text.selectWarehouse
+                        : text.noMatchingWarehouse
+                      : text.chooseAgent
+                  }
+                  items={
+                    draft.purpose === 'NETWORK_TRANSFER'
+                      ? destinationWarehouses
+                      : options.agents
+                  }
+                />
+              </Select>
+            </FormField>
+          )}
+        </div>
+        {saveError ? (
+          <Alert tone="danger" className="mt-4">
+            {saveError}
+          </Alert>
+        ) : null}
+        <div className="mt-4 flex justify-end gap-2">
+          <Button variant="secondary" onClick={onCancel} disabled={saving}>
+            {text.cancel}
+          </Button>
+          <Button onClick={onSave} loading={saving}>
+            {text.save}
+          </Button>
+        </div>
+      </div>
+    )
+  } else {
+    body = (
+      <dl className="grid grid-cols-1 gap-x-5 gap-y-3.5 sm:grid-cols-2">
+        <Fact label={text.purpose}>{text[view.purpose]}</Fact>
+        <Fact label={destinationLabel(view.purpose)}>
+          {view.destination.name ??
+            (view.purpose === 'DELIVERY_TO_VESSEL' ? text.derivedVessel : '—')}
+        </Fact>
+      </dl>
+    )
+  }
+
+  return (
+    <SectionCard
+      title={text.shipmentPurpose}
+      actions={
+        canEdit && !draft ? (
+          <Button
+            ref={editRef}
+            variant="secondary"
+            size="sm"
+            onClick={onBeginEdit}
+          >
+            {text.edit}
+          </Button>
+        ) : null
+      }
+    >
+      {body}
+    </SectionCard>
+  )
+}
+
+export function ShipmentHandoverCard({ view }: { view: ShipmentDetailsView }) {
+  const { text, locale } = useShipmentDetailsLabels()
+  const handover = view.handover
+  if (!handover) return null
+  return (
+    <SectionCard title={text.finalHandover}>
+      <dl className="grid grid-cols-1 gap-x-5 gap-y-3.5 sm:grid-cols-2 lg:grid-cols-4">
+        <Fact label={text.recipientKind}>{handover.recipientKind}</Fact>
+        <Fact label={text.recipient}>{handover.recipient ?? '—'}</Fact>
+        <Fact label={text.receivedBy}>{handover.receivedBy ?? '—'}</Fact>
+        <Fact label={text.proof}>
+          <span className="font-mono">{handover.proof ?? '—'}</span>
+        </Fact>
+        <Fact label={text.confirmed}>
+          <span className="font-mono">
+            {formatMoment(locale, handover.confirmedAt)}
+          </span>
+        </Fact>
+      </dl>
+    </SectionCard>
+  )
+}
