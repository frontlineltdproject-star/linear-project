+function ParticipationEditor({
+  view,
+  candidates,
+  candidatesState,
+  onSearchCandidates,
+  onSave,
+  onClose,
+}: {
+  view: ShipmentDetailsView
+  candidates: ParticipationCandidateOrder[]
+  candidatesState: LoadState
+  onSearchCandidates: (query: string) => void
+  onSave: (submission: ParticipationSubmission) => Promise<OperationResult>
+  onClose: () => void
+}) {
+  const { text, format } = useShipmentDetailsLabels()
+  const searchId = useId()
+  const baseId = useId()
+  const original = new Set(view.collis.map((colli) => colli.id))
+  const [selected, setSelected] = useState<Set<string>>(() => new Set(original))
+  const [decisions, setDecisions] = useState<
+    Record<string, { reason: PartialReason | ''; remark: string }>
+  >({})
+  const [query, setQuery] = useState('')
+  const [showErrors, setShowErrors] = useState(false)
+  const [confirming, setConfirming] = useState(false)
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  const result = validateParticipation(
+    selected,
+    candidates,
+    view.loadUnits,
+    decisions,
+  )
+  const partials = partialOrders(selected, candidates)
+  const changed =
+    selected.size !== original.size ||
+    [...selected].some((id) => !original.has(id))
+
+  const toggleColli = (id: string, on: boolean) => {
+    const next = new Set(selected)
+    if (on) next.add(id)
+    else next.delete(id)
+    setSelected(next)
+    setConfirming(false)
+  }
+  const toggleOrder = (order: ParticipationCandidateOrder, on: boolean) => {
+    const next = new Set(selected)
+    for (const colli of order.collis)
+      if (on && colli.available) next.add(colli.id)
+      else if (!on) next.delete(colli.id)
+    setSelected(next)
+    setConfirming(false)
+  }
+
+  async function submit() {
+    setSaving(true)
+    setError(null)
+    const partialDecisions: ParticipationSubmission['partialDecisions'] = {}
+    for (const order of partials) {
+      const decision = decisions[order.id]
+      if (decision?.reason)
+        partialDecisions[order.id] = {
+          reason: decision.reason,
+          remark: decision.remark.trim(),
+        }
+    }
+    const outcome = await onSave({
+      colliIds: [...selected].sort(),
+      partialDecisions,
+    })
+    setSaving(false)
+    setConfirming(false)
+    if (outcome.ok) onClose()
+    else setError('message' in outcome ? outcome.message : text.operationFailed)
+  }
+
+  function save() {
+    setShowErrors(true)
+    if (
+      result.empty ||
+      result.emptiedUnits.length ||
+      result.partialMissing.length ||
+      result.wholeRequired.length
+    )
+      return
+    if (view.status === 'READY_FOR_DISPATCH' && changed) setConfirming(true)
+    else void submit()
+  }
+
+  return (
+    <Modal
+      open
+      onClose={() => !saving && onClose()}
+      title={text.participationTitle}
+      size="xl"
+      className="max-w-5xl"
+      footer={
+        <ModalActions>
+          {confirming ? (
+            <>
+              <Button
+                variant="secondary"
+                onClick={() => setConfirming(false)}
+                disabled={saving}
+              >
+                {text.back}
+              </Button>
+              <Button onClick={submit} loading={saving}>
+                {text.saveAndReturn}
+              </Button>
+            </>
+          ) : (
+            <>
+              <Button variant="secondary" onClick={onClose} disabled={saving}>
+                {text.cancel}
+              </Button>
+              <Button onClick={save} loading={saving}>
+                {text.save}
+              </Button>
+            </>
+          )}
+        </ModalActions>
+      }
+    >
+      <div className="flex max-h-[65vh] flex-col gap-4 overflow-y-auto pr-1">
+        <FormField
+          htmlFor={searchId}
+          label={text.searchOrders}
+          hint={text.addedTravelIndividually}
+        >
+          <Input
+            id={searchId}
+            leadingIcon={<Search aria-hidden />}
+            value={query}
+            onChange={(event) => {
+              setQuery(event.target.value)
+              onSearchCandidates(event.target.value)
+            }}
+          />
+        </FormField>
+        {candidatesState === 'error' ? (
+          <Alert tone="danger">{text.historyError}</Alert>
+        ) : null}
+        <div className="overflow-x-auto rounded-md border border-border">
+          <Table>
+            <TBody>
+              {candidates.map((order) => {
+                const selectable = order.collis.filter(
+                  (colli) => colli.available || selected.has(colli.id),
+                )
+                const count = selectable.filter((colli) =>
+                  selected.has(colli.id),
+                ).length
+                return (
+                  <Fragment key={order.id}>
+                    <TR className="bg-canvas">
+                      <TD className="w-10">
+                        <Checkbox
+                          id={`${baseId}-${order.id}`}
+                          aria-label={order.number}
+                          checked={count > 0 && count === selectable.length}
+                          indeterminate={count > 0 && count < selectable.length}
+                          disabled={!selectable.length}
+                          onChange={(event) =>
+                            toggleOrder(order, event.target.checked)
+                          }
+                        />
+                      </TD>
+                      <TD className="whitespace-nowrap font-mono font-semibold">
+                        {order.number}
+                        {order.rootNumber ? (
+                          <span className="ml-2 font-sans font-normal text-fg-muted">
+                            {format(text.splitFrom, { root: order.rootNumber })}
+                          </span>
+                        ) : null}
+                      </TD>
+                      <TD>{order.client ?? '—'}</TD>
+                      <TD>{order.vessel ?? '—'}</TD>
+                      <TD className="whitespace-nowrap text-right text-caption text-fg-muted">
+                        {order.inShipment ? text.inShipment : text.eligible}
+                      </TD>
+                    </TR>
+                    {order.collis.map((colli) => (
+                      <TR key={colli.id}>
+                        <TD className="pl-8">
+                          <Checkbox
+                            id={`${baseId}-${colli.id}`}
+                            aria-label={colli.code}
+                            checked={selected.has(colli.id)}
+                            disabled={
+                              !colli.available && !selected.has(colli.id)
+                            }
+                            onChange={(event) =>
+                              toggleColli(colli.id, event.target.checked)
+                            }
+                          />
+                        </TD>
+                        <TD className="font-mono">{colli.code}</TD>
+                        <TD colSpan={3} className="text-fg-muted">
+                          {colli.description ?? text.noDescription}
+                          {!colli.available && colli.unavailableReason ? (
+                            <span className="ml-2 text-xs">
+                              {colli.unavailableReason}
+                            </span>
+                          ) : null}
+                        </TD>
+                      </TR>
+                    ))}
+                  </Fragment>
+                )
+              })}
+            </TBody>
+          </Table>
+        </div>
+        {partials.length ? (
+          <section>
+            <h4 className="mb-2 text-sm font-semibold text-fg">
+              {text.partialSelections}
+            </h4>
+            <div className="flex flex-col gap-3">
+              {partials.map((order) => {
+                const decision = decisions[order.id] ?? {
+                  reason: '',
+                  remark: '',
+                }
+                const missing =
+                  showErrors && result.partialMissing.includes(order.id)
+                const reasonId = `${baseId}-reason-${order.id}`
+                const remarkId = `${baseId}-remark-${order.id}`
+                return (
+                  <div
+                    key={order.id}
+                    className="grid grid-cols-1 gap-3 sm:grid-cols-2"
+                  >
+                    <FormField
+                      label={`${text.reason} · ${order.number}`}
+                      htmlFor={reasonId}
+                      error={
+                        missing && !decision.reason
+                          ? text.reasonRequired
+                          : undefined
+                      }
+                    >
+                      <Select
+                        id={reasonId}
+                        value={decision.reason}
+                        invalid={missing && !decision.reason}
+                        onChange={(event) =>
+                          setDecisions({
+                            ...decisions,
+                            [order.id]: {
+                              ...decision,
+                              reason: event.target.value as PartialReason | '',
+                            },
+                          })
+                        }
+                      >
+                        <option value="">{text.chooseReason}</option>
+                        {reasons.map((reason) => (
+                          <option key={reason} value={reason}>
+                            {text[reason]}
+                          </option>
+                        ))}
+                      </Select>
+                    </FormField>
+                    <FormField
+                      label={text.remark}
+                      htmlFor={remarkId}
+                      error={
+                        missing && decision.reason === 'OTHER'
+                          ? text.remarkRequired
+                          : undefined
+                      }
+                    >
+                      <Input
+                        id={remarkId}
+                        value={decision.remark}
+                        onChange={(event) =>
+                          setDecisions({
+                            ...decisions,
+                            [order.id]: {
+                              ...decision,
+                              remark: event.target.value,
+                            },
+                          })
+                        }
+                      />
+                    </FormField>
+                  </div>
+                )
+              })}
+            </div>
+          </section>
+        ) : null}
+        {showErrors && result.empty ? (
+          <Alert tone="danger">{text.selectAtLeastOne}</Alert>
+        ) : null}
+        {showErrors
+          ? result.emptiedUnits.map((unit) => (
+              <Alert key={unit} tone="danger">
+                {format(text.emptiedUnit, { unit })}
+              </Alert>
+            ))
+          : null}
+        {showErrors && result.wholeRequired.length ? (
+          <Alert tone="danger">{text.wholeRequired}</Alert>
+        ) : null}
+        {confirming ? <Alert tone="warning">{text.readyWarning}</Alert> : null}
+        {error ? <Alert tone="danger">{error}</Alert> : null}
+      </div>
+    </Modal>
+  )
+}
+
+export interface ShipmentOrdersTabProps {
+  view: ShipmentDetailsView
+  capabilities: ShipmentDetailsCapabilities
+  candidates: ParticipationCandidateOrder[]
+  candidatesState: LoadState
+  onSearchCandidates: (query: string) => void
+  onSaveParticipation: (
+    submission: ParticipationSubmission,
+  ) => Promise<OperationResult>
+  onOpenPacking: () => void
+  /** Whether the packing modal is open, so focus can return to its entry button. */
+  packingOpen?: boolean
+  orderHref: (id: string) => string
+  colliHref: (id: string) => string
+}
+
+export function ShipmentOrdersTab({
+  view,
+  capabilities,
+  candidates,
+  candidatesState,
+  onSearchCandidates,
+  onSaveParticipation,
+  onOpenPacking,
+  packingOpen = false,
+  orderHref,
+  colliHref,
+}: ShipmentOrdersTabProps) {
+  const [editing, setEditing] = useState(false)
+  const editButtonRef = useEditFocus(editing)
+  const close = () => setEditing(false)
+  return (
+    <div className="flex flex-col gap-[var(--section-gap)]">
+      <OrdersCard
+        view={view}
+        canEdit={capabilities.editParticipation}
+        onEdit={() => setEditing(true)}
+        editButtonRef={editButtonRef}
+        orderHref={orderHref}
+        colliHref={colliHref}
+      />
+      <PackagesCard
+        view={view}
+        canEdit={capabilities.editPacking}
+        packingOpen={packingOpen}
+        onOpenPacking={onOpenPacking}
+        orderHref={orderHref}
+        colliHref={colliHref}
+      />
+      {editing ? (
+        <ParticipationEditor
+          view={view}
+          candidates={candidates}
+          candidatesState={candidatesState}
+          onSearchCandidates={onSearchCandidates}
+          onSave={onSaveParticipation}
+          onClose={close}
+        />
+      ) : null}
+    </div>
+  )
+}
