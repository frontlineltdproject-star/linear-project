+import { useState } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { StatusPill } from '#/components/ui/badge'
+import { Button } from '#/components/ui/button'
+import { Modal } from '#/components/ui/modal'
+import { cn } from '#/lib/utils'
+import { useShipmentDetailsLabels } from '../../localization/shipment-details-labels'
+import type {
+  OperationResult,
+  ShipmentBlocker,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+import {
+  isExceptionStatus,
+  lifecycleSteps,
+  shipmentStatusTone,
+  statusSteps,
+} from './shipment-details-values'
+import { ModalActions } from './modal-actions'
+
+const documentTypeByMode = {
+  ROAD: 'CMR',
+  AIR: 'AIR_WAYBILL',
+  SEA: 'BILL_OF_LADING',
+} as const
+
+export function documentTypeKey(mode: ShipmentDetailsView['mode']) {
+  return mode ? documentTypeByMode[mode] : null
+}
+
+function BlockerList({
+  title,
+  blockers,
+  id,
+}: {
+  title: string
+  blockers: ShipmentBlocker[]
+  id?: string
+}) {
+  if (!blockers.length) return null
+  return (
+    <Alert tone="warning" className="mt-3">
+      <span id={id}>{title}</span>
+      <ul className="mt-1 list-disc pl-5">
+        {blockers.map((blocker) => (
+          <li key={`${blocker.code}-${blocker.orderNumber ?? ''}`}>
+            {blocker.message}
+          </li>
+        ))}
+      </ul>
+    </Alert>
+  )
+}
+
+/**
+ * Read-only lifecycle presentation. The steps never trigger transitions;
+ * exceptions replace them so no false progress position is shown.
+ */
+export function ShipmentStatusCard({
+  view,
+  canDispatch,
+  canPrepare,
+  onOpenOrders,
+  onViewHistory,
+  onDispatch,
+}: {
+  view: ShipmentDetailsView
+  /** Controller-resolved permission to dispatch (authority + Ready). */
+  canDispatch: boolean
+  /** Whether to show the preparation pointer (authority + Preparing). */
+  canPrepare: boolean
+  onOpenOrders: () => void
+  onViewHistory: (eventId: string | null) => void
+  onDispatch: () => Promise<OperationResult>
+}) {
+  const { text, format } = useShipmentDetailsLabels()
+  const [dispatchOpen, setDispatchOpen] = useState(false)
+  const [dispatching, setDispatching] = useState(false)
+  const [dispatchError, setDispatchError] = useState<string | null>(null)
+  const steps = statusSteps(view.status, view.historicalArrival)
+  const exception = isExceptionStatus(view.status)
+  const documentType = documentTypeKey(view.mode)
+  const dispatchBlocked = view.dispatchBlockers.length > 0
+
+  async function confirmDispatch() {
+    if (dispatching) return
+    setDispatching(true)
+    setDispatchError(null)
+    const result = await onDispatch()
+    setDispatching(false)
+    if (result.ok) setDispatchOpen(false)
+    else
+      setDispatchError(
+        'message' in result ? result.message : text.operationFailed,
+      )
+  }
+
+  return (
+    <div className="rounded-md border border-border bg-canvas p-4">
+      <p className="text-xs font-semibold text-fg">{text.shipmentStatus}</p>
+      <div className="mt-1.5">
+        <StatusPill tone={shipmentStatusTone(view.status)}>
+          {text[view.status]}
+        </StatusPill>
+      </div>
+
+      {exception ? (
+        <Alert tone="danger" className="mt-3" title={text[view.status]}>
+          {view.lastConfirmedStage ? (
+            <p className="mt-1">
+              {format(text.lastConfirmedStage, {
+                stage: text[view.lastConfirmedStage],
+              })}
+            </p>
+          ) : null}
+          <Button
+            variant="secondary"
+            size="sm"
+            className="mt-2"
+            onClick={() => onViewHistory(view.exceptionEventId)}
+          >
+            {text.viewHistory}
+          </Button>
+        </Alert>
+      ) : steps ? (
+        <ol
+          aria-label={text.shipmentStatus}
+          className="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-4 sm:gap-3"
+        >
+          {lifecycleSteps.map((step, index) => {
+            const state = steps[index]
+            return (
+              <li
+                key={step}
+                aria-current={state === 'current' ? 'step' : undefined}
+                className={cn(
+                  'flex items-center gap-2 border-t-[3px] pt-2 text-body-sm',
+                  state === 'current' && 'border-accent font-semibold text-fg',
+                  state === 'done' && 'border-accent text-fg',
+                  state === 'upcoming' && 'border-border-strong text-fg-subtle',
+                  state === 'unrecorded' &&
+                    'border-dashed border-border-strong text-fg-subtle',
+                )}
+              >
+                <span
+                  className={cn(
+                    'grid size-[22px] shrink-0 place-content-center rounded-full border text-xs font-semibold',
+                    state === 'current'
+                      ? 'border-accent bg-accent text-fg-on-accent'
+                      : state === 'done'
+                        ? 'border-accent bg-accent-subtle text-accent-strong'
+                        : 'border-border-strong bg-surface',
+                  )}
+                  aria-hidden
+                >
+                  {index + 1}
+                </span>
+                <span>{text[step]}</span>
+              </li>
+            )
+          })}
+        </ol>
+      ) : null}
+
+      {view.status === 'PREPARING' && canPrepare ? (
+        <>
+          <p className="mt-3 text-body-sm text-fg-muted">
+            {text.nextStepPreparing}{' '}
+            <Button variant="ghost" size="sm" onClick={onOpenOrders}>
+              {text.openOrders}
+            </Button>
+          </p>
+          <BlockerList
+            title={text.readinessBlocked}
+            blockers={view.readinessBlockers}
+          />
+        </>
+      ) : null}
+
+      {view.status === 'READY_FOR_DISPATCH' && canDispatch ? (
+        <>
+          <BlockerList
+            id="shipment-dispatch-blockers"
+            title={text.dispatchBlocked}
+            blockers={view.dispatchBlockers}
+          />
+          <div className="mt-3 flex justify-end">
+            <Button
+              onClick={() => setDispatchOpen(true)}
+              disabled={dispatchBlocked}
+              aria-describedby={
+                dispatchBlocked ? 'shipment-dispatch-blockers' : undefined
+              }
+            >
+              {text.dispatch}
+            </Button>
+          </div>
+        </>
+      ) : null}
+
+      <Modal
+        open={dispatchOpen}
+        onClose={() => !dispatching && setDispatchOpen(false)}
+        title={text.dispatchTitle}
+        footer={
+          <ModalActions>
+            <Button
+              variant="secondary"
+              onClick={() => setDispatchOpen(false)}
+              disabled={dispatching}
+            >
+              {text.cancel}
+            </Button>
+            <Button onClick={confirmDispatch} loading={dispatching}>
+              {text.dispatch}
+            </Button>
+          </ModalActions>
+        }
+      >
+        <p>{text.dispatchBody}</p>
+        <dl className="mt-3 grid grid-cols-2 gap-3">
+          <div>
+            <dt className="text-xs font-semibold text-fg-muted">
+              {text.documentType}
+            </dt>
+            <dd className="text-fg">
+              {documentType ? text[documentType] : '—'}
+            </dd>
+          </div>
+          <div>
+            <dt className="text-xs font-semibold text-fg-muted">
+              {text.documentNumber}
+            </dt>
+            <dd className="font-mono text-fg">
+              {view.transportDocumentNumber ?? '—'}
+            </dd>
+          </div>
+        </dl>
+        {dispatchError ? (
+          <Alert tone="danger" className="mt-3">
+            {dispatchError}
+          </Alert>
+        ) : null}
+      </Modal>
+    </div>
+  )
+}
