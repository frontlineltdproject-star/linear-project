+} from './shipment-details-fixtures.test-utils'
+import type {
+  ShipmentDetailsTab,
+  ShipmentDetailsView,
+} from './shipment-details-types'
+
+afterEach(() => {
+  cleanup()
+  localStorage.clear()
+})
+
+const ok = async () => ({ ok: true }) as const
+
+function LanguageButton() {
+  const { setLocale } = useLocale()
+  return (
+    <button type="button" onClick={() => setLocale('el')}>
+      EL
+    </button>
+  )
+}
+
+function renderPage(view: ShipmentDetailsView = buildView()) {
+  const onTabChange = vi.fn<(tab: ShipmentDetailsTab) => void>()
+  function Harness() {
+    const [tab, setTab] = useState<ShipmentDetailsTab>('overview')
+    return (
+      <ShipmentDetailsPreparedPage
+        view={view}
+        capabilities={allCapabilities}
+        options={routeOptions}
+        history={{
+          state: 'ready',
+          statusEvents: [],
+          operations: [],
+          comments: [],
+        }}
+        candidates={[]}
+        candidatesState="ready"
+        tab={tab}
+        onTabChange={(next) => {
+          onTabChange(next)
+          setTab(next)
+        }}
+        commands={{
+          saveRoute: ok,
+          savePurpose: ok,
+          saveNote: ok,
+          dispatch: ok,
+          saveParticipation: ok,
+          savePacking: ok,
+          confirmReadiness: ok,
+          addComment: ok,
+          cancelShipment: ok,
+          markLocationUnknown: ok,
+          searchCandidates: vi.fn(),
+          retryHistory: vi.fn(),
+        }}
+        slots={{
+          documents: <p>Existing attachment panel</p>,
+          deliveryNotes: <p>Existing delivery notes</p>,
+          arrivalForm: null,
+        }}
+        orderHref={(id) => `/orders/${id}`}
+        colliHref={(id) => `/collis/${id}`}
+      />
+    )
+  }
+  render(
+    <LabelsProvider>
+      <LanguageButton />
+      <Harness />
+    </LabelsProvider>,
+  )
+  return { onTabChange }
+}
+
+describe('Shipment details prepared page', () => {
+  it('uses the TopBar title and the agreed tab order with Overview first', () => {
+    renderPage()
+    expect(screen.getByRole('heading', { level: 1 }).textContent).toBe(
+      'Shipment · SH-TEST-0001',
+    )
+    expect(screen.getAllByRole('tab').map((tab) => tab.textContent)).toEqual([
+      'Overview',
+      'Orders and collis',
+      'History & activity',
+      'Documents',
+      'Available actions',
+    ])
+    expect(
+      screen
+        .getByRole('tab', { name: 'Overview' })
+        .getAttribute('aria-selected'),
+    ).toBe('true')
+  })
+
+  it('moves between tabs with arrow, Home and End keys', () => {
+    const { onTabChange } = renderPage()
+    const overview = screen.getByRole('tab', { name: 'Overview' })
+    fireEvent.keyDown(overview, { key: 'ArrowRight' })
+    expect(onTabChange).toHaveBeenLastCalledWith('orders')
+    fireEvent.keyDown(screen.getByRole('tab', { name: 'Orders and collis' }), {
+      key: 'End',
+    })
+    expect(onTabChange).toHaveBeenLastCalledWith('actions')
+    expect(document.activeElement?.textContent).toBe('Available actions')
+    fireEvent.keyDown(screen.getByRole('tab', { name: 'Available actions' }), {
+      key: 'Home',
+    })
+    expect(onTabChange).toHaveBeenLastCalledWith('overview')
+  })
+
+  it('keeps an open Notes draft across tab and language switches', () => {
+    renderPage()
+    const editButtons = screen.getAllByRole('button', { name: 'Edit' })
+    fireEvent.click(editButtons[editButtons.length - 1])
+    fireEvent.change(screen.getByLabelText('External Notes'), {
+      target: { value: 'Unsaved note' },
+    })
+    fireEvent.click(screen.getByRole('tab', { name: 'Documents' }))
+    expect(screen.getByText('Existing attachment panel')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'EL' }))
+    fireEvent.click(screen.getByRole('tab', { name: 'Επισκόπηση' }))
+    expect(
+      (screen.getByLabelText('Εξωτερικές σημειώσεις') as HTMLTextAreaElement)
+        .value,
+    ).toBe('Unsaved note')
+  })
+
+  it('opens History & activity from View history', () => {
+    renderPage(
+      buildView({ status: 'LOCATION_UNKNOWN', exceptionEventId: 'ev-9' }),
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'View history' }))
+    expect(
+      screen
+        .getByRole('tab', { name: 'History & activity' })
+        .getAttribute('aria-selected'),
+    ).toBe('true')
+  })
+
+  it('opens the packing editor and returns focus to its entry button', async () => {
+    renderPage()
+    fireEvent.click(screen.getByRole('tab', { name: 'Orders and collis' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Plan packing' }))
+    expect(
+      screen.getByRole('heading', { name: 'Optional repacking' }),
+    ).toBeTruthy()
+    fireEvent.keyDown(document, { key: 'Escape' })
+    await waitFor(() =>
+      expect(document.activeElement).toBe(
+        screen.getByRole('button', { name: 'Plan packing' }),
+      ),
+    )
+  })
+})
