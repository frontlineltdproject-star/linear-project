+export type RouteDraftErrors = Partial<
+  Record<
+    | 'originWarehouse'
+    | 'resolution'
+    | 'documentNumber'
+    | 'destinationWarehouse',
+    true
+  >
+>
+
+/** Client-side checks before submission; the server revalidates everything. */
+export function validateRouteDraft(
+  saved: RouteDraft,
+  draft: RouteDraft,
+  purpose: ShipmentDetailsPurpose,
+  options: RouteOptions,
+): RouteDraftErrors {
+  const errors: RouteDraftErrors = {}
+  const warehouseCity = (id: string) =>
+    options.warehouses.find((warehouse) => warehouse.id === id)?.cityId ?? null
+  if (
+    draft.originWarehouseId &&
+    warehouseCity(draft.originWarehouseId) !== draft.originCityId
+  )
+    errors.originWarehouse = true
+  const modeChanged = draft.mode !== saved.mode && saved.documentNumber !== ''
+  if (modeChanged && !draft.documentResolution) errors.resolution = true
+  const replacing = !modeChanged || draft.documentResolution === 'REPLACE'
+  if (replacing && draft.documentNumber.length > 255)
+    errors.documentNumber = true
+  if (
+    modeChanged &&
+    draft.documentResolution === 'REPLACE' &&
+    !draft.documentNumber.trim()
+  )
+    errors.documentNumber = true
+  if (
+    purpose === 'NETWORK_TRANSFER' &&
+    draft.destinationCityId !== saved.destinationCityId &&
+    warehouseCity(draft.destinationWarehouseId) !== draft.destinationCityId
+  )
+    errors.destinationWarehouse = true
+  return errors
