+                    values={values}
+                    change={e.change}
+                    labels={goodLabels}
+                    currencies={props.currencies}
+                    separateNotes
+                  />
+                  <InvoiceSection title={l.notes}>
+                    <FormField label={l.notes} htmlFor="details-notes">
+                      <Textarea
+                        id="details-notes"
+                        value={values.notes}
+                        onChange={(event) =>
+                          e.change('notes', event.target.value)
+                        }
+                      />
+                    </FormField>
+                  </InvoiceSection>
+                </>
+              )}
+            </e.form.Subscribe>
+            <ShipmentInvoiceReview
+              review={e.review}
+              warnings={e.warnings}
+              ack={e.ack}
+              disabled={disabled || e.reading || e.evaluating || !e.readValid}
+              onConfirm={e.confirmReviewed}
+              labels={d}
+            />
+          </fieldset>
+          <div className="flex flex-wrap gap-2">
+            <Button
+              type="button"
+              variant="secondary"
+              disabled={e.busy}
+              onClick={e.cancel}
+            >
+              {d.cancelEdit}
+            </Button>
+            <Button
+              type="submit"
+              disabled={
+                disabled ||
+                e.reading ||
+                e.evaluating ||
+                !e.readValid ||
+                !e.evaluation ||
+                e.evaluation.evaluation.mixed ||
+                !(e.replacing ? props.onCreateReplacement : props.onSave)
