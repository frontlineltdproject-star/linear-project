+import type {
+  ShipmentInvoiceDraftValues,
+  ShipmentPresentation,
+  InvoiceOrder,
+  SelectionEvaluation,
+  ShipmentInvoiceCreateFormProps,
+} from '../create/types'
+import type { Selection } from '../create/selection'
+export enum InvoiceLifecycle {
+  Draft = 'Draft',
+  Finalized = 'Finalized',
+  Cancelled = 'Cancelled',
+}
+export interface InvoiceReviewView {
+  revision: string
+  required: boolean
+  items: string[]
+  canConfirm: boolean
+  confirmedRevision: string | null
+}
+export interface InvoiceRecordView {
+  id: string
+  revision: string
+  lifecycle: InvoiceLifecycle
+  printedNumber: string | null
+  shipmentLabel: string
+  clientLabel: string
+  companyLabel: string
+  values: ShipmentInvoiceDraftValues
+  selection: Selection
+  orders: InvoiceOrder[]
+  totalDisplay: string
+  createdLabel: string
+  updatedLabel: string | null
+  review: InvoiceReviewView
+  validationMessages: string[]
+  actions: {
+    edit: boolean
+    finalize: boolean
+    discard: boolean
+    cancel: boolean
+    replace: boolean
+  }
+  cancellationReason?: string
+  original?: { id: string; label: string }
+  replacement?: { id: string; label: string }
+}
+export type InvoiceViewState =
+  | { kind: 'ready'; record: InvoiceRecordView }
+  | { kind: 'loading' | 'error' | 'forbidden' | 'missing' }
+export interface InvoiceEditorInput {
+  values: ShipmentInvoiceDraftValues
+  selection: Selection
+  expectedRevision: string
+  reviewRevision: string | null
+}
+export type InvoiceActionResult =
+  | { kind: 'success'; record?: InvoiceRecordView; id?: string }
+  | { kind: 'validation'; messages: string[] }
+  | { kind: 'conflict'; latest: InvoiceViewState }
+  | { kind: 'failure'; message: string }
+  | { kind: 'uncertain' }
+export interface InvoiceEvaluation {
+  evaluation: SelectionEvaluation
+  review: InvoiceReviewView
+  validationMessages: string[]
+}
+/** UI host boundary only. Never a production API or authorization contract. */
+export interface ShipmentInvoiceDetailsProps {
+  state: InvoiceViewState
+  currencies: string[]
+  todayAthens: string
+  onReload?: () => Promise<InvoiceViewState>
+  onRefreshGoods?: (
+    id: string,
+    revision: string,
+  ) => Promise<{ shipment: ShipmentPresentation; review: InvoiceReviewView }>
+  onEvaluateDraft?: (input: InvoiceEditorInput) => Promise<InvoiceEvaluation>
+  onSave?: (
+    id: string,
+    input: InvoiceEditorInput,
+  ) => Promise<InvoiceActionResult>
+  onFinalize?: (
+    id: string,
+    revision: string,
+    reviewRevision: string | null,
+  ) => Promise<InvoiceActionResult>
+  onDiscard?: (id: string, revision: string) => Promise<InvoiceActionResult>
+  onCancelInvoice?: (
+    id: string,
+    revision: string,
+    reason: string,
+  ) => Promise<InvoiceActionResult>
+  onPrepareReplacement?: (id: string) => Promise<{
+    values: ShipmentInvoiceDraftValues
+    selection: Selection
+    shipment: ShipmentPresentation
+    review: InvoiceReviewView
+  }>
+  onCreateReplacement?: (
+    id: string,
+    input: InvoiceEditorInput,
+  ) => Promise<InvoiceActionResult>
+  onReconcile?: () => Promise<InvoiceViewState>
+  onOpenInvoice?: (id: string) => void
+  onOpenShipment?: (id: string) => void
+  onOpenAllocation?: (id: string) => void
+  registerNavigationGuard?: ShipmentInvoiceCreateFormProps['registerNavigationGuard']
+}
diff --git a/frontline-forwarding-client/src/features/shipment-invoices/details/use-invoice-actions.ts b/frontline-forwarding-client/src/features/shipment-invoices/details/use-invoice-actions.ts
