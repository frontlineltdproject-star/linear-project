+import { Button } from '#/components/ui/button'
+import { InvoiceSection } from './shipment-invoice-document-fields'
+import type { InvoiceReviewView } from '../details/types'
+import type { DetailsLabels } from '../details/labels'
+export function ShipmentInvoiceReview({
+  review,
+  warnings,
+  ack,
+  disabled,
+  onConfirm,
+  labels: d,
+}: {
+  review: InvoiceReviewView
+  warnings: string[]
+  ack: string | null
+  disabled: boolean
+  onConfirm?: () => void
+  labels: DetailsLabels
+}) {
+  if (!review.required && !warnings.length) return null
+  return (
+    <InvoiceSection title={d.review}>
+      <p>{d.reviewNeeded}</p>
+      <ul className="my-3 list-inside list-disc">
+        {[...new Set([...review.items, ...warnings])].map((item) => (
+          <li key={item} className="break-words">
+            {item}
+          </li>
+        ))}
+      </ul>
+      {onConfirm && (
+        <Button
+          type="button"
+          disabled={disabled || !review.canConfirm || ack === review.revision}
+          onClick={onConfirm}
+        >
+          {ack === review.revision ? d.reviewed : d.confirmReviewed}
+        </Button>
+      )}
+    </InvoiceSection>
+  )
+}
