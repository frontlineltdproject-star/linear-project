+import { useRef, useState } from 'react'
+import { Input, FormField } from '#/components/ui/input'
+import { Button } from '#/components/ui/button'
+import { Select } from '#/components/ui/select'
+import { Alert } from '#/components/ui/alert'
+import { InvoiceSection } from './shipment-invoice-document-fields'
+import type { Option } from '../create/types'
+import type { InvoiceLabels } from '../create/labels'
+export function ShipmentInvoiceShipmentPicker({
+  label,
+  value,
+  onChoose,
+  onSearch,
+  disabled,
+  labels: l,
+}: {
+  label?: string
+  value: string
+  onChoose: (id: string) => void
+  onSearch?: (query: string) => Promise<Option[]>
+  disabled: boolean
+  labels: InvoiceLabels
+}) {
+  const [query, setQuery] = useState(''),
+    [options, setOptions] = useState<Option[]>([]),
+    [state, setState] = useState('idle')
+  const generation = useRef(0)
+  async function search() {
+    if (!onSearch) return
+    const id = ++generation.current
+    setState('loading')
+    try {
+      const results = await onSearch(query)
+      if (id === generation.current) {
+        setOptions(results)
+        setState('ready')
+      }
+    } catch {
+      if (id === generation.current) setState('error')
+    }
+  }
+  return (
+    <InvoiceSection title={l.shipment}>
+      <div className="flex flex-wrap items-end gap-2">
+        <FormField
+          label={l.search}
+          htmlFor="invoice-shipment-search"
+          className="min-w-0 flex-1"
+        >
+          <Input
+            id="invoice-shipment-search"
+            value={query}
+            disabled={disabled}
+            onChange={(e) => {
+              setQuery(e.target.value)
+              generation.current++
+              setOptions([])
+              setState('idle')
+            }}
+          />
+        </FormField>
+        <Button
+          type="button"
+          variant="secondary"
+          disabled={disabled || !onSearch}
+          onClick={() => void search()}
+        >
+          {l.searchAction}
+        </Button>
+      </div>
+      <div className="mt-3">
+        <FormField label={l.choose} htmlFor="invoice-shipment-choice">
+          <Select
+            id="invoice-shipment-choice"
+            value={value}
+            disabled={disabled || state === 'loading'}
+            onChange={(event) => onChoose(event.target.value)}
+          >
+            <option value="" disabled>
+              {l.choose}
+            </option>
+            {label && !options.some((x) => x.id === value) && (
+              <option value={value}>{label}</option>
+            )}
+            {options.map((x) => (
+              <option key={x.id} value={x.id}>
+                {x.label}
+              </option>
+            ))}
+          </Select>
+        </FormField>
+      </div>
+      {state === 'loading' && <p role="status">{l.loading}</p>}
+      {state === 'error' && (
+        <Alert tone="danger">
+          {l.error}
+          <Button type="button" variant="ghost" onClick={() => void search()}>
+            {l.retry}
+          </Button>
+        </Alert>
+      )}
+      {state === 'ready' && !options.length && <p>{l.empty}</p>}
+    </InvoiceSection>
+  )
+}
