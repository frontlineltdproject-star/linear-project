+import { ShipmentInvoiceReview } from './shipment-invoice-review'
+export function ShipmentInvoiceDetails(props: ShipmentInvoiceDetailsProps) {
+  const { locale } = useLocale(),
+    d = detailsLabelsFor(locale),
+    last = useRef<InvoiceRecordView | null>(null)
+  const [loaded, setLoaded] = useState<{
+    source: InvoiceViewState
+    view: InvoiceViewState
+  } | null>(null)
+  const state = loaded?.source === props.state ? loaded.view : props.state
+  const source = useRef(props.state)
+  source.current = props.state
+  const retryGeneration = useRef(0),
+    retryLock = useRef(false)
+  const [retrying, setRetrying] = useState(false),
+    [loadError, setLoadError] = useState(false)
+  useEffect(() => {
+    retryGeneration.current++
+    retryLock.current = false
+    setRetrying(false)
+    setLoadError(false)
+  }, [props.state])
+  useEffect(
+    () => () => {
+      retryGeneration.current++
+    },
+    [],
+  )
+  async function reload() {
+    if (retryLock.current || !props.onReload) return
+    retryLock.current = true
+    setRetrying(true)
+    setLoadError(false)
+    const token = ++retryGeneration.current,
+      requestedSource = props.state
+    try {
+      const result = await props.onReload()
+      if (
+        token === retryGeneration.current &&
+        source.current === requestedSource
+      )
+        setLoaded({ source: requestedSource, view: result })
+    } catch {
+      if (
+        token === retryGeneration.current &&
+        source.current === requestedSource
+      )
+        setLoadError(true)
+    } finally {
+      if (token === retryGeneration.current) {
+        retryLock.current = false
+        setRetrying(false)
+      }
+    }
+  }
+  if (state.kind === 'ready') last.current = state.record
+  if (!last.current)
+    return (
+      <div role="status">
+        {loadError ? d.failed : state.kind !== 'ready' && d[state.kind]}
+        {state.kind === 'error' && props.onReload && (
+          <Button disabled={retrying} onClick={() => void reload()}>
+            {d.retry}
+          </Button>
+        )}
+      </div>
+    )
+  return (
+    <InvoiceDetailsSession
+      key={last.current.id}
+      {...props}
+      state={state}
+      initial={last.current}
+    />
+  )
+}
+function InvoiceDetailsSession(
+  props: ShipmentInvoiceDetailsProps & { initial: InvoiceRecordView },
+) {
+  const { locale } = useLocale(),
+    l = labelsFor(locale),
+    d = detailsLabelsFor(locale),
+    e = useInvoiceEditor(props, props.initial),
+    r = e.record,
+    a = useInvoiceActions(props, e, d)
+  const disabled = a.blocked
+  const goodLabels = {
+    ...l,
+    refresh: d.refresh,
+    mixed: d.mixed,
+    packing: d.packing,
+  }
+  return (
+    <main className="mx-auto flex w-full max-w-5xl min-w-0 flex-col gap-4 p-4 [&_button]:h-auto [&_button]:min-h-10 [&_button]:whitespace-normal [&_button]:py-2">
+      <header className="flex flex-wrap items-start justify-between gap-3">
+        <div className="min-w-0">
