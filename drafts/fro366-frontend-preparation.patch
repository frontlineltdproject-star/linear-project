+import { InvoiceSection } from './shipment-invoice-document-fields'
+import { ShipmentInvoiceGoods } from './shipment-invoice-goods'
+import type { InvoiceRecordView } from '../details/types'
+import type { DetailsLabels } from '../details/labels'
+import type { InvoiceLabels } from '../create/labels'
+export function ShipmentInvoiceReadonly({
+  record: r,
+  labels: l,
+  details: d,
+}: {
+  record: InvoiceRecordView
+  labels: InvoiceLabels
+  details: DetailsLabels
+}) {
+  const v = r.values
+  const fields = (pairs: Array<[string, string]>) => (
+    <dl className="grid gap-4 sm:grid-cols-2">
+      {pairs.map(([label, value]) => (
+        <div key={label} className="min-w-0 break-words">
+          <dt className="text-caption text-fg-muted">{label}</dt>
+          <dd className="whitespace-pre-wrap">{value || '—'}</dd>
+        </div>
+      ))}
+    </dl>
+  )
+  const date = v.documentDate.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+  return (
+    <>
+      <InvoiceSection title={l.details}>
+        {fields([
+          [l.client, r.clientLabel || v.clientId],
+          [l.company, r.companyLabel || v.companyId],
+          [l.invoiceType, v.invoiceType],
+          [
+            l.documentDate,
+            date ? `${date[3]}-${date[2]}-${date[1]}` : v.documentDate,
+          ],
+          [l.subtitle, v.subtitle],
+        ])}
+      </InvoiceSection>
+      <InvoiceSection title={l.parties}>
+        {fields([
+          [l.shipper, v.shipper],
+          [l.consignee, v.consignee],
+          [l.agent, v.agent],
+          [l.notify, v.notify],
+        ])}
+      </InvoiceSection>
+      <ShipmentInvoiceGoods
+        showRowIdentity
+        readOnly
+        orders={r.orders}
+        selection={r.selection}
+        disabled
+        onOrder={() => {}}
+        onRow={() => {}}
+        onRefresh={() => {}}
+        labels={l}
+      />
+      <InvoiceSection title={l.total}>
+        <p className="font-mono text-lg">{r.totalDisplay}</p>
+      </InvoiceSection>
+      <InvoiceSection title={d.packing}>
+        {fields([
+          [l.packingDetails, v.packingDetails],
+          [l.totalWeightKg, v.totalWeightKg],
+          [
+            l.partialAmount,
+            v.partialAmount
+              ? [v.partialAmount, v.partialCurrency].filter(Boolean).join(' ')
+              : '',
+          ],
+        ])}
+      </InvoiceSection>
+      <InvoiceSection title={l.notes}>
+        <p className="whitespace-pre-wrap break-words">{v.notes || '—'}</p>
+      </InvoiceSection>
+    </>
+  )
+}
