@@ -0,0 +1,272 @@
+import { useRef, useState } from 'react'
+import type { useInvoiceEditor } from './use-invoice-editor'
+import {
+  InvoiceLifecycle,
+  type InvoiceActionResult,
+  type InvoiceViewState,
+  type ShipmentInvoiceDetailsProps,
+} from './types'
+import { reconcileSelection } from '../create/selection'
+import type { DetailsLabels } from './labels'
+type Action = 'finalize' | 'discard' | 'cancel'
+export function useInvoiceActions(
+  props: ShipmentInvoiceDetailsProps,
+  e: ReturnType<typeof useInvoiceEditor>,
+  d: DetailsLabels,
+) {
+  const [dialog, setDialog] = useState<Action | null>(null),
+    [reason, setReason] = useState(''),
+    [messages, setMessages] = useState<string[]>([])
+  const [destination, setDestination] = useState<{
+      kind: 'invoice' | 'shipment'
+      id: string
+    } | null>(null),
+    [navigationError, setNavigationError] = useState(false),
+    [latest, setLatest] = useState<InvoiceViewState | null>(null)
+  const trigger = useRef<HTMLElement | null>(null)
+  const r = e.record,
+    blocked =
+      e.conflict || e.uncertain || e.busy || !!destination || !!e.readState
+  function close() {
+    if (e.actionLock.current) return
+    setDialog(null)
+    queueMicrotask(() => trigger.current?.focus())
+  }
+  function open(kind: Action) {
+    if (blocked) return
+    setMessages([])
+    e.setError(null)
+    if (kind === 'finalize') {
+      const errors = [...r.validationMessages]
+      if (r.review.required && r.review.confirmedRevision !== r.review.revision)
+        errors.push(d.reviewNeeded)
+      if (errors.length) {
+        setMessages(errors)
+        return
+      }
+    }
+    trigger.current =
+      document.activeElement instanceof HTMLElement
+        ? document.activeElement
+        : null
+    setReason('')
+    setDialog(kind)
+  }
+  function navigateSaved(target = destination) {
+    if (!target) return
+    try {
+      const navigate =
+        target.kind === 'invoice' ? props.onOpenInvoice : props.onOpenShipment
+      if (!navigate) throw Error('unavailable')
+      navigate(target.id)
+      setNavigationError(false)
+    } catch {
+      setNavigationError(true)
+    }
+  }
+  async function run(
+    command: () => Promise<InvoiceActionResult>,
+    kind: Action | 'save' | 'replacement',
+  ) {
+    if (e.actionLock.current || blocked) return
+    e.mutationPending.current = true
+    e.actionLock.current = true
+    e.setBusy(true)
+    e.setError(null)
+    setMessages([])
+    const token = e.generation.current
+    try {
+      const result = await command()
+      if (!e.alive.current || token !== e.generation.current) return
+      setDialog(null)
+      if (result.kind === 'success') {
+        if (kind === 'discard' || kind === 'replacement') {
+          const id =
+            kind === 'discard'
+              ? r.values.shipmentId
+              : (result.record?.id ?? result.id)
+          if (!id) {
+            e.setUncertain(true)
+            return
+          }
+          const target = {
+            kind:
+              kind === 'discard' ? ('shipment' as const) : ('invoice' as const),
+            id,
+          }
+          setDestination(target)
+          e.setDirty(false)
+          e.setEditing(false)
+          e.setReplacing(false)
+          navigateSaved(target)
+        } else if (result.record) e.adopt(result.record)
+        else e.setUncertain(true)
+      } else if (result.kind === 'conflict') {
+        e.setConflict(true)
+        setLatest(result.latest)
+      } else if (result.kind === 'uncertain') e.setUncertain(true)
+      else if (result.kind === 'validation') setMessages(result.messages)
+      else e.setError(result.message)
+    } catch {
+      if (e.alive.current && token === e.generation.current) {
+        e.setUncertain(true)
+        setDialog(null)
+      }
+    } finally {
+      e.mutationPending.current = false
+      e.actionLock.current = false
+      if (e.alive.current) e.setBusy(false)
+    }
+  }
+  function save() {
+    if (
+      !e.readValid ||
+      e.reading ||
+      e.evaluating ||
+      !e.evaluation ||
+      e.evaluation.evaluation.mixed
+    )
+      return
+    const callback = e.replacing ? props.onCreateReplacement : props.onSave
+    if (!callback) return
+    const snapshot = e.input()
+    void run(
+      () => callback(r.id, snapshot),
+      e.replacing ? 'replacement' : 'save',
+    )
+  }
+  function confirm() {
+    if (
+      dialog === 'finalize' &&
+      r.actions.finalize &&
+      r.lifecycle === InvoiceLifecycle.Draft &&
+      props.onFinalize
+    )
+      void run(
+        () => props.onFinalize!(r.id, r.revision, r.review.confirmedRevision),
+        'finalize',
+      )
+    if (
+      dialog === 'discard' &&
+      r.actions.discard &&
+      r.lifecycle === InvoiceLifecycle.Draft &&
+      props.onDiscard
+    )
+      void run(() => props.onDiscard!(r.id, r.revision), 'discard')
+    if (
+      dialog === 'cancel' &&
+      r.actions.cancel &&
+      r.lifecycle === InvoiceLifecycle.Finalized &&
+      reason.trim() &&
+      props.onCancelInvoice
+    )
+      void run(
+        () => props.onCancelInvoice!(r.id, r.revision, reason.trim()),
+        'cancel',
+      )
+  }
+  async function prepare() {
+    if (
+      e.actionLock.current ||
+      blocked ||
+      !r.actions.replace ||
+      r.lifecycle !== InvoiceLifecycle.Cancelled ||
+      !props.onPrepareReplacement
+    )
+      return
+    e.actionLock.current = true
+    e.setBusy(true)
+    e.setError(null)
+    const token = ++e.generation.current
+    try {
+      const result = await props.onPrepareReplacement(r.id)
+      if (!e.alive.current || token !== e.generation.current) return
+      if (
+        result.shipment.id !== r.values.shipmentId ||
+        !result.shipment.eligible
+      )
+        throw Error('source')
+      const eligible = Object.fromEntries(
+        result.shipment.orders.map((o) => [
+          o.id,
+          o.rows.filter((row) => !row.ineligibleReason).map((row) => row.id),
+        ]),
+      )
+      const selected = reconcileSelection(result.selection, eligible)
+      e.form.reset({
+        ...result.values,
+        shipmentId: r.values.shipmentId,
+        documentDate: props.todayAthens,
+      })
+      e.setSelection(selected.selection)
+      e.current.current.selection = selected.selection
+      e.setShipment(result.shipment)
+      e.setReplacing(true)
+      e.setEditing(true)
+      e.setDirty(true)
+      e.setReview({ ...result.review, required: true, confirmedRevision: null })
+      e.setAck(null)
+      e.setReadValid(true)
+      e.setWarnings([
+        ...result.review.items,
+        ...selected.removed.map((row) => `${row.orderId} / ${row.rowId}`),
+        d.replacementInfo,
+      ])
+      await e.evaluate(selected.selection)
+    } catch {
+      if (e.alive.current && token === e.generation.current)
+        e.setError('failed')
+    } finally {
+      e.actionLock.current = false
+      if (e.alive.current) e.setBusy(false)
+    }
+  }
+  async function read(reconcile: boolean) {
+    const callback = reconcile ? props.onReconcile : props.onReload
+    if (!callback || e.actionLock.current) return
+    e.actionLock.current = true
+    e.setBusy(true)
+    const token = e.generation.current
+    try {
+      const result = await callback()
+      if (!e.alive.current || token !== e.generation.current) return
+      setLatest(result)
+      if (reconcile && e.editing) {
+        e.setConflict(true)
+        e.setUncertain(false)
+      } else if (result.kind === 'ready') {
+        e.adopt(result.record)
+        setLatest(null)
+        setMessages([])
+      } else {
+        e.setConflict(true)
+        e.setError(result.kind)
+        e.setUncertain(false)
+      }
+    } catch {
+      if (e.alive.current && token === e.generation.current)
+        e.setError('failed')
+    } finally {
+      e.actionLock.current = false
+      if (e.alive.current) e.setBusy(false)
+    }
+  }
+  return {
+    dialog,
+    reason,
+    setReason,
+    messages,
+    latest,
+    destination,
+    navigationError,
+    navigateSaved,
+    blocked,
+    open,
+    close,
+    confirm,
+    save,
+    prepare,
+    reconcile: () => void read(true),
+    reload: () => e.navigate(() => void read(false)),
+  }
+}
