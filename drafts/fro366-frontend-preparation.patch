+import { Modal } from '#/components/ui/modal'
+import { Button } from '#/components/ui/button'
+import type { InvoiceLabels } from '../create/labels'
+export type Confirmation = {
+  kind: 'shipment' | 'discard' | 'shipper'
+  accept: () => void
+  trigger: HTMLElement | null
+}
+export function ShipmentInvoiceConfirmations({
+  value,
+  close,
+  labels: l,
+}: {
+  value: Confirmation | null
+  close: () => void
+  labels: InvoiceLabels
+}) {
+  return (
+    <Modal
+      open={!!value}
+      onClose={close}
+      title={
+        value?.kind === 'shipper'
+          ? l.confirmShipper
+          : value?.kind === 'shipment'
+            ? l.confirmShipment
+            : l.confirmDiscard
+      }
+      footer={
+        <div className="flex flex-wrap gap-2">
+          <Button
+            type="button"
+            variant="secondary"
+            className="h-auto min-h-10 whitespace-normal py-2"
+            onClick={close}
+          >
+            {value?.kind === 'shipper' ? l.keep : l.no}
+          </Button>
+          <Button
+            type="button"
+            className="h-auto min-h-10 whitespace-normal py-2"
+            onClick={() => {
+              const accept = value?.accept
+              close()
+              accept?.()
+            }}
+          >
+            {value?.kind === 'shipper' ? l.replace : l.confirm}
+          </Button>
+        </div>
+      }
+    >
+      {l.changed}
+    </Modal>
+  )
+}
