+import { Checkbox } from '#/components/ui/choice'
+import { Table, THead, TBody, TR, TH, TD } from '#/components/ui/table'
+import { Button } from '#/components/ui/button'
+import { Alert } from '#/components/ui/alert'
+import { InvoiceSection } from './shipment-invoice-document-fields'
+import type { InvoiceOrder } from '../create/types'
+import type { Selection } from '../create/selection'
+import type { InvoiceLabels } from '../create/labels'
+export function ShipmentInvoiceGoods({
+  orders,
+  readOnly = false,
+  showRowIdentity = false,
+  selection,
+  disabled,
+  onOrder,
+  onRow,
+  onRefresh,
+  onAllocation,
+  labels: l,
+}: {
+  readOnly?: boolean
+  showRowIdentity?: boolean
+  orders: InvoiceOrder[]
+  selection: Selection
+  disabled: boolean
+  onOrder: (id: string) => void
+  onRow: (order: string, row: string) => void
+  onRefresh: () => void
+  onAllocation?: (id: string) => void
+  labels: InvoiceLabels
+}) {
+  const sorted = [
+    ...selection
+      .map((g) => orders.find((o) => o.id === g.orderId))
+      .filter((o): o is InvoiceOrder => !!o),
+    ...(readOnly
+      ? []
+      : orders.filter((o) => !selection.some((g) => g.orderId === o.id))),
+  ]
+  return (
+    <InvoiceSection title={l.goods}>
+      {!readOnly && (
+        <Button
+          type="button"
+          variant="secondary"
+          disabled={disabled}
+          onClick={onRefresh}
+        >
+          {l.refresh}
+        </Button>
+      )}
+      {!orders.length && <p className="mt-3 text-fg-muted">{l.empty}</p>}
+      {sorted.map((order) => {
+        const selected =
+          selection.find((g) => g.orderId === order.id)?.rowIds ?? []
+        const eligible = order.rows.filter((r) =>
+          readOnly ? selected.includes(r.id) : !r.ineligibleReason,
+        )
+        const unresolved = order.rows.filter((r) => r.ineligibleReason)
+        return (
+          <section
+            key={order.id}
+            className="mt-4 min-w-0 rounded-lg border border-border p-3"
+          >
+            {readOnly ? (
+              <h3 className="font-semibold">{order.id}</h3>
+            ) : (
+              <Checkbox
+                label={order.id}
+                checked={
+                  !!eligible.length &&
+                  eligible.every((r) => selected.includes(r.id))
+                }
+                indeterminate={
+                  selected.length > 0 && selected.length < eligible.length
+                }
+                disabled={disabled || !eligible.length}
+                onChange={() => onOrder(order.id)}
+              />
+            )}
+            <dl className="my-3 grid grid-cols-2 gap-2 text-caption sm:grid-cols-4">
+              {[
+                [l.stock, order.id],
+                [l.client, order.client],
+                [l.supplier, order.supplier],
+                [l.message, order.messageNumber],
+                [l.origin, order.origin],
+                [l.destination, order.destination],
+                [l.status, order.status],
+              ].map(([key, value]) => (
+                <div key={key} className="min-w-0 break-words">
+                  <dt className="text-fg-muted">{key}</dt>
+                  <dd>{value || '—'}</dd>
+                </div>
+              ))}
+            </dl>
+            <div className="overflow-x-auto">
+              <Table>
+                <THead>
+                  <TR>
+                    {!readOnly && <TH>{l.selectGoods}</TH>}
+                    <TH>{l.description}</TH>
+                    <TH>{l.hs}</TH>
+                    <TH>{l.quantity}</TH>
+                    <TH>{l.unit}</TH>
+                    <TH>{l.amount}</TH>
+                    <TH>{l.currency}</TH>
+                  </TR>
+                </THead>
+                <TBody>
+                  {eligible.map((row) => (
+                    <TR key={row.id}>
+                      {!readOnly && (
+                        <TD>
+                          <Checkbox
+                            aria-label={`${order.id} ${row.description}`}
+                            checked={selected.includes(row.id)}
+                            disabled={disabled}
+                            onChange={() => onRow(order.id, row.id)}
+                          />
+                        </TD>
+                      )}
+                      <TD>
+                        {row.description}
+                        {showRowIdentity && (
+                          <span className="block text-caption text-fg-muted">
+                            {row.id}
+                          </span>
+                        )}
+                      </TD>
+                      <TD>{row.hsCode || '—'}</TD>
+                      <TD>{row.quantity}</TD>
+                      <TD>{row.unit}</TD>
+                      <TD className="font-mono">{row.amountDisplay}</TD>
+                      <TD>{row.currency}</TD>
+                    </TR>
+                  ))}
+                </TBody>
+              </Table>
+            </div>
+            {!readOnly && unresolved.length > 0 && (
+              <div className="mt-3">
+                <Alert tone="warning" title={l.unresolved}>
+                  {unresolved.map((row) => (
+                    <div key={row.id}>
+                      <Checkbox
+                        disabled
+                        label={`${row.description} — ${row.ineligibleReason}`}
+                      />
+                    </div>
+                  ))}
+                  <Button
+                    type="button"
+                    variant="secondary"
+                    className="mt-2 h-auto min-h-10 whitespace-normal py-2"
+                    disabled={!onAllocation || disabled}
+                    onClick={() => onAllocation?.(order.id)}
+                  >
+                    {l.allocation}
+                  </Button>
+                  {!onAllocation && <p>{l.allocationUnavailable}</p>}
+                </Alert>
+              </div>
+            )}
+          </section>
+        )
+      })}
+      {!selection.length && (
+        <p className="mt-3 text-body-sm text-fg-muted">
+          {readOnly ? l.empty : l.noRows}
+        </p>
+      )}
+    </InvoiceSection>
+  )
+}
