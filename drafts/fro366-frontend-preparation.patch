+            >
+              {e.replacing ? l.create : d.save}
+            </Button>
+          </div>
+        </form>
+      ) : (
+        <>
+          <div className="flex flex-wrap gap-2">
+            {r.lifecycle === InvoiceLifecycle.Draft && r.actions.edit && (
+              <Button
+                disabled={
+                  disabled ||
+                  !props.onRefreshGoods ||
+                  !props.onEvaluateDraft ||
+                  !props.onSave
+                }
+                onClick={e.start}
+              >
+                {d.edit}
+              </Button>
+            )}
+            {r.lifecycle === InvoiceLifecycle.Draft && r.actions.finalize && (
+              <Button
+                disabled={disabled || !props.onFinalize}
+                onClick={() => a.open('finalize')}
+              >
+                {d.finalize}
+              </Button>
+            )}
+            {r.lifecycle === InvoiceLifecycle.Draft && r.actions.discard && (
+              <Button
+                variant="secondary"
+                disabled={disabled || !props.onDiscard}
+                onClick={() => a.open('discard')}
+              >
+                {d.discard}
+              </Button>
+            )}
+            {r.lifecycle === InvoiceLifecycle.Finalized && r.actions.cancel && (
+              <Button
+                variant="secondary"
+                disabled={disabled || !props.onCancelInvoice}
+                onClick={() => a.open('cancel')}
+              >
+                {d.cancelInvoice}
+              </Button>
+            )}
+            {r.lifecycle === InvoiceLifecycle.Cancelled &&
+              r.actions.replace && (
+                <Button
+                  disabled={
+                    disabled ||
+                    !props.onPrepareReplacement ||
+                    !props.onEvaluateDraft ||
+                    !props.onCreateReplacement
+                  }
+                  onClick={() => void a.prepare()}
+                >
+                  {d.replace}
+                </Button>
+              )}
+          </div>
+          <ShipmentInvoiceReadonly record={r} labels={goodLabels} details={d} />
+          <ShipmentInvoiceReview
+            review={r.review}
+            warnings={[]}
+            ack={r.review.confirmedRevision}
+            disabled
+            labels={d}
+          />
+        </>
+      )}
+      <ShipmentInvoiceLifecycleDialog
+        kind={a.dialog}
+        record={r}
+        reason={a.reason}
+        setReason={a.setReason}
+        busy={e.busy}
+        close={a.close}
+        confirm={a.confirm}
+        labels={d}
+      />
+      <ShipmentInvoiceConfirmations
+        value={e.confirmation}
+        close={e.closeConfirmation}
+        labels={l}
+      />
+    </main>
+  )
+}
