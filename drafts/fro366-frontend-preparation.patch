+import { Modal } from '#/components/ui/modal'
+import { Button } from '#/components/ui/button'
+import { FormField, Textarea } from '#/components/ui/input'
+import type { InvoiceRecordView } from '../details/types'
+import type { DetailsLabels } from '../details/labels'
+export function ShipmentInvoiceLifecycleDialog({
+  kind,
+  record: r,
+  reason,
+  setReason,
+  busy,
+  close,
+  confirm,
+  labels: d,
+}: {
+  kind: 'finalize' | 'discard' | 'cancel' | null
+  record: InvoiceRecordView
+  reason: string
+  setReason: (value: string) => void
+  busy: boolean
+  close: () => void
+  confirm: () => void
+  labels: DetailsLabels
+}) {
+  return (
+    <Modal
+      open={!!kind}
+      onClose={close}
+      hideClose={busy}
+      title={
+        kind === 'finalize'
+          ? d.finalize
+          : kind === 'discard'
+            ? d.confirmDiscard
+            : d.confirmCancel
+      }
+      footer={
+        <div className="flex flex-wrap gap-2">
+          <Button variant="secondary" disabled={busy} onClick={close}>
+            {d.back}
+          </Button>
+          <Button
+            disabled={busy || (kind === 'cancel' && !reason.trim())}
+            onClick={confirm}
+          >
+            {d.confirm}
+          </Button>
+        </div>
+      }
+    >
+      <p>
+        {r.printedNumber ?? r.id} · {r.shipmentLabel}
+      </p>
+      {kind === 'finalize' && (
+        <>
+          <p>
+            {r.clientLabel} · {r.companyLabel}
+          </p>
+          <ul>
+            {r.selection.flatMap((group) =>
+              group.rowIds.map((id) => {
+                const row = r.orders
+                  .find((order) => order.id === group.orderId)
+                  ?.rows.find((row) => row.id === id)
+                return (
+                  <li key={`${group.orderId}/${id}`}>
+                    {group.orderId} / {id} · {row?.description ?? id} ·{' '}
+                    {row?.quantity} {row?.unit}
+                  </li>
+                )
+              }),
+            )}
+          </ul>
+          <p className="font-mono">{r.totalDisplay}</p>
+          <p>{d.number}</p>
+        </>
+      )}
+      {kind === 'cancel' && (
+        <FormField label={d.reason} htmlFor="invoice-cancellation-reason">
+          <Textarea
+            id="invoice-cancellation-reason"
+            disabled={busy}
+            value={reason}
+            onChange={(event) => setReason(event.target.value)}
+          />
+        </FormField>
+      )}
+    </Modal>
+  )
+}
