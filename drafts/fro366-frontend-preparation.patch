+      {e.editing ? (
+        <form
+          onSubmit={(event) => {
+            event.preventDefault()
+            a.save()
+          }}
+          className="flex min-w-0 flex-col gap-4"
+        >
+          <p>{d.locked}</p>
+          {e.replacing && <p>{d.replacementInfo}</p>}
+          <fieldset disabled={disabled} className="flex min-w-0 flex-col gap-4">
+            <e.form.Subscribe selector={(s) => s.values}>
+              {(values) => (
+                <>
+                  <ShipmentInvoiceDocumentFields
+                    values={values}
+                    change={e.change}
+                    labels={goodLabels}
+                    shipment={e.shipment}
