+import { Card, CardHeader, CardTitle, CardBody } from '#/components/ui/card'
+import { Input, Textarea, FormField } from '#/components/ui/input'
+import { Select } from '#/components/ui/select'
+import { DatePicker } from '#/components/ui/date-picker'
+import { formatIsoDate, parseIsoDate } from '#/lib/date'
+import type { ReactNode } from 'react'
+import type { InvoiceLabels } from '../create/labels'
+import type {
+  ShipmentInvoiceDraftValues,
+  ShipmentPresentation,
+} from '../create/types'
+export function InvoiceSection({
+  title,
+  children,
+}: {
+  title: string
+  children: ReactNode
+}) {
+  return (
+    <Card flush>
+      <CardHeader>
+        <CardTitle>{title}</CardTitle>
+      </CardHeader>
+      <CardBody>{children}</CardBody>
+    </Card>
+  )
+}
+export function ShipmentInvoiceDocumentFields({
+  values,
+  change,
+  labels: l,
+  shipment,
+  chooseCompany,
+  savedReferences,
+}: {
+  values: ShipmentInvoiceDraftValues
+  change: (key: keyof ShipmentInvoiceDraftValues, value: string) => void
+  labels: InvoiceLabels
+  shipment: ShipmentPresentation | null
+  currencies: string[]
+  savedReferences?: { clientLabel: string; companyLabel: string }
+  chooseCompany: (id: string) => void
+}) {
+  const text = (key: keyof ShipmentInvoiceDraftValues, multiline = false) => (
+    <FormField
+      key={key}
+      label={l[key as keyof InvoiceLabels]}
+      htmlFor={`invoice-${key}`}
+    >
+      {multiline ? (
+        <Textarea
+          id={`invoice-${key}`}
+          value={values[key]}
+          onChange={(e) => change(key, e.target.value)}
+        />
+      ) : (
+        <Input
+          id={`invoice-${key}`}
+          value={values[key]}
+          onChange={(e) => change(key, e.target.value)}
+        />
+      )}
+    </FormField>
+  )
+  return (
+    <>
+      <InvoiceSection title={l.details}>
+        <div className="grid gap-4 sm:grid-cols-2">
+          <FormField label={l.client} htmlFor="invoice-client">
+            <Select
+              id="invoice-client"
+              value={values.clientId}
+              onChange={(e) => change('clientId', e.target.value)}
+            >
+              <option value="">—</option>
+              {savedReferences &&
+                values.clientId &&
+                !shipment?.clients.some((x) => x.id === values.clientId) && (
+                  <option value={values.clientId}>
+                    {savedReferences.clientLabel || values.clientId}
+                  </option>
+                )}
+              {shipment?.clients.map((x) => (
+                <option key={x.id} value={x.id}>
+                  {x.label}
+                </option>
+              ))}
+            </Select>
+          </FormField>
+          <FormField label={l.company} htmlFor="invoice-company">
+            <Select
+              id="invoice-company"
+              value={values.companyId}
+              disabled={!values.clientId}
+              onChange={(e) => chooseCompany(e.target.value)}
+            >
+              <option value="">—</option>
+              {savedReferences &&
+                values.companyId &&
+                !shipment?.companies.some(
+                  (x) =>
+                    x.id === values.companyId && x.clientId === values.clientId,
+                ) && (
+                  <option value={values.companyId}>
+                    {savedReferences.companyLabel || values.companyId}
+                  </option>
+                )}
+              {shipment?.companies
+                .filter((x) => x.clientId === values.clientId)
+                .map((x) => (
+                  <option key={x.id} value={x.id}>
+                    {x.label}
+                  </option>
+                ))}
+            </Select>
+          </FormField>
+          <FormField label={l.invoiceType} htmlFor="invoice-type">
+            <Select
+              id="invoice-type"
+              value={values.invoiceType}
+              onChange={(e) => change('invoiceType', e.target.value)}
+            >
+              {[
+                'Invoice',
+                'Commercial Invoice',
+                'Pro-forma Invoice',
+                'Shipping Invoice',
+              ].map((x) => (
+                <option key={x}>{x}</option>
+              ))}
+            </Select>
+          </FormField>
+          <FormField label={l.documentDate}>
+            <DatePicker
+              value={parseIsoDate(values.documentDate)}
+              onChange={(d) => change('documentDate', formatIsoDate(d))}
+              format={(d) =>
+                `${String(d.getDate()).padStart(2, '0')}-${String(d.getMonth() + 1).padStart(2, '0')}-${d.getFullYear()}`
+              }
+            />
+          </FormField>
+          {text('subtitle')}
+          <p className="text-body-sm text-fg-muted">{l.number}</p>
+        </div>
+      </InvoiceSection>
+      <InvoiceSection title={l.parties}>
+        <div className="grid gap-4 sm:grid-cols-2">
+          {(['shipper', 'consignee', 'agent', 'notify'] as const).map((k) =>
+            text(k, true),
+          )}
+        </div>
+      </InvoiceSection>
+    </>
+  )
+}
+export function ShipmentInvoicePackingFields({
+  values,
+  change,
+  labels: l,
+  currencies,
+  separateNotes = false,
+}: {
+  values: ShipmentInvoiceDraftValues
+  change: (key: keyof ShipmentInvoiceDraftValues, value: string) => void
+  labels: InvoiceLabels
+  currencies: string[]
+  separateNotes?: boolean
+}) {
+  return (
+    <InvoiceSection title={l.packing}>
+      <div className="grid gap-4 sm:grid-cols-2">
+        {(
+          ['packingDetails', 'totalWeightKg', 'partialAmount', 'notes'] as const
+        )
+          .filter((key) => !separateNotes || key !== 'notes')
+          .map((key) => (
+            <FormField key={key} label={l[key]} htmlFor={`invoice-${key}`}>
+              {key === 'notes' || key === 'packingDetails' ? (
+                <Textarea
+                  id={`invoice-${key}`}
+                  value={values[key]}
+                  onChange={(e) => change(key, e.target.value)}
+                />
+              ) : (
+                <Input
+                  id={`invoice-${key}`}
+                  inputMode="decimal"
+                  value={values[key]}
+                  onChange={(e) => change(key, e.target.value)}
+                />
+              )}
+            </FormField>
+          ))}
+        <FormField label={l.partialCurrency} htmlFor="invoice-currency">
+          <Select
+            id="invoice-currency"
+            value={values.partialCurrency}
+            onChange={(e) => change('partialCurrency', e.target.value)}
+          >
+            {!currencies.includes(values.partialCurrency) && (
+              <option value={values.partialCurrency}>
+                {values.partialCurrency || '—'}
+              </option>
+            )}
+            {currencies.map((x) => (
+              <option key={x}>{x}</option>
+            ))}
+          </Select>
+        </FormField>
+      </div>
+    </InvoiceSection>
+  )
+}
