@@ -0,0 +1,49 @@
+export type Selection = Array<{ orderId: string; rowIds: string[] }>
+export function toggleOrder(
+  selection: Selection,
+  orderId: string,
+  ids: string[],
+): Selection {
+  const unique = [...new Set(ids)]
+  const current = selection.find((g) => g.orderId === orderId)
+  const rest = selection.filter((g) => g.orderId !== orderId)
+  return !unique.length || unique.every((id) => current?.rowIds.includes(id))
+    ? rest
+    : [{ orderId, rowIds: unique }, ...rest]
+}
+export function toggleRow(
+  selection: Selection,
+  orderId: string,
+  rowId: string,
+  ids: string[],
+): Selection {
+  if (!ids.includes(rowId)) return selection
+  const group = selection.find((g) => g.orderId === orderId)
+  const selected = new Set(group?.rowIds)
+  if (selected.has(rowId)) selected.delete(rowId)
+  else selected.add(rowId)
+  const rowIds = [...new Set(ids)].filter((id) => selected.has(id))
+  if (!group) return [{ orderId, rowIds }, ...selection]
+  return selection
+    .map((g) => (g.orderId === orderId ? { orderId, rowIds } : g))
+    .filter((g) => g.rowIds.length)
+}
+export function reconcileSelection(
+  selection: Selection,
+  eligible: Record<string, string[]>,
+) {
+  const removed: Array<{ orderId: string; rowId: string }> = []
+  return {
+    selection: selection
+      .map((g) => ({
+        ...g,
+        rowIds: g.rowIds.filter((rowId) => {
+          if (eligible[g.orderId]?.includes(rowId)) return true
+          removed.push({ orderId: g.orderId, rowId })
+          return false
+        }),
+      }))
+      .filter((g) => g.rowIds.length),
+    removed,
+  }
+}
