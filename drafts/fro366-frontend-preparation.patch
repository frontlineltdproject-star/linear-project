@@ -0,0 +1,450 @@
+import { useEffect, useRef, useState } from 'react'
+import { useAppForm } from '#/components/form'
+import { useDraftGuards } from '../create/use-draft-guards'
+import {
+  reconcileSelection,
+  toggleOrder,
+  toggleRow,
+  type Selection,
+} from '../create/selection'
+import type {
+  ShipmentInvoiceDraftValues,
+  ShipmentPresentation,
+} from '../create/types'
+import type { Confirmation } from '../components/shipment-invoice-confirmations'
+import {
+  InvoiceLifecycle,
+  type InvoiceRecordView,
+  type InvoiceEvaluation,
+  type InvoiceEditorInput,
+  type ShipmentInvoiceDetailsProps,
+} from './types'
+
+export function useInvoiceEditor(
+  props: ShipmentInvoiceDetailsProps,
+  initial: InvoiceRecordView,
+) {
+  const [replacing, setReplacing] = useState(false)
+  const [record, setRecord] = useState(initial),
+    [editing, setEditing] = useState(false),
+    [dirty, setDirty] = useState(false)
+  const [shipment, setShipment] = useState<ShipmentPresentation | null>(null),
+    [selection, setSelection] = useState<Selection>(initial.selection)
+  const [evaluation, setEvaluation] = useState<InvoiceEvaluation | null>(null),
+    [review, setReview] = useState(initial.review),
+    [ack, setAck] = useState<string | null>(initial.review.confirmedRevision)
+  const [warnings, setWarnings] = useState<string[]>([]),
+    [busy, setBusy] = useState(false),
+    [reading, setReading] = useState(false),
+    [evaluating, setEvaluating] = useState(false),
+    [readValid, setReadValid] = useState(false)
+  const [error, setError] = useState<string | null>(null),
+    [conflict, setConflict] = useState(false),
+    [uncertain, setUncertain] = useState(false),
+    [confirmation, setConfirmation] = useState<Confirmation | null>(null)
+  const form = useAppForm({ defaultValues: structuredClone(initial.values) })
+  const mutationPending = useRef(false)
+  const acknowledgedRead = useRef<ShipmentInvoiceDetailsProps['state'] | null>(
+    null,
+  )
+  const readState =
+    props.state.kind !== 'ready' && acknowledgedRead.current !== props.state
+      ? props.state.kind
+      : null
+  const callbacks = useRef(props)
+  callbacks.current = props
+  const current = useRef({
+    record,
+    selection,
+    ack,
+    editing,
+    dirty,
+    busy,
+    conflict,
+    uncertain,
+    readValid,
+  })
+  current.current = {
+    record,
+    selection,
+    ack,
+    editing,
+    dirty,
+    busy,
+    conflict,
+    uncertain,
+    readValid,
+  }
+  const generation = useRef(0),
+    evaluationGeneration = useRef(0),
+    actionLock = useRef(false),
+    alive = useRef(true),
+    externalRevision = useRef(initial.revision)
+  const reviewInvalidated = useRef(false)
+  const localAck = useRef<string | null>(null)
+  const shipperPrefillAccepted = useRef(false)
+  const shipperBaseline = useRef(initial.values.shipper)
+  useDraftGuards(dirty || busy || uncertain)
+  useEffect(() => {
+    alive.current = true
+    return () => {
+      alive.current = false
+      generation.current++
+      evaluationGeneration.current++
+    }
+  }, [])
+  useEffect(() => {
+    if (props.state.kind !== 'ready') {
+      if (mutationPending.current) setUncertain(true)
+      generation.current++
+      evaluationGeneration.current++
+      setReading(false)
+      setEvaluating(false)
+      setReadValid(false)
+    }
+  }, [props.state])
+  useEffect(() => {
+    if (
+      (props.state.kind === 'ready' &&
+        props.state.record.revision !== externalRevision.current) ||
+      props.state.kind === 'missing' ||
+      props.state.kind === 'forbidden'
+    ) {
+      generation.current++
+      evaluationGeneration.current++
+      setConflict(true)
+      setBusy(false)
+      setReading(false)
+      setEvaluating(false)
+      if (props.state.kind === 'ready')
+        externalRevision.current = props.state.record.revision
+    }
+  }, [props.state])
+  function closeConfirmation() {
+    const trigger = confirmation?.trigger
+    setConfirmation(null)
+    queueMicrotask(() => trigger?.focus())
+  }
+  function ask(kind: Confirmation['kind'], accept: () => void) {
+    setConfirmation({
+      kind,
+      accept,
+      trigger:
+        document.activeElement instanceof HTMLElement
+          ? document.activeElement
+          : null,
+    })
+  }
+  function navigate(proceed: () => void) {
+    if (actionLock.current || current.current.busy) return
+    if (current.current.dirty || current.current.uncertain)
+      ask('discard', proceed)
+    else proceed()
+  }
+  useEffect(
+    () => props.registerNavigationGuard?.(navigate),
+    [props.registerNavigationGuard],
+  )
+  const input = (
+    next = selection,
+    reviewRevision = ack,
+  ): InvoiceEditorInput => ({
+    values: structuredClone(form.state.values),
+    selection: structuredClone(next),
+    expectedRevision: record.revision,
+    reviewRevision,
+  })
+  function invalidate() {
+    reviewInvalidated.current = true
+    localAck.current = null
+    setAck(null)
+    setReview((old) => ({ ...old, required: true, confirmedRevision: null }))
+    setDirty(true)
+  }
+  async function evaluate(
+    next: Selection,
+    reviewRevision: string | null = null,
+  ) {
+    const token = ++evaluationGeneration.current
+    setEvaluating(true)
+    setEvaluation(null)
+    try {
+      const result = await callbacks.current.onEvaluateDraft?.(
+        input(next, reviewRevision),
+      )
+      if (!alive.current || token !== evaluationGeneration.current) return
+      if (!result) throw Error('unavailable')
+      setEvaluation(result)
+      setReview({
+        ...result.review,
+        required: result.review.required || reviewInvalidated.current,
+      })
+      setWarnings((old) => [...new Set([...old, ...result.review.items])])
+      setAck(
+        (!reviewInvalidated.current &&
+          result.review.confirmedRevision === result.review.revision) ||
+          localAck.current === result.review.revision
+          ? result.review.revision
+          : null,
+      )
+    } catch {
+      if (alive.current && token === evaluationGeneration.current)
+        setError('failed')
+    } finally {
+      if (alive.current && token === evaluationGeneration.current)
+        setEvaluating(false)
+    }
+  }
+  async function refresh() {
+    if (
+      actionLock.current ||
+      current.current.conflict ||
+      current.current.uncertain
+    )
+      return
+    const token = ++generation.current
+    evaluationGeneration.current++
+    setReading(true)
+    setReadValid(false)
+    setEvaluation(null)
+    setError(null)
+    try {
+      const result = await callbacks.current.onRefreshGoods?.(
+        record.id,
+        record.revision,
+      )
+      if (!alive.current || token !== generation.current) return
+      if (
+        !result ||
+        result.shipment.id !== record.values.shipmentId ||
+        !result.shipment.eligible
+      )
+        throw Error('read')
+      setShipment(result.shipment)
+      const eligible = Object.fromEntries(
+        result.shipment.orders.map((o) => [
+          o.id,
+          o.rows.filter((r) => !r.ineligibleReason).map((r) => r.id),
+        ]),
+      )
+      const reconciled = reconcileSelection(current.current.selection, eligible)
+      setSelection(reconciled.selection)
+      current.current.selection = reconciled.selection
+      setWarnings((old) => [
+        ...new Set([
+          ...old,
+          ...result.review.items,
+          ...reconciled.removed.map((r) => `${r.orderId} / ${r.rowId}`),
+        ]),
+      ])
+      if (
+        result.review.required ||
+        reconciled.removed.length ||
+        result.review.revision !== current.current.ack
+      )
+        invalidate()
+      setReview({
+        ...result.review,
+        required: result.review.required || reviewInvalidated.current,
+      })
+      setReadValid(true)
+      await evaluate(reconciled.selection, current.current.ack)
+    } catch {
+      if (alive.current && token === generation.current)
+        setError('sourceFailed')
+    } finally {
+      if (alive.current && token === generation.current) setReading(false)
+    }
+  }
+  function start() {
+    if (record.lifecycle !== InvoiceLifecycle.Draft || !record.actions.edit)
+      return
+    setEditing(true)
+    void refresh()
+  }
+  function reset() {
+    localAck.current = null
+    reviewInvalidated.current = false
+    shipperPrefillAccepted.current = false
+    shipperBaseline.current = record.values.shipper
+    generation.current++
+    evaluationGeneration.current++
+    form.reset(structuredClone(record.values))
+    setSelection(record.selection)
+    current.current.selection = record.selection
+    setEditing(false)
+    setReplacing(false)
+    setDirty(false)
+    setWarnings([])
+    setReview(record.review)
+    setAck(record.review.confirmedRevision)
+    setError(null)
+    setReading(false)
+    setEvaluating(false)
+  }
+  function cancel() {
+    navigate(reset)
+  }
+  function change(key: keyof ShipmentInvoiceDraftValues, value: string) {
+    if (key === 'shipmentId' || actionLock.current || conflict || uncertain)
+      return
+    form.setFieldValue(key, value)
+    if (key === 'shipper') shipperPrefillAccepted.current = false
+    if (key === 'clientId') form.setFieldValue('companyId', '')
+    setDirty(true)
+    if (
+      [
+        'packingDetails',
+        'totalWeightKg',
+        'partialAmount',
+        'partialCurrency',
+      ].includes(key)
+    )
+      invalidate()
+    if (readValid)
+      void evaluate(
+        selection,
+        [
+          'packingDetails',
+          'totalWeightKg',
+          'partialAmount',
+          'partialCurrency',
+        ].includes(key)
+          ? null
+          : ack,
+      )
+  }
+  function chooseCompany(id: string) {
+    const company = shipment?.companies.find(
+      (c) => c.id === id && c.clientId === form.state.values.clientId,
+    )
+    change('companyId', id)
+    const replace = () => {
+      change('shipper', company?.shipper ?? '')
+      shipperBaseline.current = company?.shipper ?? ''
+      shipperPrefillAccepted.current = true
+    }
+    if (
+      form.state.values.shipper !== shipperBaseline.current ||
+      (!shipperPrefillAccepted.current &&
+        form.state.values.shipper !==
+          shipment?.companies.find((c) => c.id === record.values.companyId)
+            ?.shipper)
+    )
+      ask('shipper', replace)
+    else replace()
+  }
+  function select(next: Selection) {
+    setSelection(next)
+    current.current.selection = next
+    invalidate()
+    void evaluate(next)
+  }
+  function order(id: string) {
+    const rows =
+      shipment?.orders
+        .find((o) => o.id === id)
+        ?.rows.filter((r) => !r.ineligibleReason)
+        .map((r) => r.id) ?? []
+    select(toggleOrder(selection, id, rows))
+  }
+  function row(id: string, rowId: string) {
+    const rows =
+      shipment?.orders
+        .find((o) => o.id === id)
+        ?.rows.filter((r) => !r.ineligibleReason)
+        .map((r) => r.id) ?? []
+    select(toggleRow(selection, id, rowId, rows))
+  }
+  function confirmReviewed() {
+    if (evaluating || reading || !review.canConfirm || !readValid) return
+    localAck.current = review.revision
+    setAck(review.revision)
+    setDirty(true)
+  }
+  function adopt(next: InvoiceRecordView) {
+    generation.current++
+    evaluationGeneration.current++
+    acknowledgedRead.current = callbacks.current.state
+    externalRevision.current = next.revision
+    shipperPrefillAccepted.current = false
+    setRecord(next)
+    form.reset(structuredClone(next.values))
+    setSelection(next.selection)
+    current.current.selection = next.selection
+    setEditing(false)
+    setReplacing(false)
+    setDirty(false)
+    setWarnings([])
+    setReview(next.review)
+    setAck(next.review.confirmedRevision)
+    localAck.current = null
+    reviewInvalidated.current = false
+    setError(null)
+    setConflict(false)
+    setUncertain(false)
+    setReading(false)
+    setEvaluating(false)
+    setBusy(false)
+    shipperBaseline.current = next.values.shipper
+  }
+
+  return {
+    mutationPending,
+    readState,
+    replacing,
+    setReplacing,
+    adopt,
+    record,
+    setRecord,
+    editing,
+    setEditing,
+    dirty,
+    setDirty,
+    shipment,
+    setShipment,
