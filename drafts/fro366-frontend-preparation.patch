+import { useEffect, useRef, useState } from 'react'
+import { useLocale } from '#/app/providers/labels-provider'
+import { Button } from '#/components/ui/button'
+import { Alert } from '#/components/ui/alert'
+import { FormField, Textarea } from '#/components/ui/input'
+import { labelsFor } from '../create/labels'
+import { detailsLabelsFor } from '../details/labels'
+import {
+  InvoiceLifecycle,
+  type InvoiceViewState,
+  type InvoiceRecordView,
+  type ShipmentInvoiceDetailsProps,
+} from '../details/types'
+import { useInvoiceActions } from '../details/use-invoice-actions'
+import { ShipmentInvoiceLifecycleDialog } from './shipment-invoice-lifecycle-dialog'
+import { useInvoiceEditor } from '../details/use-invoice-editor'
+import { ShipmentInvoiceReadonly } from './shipment-invoice-readonly'
