+import { describe, expect, it } from 'vitest'
+import { toggleOrder, toggleRow, reconcileSelection } from './selection'
+describe('invoice selection identities', () => {
+  it('adds newest order first and deduplicates source rows', () => {
+    expect(
+      toggleOrder([{ orderId: 'A', rowIds: ['a'] }], 'B', ['b', 'b', 'c']),
+    ).toEqual([
+      { orderId: 'B', rowIds: ['b', 'c'] },
+      { orderId: 'A', rowIds: ['a'] },
+    ])
+  })
+  it('deselects a complete order', () => {
+    expect(toggleOrder([{ orderId: 'A', rowIds: ['a'] }], 'A', ['a'])).toEqual(
+      [],
+    )
+  })
+  it('preserves source row order on individual selection', () => {
+    expect(
+      toggleRow([{ orderId: 'A', rowIds: ['b'] }], 'A', 'a', ['a', 'b']),
+    ).toEqual([{ orderId: 'A', rowIds: ['a', 'b'] }])
+  })
+  it('never selects a row outside eligibility', () => {
+    expect(toggleRow([], 'A', 'x', ['a'])).toEqual([])
+  })
+  it('keeps eligible selections and reports removals without adding new rows', () => {
+    expect(
+      reconcileSelection([{ orderId: 'A', rowIds: ['a', 'b'] }], {
+        A: ['b', 'c'],
+      }),
+    ).toEqual({
+      selection: [{ orderId: 'A', rowIds: ['b'] }],
+      removed: [{ orderId: 'A', rowId: 'a' }],
+    })
+  })
+})
