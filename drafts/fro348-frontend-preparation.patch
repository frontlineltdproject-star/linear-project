+import { type ReactNode } from 'react'
+import { Card } from '#/components/ui/card'
+import { useSupplierInvoiceDetailLabels } from '../localization/supplier-invoice-detail-labels'
+
+export interface SupplierInvoiceVatSummaryProps {
+  stage:
+    'not-started' | 'in-progress' | 'exempted' | 'not-required' | 'historical'
+  savedStatus: string
+  dispatchDate: ReactNode
+  returnDate: ReactNode
+  sentDate: ReactNode
+  currentAction?: ReactNode
+  onwardAction?: ReactNode
+}
+export function SupplierInvoiceVatSummary(p: SupplierInvoiceVatSummaryProps) {
+  const text = useSupplierInvoiceDetailLabels()
+  const progress =
+    p.stage === 'not-started' ||
+    p.stage === 'in-progress' ||
+    p.stage === 'exempted'
+  const index = p.stage === 'exempted' ? 2 : p.stage === 'in-progress' ? 1 : 0
+  return (
+    <Card flush className="min-w-0 p-4 min-[701px]:p-5">
+      <section aria-label={text.vat}>
+        <h2 className="mb-5 text-subheading text-fg">{text.vat}</h2>
+        <div className="flex flex-wrap items-end justify-between gap-4">
+          <dl className="w-full min-w-0 max-w-[400px]">
+            <dt className="mb-1.5 text-xs text-fg-muted">{text.status}</dt>
+            <dd
+              className={
+                'min-h-10 break-words rounded-md border border-border px-3 py-2 text-sm font-semibold ' +
+                (p.stage === 'exempted'
+                  ? 'bg-success-subtle text-success-fg'
+                  : 'bg-canvas text-fg')
+              }
+            >
+              {p.savedStatus}
+            </dd>
+          </dl>
+          {progress && p.currentAction}
+        </div>
+        {progress && (
+          <>
+            <ol
+              aria-label={text.progress}
+              className="my-5 grid grid-cols-3 gap-3"
+            >
+              {[text.notStarted, text.inProgress, text.exempted].map(
+                (label, i) => (
+                  <li
+                    key={i}
+                    aria-current={i === index ? 'step' : undefined}
+                    className="min-w-0"
+                  >
+                    <span
+                      aria-hidden
+                      className={
+                        'mb-2 block h-1 rounded-full ' +
+                        (i <= index
+                          ? index === 2
+                            ? 'bg-success'
+                            : 'bg-accent'
+                          : 'bg-border')
+                      }
+                    />
+                    <span
+                      className={
+                        'block break-words text-xs ' +
+                        (i === index
+                          ? 'font-semibold text-fg'
+                          : 'text-fg-muted')
+                      }
+                    >
+                      {label}
+                    </span>
+                  </li>
+                ),
+              )}
+            </ol>
+            <dl className="grid grid-cols-1 items-stretch gap-x-7 gap-y-[18px] min-[701px]:grid-cols-2 min-[1101px]:grid-cols-3">
+              {[
+                [text.dispatchDate, p.dispatchDate],
+                [text.returnDate, p.returnDate],
+                [text.sentDate, p.sentDate],
+              ].map(([label, value], i) => (
+                <div key={i} className="flex min-w-0 flex-col">
+                  <dt className="mb-1.5 flex-1 text-xs text-fg-muted">
+                    {label}
+                  </dt>
+                  <dd className="min-h-10 break-words rounded-md border border-border bg-canvas px-3 py-2 font-mono text-sm text-fg">
+                    {value}
+                  </dd>
+                </div>
+              ))}
+            </dl>
+            {p.onwardAction && (
+              <div className="mt-5 flex justify-end max-[700px]:[&>*]:w-full">
+                {p.onwardAction}
+              </div>
+            )}
+          </>
+        )}
+      </section>
+    </Card>
+  )
+}
