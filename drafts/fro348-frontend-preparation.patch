+import { useEffect, useId, useRef, type ReactNode } from 'react'
+import { Modal } from '#/components/ui/modal'
+import { Button } from '#/components/ui/button'
+import { Alert } from '#/components/ui/alert'
+import { useSupplierInvoiceDetailLabels } from '../localization/supplier-invoice-detail-labels'
+
+export interface SupplierInvoiceConfirmationProps {
+  open: boolean
+  kind: 'cancel' | 'dispatch' | 'return' | 'send'
+  identity: string
+  body: ReactNode
+  fields?: ReactNode
+  eligible: boolean
+  disabledReason?: ReactNode
+  outcome: 'idle' | 'pending' | 'rejected' | 'stale' | 'unknown'
+  feedback?: ReactNode
+  onClose: () => void
+  onConfirm: () => void
+  onCheckAttempt?: () => void
+}
+export function SupplierInvoiceConfirmation(
+  p: SupplierInvoiceConfirmationProps,
+) {
+  const text = useSupplierInvoiceDetailLabels()
+  const titleId = useId()
+  const titleRef = useRef<HTMLSpanElement>(null)
+  useEffect(() => {
+    if (!p.open) return
+    const dialog = titleRef.current?.closest('[role=dialog]')
+    dialog?.setAttribute('aria-labelledby', titleId)
+    return () => {
+      if (dialog?.getAttribute('aria-labelledby') === titleId)
+        dialog.removeAttribute('aria-labelledby')
+    }
+  }, [p.open, titleId])
+  const titles = {
+    cancel: text.cancelInvoice,
+    dispatch: text.dispatch,
+    return: text.return,
+    send: text.send,
+  }
+  const blocked = p.outcome !== 'idle' || !p.eligible
+  const close = () => {
+    if (p.outcome !== 'pending') p.onClose()
+  }
+  return (
+    <Modal
+      open={p.open}
+      className="max-h-[calc(100dvh-2rem)] overflow-y-auto"
+      onClose={close}
+      hideClose={p.outcome === 'pending'}
+      title={
+        <span ref={titleRef} id={titleId}>
+          {titles[p.kind]} · {p.identity}
+        </span>
+      }
+      footer={
+        <div className="flex w-full flex-wrap justify-end gap-2">
+          <Button
+            type="button"
+            variant="secondary"
+            disabled={p.outcome === 'pending'}
+            onClick={close}
+            className="h-auto min-h-10 whitespace-normal py-2"
+          >
+            {text.cancel}
+          </Button>
+          {p.outcome === 'unknown' ? (
+            p.onCheckAttempt && (
+              <Button
+                type="button"
+                onClick={p.onCheckAttempt}
+                className="h-auto min-h-10 whitespace-normal py-2"
+              >
+                {text.check}
+              </Button>
+            )
+          ) : (
+            <Button
+              type="button"
+              variant={p.kind === 'cancel' ? 'danger' : 'primary'}
+              loading={p.outcome === 'pending'}
+              disabled={blocked}
+              onClick={() => {
+                if (!blocked) p.onConfirm()
+              }}
+              className="h-auto min-h-10 whitespace-normal py-2"
+            >
+              {text.confirm}
+            </Button>
+          )}
+        </div>
+      }
+    >
+      <div className="min-w-0 space-y-4 break-words [overflow-wrap:anywhere]">
+        {p.body}
+        {p.kind === 'cancel' && <p>{text.retention}</p>}
+        {p.fields}
+        {p.disabledReason && <Alert tone="info">{p.disabledReason}</Alert>}
+        {p.outcome !== 'idle' && (
+          <Alert tone={p.outcome === 'rejected' ? 'danger' : 'warning'}>
+            {text[p.outcome]}
+          </Alert>
+        )}
+        {p.feedback && <div>{p.feedback}</div>}
+      </div>
+    </Modal>
+  )
+}
