+import { useEffect, useRef, type ReactNode, type KeyboardEvent } from 'react'
+import { Card } from '#/components/ui/card'
+import { TopBar } from '#/components/layout/top-bar'
+import { Badge } from '#/components/ui/badge'
+import { Button } from '#/components/ui/button'
+import { Tab, TabList, TabPanel, Tabs } from '#/components/ui/tabs'
+import { useSupplierInvoiceDetailLabels } from '../localization/supplier-invoice-detail-labels'
+
+export type DetailTab = 'overview' | 'export' | 'documents'
+export type DetailCard = 'order' | 'invoice'
+const orderKeys = ['stockId', 'client', 'invoiceCompany', 'supplier'] as const
+const invoiceKeys = [
+  'invoiceNumber',
+  'invoiceDate',
+  'expirationDate',
+  'currency',
+  'invoiceType',
+  'invoiceVessel',
+  'netValue',
+  'vatValue',
+] as const
+type FieldKey = (typeof orderKeys)[number] | (typeof invoiceKeys)[number]
+export type DetailField = { saved: ReactNode; editor?: ReactNode }
+export interface SupplierInvoiceDetailLayoutProps {
+  identity: string
+  cancelled: boolean
+  documentCount: number | null
+  tab: DetailTab
+  onTabChange: (tab: DetailTab) => void
+  fields: Record<FieldKey, DetailField>
+  entryNote: ReactNode
+  vat: ReactNode
+  recordManagement: ReactNode
+  relatedExport: ReactNode
+  documents: ReactNode
+  activeCard: DetailCard | null
+  canEditOrder: boolean
+  canEditInvoice: boolean
+  busy: boolean
+  unresolved: boolean
+  feedback?: ReactNode
+  onBeginEdit: (card: DetailCard) => void
+  onCancelEdit: () => void
+  onSaveEdit: () => void
+}
+const grid =
+  'grid grid-cols-1 gap-x-7 gap-y-[18px] min-[701px]:grid-cols-2 min-[1101px]:grid-cols-4'
+const padding = 'min-w-0 p-4 min-[701px]:p-5'
+const wrappingButton = 'h-auto min-h-10 whitespace-normal py-2 text-left'
+export function SupplierInvoiceDetailLayout(
+  p: SupplierInvoiceDetailLayoutProps,
+) {
+  const text = useSupplierInvoiceDetailLabels()
+  const tabsRef = useRef<HTMLDivElement>(null)
+  const orderEdit = useRef<HTMLButtonElement>(null)
+  const invoiceEdit = useRef<HTMLButtonElement>(null)
+  const previousCard = useRef(p.activeCard)
+  useEffect(() => {
+    tabsRef.current
+      ?.querySelectorAll<HTMLButtonElement>('[role=tab]')
+      .forEach((tab) => {
+        tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1
+      })
+  }, [p.tab])
+  useEffect(() => {
+    if (previousCard.current && !p.activeCard) {
+      ;(previousCard.current === 'order'
+        ? orderEdit
+        : invoiceEdit
+      ).current?.focus()
+    }
+    previousCard.current = p.activeCard
+  }, [p.activeCard])
+  function keyboardTabs(e: KeyboardEvent<HTMLDivElement>) {
+    if (
+      !(e.target instanceof HTMLElement) ||
+      e.target.getAttribute('role') !== 'tab'
+    )
+      return
+    const tabs = Array.from(
+      tabsRef.current?.querySelectorAll<HTMLButtonElement>('[role=tab]') ?? [],
+    )
+    const index = tabs.indexOf(e.target as HTMLButtonElement)
+    const next =
+      e.key === 'Home'
+        ? 0
+        : e.key === 'End'
+          ? tabs.length - 1
+          : e.key === 'ArrowRight'
+            ? (index + 1) % tabs.length
+            : e.key === 'ArrowLeft'
+              ? (index + tabs.length - 1) % tabs.length
+              : null
+    if (next === null) return
+    e.preventDefault()
+    tabs[next]?.click()
+    tabs[next]?.focus()
+  }
+  function card(card: DetailCard, keys: readonly FieldKey[]) {
+    const allowed = card === 'order' ? p.canEditOrder : p.canEditInvoice
+    const editing = p.activeCard === card && allowed && !p.cancelled
+    const locked = p.busy || p.unresolved || p.cancelled
+    return (
+      <Card flush className={padding}>
+        <section
+          aria-label={text[card]}
+          onKeyDown={(e) => {
+            if (
+              e.key === 'Escape' &&
+              !e.defaultPrevented &&
+              editing &&
+              !locked
+            ) {
+              e.stopPropagation()
+              p.onCancelEdit()
+            }
+          }}
+        >
+          <div className="mb-5 flex flex-wrap items-start justify-between gap-3">
+            <h2 className="text-subheading text-fg">{text[card]}</h2>
+            {allowed && !p.cancelled && !editing && (
+              <Button
+                type="button"
+                variant="ghost"
+                ref={card === 'order' ? orderEdit : invoiceEdit}
+                className={wrappingButton}
+                aria-label={
+                  card === 'order' ? text.editOrder : text.editInvoice
+                }
+                disabled={locked || p.activeCard !== null}
+                onClick={() => p.onBeginEdit(card)}
+              >
+                {text.edit}
+              </Button>
+            )}
+          </div>
+          <dl className={grid}>
+            {keys.map((key) => (
+              <div key={key} className="min-w-0">
+                <dt className="mb-1.5 text-xs text-fg-muted">{text[key]}</dt>
+                <dd className="min-w-0">
+                  {editing && p.fields[key].editor !== undefined ? (
+                    p.fields[key].editor
+                  ) : (
+                    <div
+                      className={
+                        'min-h-10 break-words rounded-md border border-border bg-canvas px-3 py-2 text-sm text-fg [overflow-wrap:anywhere]' +
+                        ([
+                          'stockId',
+                          'invoiceNumber',
+                          'invoiceDate',
+                          'expirationDate',
+                          'netValue',
+                          'vatValue',
+                        ].includes(key)
+                          ? ' font-mono'
+                          : '')
+                      }
+                    >
+                      {p.fields[key].saved}
+                    </div>
+                  )}
+                </dd>
+              </div>
+            ))}
+            {card === 'order' && (
+              <div className="min-w-0 min-[701px]:col-start-1">
+                <dt className="mb-1.5 text-xs text-fg-muted">
+                  {text.entryNote}
+                </dt>
+                <dd className="min-w-0 break-words">{p.entryNote}</dd>
+              </div>
+            )}
+          </dl>
+          {editing && (
+            <div className="mt-5 space-y-3">
+              {p.feedback}
+              <div className="flex flex-wrap justify-end gap-2">
+                <Button
+                  type="button"
+                  variant="secondary"
+                  className={wrappingButton}
+                  disabled={locked}
+                  onClick={p.onCancelEdit}
+                >
+                  {text.cancel}
+                </Button>
+                <Button
+                  type="button"
+                  className={wrappingButton}
+                  loading={p.busy}
+                  disabled={locked || !allowed}
+                  onClick={p.onSaveEdit}
+                >
+                  {text.save}
+                </Button>
+              </div>
+            </div>
+          )}
+        </section>
+      </Card>
+    )
+  }
+  return (
+    <div data-density="comfortable" className="space-y-5">
+      <Card flush className={padding + ' [&>div]:mb-0'}>
+        <TopBar
+          title={text.title + ' · ' + p.identity}
+          actions={
+            p.cancelled ? (
+              <Badge tone="danger">{text.cancelled}</Badge>
+            ) : undefined
+          }
+        />
+      </Card>
+      <Card flush className={padding}>
+        <div
+          ref={tabsRef}
+          onKeyDown={keyboardTabs}
+          className="min-w-0 overflow-x-auto"
+        >
+          <Tabs
+            defaultValue="overview"
+            value={p.tab}
+            onValueChange={(value) => p.onTabChange(value as DetailTab)}
+          >
+            <TabList className="min-w-max">
+              <Tab value="overview">{text.overview}</Tab>
+              <Tab value="export">{text.exportTab}</Tab>
+              <Tab value="documents">
+                {text.documents}
+                {p.documentCount !== null ? ' (' + p.documentCount + ')' : ''}
+              </Tab>
+            </TabList>
+            <TabPanel value="overview" className="space-y-5 pt-5">
+              {card('order', orderKeys)}
+              {card('invoice', invoiceKeys)}
+              {p.vat}
+              <section aria-label={text.management} className="min-w-0">
+                {p.recordManagement}
+              </section>
+            </TabPanel>
+            <TabPanel value="export" className="pt-5">
+              {p.relatedExport}
+            </TabPanel>
+            <TabPanel value="documents" className="pt-5">
+              {p.documents}
+            </TabPanel>
+          </Tabs>
+        </div>
+      </Card>
+    </div>
+  )
+}
