+import { type ReactNode } from 'react'
+import { Download } from 'lucide-react'
+import { Card } from '#/components/ui/card'
+import { Button } from '#/components/ui/button'
+import { Alert } from '#/components/ui/alert'
+import { Spinner, EmptyState } from '#/components/ui/feedback'
+import { useSupplierInvoiceDetailLabels } from '../localization/supplier-invoice-detail-labels'
+
+export interface SavedInvoiceDocument {
+  key: string
+  filename: string
+  metadata: ReactNode
+  onDownload?: () => void
+  downloading?: boolean
+}
+export type SupplierInvoiceSavedDocumentsState =
+  | { status: 'loading' | 'denied' | 'unavailable' }
+  | { status: 'error'; onRetry?: () => void }
+  | { status: 'ready'; documents: SavedInvoiceDocument[] }
+export function SupplierInvoiceSavedDocuments({
+  state,
+}: {
+  state: SupplierInvoiceSavedDocumentsState
+}) {
+  const text = useSupplierInvoiceDetailLabels()
+  if (state.status === 'loading')
+    return (
+      <div className="flex items-center gap-2 text-sm text-fg-muted">
+        <Spinner label={text.loading} />
+        <span>{text.loading}</span>
+      </div>
+    )
+  if (state.status !== 'ready')
+    return (
+      <Alert tone={state.status === 'error' ? 'danger' : 'info'}>
+        <div className="space-y-3">
+          <p>{state.status === 'error' ? text.error : text[state.status]}</p>
+          {state.status === 'error' && state.onRetry && (
+            <Button type="button" variant="secondary" onClick={state.onRetry}>
+              {text.retry}
+            </Button>
+          )}
+        </div>
+      </Alert>
+    )
+  if (!state.documents.length) return <EmptyState title={text.noDocuments} />
+  return (
+    <Card flush>
+      <ul className="divide-y divide-border">
+        {state.documents.map((file) => (
+          <li
+            key={file.key}
+            className="flex min-w-0 flex-wrap items-start justify-between gap-4 p-4 min-[701px]:p-5"
+          >
+            <div className="min-w-0 flex-1 basis-48">
+              <p className="break-words text-sm font-semibold text-fg [overflow-wrap:anywhere]">
+                {file.filename}
+              </p>
+              <div className="mt-1 break-words text-xs text-fg-muted [overflow-wrap:anywhere]">
+                {file.metadata}
+              </div>
+            </div>
+            {file.onDownload ? (
+              <Button
+                type="button"
+                variant="secondary"
+                leadingIcon={
+                  <Download className="size-4 shrink-0" aria-hidden />
+                }
+                aria-label={text.download + ' ' + file.filename}
+                loading={file.downloading}
+                onClick={file.onDownload}
+                className="h-auto min-h-10 whitespace-normal py-2"
+              >
+                {text.download}
+              </Button>
+            ) : (
+              <span className="text-xs text-fg-muted">
+                {text.downloadUnavailable}
+              </span>
+            )}
+          </li>
+        ))}
+      </ul>
+    </Card>
+  )
+}
