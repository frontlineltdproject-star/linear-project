+import { type ReactNode } from 'react'
+import { Alert } from '#/components/ui/alert'
+import { Button } from '#/components/ui/button'
+import { Spinner, EmptyState } from '#/components/ui/feedback'
+import { useSupplierInvoiceDetailLabels } from '../localization/supplier-invoice-detail-labels'
+
+export type SupplierInvoiceRelationshipState =
+  | { status: 'unavailable' | 'loading' | 'denied' | 'conflict' | 'absent' }
+  | { status: 'error'; onRetry?: () => void }
+  | { status: 'ready'; content: ReactNode }
+export interface SupplierInvoiceRelationshipProps {
+  kind: 'entry-note' | 'export'
+  state: SupplierInvoiceRelationshipState
+}
+export function SupplierInvoiceRelationship({
+  kind,
+  state,
+}: SupplierInvoiceRelationshipProps) {
+  const text = useSupplierInvoiceDetailLabels()
+  if (state.status === 'ready')
+    return (
+      <div className="min-w-0 break-words [overflow-wrap:anywhere]">
+        {state.content}
+      </div>
+    )
+  if (state.status === 'loading')
+    return (
+      <div className="flex items-center gap-2 text-sm text-fg-muted">
+        <Spinner label={text.loading} />
+        <span>{text.loading}</span>
+      </div>
+    )
+  if (state.status === 'absent')
+    return (
+      <EmptyState
+        title={kind === 'export' ? text.noExport : text.noEntryNote}
+      />
+    )
+  return (
+    <Alert
+      tone={
+        state.status === 'error'
+          ? 'danger'
+          : state.status === 'conflict'
+            ? 'warning'
+            : 'info'
+      }
+    >
+      <div className="space-y-3">
+        <p>{state.status === 'error' ? text.error : text[state.status]}</p>
+        {state.status === 'error' && state.onRetry && (
+          <Button type="button" variant="secondary" onClick={state.onRetry}>
+            {text.retry}
+          </Button>
+        )}
+      </div>
+    </Alert>
+  )
+}
