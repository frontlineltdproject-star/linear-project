+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  within,
+} from '@testing-library/react'
+import { useState } from 'react'
+import { LabelsProvider, useLocale } from '#/app/providers/labels-provider'
+import { Input } from '#/components/ui/input'
+import { SupplierInvoiceDetailLayout } from './supplier-invoice-detail-layout'
+import { SupplierInvoiceVatSummary } from './supplier-invoice-vat-summary'
+import { SupplierInvoiceConfirmation } from './supplier-invoice-confirmation'
+import { SupplierInvoiceRelationship } from './supplier-invoice-relationship'
+import { SupplierInvoiceSavedDocuments } from './supplier-invoice-saved-documents'
+
+afterEach(() => {
+  cleanup()
+  localStorage.clear()
+})
+const fieldNames = [
+  'stockId',
+  'client',
+  'invoiceCompany',
+  'supplier',
+  'invoiceNumber',
+  'invoiceDate',
+  'expirationDate',
+  'currency',
+  'invoiceType',
+  'invoiceVessel',
+  'netValue',
+  'vatValue',
+] as const
+const fields = Object.fromEntries(
+  fieldNames.map((key) => [key, { saved: key }]),
+) as Record<(typeof fieldNames)[number], { saved: string }>
+function baseProps() {
+  return {
+    identity: '42',
+    cancelled: false,
+    documentCount: null,
+    tab: 'overview' as const,
+    onTabChange: vi.fn(),
+    fields,
+    entryNote: 'Note context',
+    vat: 'Saved VAT',
+    recordManagement: 'Management',
+    relatedExport: 'Export context',
+    documents: 'Document context',
+    activeCard: null as 'invoice' | 'order' | null,
+    canEditOrder: true,
+    canEditInvoice: true,
+    busy: false,
+    unresolved: false,
+    onBeginEdit: vi.fn(),
+    onSaveEdit: vi.fn(),
+    onCancelEdit: vi.fn(),
+  }
+}
+function LocaleSwitch() {
+  const { setLocale } = useLocale()
+  return <button onClick={() => setLocale('el')}>EL</button>
+}
+describe('layout', () => {
+  it('retains exact caller-owned draft through tab and locale changes without saving', () => {
+    const save = vi.fn()
+    function Harness() {
+      const [tab, setTab] = useState<'overview' | 'export' | 'documents'>(
+        'overview',
+      )
+      const [number, setNumber] = useState('00042')
+      const [amount, setAmount] = useState('99999999999999999.99')
+      return (
+        <>
+          <LocaleSwitch />
+          <SupplierInvoiceDetailLayout
+            {...baseProps()}
+            tab={tab}
+            onTabChange={setTab}
+            activeCard="invoice"
+            onSaveEdit={save}
+            fields={{
+              ...fields,
+              invoiceNumber: {
+                saved: 'Saved 1',
+                editor: (
+                  <Input
+                    aria-label="Number"
+                    value={number}
+                    onChange={(e) => setNumber(e.target.value)}
+                  />
+                ),
+              },
+              netValue: {
+                saved: 'Saved 2',
+                editor: (
+                  <Input
+                    aria-label="Amount"
+                    value={amount}
+                    onChange={(e) => setAmount(e.target.value)}
+                  />
+                ),
+              },
+            }}
+          />
+        </>
+      )
+    }
+    render(
+      <LabelsProvider>
+        <Harness />
+      </LabelsProvider>,
+    )
+    fireEvent.change(screen.getByLabelText('Number'), {
+      target: { value: '00043' },
+    })
+    fireEvent.click(screen.getByRole('tab', { name: /Documents/ }))
+    expect(screen.queryByLabelText('Number')).toBeNull()
+    fireEvent.click(screen.getByRole('tab', { name: 'Overview' }))
+    fireEvent.click(screen.getByText('EL'))
+    expect((screen.getByLabelText('Number') as HTMLInputElement).value).toBe(
+      '00043',
+    )
+    expect((screen.getByLabelText('Amount') as HTMLInputElement).value).toBe(
+      '99999999999999999.99',
+    )
+    expect(screen.getByText('Saved VAT')).toBeTruthy()
+    expect(save).not.toHaveBeenCalled()
+    expect(
+      screen.getByRole('tab', { name: /Έγγραφα/ }).textContent,
+    ).not.toContain('0')
+  })
+  it('locks competing editor and busy/unresolved/cancelled mutations', () => {
+    const props = baseProps()
+    const view = render(
+      <SupplierInvoiceDetailLayout {...props} activeCard="invoice" />,
+    )
+    expect(
+      (
+        screen.getByRole('button', {
+          name: 'Edit Order relationship',
+        }) as HTMLButtonElement
+      ).disabled,
+    ).toBe(true)
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+    expect(props.onCancelEdit).toHaveBeenCalledTimes(1)
+    expect(props.onSaveEdit).not.toHaveBeenCalled()
+    for (const extra of [
+      { busy: true },
+      { unresolved: true },
+      { cancelled: true },
+    ]) {
+      view.rerender(
+        <SupplierInvoiceDetailLayout
+          {...props}
+          activeCard="invoice"
+          {...extra}
+        />,
+      )
+      const save = screen.queryByRole('button', { name: 'Save' })
+      if (save) fireEvent.click(save)
+      for (const edit of screen.queryAllByRole('button', { name: /^Edit / }))
+        fireEvent.click(edit)
+    }
+    expect(props.onSaveEdit).not.toHaveBeenCalled()
+    expect(props.onBeginEdit).not.toHaveBeenCalled()
+    view.rerender(
+      <SupplierInvoiceDetailLayout
+        {...props}
+        activeCard="invoice"
+        canEditInvoice={false}
+      />,
+    )
+    expect(screen.queryByRole('button', { name: 'Save' })).toBeNull()
+  })
+  it('supports keyboard tabs with selection and focus', () => {
+    function Harness() {
+      const [tab, setTab] = useState<'overview' | 'export' | 'documents'>(
+        'overview',
+      )
+      return (
+        <SupplierInvoiceDetailLayout
+          {...baseProps()}
+          tab={tab}
+          onTabChange={setTab}
+        />
+      )
+    }
+    render(<Harness />)
+    const overview = screen.getByRole('tab', { name: 'Overview' })
+    overview.focus()
+    fireEvent.keyDown(overview, { key: 'ArrowRight' })
