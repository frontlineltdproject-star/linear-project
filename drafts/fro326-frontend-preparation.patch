+    fireEvent.click(internal.getByRole('button', { name: 'Edit' }))
+    fireEvent.click(external.getByRole('button', { name: 'Edit' }))
+    fireEvent.change(internal.getByRole('textbox'), {
+      target: { value: '  new internal  ' },
+    })
+    fireEvent.change(external.getByRole('textbox'), {
+      target: { value: 'keep external draft' },
