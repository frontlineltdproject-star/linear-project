+// UI draft values only. These are not GraphQL inputs or transport contracts.
+export type OrderDraftValues = Record<string, string>
+export type SavedOrderUiRow = {
+  id: string
+  revision: string
+  values: OrderDraftValues
+  terminal?: string
+}
+
+export function invoiceTotal(quantity: string, price: string): string | null {
+  if (
+    !/^\d+$/.test(quantity) ||
+    !/^\d+(\.\d{1,2})?$/.test(price) ||
+    quantity.length > 10 ||
+    price.length > 20
+  )
+    return null
+  const count = BigInt(quantity)
+  if (count < 1n || count > 2147483647n) return null
+  const [whole, fraction = ''] = price.split('.')
+  const cents = BigInt(whole) * 100n + BigInt(fraction.padEnd(2, '0'))
+  const maximum = 9999999999999999999n
+  const total = count * cents
+  if (cents > maximum || total > maximum) return null
+  return `${total / 100n}.${String(total % 100n).padStart(2, '0')}`
+}
+
+export function copyColliDraft(values: OrderDraftValues): OrderDraftValues {
+  return Object.fromEntries(
+    [
+      'description',
+      'packageType',
+      'length',
+      'width',
+      'height',
+      'gross',
+      'net',
+      'dg',
+      'fragile',
+      'unpacked',
+      'damagedPacking',
+      'dgClass',
+      'dgText',
+    ]
+      .filter((key) => key in values)
+      .map((key) => [key, values[key]]),
+  )
+}
