+import { useEffect, useRef, useState, type ReactNode } from 'react'
+import { Button } from '#/components/ui/button'
+import { Card } from '#/components/ui/card'
+import { Modal } from '#/components/ui/modal'
+import { PurchaseOrderActionHelp } from './purchase-order-action-help'
+import { useOrderUiText, type UiText } from './order-ui-fields'
+
+export type EmailIntent = 'request' | 'confirm'
+export type PreparedEmailView = {
+  reference: string
+  recipient: string
+  subject: string
+  body: string
+}
+export type EmailAvailability = { allowed: boolean; reason: string }
+export function OrderReviewedEmails({
+  contextKey,
+  visible,
+  availability,
+  onPrepare,
+  onSend,
+  children,
+}: {
+  contextKey: string
+  visible: boolean
+  availability: Record<EmailIntent, EmailAvailability>
+  onPrepare: (intent: EmailIntent) => Promise<PreparedEmailView>
+  onSend: (preparation: PreparedEmailView) => Promise<void>
+  children: (slots: { buttons: ReactNode; cards: ReactNode }) => ReactNode
+}) {
+  const t = useOrderUiText()
+  const [review, setReview] = useState<{
+    message: PreparedEmailView
+    intent: EmailIntent
+    context: string
+  } | null>(null)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState('')
+  const source = useRef<HTMLElement | null>(null)
+  const context = useRef(contextKey)
+  context.current = contextKey
+  const title: Record<EmailIntent, UiText> = {
+    request: ['Request readiness date', 'Αίτημα ημερομηνίας ετοιμότητας'],
+    confirm: ['Confirm readiness date', 'Επιβεβαίωση ημερομηνίας ετοιμότητας'],
+  }
+  useEffect(() => {
+    setReview(null)
+  }, [contextKey])
+  const close = () => {
+    if (pending) return
+    setReview(null)
+    setError('')
+    requestAnimationFrame(() => source.current?.focus())
+  }
+  const prepare = async (intent: EmailIntent) => {
+    if (pending || !visible || !availability[intent].allowed) return
+    source.current = document.activeElement as HTMLElement
+    const key = contextKey
+    setPending(true)
+    setError('')
+    try {
+      const message = await onPrepare(intent)
+      if (context.current === key) setReview({ message, intent, context: key })
+      else
+        setError(
+          t([
+            'The context changed. Prepare the message again.',
+            'Τα στοιχεία άλλαξαν. Προετοιμάστε ξανά το μήνυμα.',
+          ]),
+        )
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : t(['Preparation failed.', 'Η προετοιμασία απέτυχε.']),
+      )
+    } finally {
+      setPending(false)
+    }
+  }
+  const send = async () => {
+    if (
+      !review ||
+      pending ||
+      !visible ||
+      contextKey !== review.context ||
+      !availability[review.intent].allowed
+    )
+      return
+    setPending(true)
+    setError('')
+    try {
+      await onSend(review.message)
+      setReview(null)
+      requestAnimationFrame(() => source.current?.focus())
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : t(['Send failed.', 'Η αποστολή απέτυχε.']),
+      )
+    } finally {
+      setPending(false)
+    }
+  }
+  const button = (intent: EmailIntent, compact: boolean) => (
+    <div className="flex items-center gap-1">
+      <Button
+        variant="secondary"
+        className="h-auto min-h-10 whitespace-normal py-2 text-left"
+        disabled={pending || !availability[intent].allowed}
+        onClick={() => void prepare(intent)}
+      >
+        {t(title[intent])}
+      </Button>
+      {compact && !availability[intent].allowed && (
+        <PurchaseOrderActionHelp reason={availability[intent].reason} />
+      )}
+    </div>
+  )
+  const buttons = visible ? (
+    <div className="flex flex-wrap gap-2">
+      {button('request', true)}
+      {button('confirm', true)}
+    </div>
+  ) : null
+  const cards = visible ? (
+    <>
+      {(['request', 'confirm'] as const).map((intent) => (
+        <Card key={intent} className="space-y-3">
+          <h3 className="text-subheading">{t(title[intent])}</h3>
+          {button(intent, false)}
+          {!availability[intent].allowed && (
+            <p className="text-sm text-fg-muted">
+              {availability[intent].reason}
+            </p>
+          )}
+        </Card>
+      ))}
+    </>
+  ) : null
+  return (
+    <>
+      {children({ buttons, cards })}
+      {error && (
+        <p role="alert" className="mt-3 text-danger-fg">
+          {error}
+        </p>
+      )}
+      <Modal
+        open={!!review}
+        onClose={close}
+        title={t(['Review supplier email', 'Έλεγχος email προμηθευτή'])}
+        ariaLabel={t(['Review supplier email', 'Έλεγχος email προμηθευτή'])}
+        size="xl"
+        footer={
+          <>
+            <Button disabled={pending} variant="secondary" onClick={close}>
+              {t(['Cancel', 'Ακύρωση'])}
+            </Button>
+            <Button
+              loading={pending}
+              disabled={
+                !review || !visible || !availability[review.intent].allowed
+              }
+              onClick={() => void send()}
+            >
+              {t(['Send', 'Αποστολή'])}
+            </Button>
+          </>
+        }
+      >
+        <dl className="max-h-[60vh] space-y-3 overflow-y-auto">
+          <dt className="font-semibold">{t(['Recipient', 'Παραλήπτης'])}</dt>
+          <dd>{review?.message.recipient}</dd>
+          <dt className="font-semibold">{t(['Subject', 'Θέμα'])}</dt>
+          <dd>{review?.message.subject}</dd>
+          <dt className="font-semibold">{t(['Message', 'Μήνυμα'])}</dt>
+          <dd className="whitespace-pre-wrap break-words">
+            {review?.message.body}
+          </dd>
+        </dl>
+        {error && (
+          <p role="alert" className="text-danger-fg">
+            {error}
+          </p>
+        )}
+      </Modal>
+    </>
+  )
+}
+
+export type DocumentActionView = {
+  state: 'loading' | 'error' | 'denied' | 'create' | 'open' | 'disabled'
+  reason?: string
+  owner?: string
+}
+export function OrderDocumentAction({
+  kind,
+  view,
+  onRetry,
+  onNavigate,
+}: {
+  kind: 'invoice' | 'entry'
+  view: DocumentActionView
+  onRetry: () => void
+  onNavigate: () => void
+}) {
+  const t = useOrderUiText()
+  if (view.state === 'denied') return null
+  const heading: UiText =
+    kind === 'invoice'
+      ? ['Create supplier invoice', 'Δημιουργία τιμολογίου προμηθευτή']
+      : ['Entry Note', 'Δελτίο Εισόδου']
+  const button: UiText =
+    kind === 'invoice'
+      ? heading
+      : view.state === 'open'
+        ? ['Open Entry Note', 'Άνοιγμα Δελτίου Εισόδου']
+        : ['Create Entry Note', 'Δημιουργία Δελτίου Εισόδου']
+  return (
+    <Card className="space-y-3">
+      <h3 className="text-subheading">{t(heading)}</h3>
+      {view.state === 'loading' ? (
+        <p role="status">{t(['Loading…', 'Φόρτωση…'])}</p>
+      ) : view.state === 'error' ? (
+        <>
+          <p role="alert">{view.reason}</p>
+          <Button variant="secondary" onClick={onRetry}>
+            {t(['Retry', 'Επανάληψη'])}
+          </Button>
+        </>
+      ) : (
+        <Button
+          variant="secondary"
+          disabled={view.state === 'disabled'}
+          onClick={onNavigate}
+        >
+          {t(button)}
+        </Button>
+      )}
+      {view.owner && (
+        <p className="text-sm">
+          {t(['Owning Order', 'Παραγγελία προέλευσης'])}: {view.owner}
+        </p>
+      )}
+      {view.reason && view.state !== 'error' && (
+        <p className="text-sm text-fg-muted">{view.reason}</p>
+      )}
+    </Card>
+  )
+}
