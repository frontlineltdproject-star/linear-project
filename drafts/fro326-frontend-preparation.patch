+import { describe, expect, it } from 'vitest'
+import { copyColliDraft, invoiceTotal } from './order-ui-values'
+describe('Order UI drafts', () => {
+  it('calculates exact cents without floating point and checks price/product capacity', () => {
+    expect(invoiceTotal('3', '0.10')).toBe('0.30')
+    expect(invoiceTotal('1', '99999999999999999.99')).toBe(
+      '99999999999999999.99',
+    )
+    expect(invoiceTotal('2', '99999999999999999.99')).toBeNull()
+    expect(invoiceTotal('1', '0')).toBe('0.00')
+    for (const [q, p] of [
+      ['1', ''],
+      ['0', '1'],
+      ['1.5', '1'],
+      ['1', '1.001'],
+      ['2147483648', '1'],
+      ['1', '-1'],
+    ])
+      expect(invoiceTotal(q, p)).toBeNull()
+  })
+  it('copies only editable colli values and never identity, custody or retired fields', () => {
+    const source = {
+      description: 'parts',
+      packageType: 'PALLET',
+      length: '10',
+      dg: 'true',
+      dgClass: 'FLAMMABLE_LIQUIDS',
+      dgText: 'UN fixture',
+      id: '42',
+      trackingCode: 'HU42',
+      pcs: '4',
+      notes: 'private',
+      revision: '9',
+      terminal: 'DAMAGED',
+      warehouse: 'W1',
+    }
+    const copy = copyColliDraft(source)
+    expect(copy.description).toBe('parts')
+    expect(copy.dgText).toBe('UN fixture')
+    for (const key of [
+      'id',
+      'trackingCode',
+      'pcs',
+      'notes',
+      'revision',
+      'terminal',
+      'warehouse',
+    ])
+      expect(copy[key]).toBeUndefined()
+  })
+})
