+                        </Badge>
+                      )}
+                    </div>
+                  </TD>
+                </TR>
+                {expanded && (
+                  <TR>
+                    <TD colSpan={6} className="!p-0">
+                      <div
+                        id={`colli-details-${id}`}
+                        role="region"
+                        aria-label={`${text.colliDetails} ${unit.trackingCode}`}
+                        className="sticky left-0 w-[calc(100vw-5rem)] max-w-full space-y-4 bg-surface-2 p-4 sm:static sm:w-auto"
+                      >
+                        <dl className="grid gap-4 sm:grid-cols-2">
+                          <div>
+                            <dt className="text-xs font-medium text-fg-muted">
+                              {text.description}
+                            </dt>
+                            <dd className="mt-1 whitespace-pre-wrap break-words text-sm">
+                              {unit.setDescription || text.noDescription}
+                            </dd>
+                          </div>
+                          <div>
+                            <dt className="text-xs font-medium text-fg-muted">
+                              {text.packageType}
+                            </dt>
+                            <dd className="mt-1 text-sm">
+                              {enumLabel(unit.packageType)}
+                            </dd>
+                          </div>
+                        </dl>
+                        {unit.dangerousGoods && (
+                          <dl className="border-t border-border pt-4">
+                            <dt className="text-xs font-medium text-fg-muted">
+                              {text.dgClass}
+                            </dt>
+                            <dd className="mt-1 text-sm">
+                              {enumLabel(unit.dangerousGoodsClass)}
+                            </dd>
+                          </dl>
+                        )}
+                      </div>
+                    </TD>
+                  </TR>
+                )}
+              </Fragment>
+            )
+          })}
+        </TBody>
+      </Table>
+    </div>
+  )
+}
