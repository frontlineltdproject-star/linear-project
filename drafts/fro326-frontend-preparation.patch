+            t([
+              'This operation is no longer available. Cancel and review the current rows.',
+              'Η ενέργεια δεν είναι πλέον διαθέσιμη. Ακυρώστε και ελέγξτε τις τρέχουσες γραμμές.',
+            ]),
+          )
+        if (!reason.trim())
+          throw new Error(t(['Reason is required.', 'Απαιτείται αιτιολογία.']))
+        await props.onOperation(
+          operation,
+          selectedRows.map((r) => r.id),
+          reason.trim(),
+          disposition,
+        )
+        setOperation(null)
+        setReason('')
+        setSelected(new Set())
+      }
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : t(['Operation failed.', 'Η ενέργεια απέτυχε.']),
+      )
+    } finally {
+      setPending(false)
+    }
+  }
+  const columns: UiText[] =
+    props.kind === 'colli'
+      ? [
+          ['Selection', 'Επιλογή'],
+          ['Colli', 'Κόλλι'],
+          ['Flags', 'Ενδείξεις'],
+          ['Dimensions (cm)', 'Διαστάσεις (cm)'],
+          ['Gross weight (kg)', 'Μικτό βάρος (kg)'],
+          ['Net weight (kg)', 'Καθαρό βάρος (kg)'],
+          ['Actions', 'Ενέργειες'],
+        ]
+      : [
+          ['Line', 'Γραμμή'],
+          ['Description', 'Περιγραφή'],
+          ['HS code', 'Κωδικός HS'],
+          ['Quantity', 'Ποσότητα'],
+          ['Unit', 'Μονάδα'],
+          ['Unit price', 'Τιμή μονάδας'],
+          ['Currency', 'Νόμισμα'],
+          ['Total value', 'Συνολική αξία'],
+          ['Actions', 'Ενέργειες'],
+        ]
+  return (
+    <Card className="space-y-4">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <h3 className="text-subheading">
+          {t(
+            props.kind === 'colli'
+              ? ['Collis', 'Κόλλι']
+              : ['Invoice rows', 'Γραμμές τιμολογίου'],
+          )}
+        </h3>
+        {props.editable && (
+          <div className="flex flex-wrap gap-2">
+            <Button variant="secondary" onClick={() => add()}>
+              {t(
+                props.kind === 'colli'
+                  ? ['Add colli', 'Προσθήκη κόλλι']
+                  : ['Add row', 'Προσθήκη γραμμής'],
+              )}
+            </Button>
+            {props.kind === 'colli' && (
+              <Button
+                variant="secondary"
+                disabled={!selectedRows.length}
+                onClick={() =>
+                  selectedRows.forEach((r) => add(copyColliDraft(r.values)))
+                }
+              >
+                {t(['Add identical', 'Προσθήκη ίδιων'])}
+              </Button>
+            )}
+          </div>
+        )}
+      </div>
+      <div className="overflow-x-auto">
+        <Table>
+          <THead>
+            <TR>
+              {columns.map((col) => (
+                <TH key={col[0]}>{t(col)}</TH>
+              ))}
+            </TR>
+          </THead>
+          <TBody>
+            {[...rows, ...newRows].map((row, index) => (
+              <EditableRow
+                key={row.id}
+                row={row}
+                index={index}
+                isNew={newRows.includes(row)}
+                {...props}
+                expanded={expanded.has(row.id)}
+                toggle={() =>
+                  setExpanded((current) => {
+                    const next = new Set(current)
+                    next.has(row.id) ? next.delete(row.id) : next.add(row.id)
+                    return next
+                  })
+                }
+                selected={selected.has(row.id)}
+                select={(checked) =>
+                  setSelected((current) => {
+                    const next = new Set(current)
+                    checked ? next.add(row.id) : next.delete(row.id)
+                    return next
+                  })
+                }
+                save={(values, revision) =>
+                  onSave(row, values, revision, newRows.includes(row))
+                }
+                discard={() => discard(row.id)}
+                remove={() => {
+                  setError('')
+                  setRemove(row)
+                }}
+                canRemove={props.kind === 'invoice' || active.length > 1}
+              />
+            ))}
+          </TBody>
+        </Table>
+      </div>
+      {!rows.length && !newRows.length && (
+        <p className="py-4 text-sm text-fg-muted">
+          {t(['No records.', 'Δεν υπάρχουν εγγραφές.'])}
+        </p>
+      )}
+      {props.kind === 'colli' && (props.canSplit || props.canDispose) && (
+        <div className="flex flex-wrap gap-2">
+          <Button
+            variant="secondary"
+            disabled={
+              !props.canSplit ||
+              active.length < 2 ||
+              !selectedRows.length ||
+              selectedRows.length >= active.length
+            }
+            onClick={() => {
+              setError('')
+              setReviewedRows(selectedRows)
+              setOperation('split')
+            }}
+          >
+            {t(['Split collis', 'Διαχωρισμός κόλλι'])}
+          </Button>
+          <Button
+            variant="secondary"
+            disabled={!props.canDispose || selectedRows.length !== 1}
+            onClick={() => {
+              setError('')
+              setReviewedRows(selectedRows)
+              setOperation('terminal')
+            }}
+          >
+            {t([
+              'Record terminal colli disposition',
+              'Καταγραφή οριστικής διάθεσης κόλλι',
+            ])}
+          </Button>
+          <Button variant="ghost" onClick={() => setSelected(new Set())}>
+            {t(['Clear', 'Καθαρισμός'])}
+          </Button>
+        </div>
+      )}
+      <Modal
+        open={!!remove || !!operation}
+        onClose={() => {
+          if (!pending) {
+            setRemove(null)
+            setOperation(null)
+            setReason('')
+            setError('')
+          }
+        }}
+        title={t(
+          remove
+            ? ['Remove record?', 'Αφαίρεση εγγραφής;']
+            : ['Review operation', 'Έλεγχος ενέργειας'],
+        )}
+        ariaLabel={t(['Review operation', 'Έλεγχος ενέργειας'])}
+        footer={
+          <>
+            <Button
+              variant="secondary"
+              disabled={pending}
+              onClick={() => {
+                setRemove(null)
+                setOperation(null)
+                setReason('')
+              }}
+            >
+              {t(cancelText)}
+            </Button>
+            <Button loading={pending} onClick={() => void finishOperation()}>
+              {t(['Confirm', 'Επιβεβαίωση'])}
+            </Button>
+          </>
+        }
+      >
+        {remove ? (
+          <p>
+            {props.kind === 'colli'
+              ? t([
+                  'The saved colli remains in history as Cancelled.',
+                  'Το αποθηκευμένο κόλλι παραμένει στο ιστορικό ως ακυρωμένο.',
+                ])
