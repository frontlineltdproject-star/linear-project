+          packageType: 'CARDBOARD_BOX',
+          dangerousGoods: true,
+          dangerousGoodsClass: 'FLAMMABLE_LIQUIDS',
+          bonded: false,
+          declaredLengthCm: null,
+          declaredWidthCm: 30,
+          declaredHeightCm: 20,
+          declaredGrossWeightKg: 12,
+          declaredNetWeightKg: null,
+          terminalDisposition: null,
+        },
+        {
+          id: 102,
+          trackingCode: 'HU-102',
+          setDescription: 'Terminal spare',
+          packageType: 'PALLET',
+          dangerousGoods: false,
+          bonded: true,
+          terminalDisposition: { disposition: 'DAMAGED' },
+        },
+      ],
+    } as unknown as PurchaseOrder
+    const view = render(
+      <LabelsProvider>
+        <PurchaseOrderDetail purchaseOrder={record} />
+      </LabelsProvider>,
+    )
+    fireEvent.click(screen.getByRole('tab', { name: /Collis/ }))
+    fireEvent.click(screen.getByRole('button', { name: 'Expand HU-101' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Expand HU-102' }))
+    expect(screen.getByText('Engine spare')).toBeTruthy()
+    expect(screen.getByText('Terminal spare')).toBeTruthy()
+    expect(
+      screen.getByRole('link', { name: 'HU-101' }).getAttribute('href'),
+    ).toBe('/secured/handling-units/101')
+    expect(screen.getByText('Damaged')).toBeTruthy()
+    fireEvent.click(screen.getByRole('tab', { name: 'Overview' }))
+    fireEvent.click(screen.getByRole('tab', { name: /Collis/ }))
+    expect(
+      screen
+        .getByRole('button', { name: 'Collapse HU-101' })
+        .getAttribute('aria-expanded'),
+    ).toBe('true')
+    expect(screen.getByText('Terminal spare')).toBeTruthy()
+    view.rerender(
+      <LabelsProvider>
+        <PurchaseOrderDetail purchaseOrder={{ ...record, id: 43 }} />
+      </LabelsProvider>,
+    )
+    fireEvent.click(screen.getByRole('tab', { name: /Collis/ }))
+    expect(screen.queryByText('Engine spare')).toBeNull()
+    expect(screen.getByRole('button', { name: 'Expand HU-101' })).toBeTruthy()
+  })
+})
