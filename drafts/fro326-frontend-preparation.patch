+import { useEffect, useRef, useState, type ReactNode } from 'react'
+import { useAppForm } from '#/components/form'
+import { Card } from '#/components/ui/card'
+import { Button } from '#/components/ui/button'
+import { Modal } from '#/components/ui/modal'
+import { FormField, Textarea } from '#/components/ui/input'
+import { Select } from '#/components/ui/select'
+import {
+  OrderUiControl,
+  cancelText,
+  editText,
+  fieldsError,
+  saveText,
+  useOrderUiText,
+  type OrderUiField,
+  type UiText,
+} from './order-ui-fields'
+import type { OrderDraftValues } from './order-ui-values'
+
+export type DetailsEditMode = 'ordinary' | 'invoiceCompany' | 'alk'
+export type DetailsUiSnapshot = { values: OrderDraftValues; revision: string }
+export type DetailsUiIntent = {
+  mode: DetailsEditMode
+  values: OrderDraftValues
+  reviewedRevision: string
+  reason: string
+}
+// Eligibility and impact are supplied by the eventual authorized adapter, never inferred here.
+export type OrderDetailsEditorProps = {
+  saved: DetailsUiSnapshot
+  fields: OrderUiField[]
+  modes: DetailsEditMode[]
+  status: ReactNode
+  correctionAllowed: boolean
+  onReview: (
+    intent: DetailsUiIntent,
+  ) => Promise<{ summary: string; token: string }>
+  onConfirm: (
+    intent: DetailsUiIntent,
+    reviewToken: string,
+  ) => Promise<DetailsUiSnapshot>
+  onDraftChange?: (active: boolean) => void
+}
+const modeLabels: Record<DetailsEditMode, UiText> = {
+  ordinary: ['Order details', 'Στοιχεία παραγγελίας'],
+  invoiceCompany: [
+    'Invoice company correction',
+    'Διόρθωση εταιρείας τιμολόγησης',
+  ],
+  alk: ['ΑΛΚ correction', 'Διόρθωση ΑΛΚ'],
+}
+export function OrderDetailsEditor(props: OrderDetailsEditorProps) {
+  const t = useOrderUiText()
+  const [saved, setSaved] = useState(props.saved)
+  const [mode, setMode] = useState<DetailsEditMode | null>(null)
+  const [choose, setChoose] = useState(false)
+  const [revision, setRevision] = useState(props.saved.revision)
+  const [error, setError] = useState('')
+  const [pending, setPending] = useState(false)
+  const [review, setReview] = useState<{
+    intent: DetailsUiIntent
+    summary: string
+    token: string
+  } | null>(null)
+  const editRef = useRef<HTMLButtonElement>(null)
+  const draftCallback = useRef(props.onDraftChange)
+  draftCallback.current = props.onDraftChange
+  useEffect(() => setSaved(props.saved), [props.saved])
+  useEffect(() => {
+    draftCallback.current?.(mode !== null)
+    return () => draftCallback.current?.(false)
+  }, [mode])
+  const close = () => {
+    if (pending) return
+    setMode(null)
+    setReview(null)
+    setError('')
+    requestAnimationFrame(() => editRef.current?.focus())
+  }
+  const success = (result: DetailsUiSnapshot) => {
+    setSaved(result)
+    setMode(null)
+    setReview(null)
+    setError('')
+    requestAnimationFrame(() => editRef.current?.focus())
+  }
+  const form = useAppForm({
+    defaultValues: props.saved.values,
+    onSubmit: async ({ value }) => {
+      if (!mode || pending || !props.modes.includes(mode)) return
+      if (saved.revision !== revision) {
+        setError(
+          t([
+            'This Order changed. Cancel and reopen to review the latest values. Your draft remains here.',
+            'Η παραγγελία άλλαξε. Ακυρώστε και ανοίξτε ξανά για έλεγχο. Το πρόχειρο παραμένει εδώ.',
+          ]),
+        )
+        return
+      }
+      const activeFields = props.fields.filter(
+        (f) => mode === 'ordinary' || f.key === mode,
+      )
+      const invalid = fieldsError(activeFields, value)
+      if (invalid) {
+        setError(t(invalid))
+        return
+      }
+      if (value.alk && !/^\d{1,50}$/.test(value.alk)) {
+        setError(
+          t([
+            'ΑΛΚ must contain up to 50 digits.',
+            'Το ΑΛΚ απαιτεί έως 50 ψηφία.',
+          ]),
+        )
+        return
+      }
+      const correction =
+        mode === 'ordinary' && value.status !== saved.values.status
+      if (
+        correction &&
+        (!props.correctionAllowed ||
+          !['PENDING', 'EXPECTED_READINESS', 'READY'].includes(value.status))
+      ) {
+        setError(
+          t([
+            'Readiness correction is unavailable.',
+            'Η διόρθωση ετοιμότητας δεν είναι διαθέσιμη.',
+          ]),
+        )
+        return
+      }
+      if (
+        correction &&
+        (!value.reason?.trim() ||
+          value.reason.length > 1000 ||
+          (value.status === 'EXPECTED_READINESS' && !value.readinessDate))
+      ) {
+        setError(
+          t([
+            'Provide a correction reason and the required readiness date.',
+            'Συμπληρώστε αιτιολογία διόρθωσης και την απαιτούμενη ημερομηνία.',
+          ]),
+        )
+        return
+      }
+      const values =
+        mode === 'ordinary' ? { ...value } : { [mode]: value[mode] }
+      const intent: DetailsUiIntent = {
+        mode,
+        values,
+        reviewedRevision: revision,
+        reason: correction ? value.reason.trim() : '',
+      }
+      setPending(true)
+      setError('')
+      try {
+        // Review is requested for every save: unchanged status does not waive fiscal/customs impacts.
+        const result = await props.onReview(intent)
+        setReview({ ...result, intent })
+      } catch (e) {
+        setError(
+          e instanceof Error
+            ? e.message
+            : t(['Review failed.', 'Ο έλεγχος απέτυχε.']),
+        )
+      } finally {
+        setPending(false)
+      }
+    },
+  })
+  const start = (next: DetailsEditMode) => {
+    form.reset({ ...saved.values, reason: '' })
+    setRevision(saved.revision)
+    setMode(next)
+    setChoose(false)
+    setError('')
+  }
+  const confirm = async () => {
+    if (!review || pending || !props.modes.includes(review.intent.mode)) return
+    if (saved.revision !== review.intent.reviewedRevision) {
+      setReview(null)
+      setError(
+        t([
+          'This Order changed. Cancel and reopen to review the latest values. Your draft remains here.',
+          'Η παραγγελία άλλαξε. Ακυρώστε και ανοίξτε ξανά για έλεγχο. Το πρόχειρο παραμένει εδώ.',
+        ]),
+      )
+      return
+    }
+    setPending(true)
+    setError('')
+    try {
+      success(await props.onConfirm(review.intent, review.token))
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : t([
+              'Save failed. Your draft is retained.',
+              'Η αποθήκευση απέτυχε. Το πρόχειρο διατηρείται.',
+            ]),
+      )
+      setReview(null)
+    } finally {
+      setPending(false)
+    }
+  }
+  return (
+    <Card className="space-y-5">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <h3 className="text-subheading">{t(modeLabels.ordinary)}</h3>
+        {!mode && props.modes.length > 0 && (
+          <Button
+            ref={editRef}
+            variant="secondary"
+            onClick={() =>
+              props.modes.length === 1 ? start(props.modes[0]) : setChoose(true)
+            }
+          >
+            {t(editText)}
+          </Button>
+        )}
+      </div>
+      {props.status}
+      <form.Subscribe selector={(state) => state.values}>
+        {(values) => (
+          <form
+            onSubmit={(e) => {
+              e.preventDefault()
+              void form.handleSubmit()
+            }}
+            onKeyDown={(e) => {
+              if (e.key === 'Escape' && !review) {
+                e.preventDefault()
+                close()
+              }
+            }}
+          >
+            <fieldset disabled={pending} className="space-y-4">
+              {mode && (
+                <p className="text-sm font-semibold">{t(modeLabels[mode])}</p>
+              )}
+              <div className="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
+                {props.fields
+                  .filter(
+                    (f) =>
+                      ![
+                        'regime',
+                        'alk',
+                        'urgent',
+                        'urgentInformation',
+                      ].includes(f.key),
+                  )
+                  .map((field) => (
+                    <OrderUiControl
+                      key={field.key}
+                      field={{
+                        ...field,
+                        readonly:
+                          field.readonly ||
+                          !mode ||
+                          (mode !== 'ordinary' && field.key !== mode),
+                      }}
+                      value={(mode ? values : saved.values)[field.key] ?? ''}
+                      onChange={(value) => {
+                        form.setFieldValue(field.key, value)
+                        setReview(null)
+                      }}
+                    />
+                  ))}
+              </div>
+              <div className="grid grid-cols-1 gap-4 border-y border-border py-4 md:grid-cols-2">
+                {props.fields
+                  .filter((f) => ['regime', 'alk'].includes(f.key))
+                  .map((field) => (
+                    <OrderUiControl
+                      key={field.key}
+                      field={{
+                        ...field,
+                        readonly:
+                          field.readonly ||
+                          !mode ||
+                          (mode !== 'ordinary' && field.key !== mode),
+                      }}
+                      value={(mode ? values : saved.values)[field.key] ?? ''}
+                      onChange={(value) => {
+                        form.setFieldValue(field.key, value)
+                        setReview(null)
+                      }}
+                    />
+                  ))}
+              </div>
+              {props.fields
+                .filter((f) => ['urgent', 'urgentInformation'].includes(f.key))
+                .map((field) => (
+                  <OrderUiControl
+                    key={field.key}
+                    field={{
+                      ...field,
+                      readonly: field.readonly || !mode || mode !== 'ordinary',
+                    }}
+                    disabled={!mode || mode !== 'ordinary'}
+                    value={(mode ? values : saved.values)[field.key] ?? ''}
+                    onChange={(value) => form.setFieldValue(field.key, value)}
+                  />
+                ))}
+              {mode === 'ordinary' && props.correctionAllowed && (
+                <div className="grid gap-4 rounded-md bg-surface-2 p-4 md:grid-cols-2">
+                  <FormField
+                    label={t(['Readiness status', 'Κατάσταση ετοιμότητας'])}
+                  >
+                    <Select
+                      aria-label={t([
+                        'Readiness status',
+                        'Κατάσταση ετοιμότητας',
+                      ])}
+                      value={values.status}
+                      onChange={(e) =>
+                        form.setFieldValue('status', e.target.value)
+                      }
+                    >
+                      {[
+                        [
+                          'PENDING',
+                          'Awaiting Readiness Date',
+                          'Αναμονή ημερομηνίας ετοιμότητας',
+                        ],
+                        [
+                          'EXPECTED_READINESS',
+                          'Received Readiness Date',
+                          'Λήφθηκε ημερομηνία ετοιμότητας',
+                        ],
+                        ['READY', 'Ready', 'Έτοιμο'],
+                      ].map(([key, en, el]) => (
+                        <option key={key} value={key}>
+                          {t([en, el])}
+                        </option>
+                      ))}
+                    </Select>
+                  </FormField>
+                  {values.status !== saved.values.status && (
+                    <>
+                      <FormField
+                        label={t(['Correction reason', 'Αιτιολογία διόρθωσης'])}
+                        required
+                      >
+                        <Textarea
+                          aria-label={t([
+                            'Correction reason',
+                            'Αιτιολογία διόρθωσης',
+                          ])}
+                          value={values.reason ?? ''}
+                          maxLength={1000}
+                          onChange={(e) =>
+                            form.setFieldValue('reason', e.target.value)
+                          }
+                        />
+                      </FormField>
+                      {values.status === 'EXPECTED_READINESS' && (
+                        <OrderUiControl
+                          field={{
+                            key: 'readinessDate',
+                            label: [
+                              'Corrected readiness date',
+                              'Διορθωμένη ημερομηνία ετοιμότητας',
+                            ],
+                            type: 'date',
+                            required: true,
+                          }}
+                          value={values.readinessDate ?? ''}
+                          onChange={(v) =>
+                            form.setFieldValue('readinessDate', v)
+                          }
+                        />
+                      )}
+                    </>
+                  )}
+                </div>
+              )}
+              {error && (
