+import { useEffect, useRef, useState } from 'react'
+import { useAppForm } from '#/components/form'
+import { useLocale } from '#/app/providers/labels-provider'
+import { Card } from '#/components/ui/card'
+import { Button } from '#/components/ui/button'
+import { Textarea } from '#/components/ui/input'
+
+export type NoteValue = { value: string; revision: string }
+export type NoteKind = 'internal' | 'external'
+export type OrderDetailsNotesProps = {
+  internal?: NoteValue
+  external: NoteValue
+  editable: boolean
+  onSave: (
+    kind: NoteKind,
+    value: string,
+    reviewedRevision: string,
+  ) => Promise<NoteValue>
+  onDraftChange?: (kind: NoteKind, active: boolean) => void
+}
+
+export function OrderDetailsNotes(props: OrderDetailsNotesProps) {
+  const { locale } = useLocale()
+  return (
+    <Card className="space-y-4">
+      <h3 className="text-subheading">
+        {locale === 'el' ? 'Σημειώσεις' : 'Notes'}
+      </h3>
+      {props.internal !== undefined && (
+        <NoteEditor {...props} kind="internal" saved={props.internal} />
+      )}
+      <NoteEditor {...props} kind="external" saved={props.external} />
+    </Card>
+  )
+}
+
+function NoteEditor({
+  kind,
+  saved,
+  editable,
+  onSave,
+  onDraftChange,
+}: OrderDetailsNotesProps & { kind: NoteKind; saved: NoteValue }) {
+  const { locale } = useLocale()
+  const t = (en: string, el: string) => (locale === 'el' ? el : en)
+  const label =
+    kind === 'internal'
+      ? t('Internal notes', 'Εσωτερικές σημειώσεις')
+      : t('External notes', 'Εξωτερικές σημειώσεις')
+  const [editing, setEditing] = useState(false)
+  const [canonical, setCanonical] = useState(saved)
+  const [reviewed, setReviewed] = useState(saved.revision)
+  const [error, setError] = useState('')
+  const [pending, setPending] = useState(false)
+  const editRef = useRef<HTMLButtonElement>(null)
+  const inputRef = useRef<HTMLTextAreaElement>(null)
+  const callback = useRef(onDraftChange)
+  callback.current = onDraftChange
+  useEffect(() => setCanonical(saved), [saved])
+  useEffect(() => {
+    callback.current?.(kind, editing)
+    return () => callback.current?.(kind, false)
+  }, [editing, kind])
+  useEffect(() => {
+    if (editing) inputRef.current?.focus()
+  }, [editing])
+  const close = () => {
+    if (pending) return
+    setEditing(false)
+    setError('')
+    requestAnimationFrame(() => editRef.current?.focus())
+  }
+  const form = useAppForm({
+    defaultValues: { value: saved.value },
+    onSubmit: async ({ value }) => {
+      if (pending || !editable) return
+      if (value.value.length > 2000) {
+        setError(t('Maximum 2,000 characters.', 'Μέγιστο 2.000 χαρακτήρες.'))
+        return
+      }
+      if (canonical.revision !== reviewed) {
+        setError(
+          t(
+            'The saved note changed. Review its latest value before retrying.',
+            'Η αποθηκευμένη σημείωση άλλαξε. Ελέγξτε τη νέα τιμή πριν προσπαθήσετε ξανά.',
+          ),
+        )
+        return
+      }
+      setPending(true)
+      setError('')
+      try {
+        const result = await onSave(kind, value.value.trim(), reviewed)
+        setCanonical(result)
+        setEditing(false)
+        requestAnimationFrame(() => editRef.current?.focus())
+      } catch (e) {
+        setError(
+          e instanceof Error
+            ? e.message
+            : t(
+                'Could not save. Your draft is retained.',
+                'Η αποθήκευση απέτυχε. Το πρόχειρο διατηρείται.',
+              ),
+        )
+      } finally {
+        setPending(false)
+      }
+    },
+  })
+  return (
+    <section
+      aria-label={label}
+      className="rounded-md border border-border bg-surface-2 p-4"
+    >
+      <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
+        <h4 className="text-xs font-semibold">{label}</h4>
+        {editable && !editing && (
+          <Button
+            ref={editRef}
+            variant="secondary"
+            size="sm"
+            onClick={() => {
+              form.reset({ value: canonical.value })
+              setReviewed(canonical.revision)
+              setEditing(true)
+            }}
+          >
+            {t('Edit', 'Επεξεργασία')}
+          </Button>
+        )}
+      </div>
+      {editing ? (
+        <form
+          onSubmit={(e) => {
+            e.preventDefault()
+            e.stopPropagation()
+            void form.handleSubmit()
+          }}
+          onKeyDown={(e) => {
+            if (e.key === 'Escape') {
+              e.preventDefault()
+              close()
+            }
+          }}
+        >
+          <fieldset disabled={pending || !editable} className="space-y-3">
+            <form.Field name="value">
+              {(field) => (
+                <Textarea
+                  ref={inputRef}
+                  aria-label={label}
+                  value={field.state.value}
+                  onChange={(e) => field.handleChange(e.target.value)}
+                  className="min-h-28"
+                />
+              )}
+            </form.Field>
+            {error && (
+              <p role="alert" className="text-sm text-danger-fg">
+                {error}
+              </p>
+            )}
+            {canonical.revision !== reviewed && (
+              <div className="space-y-2 rounded-md border border-warning p-3">
+                <p>{t('Latest saved value', 'Νεότερη αποθηκευμένη τιμή')}</p>
+                <p className="whitespace-pre-wrap break-words">
+                  {canonical.value || '—'}
+                </p>
+                <Button
+                  type="button"
+                  variant="secondary"
+                  onClick={() => {
+                    setReviewed(canonical.revision)
+                    setError('')
+                  }}
+                >
+                  {t(
+                    'Use this version and keep my draft',
+                    'Χρήση αυτής της έκδοσης και διατήρηση προχείρου',
+                  )}
+                </Button>
+              </div>
+            )}
+            <div className="flex justify-end gap-2">
+              <Button type="button" variant="secondary" onClick={close}>
+                {t('Cancel', 'Ακύρωση')}
+              </Button>
+              <Button type="submit" loading={pending}>
+                {t('Save', 'Αποθήκευση')}
+              </Button>
+            </div>
+          </fieldset>
+        </form>
+      ) : (
+        <p className="whitespace-pre-wrap break-words text-sm">
+          {canonical.value || '—'}
+        </p>
+      )}
+    </section>
+  )
+}
