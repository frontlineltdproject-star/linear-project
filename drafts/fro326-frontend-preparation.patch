+  const [error, setError] = useState('')
+  const nextId = useRef(1)
+  useEffect(() => setRows(props.rows), [props.rows])
+  const active = rows.filter((r) => !r.terminal)
+  const selectedRows = active.filter((r) => selected.has(r.id))
+  const add = (values = props.initialValues) => {
+    const id = `draft-${nextId.current++}`
+    setNewRows((current) => [
+      ...current,
+      { id, revision: '', values: { ...values } },
+    ])
+    setExpanded((current) => new Set([...current, id]))
+  }
+  const discard = (id: string) => {
+    setNewRows((current) => current.filter((r) => r.id !== id))
+    props.onDraftChange?.(id, false)
+  }
+  const onSave = async (
+    row: SavedOrderUiRow,
+    values: OrderDraftValues,
+    revision: string,
+    isNew: boolean,
+  ) => {
+    const saved = await props.onSave(isNew ? null : row.id, values, revision)
+    setRows((current) =>
+      isNew
+        ? [...current, saved]
+        : current.map((r) => (r.id === row.id ? saved : r)),
+    )
+    if (isNew) discard(row.id)
+    return saved
+  }
+  const finishOperation = async () => {
+    if (pending) return
+    setPending(true)
+    setError('')
+    try {
+      if (remove) {
+        const current = rows.find((r) => r.id === remove.id)
+        if (
+          !props.editable ||
+          !current ||
+          current.terminal ||
+          current.revision !== remove.revision ||
+          (props.kind === 'colli' && active.length <= 1)
