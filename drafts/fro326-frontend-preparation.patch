+
+export function PurchaseOrderCollis({ units, expandedIds, onToggle }: Props) {
+  const { text, enumLabel } = usePurchaseOrderLabels()
+  if (!units.length)
+    return <p className="text-sm text-fg-muted">{text.noCollis}</p>
+  return (
+    <div className="overflow-x-auto rounded-md border border-border">
+      <Table className="min-w-[660px]">
