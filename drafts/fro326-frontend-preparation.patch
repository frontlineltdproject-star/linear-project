+import { useEffect, useRef, useState } from 'react'
+import { Info } from 'lucide-react'
+import { Button } from '#/components/ui/button'
+import {
+  Popover,
+  PopoverContent,
+  PopoverTrigger,
+} from '#/components/ui/popover'
+import { usePurchaseOrderLabels } from '../localization/purchase-order-labels'
+
+export function PurchaseOrderActionHelp({ reason }: { reason: string }) {
+  const { text } = usePurchaseOrderLabels()
+  const [open, setOpen] = useState(false)
+  const closeTimer = useRef<ReturnType<typeof setTimeout> | undefined>(
+    undefined,
+  )
+  const pointerFocus = useRef(false)
+  const clearClose = () => clearTimeout(closeTimer.current)
+  const show = () => {
+    clearClose()
+    setOpen(true)
+  }
+  const hideLater = () => {
+    clearClose()
+    closeTimer.current = setTimeout(() => setOpen(false), 200)
+  }
+  useEffect(() => () => clearTimeout(closeTimer.current), [])
+  return (
+    <Popover open={open} onOpenChange={setOpen} placement="bottom-start">
+      <PopoverTrigger>
+        <Button
+          type="button"
+          variant="ghost"
+          className="w-10 shrink-0 px-0"
+          aria-label={text.actionUnavailableHelp}
+          onClick={show}
+          onMouseEnter={show}
+          onMouseLeave={hideLater}
+          onPointerDown={() => {
+            pointerFocus.current = true
+          }}
+          onFocus={() => {
+            if (!pointerFocus.current) show()
+          }}
+          onBlur={() => {
+            pointerFocus.current = false
+            hideLater()
+          }}
+        >
+          <Info className="size-4" aria-hidden />
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent className="max-w-[min(22rem,calc(100vw-2rem))]">
+        <p
+          className="p-2 text-sm"
+          onMouseEnter={clearClose}
+          onMouseLeave={hideLater}
+        >
+          {reason}
+        </p>
+      </PopoverContent>
+    </Popover>
+  )
+}
