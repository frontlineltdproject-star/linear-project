+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { LabelsProvider } from '#/app/providers/labels-provider'
+import {
+  OrderDetailsEditor,
+  type OrderDetailsEditorProps,
+} from './order-details-editor'
+afterEach(cleanup)
+const base: OrderDetailsEditorProps = {
+  saved: { revision: '1', values: { alk: '123', urgent: 'true' } },
+  fields: [
+    { key: 'alk', label: ['ΑΛΚ', 'ΑΛΚ'], readonly: true },
+    {
+      key: 'urgent',
+      label: ['Urgent', 'Επείγον'],
+      type: 'boolean',
+      readonly: true,
+    },
+  ],
+  modes: ['ordinary'],
+  status: null,
+  correctionAllowed: false,
+  onReview: async () => ({ summary: 'Reviewed', token: 't' }),
+  onConfirm: vi.fn(),
+}
+it('preserves adapter field locks when Details enters edit mode', () => {
+  render(
+    <LabelsProvider>
+      <OrderDetailsEditor {...base} />
+    </LabelsProvider>,
+  )
+  fireEvent.click(screen.getByRole('button', { name: 'Edit' }))
+  expect(screen.queryByRole('textbox', { name: 'ΑΛΚ' })).toBeNull()
+  expect(
+    (screen.getByRole('checkbox', { name: 'Urgent' }) as HTMLInputElement)
+      .disabled,
+  ).toBe(true)
+})
+it('does not confirm an obsolete review and retains the draft', async () => {
+  const confirm = vi.fn()
+  const props = {
+    ...base,
+    fields: [{ key: 'alk', label: ['ΑΛΚ', 'ΑΛΚ'] as [string, string] }],
+    onConfirm: confirm,
+  }
+  const view = render(
+    <LabelsProvider>
+      <OrderDetailsEditor {...props} />
+    </LabelsProvider>,
+  )
+  fireEvent.click(screen.getByRole('button', { name: 'Edit' }))
+  fireEvent.change(screen.getByRole('textbox', { name: 'ΑΛΚ' }), {
+    target: { value: '456' },
+  })
+  fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+  await screen.findByRole('button', { name: 'Confirm save' })
+  view.rerender(
+    <LabelsProvider>
+      <OrderDetailsEditor
+        {...props}
+        saved={{ revision: '2', values: { alk: '789' } }}
+      />
+    </LabelsProvider>,
+  )
+  fireEvent.click(screen.getByRole('button', { name: 'Confirm save' }))
+  await screen.findByRole('alert')
+  expect(confirm).not.toHaveBeenCalled()
+  expect(
+    (screen.getByRole('textbox', { name: 'ΑΛΚ' }) as HTMLInputElement).value,
+  ).toBe('456')
+})
