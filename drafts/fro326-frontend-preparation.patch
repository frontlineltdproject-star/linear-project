+              setFiles((current) => [
+                ...current,
+                ...Array.from(e.target.files ?? []).map((f) => f.name),
+              ])
+            }
+          />
+        </label>
+      )}
+      <div className="space-y-3 rounded-md border border-border bg-surface-2 p-4">
+        {!empty && (
+          <div>
+            <p>fixture-inherited-document.txt</p>
+            <p className="text-xs text-fg-muted">
+              {t([
+                'Inherited from PO-DEMO-ROOT · read-only',
+                'Από PO-DEMO-ROOT · μόνο ανάγνωση',
+              ])}
+            </p>
+            <Button
+              variant="ghost"
+              onClick={() =>
+                guard(() => {
+                  const link = document.createElement('a')
+                  link.href = URL.createObjectURL(
+                    new Blob(['Fictional document only'], {
+                      type: 'text/plain',
+                    }),
+                  )
+                  link.download = 'fixture-inherited-document.txt'
+                  link.click()
+                  URL.revokeObjectURL(link.href)
+                })
+              }
+            >
+              {t(['Download', 'Λήψη'])}
+            </Button>
+          </div>
+        )}
+        {files.map((name, i) => (
+          <div
+            key={`${name}-${i}`}
+            className="flex items-center justify-between gap-3"
+          >
+            <span className="break-all">{name}</span>
+            {editable && (
+              <Button
+                variant="ghost"
+                onClick={() =>
+                  setFiles((current) =>
+                    current.filter((_, index) => index !== i),
+                  )
+                }
+              >
+                {t(['Remove local selection', 'Αφαίρεση τοπικής επιλογής'])}
+              </Button>
+            )}
+          </div>
+        ))}
+        {empty && !files.length && <p>—</p>}
+      </div>
+    </Card>
+  )
+}
+
+if (
+  import.meta.env.DEV &&
+  ['127.0.0.1', 'localhost', '[::1]'].includes(location.hostname)
+) {
+  const root = createRoot(document.getElementById('root')!)
+  import.meta.hot?.dispose(() => root.unmount())
+  root.render(
+    <LabelsProvider>
+      <ThemeProvider>
+        <Review />
+      </ThemeProvider>
+    </LabelsProvider>,
+  )
+} else {
+  document.body.textContent = 'Local development review only.'
+}
