+import { useLocale } from '#/app/providers/labels-provider'
+import { FormField, Input, Textarea } from '#/components/ui/input'
+import { Select } from '#/components/ui/select'
+import { Checkbox } from '#/components/ui/choice'
+import { Combobox } from '#/components/ui/combobox'
+import { DatePicker } from '#/components/ui/date-picker'
+import type { OrderDraftValues } from './order-ui-values'
+
+export type UiText = readonly [string, string]
+export type UiOption = { value: string; label: UiText }
+export type OrderUiField = {
+  key: string
+  label: UiText
+  type?: 'text' | 'textarea' | 'boolean' | 'select' | 'entity' | 'date'
+  options?: UiOption[]
+  required?: boolean
+  maxLength?: number
+  readonly?: boolean
+  wide?: boolean
+}
+export function useOrderUiText() {
+  const { locale } = useLocale()
+  return (text: UiText) => text[locale === 'el' ? 1 : 0]
+}
+export const editText: UiText = ['Edit', 'Επεξεργασία']
+export const cancelText: UiText = ['Cancel', 'Ακύρωση']
+export const saveText: UiText = ['Save', 'Αποθήκευση']
+export function OrderUiControl({
+  field,
+  value,
+  onChange,
+  disabled = false,
+}: {
+  field: OrderUiField
+  value: string
+  onChange: (value: string) => void
+  disabled?: boolean
+}) {
+  const t = useOrderUiText()
+  const label = t(field.label)
+  if (field.type === 'boolean')
+    return (
+      <Checkbox
+        label={label}
+        checked={value === 'true'}
+        disabled={disabled || field.readonly}
+        onChange={(e) => onChange(String(e.target.checked))}
+      />
+    )
+  return (
+    <FormField
+      label={label}
+      required={field.required}
+      className={field.wide ? 'md:col-span-2 xl:col-span-4' : undefined}
+    >
+      {field.readonly ? (
+        <p className="min-h-10 whitespace-pre-wrap break-words rounded-md bg-surface-2 px-3 py-2 text-sm">
+          {field.options?.find((o) => o.value === value)
+            ? t(field.options.find((o) => o.value === value)!.label)
+            : value || '—'}
+        </p>
+      ) : field.type === 'textarea' ? (
+        <Textarea
+          aria-label={label}
+          value={value}
+          disabled={disabled}
+          maxLength={field.maxLength}
+          onChange={(e) => onChange(e.target.value)}
+        />
+      ) : field.type === 'entity' ? (
+        <div role="group" aria-label={label}>
+          <Combobox
+            options={(field.options ?? []).map((o) => ({
+              value: o.value,
+              label: t(o.label),
+            }))}
+            value={value}
+            disabled={disabled}
+            onChange={onChange}
+            placeholder={t(['Select…', 'Επιλογή…'])}
+          />
+        </div>
+      ) : field.type === 'select' ? (
+        <Select
+          aria-label={label}
+          value={value}
+          disabled={disabled}
+          onChange={(e) => onChange(e.target.value)}
+        >
+          <option value="">—</option>
+          {field.options?.map((o) => (
+            <option key={o.value} value={o.value}>
+              {t(o.label)}
+            </option>
+          ))}
+        </Select>
+      ) : field.type === 'date' ? (
+        <div role="group" aria-label={label}>
+          <DatePicker
+            value={value ? new Date(value + 'T12:00:00') : null}
+            disabled={disabled}
+            onChange={(date) =>
+              onChange(
+                `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`,
+              )
+            }
+          />
+        </div>
+      ) : (
+        <Input
+          aria-label={label}
+          value={value}
+          disabled={disabled}
+          maxLength={field.maxLength}
+          onChange={(e) => onChange(e.target.value)}
+        />
+      )}
+    </FormField>
+  )
+}
+export function fieldsError(
+  fields: OrderUiField[],
+  values: OrderDraftValues,
+): UiText | undefined {
+  if (fields.some((f) => f.required && !values[f.key]?.trim()))
+    return [
+      'Complete the required fields.',
+      'Συμπληρώστε τα απαιτούμενα πεδία.',
+    ]
+  if (
+    fields.some(
+      (f) => f.maxLength && (values[f.key]?.length ?? 0) > f.maxLength,
+    )
+  )
+    return [
+      'A value exceeds its character limit.',
+      'Μια τιμή υπερβαίνει το όριο χαρακτήρων.',
+    ]
+}
