+            </TH>
+            <TH>{text.trackingCode}</TH>
+            <TH>{text.measurements}</TH>
+            <TH>{text.grossKg}</TH>
+            <TH>{text.netKg}</TH>
+            <TH>{text.flags}</TH>
+          </TR>
+        </THead>
+        <TBody>
+          {units.map((unit) => {
+            const id = String(unit.id)
+            const expanded = expandedIds.has(id)
+            const Icon = expanded ? ChevronDown : ChevronRight
+            return (
+              <Fragment key={id}>
+                <TR>
+                  <TD className="w-12">
+                    <Button
+                      variant="ghost"
+                      type="button"
+                      className="w-10 shrink-0 px-0"
+                      aria-label={`${expanded ? text.collapseColli : text.expandColli} ${unit.trackingCode}`}
+                      aria-expanded={expanded}
+                      aria-controls={`colli-details-${id}`}
+                      onClick={() => onToggle(id)}
+                    >
+                      <Icon className="size-4" aria-hidden />
+                    </Button>
+                  </TD>
+                  <TD>
+                    <Link
