+              aria-label={t(['Operational reason', 'Επιχειρησιακή αιτιολογία'])}
+              value={reason}
+              disabled={pending}
+              maxLength={1000}
+              onChange={(e) => setReason(e.target.value)}
+            />
+          </div>
+        )}
+        {error && (
+          <p role="alert" className="mt-3 text-danger-fg">
+            {error}
+          </p>
+        )}
+      </Modal>
+    </Card>
+  )
+}
+
+function EditableRow(
+  props: EditableRowsProps & {
+    row: SavedOrderUiRow
+    index: number
+    isNew: boolean
+    expanded: boolean
+    toggle: () => void
+    selected: boolean
+    select: (checked: boolean) => void
+    save: (
+      values: OrderDraftValues,
+      revision: string,
+    ) => Promise<SavedOrderUiRow>
+    discard: () => void
+    remove: () => void
+    canRemove: boolean
+  },
+) {
+  const t = useOrderUiText()
+  const { enumLabel } = usePurchaseOrderLabels()
+  const [editing, setEditing] = useState(props.isNew)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState('')
+  const [baseline, setBaseline] = useState(props.row.revision)
+  const editRef = useRef<HTMLButtonElement>(null)
+  const callback = useRef(props.onDraftChange)
+  callback.current = props.onDraftChange
+  useEffect(() => {
+    callback.current?.(props.row.id, editing)
+    return () => callback.current?.(props.row.id, false)
+  }, [editing, props.row.id])
+  const form = useAppForm({
+    defaultValues: props.row.values,
+    onSubmit: async ({ value }) => {
+      if (pending || !props.editable || props.row.terminal) return
+      const invalid = fieldsError(props.fields, value)
+      if (invalid) {
+        setError(t(invalid))
+        return
+      }
+      if (
+        props.kind === 'invoice' &&
+        invoiceTotal(value.quantity, value.price) === null
+      ) {
+        setError(
+          t([
+            'Enter a positive integer quantity and valid price with up to two decimals, within the permitted total.',
+            'Εισαγάγετε θετική ακέραια ποσότητα και έγκυρη τιμή έως δύο δεκαδικά εντός ορίου.',
+          ]),
+        )
+        return
+      }
+      if (
+        props.kind === 'colli' &&
+        ['length', 'width', 'height', 'gross', 'net'].some(
+          (key) =>
+            value[key] !== '' &&
+            (!Number.isFinite(Number(value[key])) || Number(value[key]) <= 0),
+        )
+      ) {
+        setError(
+          t([
+            'Measurements must be positive numbers or empty.',
+            'Οι μετρήσεις πρέπει να είναι θετικές ή κενές.',
+          ]),
+        )
+        return
+      }
+      if (props.row.revision !== baseline) {
+        setError(
+          t([
+            'This record changed. Cancel and reopen to review it; your draft is retained.',
+            'Η εγγραφή άλλαξε. Ακυρώστε και ανοίξτε ξανά για έλεγχο· το πρόχειρο διατηρείται.',
+          ]),
+        )
+        return
+      }
+      setPending(true)
+      setError('')
+      try {
+        await props.save(value, baseline)
+        setEditing(false)
+        requestAnimationFrame(() => editRef.current?.focus())
+      } catch (e) {
+        setError(
+          e instanceof Error
+            ? e.message
+            : t(['Save failed.', 'Η αποθήκευση απέτυχε.']),
+        )
+      } finally {
+        setPending(false)
+      }
+    },
+  })
+  const cancel = () => {
+    if (pending) return
+    props.isNew ? props.discard() : setEditing(false)
+    setError('')
+    requestAnimationFrame(() => editRef.current?.focus())
+  }
+  const flags = ['dg', 'fragile', 'unpacked', 'damagedPacking']
+  const field = (key: string, values: OrderDraftValues) => {
+    const def = props.fields.find((f) => f.key === key)
+    if (!def) return null
+    return (
+      <OrderUiControl
+        field={def}
+        value={values[key] ?? ''}
+        disabled={pending || !props.editable}
+        onChange={(v) => {
+          form.setFieldValue(key, v)
+          if (key === 'dg' && v === 'false') {
+            form.setFieldValue('dgClass', '')
+            form.setFieldValue('dgText', '')
+          }
+        }}
+      />
+    )
+  }
+  return (
+    <form.Subscribe selector={(state) => state.values}>
+      {(draft) => {
+        const values = editing ? draft : props.row.values
+        const controls = (
+          <div className="flex flex-wrap gap-2">
+            {editing ? (
+              <>
+                <Button
+                  size="sm"
+                  variant="secondary"
+                  disabled={pending}
+                  onClick={cancel}
+                >
+                  {t(cancelText)}
+                </Button>
+                <Button
+                  size="sm"
+                  loading={pending}
+                  onClick={() => void form.handleSubmit()}
+                >
+                  {t(saveText)}
+                </Button>
+              </>
+            ) : props.editable && !props.row.terminal ? (
+              <>
+                <Button
+                  ref={editRef}
+                  size="sm"
+                  variant="secondary"
+                  onClick={() => {
+                    form.reset(props.row.values)
+                    setBaseline(props.row.revision)
+                    setEditing(true)
+                    if (!props.expanded) props.toggle()
+                  }}
+                >
+                  {t(editText)}
+                </Button>
+                <Button
+                  size="sm"
+                  variant="ghost"
+                  disabled={!props.canRemove}
+                  onClick={props.remove}
+                >
+                  {t(['Remove', 'Αφαίρεση'])}
+                </Button>
+              </>
+            ) : null}
+          </div>
+        )
+        return (
+          <Fragment>
+            <TR
+              onKeyDown={(e) => {
+                if (editing && e.key === 'Escape') {
+                  e.preventDefault()
+                  cancel()
+                }
+              }}
+            >
+              {props.kind === 'colli' ? (
+                <>
+                  <TD>
+                    <Checkbox
+                      aria-label={`${t(['Select colli', 'Επιλογή κόλλι'])} ${props.row.id}`}
+                      checked={props.selected}
+                      disabled={
+                        props.isNew ||
+                        !!props.row.terminal ||
+                        (!props.editable &&
+                          !props.canSplit &&
+                          !props.canDispose)
+                      }
+                      onChange={(e) => props.select(e.target.checked)}
+                    />
+                  </TD>
+                  <TD>
+                    <Button
+                      variant="ghost"
+                      size="sm"
+                      aria-expanded={props.expanded || editing}
+                      onClick={props.toggle}
+                    >
+                      {props.row.id}
+                    </Button>
+                    {!props.isNew && props.onTrace && (
+                      <Button
+                        variant="ghost"
+                        size="sm"
+                        onClick={() => props.onTrace?.(props.row)}
+                      >
+                        {t(['Trace', 'Ιχνηλασιμότητα'])}
+                      </Button>
+                    )}
+                    {props.row.terminal && (
+                      <Badge tone="danger">
+                        {enumLabel(props.row.terminal)}
+                      </Badge>
+                    )}
+                  </TD>
+                  <TD>
+                    <div className="flex max-w-60 flex-wrap gap-2">
+                      {flags.map((key) =>
+                        editing ? (
+                          <Fragment key={key}>{field(key, values)}</Fragment>
+                        ) : values[key] === 'true' ? (
+                          <Badge
+                            key={key}
+                            tone={key === 'dg' ? 'danger' : 'neutral'}
+                          >
+                            {t(props.fields.find((f) => f.key === key)!.label)}
+                          </Badge>
+                        ) : null,
+                      )}
+                    </div>
+                  </TD>
+                  <TD>
+                    {editing ? (
+                      <div className="flex min-w-60 gap-2">
+                        {['length', 'width', 'height'].map((key) => (
+                          <div key={key} className="w-20">
+                            {field(key, values)}
+                          </div>
+                        ))}
+                      </div>
+                    ) : (
+                      ['length', 'width', 'height']
+                        .map((k) => values[k] || '—')
+                        .join(' × ')
+                    )}
+                  </TD>
+                  <TD>
+                    {editing ? (
+                      <div className="w-28">{field('gross', values)}</div>
+                    ) : (
+                      values.gross || '—'
+                    )}
+                  </TD>
+                  <TD>
+                    {editing ? (
+                      <div className="w-28">{field('net', values)}</div>
+                    ) : (
+                      values.net || '—'
+                    )}
+                  </TD>
+                  <TD>{controls}</TD>
+                </>
+              ) : (
+                <>
+                  <TD>{props.index + 1}</TD>
+                  {[
+                    'description',
+                    'hs',
+                    'quantity',
+                    'unit',
+                    'price',
+                    'currency',
+                  ].map((key) => (
+                    <TD key={key}>
+                      {editing ? (
+                        <div
+                          className={
+                            key === 'description' ? 'min-w-48' : 'min-w-24'
+                          }
+                        >
+                          {field(key, values)}
+                        </div>
+                      ) : (
+                        values[key] || '—'
+                      )}
+                    </TD>
+                  ))}
+                  <TD>
+                    <span className="whitespace-nowrap font-mono">
+                      {invoiceTotal(values.quantity, values.price) ?? '—'}
+                    </span>
+                  </TD>
+                  <TD>{controls}</TD>
+                </>
+              )}
+            </TR>
+            {props.kind === 'colli' && (props.expanded || editing) && (
+              <TR
+                onKeyDown={(e) => {
+                  if (editing && e.key === 'Escape') {
+                    e.preventDefault()
+                    cancel()
+                  }
+                }}
+              >
+                <TD colSpan={7}>
+                  <div
+                    className="sticky left-0 w-[calc(100vw-8rem)] max-w-full space-y-4 rounded-md border border-border bg-surface-2 p-4 md:w-auto"
+                    onKeyDown={(e) => {
+                      if (e.key === 'Escape') cancel()
+                    }}
+                  >
+                    <div className="grid gap-4 md:grid-cols-2">
+                      {['description', 'packageType'].map((key) => (
+                        <Fragment key={key}>
+                          {editing ? (
+                            field(key, values)
+                          ) : (
+                            <OrderUiControl
+                              field={{
+                                ...props.fields.find((f) => f.key === key)!,
+                                readonly: true,
+                              }}
+                              value={values[key] ?? ''}
+                              onChange={() => {}}
+                            />
+                          )}
+                        </Fragment>
+                      ))}
+                    </div>
+                    {values.dg === 'true' && (
+                      <div className="space-y-3 border-t border-border pt-3">
+                        <h4 className="text-xs font-semibold">
+                          {t(['Dangerous goods', 'Επικίνδυνα εμπορεύματα'])}
+                        </h4>
+                        <div className="grid gap-4 md:grid-cols-2">
+                          {['dgClass', 'dgText'].map((key) => (
+                            <Fragment key={key}>
+                              {editing ? (
+                                field(key, values)
+                              ) : (
+                                <OrderUiControl
+                                  field={{
+                                    ...props.fields.find((f) => f.key === key)!,
+                                    readonly: true,
+                                  }}
+                                  value={values[key] ?? ''}
+                                  onChange={() => {}}
+                                />
+                              )}
+                            </Fragment>
+                          ))}
+                        </div>
+                      </div>
+                    )}
+                    {error && (
+                      <p role="alert" className="text-danger-fg">
+                        {error}
+                      </p>
+                    )}
+                  </div>
+                </TD>
+              </TR>
+            )}
+            {props.kind === 'invoice' && error && (
+              <TR
+                onKeyDown={(e) => {
+                  if (editing && e.key === 'Escape') {
+                    e.preventDefault()
+                    cancel()
+                  }
+                }}
+              >
+                <TD colSpan={9}>
+                  <p role="alert" className="text-danger-fg">
+                    {error}
+                  </p>
+                </TD>
+              </TR>
+            )}
+          </Fragment>
+        )
+      }}
+    </form.Subscribe>
+  )
+}
