+        onClose={() => setChoose(false)}
+        title={t(['Choose one correction', 'Επιλέξτε μία διόρθωση'])}
+        ariaLabel={t(['Choose one correction', 'Επιλέξτε μία διόρθωση'])}
+      >
+        <div className="flex flex-col gap-3">
+          {props.modes.map((m) => (
+            <Button key={m} variant="secondary" onClick={() => start(m)}>
