+          next.delete(remove.id)
+          return next
+        })
+        setRemove(null)
+      } else if (operation && props.onOperation) {
+        const stale =
+          reviewedRows.length !== selectedRows.length ||
+          reviewedRows.some(
+            (r) =>
+              !selectedRows.some(
+                (current) =>
+                  current.id === r.id && current.revision === r.revision,
+              ),
+          )
+        if (
+          stale ||
+          (operation === 'split'
+            ? !props.canSplit ||
+              selectedRows.length < 1 ||
+              selectedRows.length >= active.length
+            : !props.canDispose || selectedRows.length !== 1)
+        )
