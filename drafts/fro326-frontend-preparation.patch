+              {t(['Back', 'Πίσω'])}
+            </Button>
+            <Button loading={pending} onClick={() => void confirm()}>
+              {t(['Confirm save', 'Επιβεβαίωση αποθήκευσης'])}
+            </Button>
+          </>
+        }
+      >
+        <div className="max-h-[60vh] space-y-4 overflow-y-auto">
+          {review &&
+            Object.entries(review.intent.values)
+              .filter(
+                ([key, v]) =>
+                  key !== 'reason' && v !== (saved.values[key] ?? ''),
+              )
+              .map(([key, v]) => (
+                <p key={key}>
