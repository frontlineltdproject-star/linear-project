+                ])}{' '}
+            {remove.id}
+          </p>
+        ) : (
+          <div className="space-y-3">
+            <p>{selectedRows.map((r) => r.id).join(', ')}</p>
+            {operation === 'terminal' && (
+              <Select
+                aria-label={t(['Disposition', 'Διάθεση'])}
+                value={disposition}
+                disabled={pending}
+                onChange={(e) => setDisposition(e.target.value)}
+              >
+                {[
+                  'DAMAGED',
+                  'UNCOLLECTABLE',
+                  'MISSING',
+                  'CANCELLED',
+                  'OTHER',
+                ].map((value) => (
